<script defer>
window.addEventListener('DOMContentLoaded', function () {
const widget = document.getElementById('trentino-widget');

const btn = document.getElementById('chiedi-btn');
if (btn) {
btn.addEventListener('click', () => { widget.open(); });
btn.addEventListener('mouseenter', () => btn.style.opacity = '0.88');
btn.addEventListener('mouseleave', () => btn.style.opacity = '1');
}

widget.addEventListener('fw:close', () => {
const locale = document.documentElement.lang || 'it';

// 1. Login locale (backend invariato: ritorna { authenticated })
fetch('/sso/session-check', { credentials: 'include' })
.then(r => r.json())
.then(({ authenticated }) => {
// 2. Già loggato da me → mi fermo
if (authenticated) return;

// 3. Non loggato in VT: controllo MioTrentino
return fetch('https://account.miotrentino.info/TTA_SessionJson', {
method: 'GET',
credentials: 'include'
})
.then(r => r.json())
.then((data) => {
// 4. Loggato dall'altra parte → redirect per loggarlo anche da me
if (data && data.authenticated === true) {
window.location.href = '/sso/silent-login?locale=' + locale
+ '&returnUrl=' + encodeURIComponent(window.location.href);
}
});
})
.catch((err) => { console.error('[MIA] session check failed:', err); });
});

});

</script>

<script defer>
window.addEventListener('DOMContentLoaded', function () {
if (!location.pathname.includes('_md_')) return;

const h1 = document.querySelector('h1');
if (!h1 || document.getElementById('tta-ask-btn')) return;

//const title = document.title.trim();
const title = (h1.textContent || '').trim();
if (!title) return;

  

// fine del blocco che contiene l'h1 (la col dentro la .row), sotto la subline
const block = h1.closest('.col-md-12') || h1.parentElement;

const row = document.createElement('div');
row.className = 'tta-ask-row pb30';
const btn = document.createElement('a');
btn.id = 'tta-ask-btn';
btn.href = '#';
btn.setAttribute('role', 'button');
btn.className = 'btn btn-secondary strong mt30';
btn.textContent = "Ask the AI assistant";

btn.addEventListener('click', function (e) {
e.preventDefault();
const widget = document.getElementById('trentino-widget')
|| document.querySelector('floating-widget');
if (!widget) return;

if (typeof widget.openTTA === 'function') {
widget.openTTA({ action: 'I would like more information on ' + title });
} else if (typeof widget.open === 'function') {
widget.open(); // fallback se openTTA non è disponibile
}
});

row.appendChild(btn);
block.appendChild(row);
});
</script>




</body>
</html>