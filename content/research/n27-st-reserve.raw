<script>var clickMe = document.querySelector('#click-me');

			// This will run when the .click-me element is clicked
			clickMe.addEventListener('click', function (event) {

				event.preventDefault();
				clickMe.style.display = 'none';

if (!('remove' in Element.prototype)) {
			Element.prototype.remove = function() {
				if (this.parentNode) {
				this.parentNode.removeChild(this);
				}
			};
			}
			var $features = [{"type":"Feature","properties":{"message":"Jonkershoek Nature Reserve","iconSize":[30,30],"image":"https:\/\/www.capenature.co.za\/uploads\/imager\/files\/3199\/Jonkershoek-Circular-Drive-Out-5_W100_H100_P61-64-39-14.jpg","summary":"This nature reserve is home to the majestic Jonkershoek mountains and valley.","city":" ","url":"https:\/\/www.capenature.co.za\/reserves\/jonkershoek-nature-reserve","entryId":19639},"geometry":{"type":"Point","coordinates":["18.92555","-33.963527777778"]}}]
				mapboxgl.accessToken = '[REDACTED_EMBEDDED_PUBLIC_MAPBOX_TOKEN]';
				
				
				var mapAttraction = new mapboxgl.Map({
					container: 'mapAttraction',
					style: 'mapbox://styles/mapbox/streets-v11', // replace this with your style URL
					center: $features[0].geometry.coordinates,
					zoom: 6.75,
					attributionControl: false

				});

				// first coordinate in features
				let co = $features[0].geometry.coordinates;

				// we want to determine the bounds for the features data
				let bounds = $features.reduce((bounds, feature) => {
				return bounds.extend(feature.geometry.coordinates);
				}, new mapboxgl.LngLatBounds(co[0].lng, co[0].lat));

				// set bounds according to features
				mapAttraction.fitBounds(bounds, {
				maxZoom: 6.75,
				});
				var geojson = {
					"type": "FeatureCollection",
					"features": $features
				};
				var i = -1;
				geojson.features.forEach(function(marker) {
					i = i + 1;
					// create a DOM element for the marker
					var el = document.createElement('div');
					el.className = 'marker active';
					el.style.content = 'url(/uploads/files/map.png)';
					el.style.width = marker.properties.iconSize[0] + 'px';
					el.style.height = marker.properties.iconSize[1] + 'px';
					el.color = "#00ADF0";
				
					// add marker to map
					new mapboxgl.Marker(el)
					.setLngLat(marker.geometry.coordinates)
					.setPopup(new mapboxgl.Popup({ offset: 25 }).setMaxWidth(200) // add popups
					.setHTML('<div class="d-flex align-items-center"><div class="w-50"><img src="'+ marker.properties.image +'" class="w-100"></div><div class="flex-grow-1 pl-1"><div class="w-100 d-flex justify-between align-items-center"><a href="'+ marker.properties.url +'"><h6>' + marker.properties.message + '&nbsp;&nbsp;</h6></a></div><p class="mb-0">' + marker.properties.city + '</p></div></div>'))
					.addTo(mapAttraction);

					

					var currentFeature = marker;
					var prop = currentFeature.properties;
					var listings = document.getElementById('listings');
					var listing = listings.appendChild(document.createElement('div'));
					listing.className = 'item map-item';
					listing.id = 'listing-' + i;

					var link = listing.appendChild(document.createElement('a'));
					link.href = '#';
					link.className = 'title d-flex align-items-center p-1 border-bottom';
					link.dataPosition = i;
					link.innerHTML = '<div class="col-3 col-lg-2 px-0"><img src="'+marker.properties.image+'" class="w-100"></div><div class="col-9 col-lg-10 d-flex flex-column"><div class="d-flex align-items-center"><h5 class="text-dark mb-1">'+marker.properties.message+'</h5><i class="far fa-chevron-right ml-auto"></i></div><span class="small text-dark">'+marker.properties.summary+'</span></div>';

					link.addEventListener('click', function(e) {
						var clickedListing = $features[this.dataPosition];

						e.preventDefault();

						flyToStore(clickedListing);
						createPopUp(clickedListing).setMaxWidth(400);
						var activeItem = document.getElementsByClassName('active');
						
						if (activeItem[0]) {
							activeItem[0].classList.remove('active');
						}

						var listing = document.getElementById(marker.properties.entryId);
						console.log(listing);
						listing.classList.add('active');

						return false;
					});
					
				});

				function flyToStore(currentFeature) {
					mapAttraction.flyTo({
						center: currentFeature.geometry.coordinates,
						zoom: 10
					});
				}

				function createPopUp(currentFeature) {
				var popUps = document.getElementsByClassName('mapboxgl-popup');
				// Check if there is already a popup on the map and if so, remove it
				if (popUps[0]) popUps[0].remove();

				var popup = new mapboxgl.Popup({ closeOnClick: false })
					.setLngLat(currentFeature.geometry.coordinates)
					.setHTML( 
					'<div class="d-flex align-items-center"><div class="w-50"><img src="'+ currentFeature.properties.image +'" class="w-100"></div><div class="flex-grow-1 pl-1"><div class="w-100 d-flex justify-between align-items-center"><a href="'+ currentFeature.properties.url +'"><h6>' + currentFeature.properties.message + '&nbsp;&nbsp;</h6></a></div><p class="mb-0">' + currentFeature.properties.city + '</p></div></div> ')
					.setMaxWidth(200)
					.addTo(mapAttraction);
				}



				// disable map zoom when using scroll
				$(window).bind('mousewheel DOMMouseScroll', function(event) 
				{
					if(event.ctrlKey == true) {
						mapAttraction['scrollZoom'].enable();
					}
					else {
						mapAttraction['scrollZoom'].disable();
					}
				});



			});</script></body>
</html>