---
import { dictionary, continents, type Locale } from '../i18n';
import { destinations } from '../data/destinations';
import { route } from '../lib/routes';
import { production } from '../lib/site';
import { forLocale, articlePath, photoFor, photoSrcSet } from '../lib/content';
import Icon from './Icon.astro';
import TravelGlobe from './TravelGlobe.astro';
import Card from './DestinationCard.astro';
import Advertisement from './Advertisement.astro';
const { lang, showHeroAdvertisement = false } = Astro.props as { lang: Locale; showHeroAdvertisement?: boolean };
const t = dictionary[lang];
const articles = forLocale(lang);
const available = destinations.filter((d) => articles.some((a) => a.destinationId === d.id));
const chosen = ['tokyo', 'paris', 'bali']
  .map((id) => available.find((d) => d.id === id))
  .filter(Boolean);
const seasonal = ['halloween-ireland', 'halloween-japan', 'muertos-mexico-city', 'muertos-merida']
  .map((id) => available.find((d) => d.id === id))
  .filter((d) => d && articles.some((a) => a.destinationId === d.id));
const christmas = ['christmas-new-york', 'christmas-strasbourg', 'christmas-vienna', 'christmas-rovaniemi']
  .map((id) => available.find((d) => d.id === id))
  .filter((d) => d && articles.some((a) => a.destinationId === d.id));
---

<section class="shell explorer-hero" aria-labelledby="hero-heading">
  <div class="explorer-copy">
    <span class="eyebrow atlas-eyebrow"><span></span>{lang === 'es' ? '02 · ATLAS' : '02 · ATLAS'}</span>
    <h1 id="hero-heading"><span>{lang === 'es' ? 'El mundo' : 'A world'}</span><em>{lang === 'es' ? 'te espera' : 'awaits you'}</em></h1>
    <p>{lang === 'es' ? 'Ideas, guías y destinos para vivir viajes que te hacen bien.' : 'Ideas, guides and destinations for journeys that make you feel alive.'}</p>
    <form class="explorer-search" action={route(lang, 'search')} role="search">
      <Icon name="search" size={22} />
      <label class="sr-only" for="destination-search">{t.searchLabel}</label>
      <input id="destination-search" name="q" placeholder={lang === 'es' ? '¿A dónde quieres viajar?' : 'Where would you like to go?'} maxlength="100" />
      <label class="sr-only" for="hero-continent">{t.continent}</label>
      <select id="hero-continent" name="continent"><option value="all">{lang === 'es' ? 'Cualquier destino' : 'Any destination'}</option>{Object.entries(continents).filter(([key]) => available.some(d => d.continent === key)).map(([key,names]) => <option value={key}>{names[lang]}</option>)}</select>
      <button type="submit" aria-label={t.search}><Icon name="search" size={23}/></button>
    </form>
    <div class="explorer-promises">
      <span><Icon name="compass" size={29}/><span>{lang === 'es' ? 'Destinos' : 'Incredible'}<br/>{lang === 'es' ? 'increíbles' : 'destinations'}</span></span>
      <span><Icon name="book" size={29}/><span>{lang === 'es' ? 'Guías' : 'Practical'}<br/>{lang === 'es' ? 'prácticas' : 'guides'}</span></span>
      <span><Icon name="mountain" size={29}/><span>{lang === 'es' ? 'Inspiración' : 'Inspiration'}<br/>{lang === 'es' ? 'para tu próximo viaje' : 'for your next trip'}</span></span>
      <span><Icon name="sun" size={29}/><span>{lang === 'es' ? 'Viajar' : 'Travel'}<br/>{lang === 'es' ? 'te hace feliz' : 'makes you happy'}</span></span>
    </div>
  </div>
  <TravelGlobe lang={lang}/>
</section>
{showHeroAdvertisement && <Advertisement lang={lang} placement="top" />}
<section class="continent-band">
  <div class="shell">
    <div class="section-heading">
      <div>
        <span class="eyebrow orange">
          {lang === 'es'
            ? 'SIN FRONTERAS PARA LA CURIOSIDAD'
            : 'CURIOSITY HAS NO BORDERS'}
        </span>
        <h2>{lang === 'es' ? 'Explora por continente' : 'Explore by continent'}</h2>
        <p>{t.continentsText}</p>
      </div>
      <a class="text-link" href={route(lang, 'destinations')}>{lang === 'es' ? 'Ver todos los destinos' : 'View all destinations'}<Icon/></a>
    </div>
    <div class="continent-photo-grid">
      {['europe', 'asia', 'america', 'africa', 'oceania'].map(key => {
        const names = continents[key as keyof typeof continents];
        const descriptions: Record<string, string[]> = {europe:['Historia, cultura y paisajes inolvidables','History, culture and unforgettable scenery'], asia:['Tradición, modernidad y experiencias únicas','Tradition, modernity and unique experiences'], america:['Naturaleza, aventura y grandes contrastes','Nature, adventure and striking contrasts'], africa:['Paisajes épicos y culturas fascinantes','Epic landscapes and fascinating cultures'], oceania:['Islas, montañas y horizontes abiertos','Islands, mountains and open horizons']};
        const preferred: Record<string,string> = {europe:'rome', asia:'kyoto', america:'rio', africa:'cape-town', oceania:'queenstown'};
        const d = available.find(d => d.id === preferred[key]) || available.find(d => d.continent === key);
        const a = d && articles.find(a => a.destinationId === d.id);
        const image = a && photoFor(a.coverImageId);
        return image && <a href={route(lang, 'explore', key)} class="continent-photo">
          <img src={image.src} srcset={photoSrcSet(image)} sizes="(max-width: 540px) 80vw, 25vw" width={image.width} height={image.height} alt={image.alt[lang]} loading="lazy" />
          <span class="continent-photo-copy"><small>{lang === 'es' ? 'EXPLORA' : 'EXPLORE'}</small><strong>{names[lang]}</strong><span class="continent-description">{descriptions[key][lang === 'es' ? 0 : 1]}</span><Icon/></span>
          <span class="continent-photo-credit">{image.credit} · {image.license}</span>
        </a>;
      })}
    </div>
  </div>
</section>
{christmas.length > 0 && (
  <section class="shell section" aria-labelledby="christmas-heading">
    <div class="section-heading">
      <div>
        <span class="eyebrow orange">{lang === 'es' ? 'PREPARÁ TU VIAJE DE NAVIDAD' : 'PLAN YOUR CHRISTMAS TRIP'}</span>
        <h2 id="christmas-heading">{lang === 'es' ? 'Navidad 2026: ciudades, luces y mercadillos' : 'Christmas 2026: cities, lights and markets'}</h2>
        <p>{lang === 'es' ? 'Rutas, fotos reales y consejos para elegir destino y comprobar las fechas antes de reservar.' : 'Routes, real photographs and advice for choosing a destination and checking dates before booking.'}</p>
      </div>
      <a class="text-link" href={route(lang, 'christmas')}>
        {lang === 'es' ? 'Ver todas las guías de Navidad' : 'Explore all Christmas guides'} <Icon />
      </a>
    </div>
    <div class="card-grid">{christmas.map((d) => <Card destination={d!} lang={lang} />)}</div>
  </section>
)}
<section class="shell section">
  <div class="section-heading">
    <div>
      <span class="eyebrow orange">
        {lang === 'es'
          ? 'LA INSPIRACIÓN VA EN LA MALETA'
          : 'PACK A LITTLE INSPIRATION'}
      </span>
      <h2>{lang === 'es' ? 'Destinos que inspiran' : 'Destinations to inspire you'}</h2>
      <p>{t.featuredText}</p>
    </div>
    <a class="text-link" href={route(lang, 'guides')}>
      {t.viewAll}
      <Icon />
    </a>
  </div>
  <div class="featured-grid">
    {chosen.map((d) => (
      <Card destination={d!} lang={lang} large />
    ))}
  </div>
  {!production && <p class="preview-explanation">{t.previewNote}</p>}
</section>

<section class="shell section">
  <div class="section-heading">
    <div>
      <span class="eyebrow orange">
        {lang === 'es'
          ? 'EL PRÓXIMO VIAJE EMPIEZA AQUÍ'
          : 'YOUR NEXT JOURNEY STARTS HERE'}
      </span>
      <h2>{t.destinationsTitle}</h2>
    </div>
    <a class="text-link" href={route(lang, 'destinations')}>
      {t.viewAll}
      <Icon />
    </a>
  </div>
  <div class="card-grid">
    {['miami', 'rome', 'queenstown', 'cape-town']
      .map((id) => available.find((d) => d.id === id))
      .filter(Boolean)
      .map((d) => (
        <Card destination={d!} lang={lang} />
      ))}
  </div>
</section>
<section
  class="shell category-strip"
  aria-label={lang === 'es' ? 'Categorías turísticas' : 'Travel categories'}
>
  {[
    ['cities', t.cities, 'city'],
    ['nature', t.nature, 'mountain'],
    ['culture', t.culture, 'book'],
    ['beaches', t.beaches, 'sun'],
    ['festivals', lang === 'es' ? 'Festividades' : 'Festivals', 'compass'],
  ].filter(([key]) => available.some(d => d.categories.includes(key))).map(([key, label, icon]) => (
    <a href={route(lang, 'explore', `category-${key}`)}>
      <Icon name={icon} size={26} />
      <span>{label}</span>
      <Icon size={16} />
    </a>
  ))}
</section>
{seasonal.length > 0 && (
  <section class="shell section" aria-labelledby="seasonal-heading">
    <div class="section-heading">
      <div>
        <span class="eyebrow orange">{lang === 'es' ? 'VIAJAR EN ESTAS FECHAS' : 'SEASONAL TRAVEL'}</span>
        <h2 id="seasonal-heading">{lang === 'es' ? 'Guías por temporada' : 'Seasonal travel guides'}</h2>
        <p>{lang === 'es'
          ? 'Ideas para elegir destino, entender las celebraciones y comprobar fechas antes de viajar.'
          : 'Choose a destination, understand the celebrations and check dates before travelling.'}</p>
      </div>
      <a class="text-link" href={route(lang, 'explore', 'category-festivals')}>
        {lang === 'es' ? 'Ver todas las guías' : 'View all guides'} <Icon />
      </a>
    </div>
    <div class="card-grid">
      {seasonal.map((d) => <Card destination={d!} lang={lang} />)}
    </div>
  </section>
)}
<section class="shell manifesto-wrap">
  <div class="manifesto">
    <div class="manifesto-mark">
      <img class="brand-icon-3d" src="/brand/icon-3d.webp" width="150" height="150" alt="" />
      <span class="orbit orbit-one"></span>
      <span class="orbit orbit-two"></span>
      <Icon name="compass" size={34} />
    </div>
    <div>
      <span class="eyebrow orange">{t.verified}</span>
      <h2>{t.manifesto}</h2>
      <p>{t.manifestoText}</p>
      <a class="text-link" href={route(lang, 'info', 'editorial')}>
        {t.manifestoLink}
        <Icon />
      </a>
    </div>
  </div>
</section>
<section class="shell section">
  <div class="section-heading">
    <div>
      <span class="eyebrow orange">
        {lang === 'es'
          ? 'PEQUEÑAS IDEAS, GRANDES VIAJES'
          : 'SMALL IDEAS, GREAT JOURNEYS'}
      </span>
      <h2>{t.countryTitle}</h2>
    </div>
  </div>
  <div class="country-grid">
    {[...new Map(available.map((d) => [d.countryId, d])).values()]
      .slice(0, 8)
      .map((d) => (
        <a href={route(lang, 'explore', `country-${d.countryId}`)}>
          <Icon name="pin" size={18} />
          <span>{d.country[lang]}</span>
          <Icon size={18} />
        </a>
      ))}
  </div>
</section>
{articles.length > 0 && (
  <section class="shell section">
    <h2>{lang === 'es' ? 'Últimos artículos' : 'Latest stories'}</h2>
    <div class="recent-list">
      {articles
        .toSorted(
          (a, b) =>
            Date.parse(b.publishedAt || '') - Date.parse(a.publishedAt || ''),
        )
        .slice(0, 6)
        .map((a) => (
          <a href={articlePath(a)}>
            {photoFor(a.coverImageId) && <img src={photoFor(a.coverImageId)!.src} srcset={photoSrcSet(photoFor(a.coverImageId)!)} sizes="100px" width="100" height="75" alt={photoFor(a.coverImageId)!.alt[lang]} loading="lazy" />}
            <span>{a.title}</span>
            <Icon />
          </a>
        ))}
    </div>
  </section>
)}
