<section id="header-page" class="header-experiences full page-header-banner" data-background-desktop="https://yucatan.travel/wp-content/uploads/2019/12/Valladolid-1920x1080-crop.jpg" data-background-mobile="https://yucatan.travel/wp-content/uploads/2019/12/Valladolid-768x1024-crop.jpg" style="background-position:center">
  <div class="single-detail content" style="background:; color:">
    <div class="title">
            <h1>Valladolid</h1>
      <p class="desc">La ciudad de Valladolid posee un gran legado histórico y cultural. Es conocida como la «Perla de Oriente» o la «Zací Heroica»</p>
    </div>
    
      </div>
  </section>
<div class="single-content">
  <div>
          <div id="single-sidebar" class="n1">
