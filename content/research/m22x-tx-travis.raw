var currentPage = $('*[property="og:url"]').attr('content');
var currentPageId = $('.share-page-container').attr('data-item-id');
	
	embeds.forEach( function (item) {
		var embedTitle = '<hr><h2>' + item['Title'] + '</h2>';
		var embedContent = '<p>' + item['Content'] + '</p>';
		var $embedCode = $(item['Embed']).attr('data-project-permalink', item['Project']);

		item['Links'].forEach(function (x) {
			if ( item['FullSection'] ) {
				if ( currentPage.indexOf( x['link'] ) > -1 ) {
					$('.main-container').append(embedTitle)
										.append(embedContent)
										.append($embedCode.attr('data-project-survey-link', x['property']));
				}
			} else {
				if ( currentPage === x['link'] || currentPageId === x['link'] ) {
					$('.main-container').append(embedTitle)
										.append(embedContent)
										.append($embedCode.attr('data-project-survey-link', x['property']));
				}
			}
		});
	});
	
	// Add EHQ hosted script to load survey
	var ehqScript = document.createElement('script');
	ehqScript.type = 'text/javascript';
	ehqScript.src = 'https://sanantonio.us.engagementhq.com/embeds/static/client/survey.js';
