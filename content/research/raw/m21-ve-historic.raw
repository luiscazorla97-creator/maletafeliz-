<section id="seccion-lugares" class="py-12 bg-[#f8f5f0]">
    <div class="max-w-7xl mx-auto px-4 md:px-8">

        <!-- Elegant Centered Header -->
        <div class="text-center mb-6">
            <h2 class="text-brand-burgundy text-2xl md:text-3.5xl font-bold uppercase tracking-widest fuente-titulos">
