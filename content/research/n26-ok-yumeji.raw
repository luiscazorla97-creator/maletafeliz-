                    <div class="carousel-item" v-bind:style="flickity.styling">
        <div class="carousel-item__thumbnail-wrapper">
        <a href="https://place.matcha-jp.com/resize/1280x2000/2024/02/16-18-45-03-10017095d376559d5486bdd06396ef08bada.webp?w=656" data-caption="9" class="carousel-item__link">
            <img
