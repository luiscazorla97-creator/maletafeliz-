n by Oliver Weber\",\"Caption\":null,\"Credits\":\"Brook Waimārama Sanctuary, Nelson\"}],\"imageFormat\":\"square\",\"link\":null}]}],\"$L4d\"]}]}]}]}]]}]\n"])</script><script>self.__next_f.push([1,"3f:[\"$\",\"$1\",\"4128\",{\"children\":[false,[\"$\",\"div\",null,{\"className\":\"ElementalPageGrid\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative\",\"children\":[\"$\",\"div\",null,{\"className\":\"\",\"children\":[[\"$\",\"div\",null,{\"className\":\"py-6 empty:hidden md:pt-12 container\",\"children\":null}],[\"$\",\"$L4e\",null,{\"className\":\"w-full\",\"opts\":{\"loop\":true},\"children\":[[\"$\",\"$L4f\",null,{\"children\":[[\"$\",\"$L50\",\"0\",{\"className\":\"relative max-h-[1400px] min-h-[500px] w-full 2xl:max-h-[75vh] 2xl:min-h-[800px]\",\"children\":[[\"$\",\"$L51\",null,{\"matchingFormat\":{\"ID\":254,\"Url\":\"https://backend.nelsontasman.nz/assets/listings/matai-river-walkway/Family-cycling-around-Nelson-Matai-River-Walkway-by-Oliver-Weber__FocusFillMaxWyIwLjE0IiwiMC4xNSIsMjg4MCwxODAwXQ.jpg\",\"WebPUrl\":\"https://backend.nelsontasman.nz/assets/listings/matai-river-walkway/Family-cycling-around-Nelson-Matai-River-Walkway-by-Oliver-Weber__FocusFillMaxWyIwLjE0IiwiMC4xNSIsMjg4MCwxODAwXQ_ExtRewriteWyJqcGciLCJ3ZWJwIl0.webp\",\"Width\":1920,\"Height\":1200,\"Format\":\"large\"},\"mediaQuerySources\":[],\"src\":\"https://backend.nelsontasman.nz/assets/listings/matai-river-walkway/Family-cycling-around-Nelson-Matai-River-Walkway-by-Oliver-Weber__FocusFillMaxWyIwLjE0IiwiMC4xNSIsMjg4MCwxODAwXQ.jpg\",\"alt\":\"Family cycling around Nelson Matai River Walkway by Oliver Weber\",\"fill\":false,\"width\":\"100%\",\"height\":\"100%\",\"focusPercentageX\":null,\"focusPercentageY\":null,\"imgCover\":\"object-cover\",\"nobg\":false,\"link\":null,\"className\":\"\",\"containerClassName\":\"md:aspect-video\",\"blurData\":\"U|IOz,x]M{x[yEtRoeozJ;ogs:bc.TbdM{o#\",\"unoptimized\":false}],[\"$\",\"div\",null,{\"className\":\"absolute inset-0 left-4 z-10 flex flex-col items-center justify-end gap-6 p-12 text-center text-white md:items-start md:p-24 md:text-start xl:p-36 bg-gradient-to-t from-black/30 md:bg-[linear-gradient(45deg,var(--tw-gradient-stops))] lg:to-80% xl:to-60%\",\"children\":[[\"$\",\"h2\",null,{\"className\":\"font-headline text-3xl font-semibold text-white md:text-5xl lg:w-3/4 xl:w-1/2\",\"children\":[\"$\",\"$L16\",null,{\"href\":\"/explore/places-to-go/cities-towns/nelson-city/free-experiences-in-nelson\",\"target\":null,\"children\":\"Free and unforgettable experiences in Nelson\"}]}],[\"$\",\"div\",null,{\"className\":\"text-xl text-white lg:w-3/4 xl:w-1/2\",\"children\":\"Free things to do in Nelson City that locals love.\"}],[\"$\",\"$L16\",null,{\"href\":\"/explore/places-to-go/cities-towns/nelson-city/free-experiences-in-nelson\",\"className\":\"no-underline font-sans inline-flex items-center justify-center whitespace-nowrap rounded md:text-normal font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-white bg-transparent text-white hover:bg-sky hover:text-white hover:border-sky h-10 px-4 py-2 after:absolute after:inset-0\",\"target\":null,\"children\":[\"Find out more \",[\"$\",\"svg\",null,{\"ref\":\"$undefined\",\"xmlns\":\"http://www.w3.org/2000/svg\",\"width\":24,\"height\":24,\"viewBox\":\"0 0 24 24\",\"fill\":\"none\",\"stroke\":\"currentColor\",\"strokeWidth\":2,\"strokeLinecap\":\"round\",\"strokeLinejoin\":\"round\",\"className\":\"lucide lucide-arrow-right ms-2 h-6 w-6\",\"children\":[[\"$\",\"path\",\"1ays0h\",{\"d\":\"M5 12h14\"}],[\"$\",\"path\",\"xquz4c\",{\"d\":\"m12 5 7 7-7 7\"}],\"$undefined\"]}]],\"ref\":null}]]}]]}]]}],[\"$\",\"$L52\",null,{\"className\":\"disabled:hidden\"}],[\"$\",\"$L53\",null,{\"className\":\"disabled:hidden\"}]]}]]}]}]}]}]]}]\n"])</script><script>self.__next_f.push([1,"42:[\"$\",\"a\",\"3\",{\"href\":\"/retail-services/little-beehive-co-op\",\"children\":\"Little Beehive Co-op\"}]\n43:[\"$\",\"a\",\"5\",{\"href\":\"/explore/things-to-do/shopping-and-markets/gifts-and-souvenirs\",\"children\":\"gifts and souvenirs\"}]\n44:[\"$\",\"a\",\"7\",{\"href\":\"/activities-day-trips/the-nelson-saturday-market\",\"children\":\"Saturday Market\"}]\n"])</script><script>self.__next_f.push([1,"45:[\"$\",\"div\",null,{\"className\":\"w-full md:w-1/2 md:order-first\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose max-w-none py-8 lg:px-12 xl:px-24 md:pe-12\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Enjoy art and artisan experiences\"}],[\"$\",\"p\",null,{\"children\":[\"Immerse yourself in Nelson's creative scene. Visit the \",[\"$\",\"a\",\"1\",{\"href\":\"/activities-day-trips/the-suter-art-gallery\",\"children\":\"Suter Art Gallery\"}],\" then take it outside on the \",[\"$\",\"a\",\"3\",{\"href\":\"/activities-day-trips/nelson-city-centre-artwalk\",\"children\":\"Nelson City Centre ArtWalk\"}],\" or stroll along the Maitai River to see sculptures, murals, and mosaics. Don't miss \",[\"$\",\"a\",\"5\",{\"href\":\"/activities-day-trips/jens-hansen-the-ringmaker\",\"children\":\"Jens Hansen\"}],\", the Nelson studio behind the original One Ring from The Lord of the Rings, and discover distinctive handcrafted jewellery made right here in the city.\"]}],[]]}]}]\n"])</script><script>self.__next_f.push([1,"46:[\"$\",\"div\",null,{\"className\":\"w-full md:w-1/2\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose max-w-none py-8 lg:px-12 xl:px-24 md:ps-12\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Go for a walk\"}],[\"$\",\"p\",null,{\"children\":[\"Starting from the city centre, a walk along the Maitai River leads to the base of the Botanical Reserve. A twenty-minute uphill trek under poplar and kauri trees brings you to the \",[\"$\",\"a\",\"1\",{\"href\":\"/scenic-attractions/centre-of-new-zealand\",\"children\":\"Centre of New Zealand\"}],\" viewing platform, marked by a large white pin from the 1870s. Enjoy stunning views of the city, Tasman Bay, and the mountains. On your way down, try the Branford Park trail to the popular ‘Black Hole’ swimming spot, or continue to Walters Bluff for a longer scenic route. Alternatively, explore nearby gardens like \",[\"$\",\"a\",\"3\",{\"href\":\"/scenic-attractions/queens-gardens\",\"children\":\"Queens\"}],\", Miyazu, or Huangshi.\"]}],[]]}]}]\n"])</script><script>self.__next_f.push([1,"47:[\"$\",\"div\",null,{\"className\":\"w-full md:w-1/2 md:order-first\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose max-w-none py-8 lg:px-12 xl:px-24 md:pe-12\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Experience the history of Nelson City\"}],[\"$\",\"p\",null,{\"children\":[\"Stroll down \",[\"$\",\"a\",\"1\",{\"href\":\"/scenic-attractions/historic-south-street\",\"children\":\"South Street\"}],\", New Zealand’s oldest fully preserved street, and see the 1860s cottages built for early Nelson settlers. Explore \",[\"$\",\"a\",\"3\",{\"href\":\"/activities-day-trips/founders-heritage-park\",\"children\":\"Founders Heritage Park\"}],\", with its giant windmill gift shop, artisan buildings, bright red train ride, beautiful gardens, Bristol Freighter Plane cockpit, and replica fire brigade engine house. Don’t miss the \",[\"$\",\"a\",\"5\",{\"href\":\"/activities-day-trips/nelson-provincial-museum-pupuri-taonga-o-te-tai-ao\",\"children\":\"Nelson Provincial Museum\"}],\" in the central city for galleries, exhibitions, and tours showcasing Nelson’s history.\"]}],[]]}]}]\n"])</script><script>self.__next_f.push([1,"48:[\"$\",\"div\",null,{\"className\":\"w-full md:w-1/2\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose max-w-none py-8 lg:px-12 xl:px-24 md:ps-12\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Spend the afternoon at Tāhunanui Beach\"}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"a\",\"0\",{\"href\":\"/scenic-attractions/tahunanui-beach\",\"children\":\"Tāhunanui Beach\"}],\" holds cherished memories and family traditions, from childhood sandcastles to sunset strolls. Just minutes from Nelson City, it’s a year-round local favourite for swimmers, dog walkers and families. Grab a coffee or an ice cream from the colourful container cafés, \",[\"$\",\"a\",\"2\",{\"href\":\"/activities-day-trips/paddle-nelson-paddleboard-hire\",\"children\":\"hire a SUP\"}],\" and get out on the water, then settle in for a local brew and a bite at \",[\"$\",\"a\",\"4\",{\"href\":\"/eat-drink/sprig-fern-tavern-tahuna\",\"children\":\"Sprig + Fern\"}],\". \"]}],[]]}]}]\n"])</script><script>self.__next_f.push([1,"49:[\"$\",\"div\",null,{\"className\":\"w-full md:w-1/2 md:order-first\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose max-w-none py-8 lg:px-12 xl:px-24 md:pe-12\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Go on a biking adventure\"}],[\"$\",\"p\",null,{\"children\":[\"Just minutes from the city centre, Nelson makes it easy to explore on two wheels. For a relaxed ride, follow the gentle \",[\"$\",\"a\",\"1\",{\"href\":\"/activities-day-trips/maitai-river-walkway\",\"children\":\"Maitai River\"}],\" pathway past swimming holes and picnic spots. Ready to hit the trails? Family-friendly \",[\"$\",\"a\",\"3\",{\"href\":\"/activities-day-trips/koata-mtb-park\",\"children\":\"Koata Park\"}],\" has options for a range of ages and abilities. Experienced riders can test their skills on Nelson’s iconic Grade 5 trails, or tackle the \",[\"$\",\"a\",\"5\",{\"href\":\"/explore/things-to-do/cycling-and-mountain-biking/great-rides/coppermine-trail-great-ride\",\"children\":\"Coppermine Trail\"}],\", one of the Ngā Haerenga Great Rides, for a half-day backcountry adventure.\"]}],[]]}]}]\n"])</script><script>self.__next_f.push([1,"4a:[\"$\",\"h2\",null,{\"children\":\"Visit the Boulder Bank\"}]\n4b:[\"$\",\"p\",null,{\"children\":[\"For 10,000 years, debris from the Mackay Bluffs formed a rare 13km spit of boulders known as the \",[\"$\",\"a\",\"1\",{\"rel\":\"noopener noreferrer\",\"href\":\"/scenic-attractions/nelson-boulder-bank\",\"target\":\"_blank\",\"children\":\"Boulder Bank Scenic Reserve\"}],\", sheltering Nelson's harbour. An 8km walk offers a glimpse into its history, and climbing the lighthouse provides stunning 360-degree views. \"]}]\n"])</script><script>self.__next_f.push([1,"4c:[\"$\",\"div\",null,{\"className\":\"w-full md:w-1/2 md:order-first\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose max-w-none py-8 lg:px-12 xl:px-24 md:pe-12\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Dine your way around town\"}],[\"$\",\"p\",null,{\"children\":[[\"$\",\"a\",\"0\",{\"href\":\"https://www.nelsontasman.nz/explore/eat-and-drink/restaurants-and-bars/?location=nelson-central\",\"children\":\"Nelson City's food scene\"}],\" offers everything from street carts to oyster bars, cocktail lounges, and boutique bakeries. Dine along Rocks Road for waterfront views or explore Hardy, Bridge, and Trafalgar Streets for renowned alfresco restaurants. Discover hidden gems in Church Street, New Street, and Kirby Lane, home to street carts with karaage chicken, falafel, and Argentinian barbecue. \"]}],[]]}]}]\n"])</script><script>self.__next_f.push([1,"4d:[\"$\",\"div\",null,{\"className\":\"w-full md:w-1/2\",\"children\":[\"$\",\"div\",null,{\"className\":\"prose max-w-none py-8 lg:px-12 xl:px-24 md:ps-12\",\"children\":[[\"$\",\"h2\",null,{\"children\":\"Discover a nature sanctuary\"}],[\"$\",\"p\",null,{\"children\":[\"Nestled in the valley behind Nelson City lies the \",[\"$\",\"a\",\"1\",{\"href\":\"/activities-day-trips/brook-waimarama-sanctuary\",\"children\":\"Brook Waimārama Sanctuary\"}],\", the South Island's largest fenced haven for endangered flora and fauna. Immerse yourself in lush native bush and tranquil scenery, enjoying birdsong as you explore the sanctuary's network of tracks. Discover diverse wildlife, waterfalls, and native plants in the mossy landscapes. Guided walks and winter glow-worm tours are also available.\"]}],[]]}]}]\n"])</script></body></html>