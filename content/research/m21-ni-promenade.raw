<script type="application/ld+json">{"@context":"https://schema.org","@type":"TouristDestination","name":"Promenade des Anglais","description":"Face \u00e0 la Baie des Anges, la Promenade des Anglais est l'un des symboles de Nice. \u00c0 toute heure de la journ\u00e9e, habitants et visiteurs s'y retrouvent pour marcher, courir, p\u00e9daler ou simplement profiter d'un moment au bord de la M\u00e9diterran\u00e9e.","address":{"@type":"PostalAddress","addressCountry":"FR","addressLocality":"Nice","addressRegion":"GR\u00ae5-Alpes","postalCode":"06000","streetAddress":"Promenade des Anglais"},"geo":{"@type":"GeoCoordinates","latitude":"43.693612","longitude":"7.255834"},"telephone":"04 92 14 46 14","url":"https://www.explorenicecotedazur.com/culture/promenade-des-anglais/","email":"info@explorenca.com","image":["https://www.explorenicecotedazur.com/app/uploads/2026/05/bord-de-mer-nice-vdn-julien-veran.webp","https://www.explorenicecotedazur.com/app/uploads/2025/09/promenadedesanglais-bounceproduction.webp","https://www.explorenicecotedazur.com/app/uploads/2025/09/borddemer-agencemedia-h265.webp","https://www.explorenicecotedazur.com/app/uploads/2025/09/promenadedesanglais-otmnca2fa.issock.webp"],"openingHoursSpecification":[{"@type":"OpeningHoursSpecification","dayOfWeek":"Monday"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Tuesday"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Wednesday"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Thursday"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Friday"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Saturday"},{"@type":"OpeningHoursSpecification","dayOfWeek":"Sunday"}]}</script>
