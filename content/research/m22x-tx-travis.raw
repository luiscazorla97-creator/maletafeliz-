Importance: 'oc-emergency-severity-30',
Content: '<p >All bulky waste, household hazardous waste (HHW) and Bitters brush drop-off locations will be closed Thursday and Friday, November 26 – 27, for Thanksgiving. Curbside cart collection schedules will also shift.</p>',
Embed: '',
FullSection: true,

Links: [{link: "https://www.sa.gov/Directory/Departments/SWMD/Garbage/My-Collection-Day#holidays", property: "View the holiday schedule.", target: "_self"},]
}
]
var currentPage = $('*[property="og:url"]').attr('content');
var currentAnn = currentPage + '/Announcements';
var currentPageId = $('.share-page-container').attr('data-item-id');
var annContainer = '<div class="oc-emergency-announcement-container relative"></div>';
var annInner = '<div class="oc-emergency-undismissed max-severity-30"></div>';
	
announcements.forEach( function (item) {
	var annLink = item['Location'];
	var annParent = annLink.substr(0, annLink.lastIndexOf('\/'));
	var annEnd = annParent.substr(annParent.lastIndexOf('\/'), annParent.length);
	
	if ( annEnd === '/Announcements' ) {
		annParent = annParent.substr(0, annParent.lastIndexOf('\/'));
	}
	
	if ( currentPage.indexOf(annParent) > -1 ) {
		var annTitle = '<hr><h2>' + item['Title'] + '</h2>';
		var annContent = '<p>' + item['Content'] + '</p>';
		var $annCode = $(item['Content']).attr('data-project-permalink', item['Project']);
		
		if ( item['FullSection'] === true ) {
			buildAnnouncements(item);
		} else {
			console.log(item['FullSection']);
			console.log(currentPage);
			console.log(annParent);
			if ( currentPage === annParent || currentAnn === annParent ) {
				buildAnnouncements(item);
			}
		}
	}
});
});

</script>
