<style>
#strutture-container{
    display: grid;
    grid-template-columns: 48% 48%;
    grid-gap: 20px;
}
#strutture-container .struttura{
    background-color: var(--e-global-color-primary);
    background-image: url(https://www.visit-assisi.it/wp-content/uploads/rosone-1.svg);
    background-position: 504px 157px;
    background-repeat: no-repeat;
    background-size: 25% auto;
    border-radius: 16px !important;
    height: 315px;
    padding: 35px 65px;
    display: flex;
    justify-content: center
}
#strutture-container .struttura h3, #strutture-container .struttura span{
    color: #fff;
}
#strutture-container .struttura svg, #strutture-container .struttura i{
    fill: #fff
}

#typologyFilter ul{
    display: flex;
   flex-wrap: wrap;
   flex-direction: row;
    list-style: none;
    padding: 0;
    margin-bottom: 30px;
}
#typologyFilter li{
    width: fit-content;
    margin-bottom: 5px;
    padding:5px;
    border-radius: 16px;
}
#typologyFilter li a{
    color: #fff;
}
#strutture-container .struttura .elementor-icon-list-items li{
    margin-top: 5px;
}
	#strutture-container .elementor-icon-list-text a{
		color: #fff;
	}
@media screen and (max-width: 1024px){
    #strutture-container{
    display: grid;
    grid-template-columns: 100%;
    grid-gap: 20px;
}
#strutture-container .struttura{
    padding: 20px;
}
#strutture-container .struttura .break-email{
   width: 90%;
  overflow-wrap: break-word;
    
}
}
</style>
<script>
    document.addEventListener('DOMContentLoaded', function() {
    var lang = document.documentElement.lang.split('-')[0] || 'it';

    var translations = {
        it: {
            openDiscover: 'Apri Discover',
            closeDiscover: 'Chiudi Discover',
            openInspired: 'Apri Ispirati',
            closeInspired: 'Chiudi Ispirati',
            openOrganize: 'Apri Organizza',
            closeOrganize: 'Chiudi Organizza',
            openEvents: 'Apri Eventi',
            closeEvents: 'Chiudi Eventi'
        },
        en: {
            openDiscover: 'Open Discover',
            closeDiscover: 'Close Discover',
            openInspired: 'Open Inspired',
            closeInspired: 'Close Inspired',
            openOrganize: 'Open Organize',
            closeOrganize: 'Close Organize',
            openEvents: 'Open Events',
            closeEvents: 'Close Events'
        }
    };

    if (!translations[lang]) lang = 'it';

    document.querySelectorAll('span.e-n-menu-dropdown-icon-closed').forEach(function(el) {
        var textElement = el.querySelector('.elementor-screen-only');
        var text = textElement.textContent;
        if (text.includes('Discover')) textElement.textContent = translations[lang].openDiscover;
        else if (text.includes('Inspired')) textElement.textContent = translations[lang].openInspired;
        else if (text.includes('Organize')) textElement.textContent = translations[lang].openOrganize;
        else if (text.includes('Events')) textElement.textContent = translations[lang].openEvents;
    });

    document.querySelectorAll('span.e-n-menu-dropdown-icon-opened').forEach(function(el) {
        var textElement = el.querySelector('.elementor-screen-only');
        var text = textElement.textContent;
        if (text.includes('Discover')) textElement.textContent = translations[lang].closeDiscover;
        else if (text.includes('Inspired')) textElement.textContent = translations[lang].closeInspired;
        else if (text.includes('Organize')) textElement.textContent = translations[lang].closeOrganize;
        else if (text.includes('Events')) textElement.textContent = translations[lang].closeEvents;
    });
});
</script>
