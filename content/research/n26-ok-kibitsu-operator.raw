                        <div class="case">
                            <h4>By Shinkansen</h4>
                            <div class="route">
                                <p>JR Shin-Osaka Station (Sanyo Line) -<br> JR Okayama Station (approx. 1 hour)</p>
                                <p>JR Hakata Station (Sanyo Line) -<br>  JR Okayama Station (approx. 2 hours)</p>
                            </div>
                        </div>
                        <div class="case">
                            <h4>By Car</h4>
                            <div class="route">
                                <p>15 minutes from Okayama Soja IC</p>
                                <p>15 minutes from Okayama IC</p>
                            </div>
                        </div>
                        <div class="case">
                            <h4>By Train</h4>
                            <div class="route">
                                <p>JR Okayama Station -<br> Kibitsu Station (approx. 30 minutes) -<br> 10-minute walk</p>
                                <p>JR Kurashiki Station -<br> Kibitsu Station (approx. 40 minutes) -<br> 10-minute walk</p>
                            </div>
                        </div>
