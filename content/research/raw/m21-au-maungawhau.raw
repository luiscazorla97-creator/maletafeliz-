                                        <option value="/maunga/te-kopuke-titikopuke" data-sub="Mount St John" >Te Kōpuke / Tītīkōpuke</option>
                                    
                                        <option value="/maunga/takarunga" data-sub="Mount Victoria" >Takarunga</option>
                                    
                                        <option value="/maunga/te-tatua-a-riukiuta" data-sub="Big King" >Te Tātua a Riukiuta</option>
                                    
                                        <option value="/maunga/te-pane-o-mataoho-te-ara-pueru" data-sub="Māngere Mountain" >Te Pane o Mataoho / Te Ara Pueru</option>
                                    
                                </select>
                            </div>
                        
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>


