        <div class="dropdown">
            <button tabindex="0" class="btn dropdown-toggle" type="button" id="dropdownMenuButtonPasseggeri" data-bs-toggle="dropdown" aria-expanded="false" data-bs-auto-close="outside" data-bs-display="static" aria-labelledby="adulto dropdownMenuButtonPasseggeritextBtn">
