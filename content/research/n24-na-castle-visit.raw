      <div class="contVox" id="info08">
        <h3 class="headStyle07">Download the Leaflet</h3>
        <div class="inner imgD">
          <div class="img">
            <figure class="alignCenter">
              <img src="../../assets/images/content/info/download/index_img02_20260417.jpg" alt="Downloadable Leaflet" />
              <figcaption class="ftGothicL">
                <div class="btnStyle02 w100p">
