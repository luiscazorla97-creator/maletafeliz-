    <script src="https://cdn.jsdelivr.net/npm/select2@4.1.0-rc.0/dist/js/select2.min.js"></script>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/jquery.validate.min.js"></script>
    
            <script src="https://cdnjs.cloudflare.com/ajax/libs/jquery-validate/1.20.0/localization/messages_it.min.js"></script>
    
    <!-- Main JS File -->
    <script src="/utenti/assets/js/main.js"></script>

    <!-- Mobile menu JS -->
    <script>
    (function () {
        var openBtn  = document.getElementById('mobileMenuOpen');
        var closeBtn = document.getElementById('mobileMenuClose');
        var menu     = document.getElementById('mobileMenu');
        var body     = document.body;

        if (!openBtn || !menu) return;

        function openMenu() {
            menu.classList.add('is-open');
            body.classList.add('has-mobile-menu-open');
            openBtn.setAttribute('aria-expanded', 'true');
            closeBtn && closeBtn.focus();
        }

        function closeMenu() {
            menu.classList.remove('is-open');
            body.classList.remove('has-mobile-menu-open');
            openBtn.setAttribute('aria-expanded', 'false');
            openBtn.focus();
        }

        openBtn.addEventListener('click', openMenu);
        if (closeBtn) closeBtn.addEventListener('click', closeMenu);

        /* Close on Escape key */
        document.addEventListener('keydown', function (e) {
            if (e.key === 'Escape' && menu.classList.contains('is-open')) closeMenu();
        });

        /* Close when login modal opens from inside the mobile menu */
        var mobileLoginBtn = document.getElementById('mobileLoginBtn');
        if (mobileLoginBtn) {
            mobileLoginBtn.addEventListener('click', function () {
                closeMenu();
            });
        }
    })();
    </script>

    <!-- Script per international telephone input e validazione registrazione -->
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@17.0.19/build/js/intlTelInput.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/intl-tel-input@17.0.19/build/js/utils.js"></script>
    </body>

</html>
