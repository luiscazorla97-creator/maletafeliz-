    "ImageDescription": {
      "value": "<p>Exterior of the Apse of the Sagrada Família - Western exposure\n</p>\n<div class=\"vcard\">\n<table class=\"toccolours collapsible collapsed\" cellpadding=\"2\" cellspacing=\"0\" dir=\"ltr\" style=\"text-align:left; border-collapse:collapse; background: var(--background-color-interactive-subtle, #f0f0ff); color: inherit; border:1px solid #aaa;\" lang=\"en\">\n<tbody><tr valign=\"top\">\n<th colspan=\"4\" style=\"background-color: var(--background-color-interactive, #e0e0ee); color: inherit; font-weight:bold; border: 1px solid var(--border-color-base, #aaa);\"><span class=\"fn\" id=\"creator\"><bdi><a href=\"https://en.wikipedia.org/wiki/en:Sagrada_Fam%C3%ADlia\" class=\"extiw\" title=\"w:en:Sagrada Família\"><span title=\"basilica under construction since 1882 in Barcelona, Spain\">Basilica and Expiatory Church of the Holy Family</span></a>\n</bdi></span> <span class=\"skin-invert\" typeof=\"mw:File\"><a href=\"//commons.wikimedia.org/wiki/Institution:Sagrada_Fam%C3%ADlia\" title=\"Institution:Sagrada Família\"><img src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/Blue_pencil.svg/20px-Blue_pencil.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"15\" height=\"15\" class=\"mw-file-element\" srcset=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/7/73/Blue_pencil.svg/40px-Blue_pencil.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail 2x\" data-file-width=\"600\" data-file-height=\"600\"></a></span> <span typeof=\"mw:File\"><a href=\"https://www.wikidata.org/wiki/Q48435\" title=\"wikidata:Q48435\"><img alt=\"wikidata:Q48435\" src=\"https://thumb.wikimedia.org/wikipedia/commons/thumb/f/ff/Wikidata-logo.svg/20px-Wikidata-logo.svg.png?utm_source=commons.wikimedia.org&amp;utm_campaign=parser&amp;utm_content=thumbnail\" decoding=\"async\" loading=\"lazy\" width=\"20\" height=\"11\" class=\"mw-file-element\" srcs