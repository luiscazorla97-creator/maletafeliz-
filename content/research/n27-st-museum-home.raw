tateyout:30;transformoriginout:50% 50% -300px;parallax:true;parallaxlevel:20;"></div><p style="font-weight:700;letter-spacing:-0.03em;font-family:Montserrat;font-size:36px;line-height:36px;color:#505050;top:129px;left:66px;" class="ls-l ls-text-layer" data-ls="offsetxin:-150;durationin:2000;easingin:easeOutExpo;rotateyin:-30;transformoriginin:97.4% 413.9% -700px;offsetxout:100;durationout:800;easingout:easeInExpo;rotateyout:30;transformoriginout:97.4% 413.9% -700px;parallax:true;parallaxlevel:35;">BERG HOUSE</p><p style="font-weight:400;width:310px;font-family:Poppins;font-size:13px;line-height:20px;color:#505050;top:231px;left:64px;white-space:normal;" class="ls-l ls-text-layer" data-ls="offsetxin:-150;durationin:2000;easingin:easeOutExpo;rotateyin:-30;transformoriginin:124.4% 30% -500px;offsetxout:100;durationout:800;easingout:easeInExpo;rotateyout:30;transformoriginout:124.4% 30% -500px;parallax:true;parallaxlevel:25;">The fourth house, which was the home of O.M. Bergh, originally had a thatched roof and gables similar to those of Blettermanhuis...</p><a style="" class="ls-l" href="https://stelmus.co.za/village-museum/berghhuis/" target="_self" data-ls="offsetxin:-150;durationin:2000;easingin:easeOutExpo;rotateyin:-30;transformoriginin:199.2% -244.4% -600px;offsetxout:100;durationout:800;easingout:easeInExpo;rotateyout:30;transformoriginout:199.2% -244.4% -600px;hover:true;hoverdurationin:300;hoveropacity:1;hoverbgcolor:#3be5f5;parallax:true;parallaxlevel:30;"><p style="font-weight:700;cursor:pointer;padding-right:30px;padding-left:30px;font-family:Montserrat;font-size:19px;line-height:45px;color:#ffffff;border-radius:10px;top:359px;left:64px;background-color:#2764b3;" class="ls-text-layer">SEE DETAILS</p></a><img loading="lazy" decoding="async" width="197" height="450" src="https://stelmus.co.za/wp-content/uploads/2019/08/pers9.png" class="ls-l ls-img-layer" alt="" srcset="https://stelmus.co.za/wp-content/uploads/2019/08/pers9.png 197w, https://stelmus.co.za/wp-content/uploads/2019/08/pers9-131x300.png 131w" sizes="auto, (max-width: 197px) 100vw, 197px" style="top:153px;left:667px;" data-ls="offsetxin:-150;durationin:2000;easingin:easeOutExpo;rotateyin:-30;transformoriginin:17% 21% -1000px;offsetxout:100;durationout:800;easingout:easeInExpo;rotateyout:30;transformoriginout:16.8% 21% -1000px;parallax:true;parallaxlevel:50;"><a style="" class="ls-l" href="http://www.mini.hu/_common/_shared_files/product_presentation/mini_f55/living_wall/tile_expanded/01_introduction/gallery_01.jpg" target="_self" data-ls="offsetxin:-150;durationin:2000;easingin:easeOutExpo;rotateyin:-30;transformoriginin:-185.1% 134.1% -1400px;offsetxout:100;durationout:800;easingout:easeInExpo;rotateyout:30;transformoriginout:-185.1% 134.1% -1400px;hover:true;hoveropacity:1;hoverscalex:0.95;hoverscaley:0.95;parallax:true;parallaxlevel:70;"><img loading="lazy" decoding="async" width="360" height="240" src="https://stelmus.co.za/wp-content/uploads/2019/08/berg2.jpg" class=" ls-imagelightbox ls-img-layer" alt="" srcset="https://stelmus.co.za/wp-content/uploads/2019/08/berg2.jpg 360w, https://stelmus.co.za/wp-content/uploads/2019/08/berg2-300x200.jpg 300w" sizes="auto, (max-width: 360px) 100vw, 360px" style="border-radius:50%;top:275px;left:418px;width:228px;height:221px;"></a><a style="" class="ls-l" href="http://www.mini.hu/_common/_shared_files/product_presentation/mini_f55/living_wall/tile_expanded/01_introduction/gallery_03.jpg" target="_self" data-ls="offsetxin:-150;durationin:2000;easingin:easeOutExpo;rotateyin:-30;transformoriginin:-149.2% 170.4% -1200px;offsetxout:100;durationout:800;easingout:easeInExpo;rotateyout:30;transformoriginout:-149.2% 170.4% -1200px;hover:true;hoveropacity:1;hoverscalex:0.95;hoverscaley:0.95;parallax:true;parallaxlevel:60;"><img loading="lazy" decoding="async" width="220" height="147" src="https://stelmus.co.za/wp-content/uploads/2019/08/berg3.jpg" class=" ls-imagelightbox ls-img-layer" alt="" style="border-radius:50%;top:34p