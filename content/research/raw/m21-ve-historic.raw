<div class="mb-6 bg-brand-burgundy/60 border-l-4 border-brand-gold border border-brand-gold/20 px-6 py-4 rounded-r-2xl backdrop-blur-md flex flex-wrap items-center justify-between gap-4 shadow-lg animate-in">
