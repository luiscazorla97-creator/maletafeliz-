	<script>
(function(){
	var isMobile=window.matchMedia("(max-width:767px)").matches;
	function restoreDeferredSources(video){
		if(video.dataset.salernoRestored==="1")return;
		video.dataset.salernoRestored="1";
		video.querySelectorAll("source[data-salerno-src]").forEach(function(s){
			if(!s.getAttribute("src"))s.setAttribute("src",s.getAttribute("data-salerno-src"));
		});
		if(video.dataset.salernoSrc&&!video.getAttribute("src"))video.setAttribute("src",video.dataset.salernoSrc);
		video.load();
	}
	function deferHomeVideos(){
		if(!isMobile||!document.body.classList.contains("home"))return;
		document.querySelectorAll("video.salerno-video-mobile-defer").forEach(function(v){
			if(v.dataset.salernoDeferred==="1")return;
			v.dataset.salernoDeferred="1";
			if(v.getAttribute("src")){v.dataset.salernoSrc=v.getAttribute("src");v.removeAttribute("src");}
			v.querySelectorAll("source[src]").forEach(function(s){
				s.setAttribute("data-salerno-src",s.getAttribute("src"));
				s.removeAttribute("src");
			});
			v.load();
		});
	}
	function playVideo(v){
		v.muted=true;v.playsInline=true;v.setAttribute("muted","");v.setAttribute("playsinline","");
		restoreDeferredSources(v);
		var p=v.play();
		if(p&&typeof p.catch==="function")p.catch(function(){});
	}
	function init(){
		document.querySelectorAll("video[autoplay],video.salerno-video-mobile-defer").forEach(playVideo);
	}
	function initHomeDeferred(){
		deferHomeVideos();
		var start=function(){setTimeout(init,1500);};
		if(document.readyState==="complete")start();
		else window.addEventListener("load",start,{once:true});
	}
	if(isMobile&&document.body.classList.contains("home"))initHomeDeferred();
	else init();
	document.addEventListener("visibilitychange",function(){
		if(document.visibilityState==="visible")init();
	});
})();
</script>
	<script>
(function() {
	function init() {
		document.querySelectorAll('.guten-nav-menu.homemenu').forEach(function(menu) {
			var btn = menu.querySelector('.gutenverse-hamburger-menu');
			if (!btn) return;
			btn.addEventListener('click', function() {
				var r = btn.getBoundingClientRect();
				var x = r.left + r.width / 2;
				var y = r.top + r.height / 2;
				menu.style.setProperty('--circle-origin-x', x + 'px');
				menu.style.setProperty('--circle-origin-y', y + 'px');
			});
		});
	}
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', init);
	} else {
		init();
	}
})();
</script>
	<script id="salerno-mobile-fab-js">
(function(){
	'use strict';
	var MOBILE_QUERY=window.matchMedia('(max-width: 767px)');
	function isMobile(){return MOBILE_QUERY.matches;}
	function getFab(){return document.getElementById('salerno-mobile-fab');}
	function setOpen(open){
		var fab=getFab();
		if(!fab){return;}
		fab.classList.toggle('is-open',open);
		var toggle=fab.querySelector('.salerno-mobile-fab__toggle');
		if(!toggle){return;}
		toggle.setAttribute('aria-expanded',open?'true':'false');
		var openLabel=fab.dataset.toggleOpen||toggle.getAttribute('data-label-open')||'';
		var closeLabel=fab.dataset.toggleClose||toggle.getAttribute('data-label-close')||'';
		var nextLabel=open?(closeLabel||openLabel):(openLabel||closeLabel);
		if(nextLabel){toggle.setAttribute('aria-label',nextLabel);}
	}
	function closeFab(){setOpen(false);}
	function openCookiePreferences(){
		var revisit=document.querySelector('[data-cky-tag="revisit-consent"] .cky-btn-revisit')||document.querySelector('[data-cky-tag="revisit-consent"]');
		if(!revisit){return false;}
		revisit.click();
		return true;
	}
	function retryAction(action,attempts){
		if(action()){return;}
		if(attempts<=0){return;}
		window.setTimeout(function(){retryAction(action,attempts-1);},250);
	}
	function bindFab(){
		var fab=getFab();
		if(!fab||fab.dataset.salernoFabBound==='1'){return;}
		fab.dataset.salernoFabBound='1';
		var toggle=fab.querySelector('.salerno-mobile-fab__toggle');
		if(toggle){
			toggle.addEventListener('click',function(){
				setOpen(!fab.classList.contains('is-open'));
			});
		}
		fab.querySelectorAll('[data-salerno-fab-action]').forEach(function(item){
			item.addEventListener('click',function(event){
				if(item.getAttribute('data-salerno-fab-action')==='cookies'){
					event.preventDefault();
					closeFab();
					retryAction(openCookiePreferences,12);
				}
			});
		});
		fab.querySelectorAll('.salerno-mobile-fab__action[href]').forEach(function(link){
			link.addEventListener('click',function(){closeFab();});
		});
		document.addEventListener('click',function(event){
			if(!fab.classList.contains('is-open')){return;}
			if(fab.contains(event.target)){return;}
			closeFab();
		});
		document.addEventListener('keydown',function(event){
			if(event.key==='Escape'){closeFab();}
		});
		MOBILE_QUERY.addEventListener('change',function(){
			if(!isMobile()){closeFab();}
		});
	}
	function init(){
		if(!isMobile()){return;}
		bindFab();
	}
	if(document.readyState==='loading'){document.addEventListener('DOMContentLoaded',init);}else{init();}
	window.addEventListener('load',init);
})();
</script>
	<div id="salerno-mobile-fab" class="salerno-mobile-fab" data-toggle-open="Apri menu servizi" data-toggle-close="Chiudi menu servizi" aria-label="Apri menu servizi">
	<ul class="salerno-mobile-fab__menu" role="menu">
		<li role="none">
			<button type="button" class="salerno-mobile-fab__action" role="menuitem" data-salerno-fab-action="cookies" aria-label="Preferenze cookie">
				<img src="https://cultura.comune.salerno.it/wp-content/mu-plugins/assets/cookie-consent-revisit-icon.png" width="22" height="22" alt="" decoding="async" />
