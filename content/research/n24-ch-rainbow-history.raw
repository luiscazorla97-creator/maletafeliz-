<style>
	.bi-video-wrap{
		position: relative;
		width: 100%;
		height: 0px;
		overflow: hidden;
		padding-bottom: 56.25%;
	}
	.bi-video-wrap iframe{
		position: absolute;
		top: 0;
		left: 0;
		width: 100% !important;
		height: 100% !important;
	}	
</style>
<script>
	console.log('Im Hereeee');
	// document.addEventListener('DOMContentLoaded', function () {
		var container = document.querySelector('.single-post-content');
		if (!container) return;

		var iframes = container.querySelectorAll('iframe');
		iframes.forEach(function (iframe) {
			if (iframe.parentElement && iframe.parentElement.classList.contains('bi-video-wrap')) {
				return;
			}

			var wrapper = document.createElement('div');
			wrapper.className = 'bi-video-wrap';
			iframe.parentNode.insertBefore(wrapper, iframe);
			wrapper.appendChild(iframe);
		});
