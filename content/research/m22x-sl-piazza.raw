/* Gutenverse imposta .guten-element *{transition:all .3s}: ogni cambio di misura veniva animato.
   Restano animati solo colori, opacità, ombre e trasformazioni (hover ecc.). */
.guten-element *{transition-property:color,background-color,border-color,outline-color,text-decoration-color,fill,stroke,opacity,box-shadow,transform,filter,backdrop-filter}
/* Colonne Gutenverse: il contenuto non deve allargare la colonna prima che gli script lo sistemino */
.guten-column>.guten-column-wrapper{min-width:0}
/* Icone Font Awesome: larghezza fissa, così non cambia il layout quando arriva il font */
i.fas,i.far,i.fab,i.fa,i.fa-solid,i.fa-regular,i.fa-brands{display:inline-block;width:1.25em;text-align:center}
@media (max-width:767px){
body.home .salerno-correlati:not(:has(.salerno-correlati__dots)) .salerno-correlati__carousel:has(.salerno-correlati__slide:nth-child(2)){padding-bottom:56.5px}
}
/* Home desktop: stessa larghezza card (268px) che poi imposta lo script, e spazio pallini se >4 card */
@media (min-width:1025px){
body.home .salerno-ultimi-eventi.salerno-correlati,body.home .salerno-notizie.salerno-correlati{--salerno-slide-width:268px}
body.home .salerno-correlati:not(:has(.salerno-correlati__dots)) .salerno-correlati__carousel:has(.salerno-correlati__slide:nth-child(5)){padding-bottom:56px}
}
</style>
