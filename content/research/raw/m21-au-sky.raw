		<script type="application/ld&#x2B;json">
		{
		  "@context": "https://schema.org",
		  "@type": "FAQPage",
		  "url": "https://skycityauckland.co.nz/sky-tower/",
		  "mainEntity": [
		    {
      "@type": "Question",
      "name": "Can I request the Sky Tower to be lit for my cause?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Every year the Sky Tower receives hundreds of requests to light up Auckland to support charities, mark national occasions and express solidarity with communities.  We are currently fulfilling established charity and partner commitments and will only reply if your request is successful due to the high demand we are experiencing.  To submit a request fill out this form:\u0026nbsp;"
      }
    },
    {
      "@type": "Question",
      "name": "Can I hire the Sky Tower for a private event?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes \u2014 New Zealand\u0027s most iconic landmark is available for private events 220 metres above Auckland. The Sky Tower has three hireable spaces: the Main Observation Area at 186 metres (Level 51), The Lookout at 192 metres (Level 53), and the Sky Deck at 220 metres (Level 60). Whether you\u0027re planning a sunrise corporate breakfast, cocktail reception, or evening celebration, our events team can help bring your vision to life above the Auckland skyline. To enquire, email  events@skycity.co.nz  or call \u002B64 9 363 6000."
      }
    },
    {
      "@type": "Question",
      "name": "What are your casual parking rates?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Our current casual, Super Saver and Early Bird rates for both the SkyCity Main Car Park and the NZICC \u0026amp; Horizon by SkyCity Car Park are set out in the  parking rates table ."
      }
    },
    {
      "@type": "Question",
      "name": "Can I use my SHOW by SkyCity Rewards for parking?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Yes, if you have sufficient SHOW by SkyCity Points or a car parking credit accrued on your card. Your SHOW by SkyCity Rewards card can be swiped at the parking machines to exit. Please note, some car parking credits are required to be activated at a SHOW by SkyCity Rewards Kiosk before redemption."
      }
    },
    {
      "@type": "Question",
      "name": "What is the height restriction for the car parks?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "The maximum height for vehicles in SkyCity Main Site car park is 2.1 metres and in SkyCity Grand Hotel car park is 2.1 metres."
      }
    },
    {
      "@type": "Question",
      "name": "Where can I download my Sky Tower photos?",
      "acceptedAnswer": {
        "@type": "Answer",
        "text": "Sky Tower photos can be downloaded from the  Magic Memories website ."
      }
    }
		  ]
		}
		</script>

<script>
(function () {
	if (window.__scFaqDeepLinkBound) return;
	window.__scFaqDeepLinkBound = true;

	function openByHash() {
		var hash = (window.location.hash || '').replace('#', '');
		if (!hash || hash.indexOf('faq-') !== 0) return;
		var item = document.getElementById(hash);
		if (!item || !item.classList || !item.classList.contains('sc-faq__item')) return;
		var btn = item.querySelector('.sc-faq__question');
		var ans = item.querySelector('.sc-faq__answer');
		if (!btn || !ans) return;
		btn.setAttribute('aria-expanded', 'true');
		ans.hidden = false;
		scrollToItem(item);
	}

	/* Re-run the scroll on load: a scroll measured before images/fonts settle lands on a stale offset and fails silently.
	   The late attempt is skipped if the reader has engaged or the item is already in view — never yank someone mid-read. */
	function scrollToItem(item) {
		var userMoved = false;
		var baseline = null;

		/* Explicit user-intent signals — scrollY alone cannot tell a browser scroll from a reader's. A scrollbar drag fires none of these (known gap). */
		function markMoved() { userMoved = true; }
		var listen = { passive: true, once: true };
		window.addEventListener('wheel', markMoved, listen);
		window.addEventListener('touchstart', markMoved, listen);
		window.addEventListener('keydown', markMoved, listen);

		function reduced() {
			return !!(window.matchMedia && window.matchMedia('(prefers-reduced-motion: reduce)').matches);
		}
		function go() {
			try { item.scrollIntoView({ behavior: reduced() ? 'auto' : 'smooth', block: 'start' }); }
			catch (e) { item.scrollIntoView(); }
		}

		/* Already substantially in view = the link worked; leave the reader alone. */
		function inView() {
			var r = item.getBoundingClientRect();
			var vh = window.innerHeight || document.documentElement.clientHeight;
			return r.top >= -40 && r.top <= vh * 0.6;
		}

		/* Baseline cannot be read synchronously — smooth scroll animates, so scrollY would be pre-scroll and the late attempt never fires.
		   Keep the capture window short (scrollend, poll fallback): a reader scroll inside it becomes the baseline. */
		function captureBaseline() {
			var done = false;
			function set() { if (!done) { done = true; baseline = Math.round(window.scrollY); } }

			if ('onscrollend' in window) {
				window.addEventListener('scrollend', set, { once: true });
				setTimeout(set, 1200);
				return;
			}
			var last = -1, stable = 0;
			var poll = setInterval(function () {
				var y = Math.round(window.scrollY);
				stable = (y === last) ? stable + 1 : 0;
				last = y;
				if (stable >= 2) { clearInterval(poll); set(); }
			}, 150);
			setTimeout(function () { clearInterval(poll); set(); }, 3000);
		}

		/* Reduced motion: go() jumps instantly, so the position is final when it returns and the baseline
		   is read synchronously. The async capture below exists only for the smooth animation. */
		setTimeout(function () {
			go();
			if (reduced()) { baseline = Math.round(window.scrollY); } else { captureBaseline(); }
		}, 60);

		if (document.readyState !== 'complete') {
			window.addEventListener('load', function () {
				setTimeout(function () {
					if (userMoved) { return; }
					/* Deliberately generous: scroll anchoring shifts the page a few pixels as images resolve; a real scroll is far larger. */
					if (baseline !== null && Math.abs(Math.round(window.scrollY) - baseline) > 80) { return; }
					if (inView()) { return; }
					go();
				}, 80);
			}, { once: true });
		}
	}

	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', openByHash);
	} else {
		openByHash();
	}
	window.addEventListener('hashchange', openByHash);
})();
</script>

