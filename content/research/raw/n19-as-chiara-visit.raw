<script>
   document.addEventListener('DOMContentLoaded', function() {
    var lang = document.documentElement.lang.split('-')[0] || 'it';

    var ariaLabels = {
        it: {
            accordion: 'Fisarmonica. Apri i collegamenti con Invio o Spazio, chiudi con Esc e naviga con i tasti freccia',
            nextSlide: 'Prossima Slide',
            prevSlide: 'Slide Precedente',
            mainMenu: 'Menu Principale Superiore',
            lowerMenu: 'Menu Navigazione Inferiore',
            fullscreen: 'Schermo Intero',
            zoomIn: 'Aumenta lo zoom',
            zoomOut: 'Diminuisci lo zoom'
        },
        en: {
            accordion: 'Accordion. Open links with Enter or Space, close with Esc and navigate with arrow keys',
            nextSlide: 'Next Slide',
            prevSlide: 'Previous Slide',
            mainMenu: 'Main Top Menu',
            lowerMenu: 'Lower Navigation Menu',
            fullscreen: 'Fullscreen',
            zoomIn: 'Zoom In',
            zoomOut: 'Zoom Out'
        }
    };

    if (!ariaLabels[lang]) lang = 'it';

    document.querySelectorAll('.sub-menu .elementor-sub-item').forEach(el => el.setAttribute('role', 'button'));
    document.querySelector('.e-n-accordion')?.setAttribute('aria-label', ariaLabels[lang].accordion);
    document.querySelector('.elementor-swiper-button-next')?.setAttribute('aria-label', ariaLabels[lang].nextSlide);
    document.querySelector('.elementor-swiper-button-prev')?.setAttribute('aria-label', ariaLabels[lang].prevSlide);
    document.querySelector('.elementor-nav-menu--main')?.setAttribute('aria-label', ariaLabels[lang].mainMenu);
    document.querySelector('.e-n-menu')?.setAttribute('aria-label', ariaLabels[lang].lowerMenu);
    document.querySelector('.fullscreen-icon')?.setAttribute('aria-label', ariaLabels[lang].fullscreen);
    document.querySelector('.leaflet-control-zoom-in')?.setAttribute('aria-label', ariaLabels[lang].zoomIn);
    document.querySelector('.leaflet-control-zoom-out')?.setAttribute('aria-label', ariaLabels[lang].zoomOut);

    document.querySelectorAll('.menu-item').forEach(function(el) {
        el.addEventListener('keydown', function(e) {
            if (e.target === document.querySelector('.menu-item:nth-child(8)')) {
                document.querySelector('.elementor-menu-toggle').classList.remove('elementor-active');
            }
        });
    });
});
</script>
<script>
document.addEventListener('DOMContentLoaded', function() {
    document.querySelectorAll('.elementor-screen-only').forEach(function(el) {
        el.textContent = el.textContent.replace('Close', 'Chiudi').replace('Open', 'Apri');
    });
});
</script>




<script>
document.addEventListener('DOMContentLoaded', function() {
    var offset = 200;

    document.querySelectorAll('a[href*="#"]:not([href="#"])').forEach(function(anchor) {
        anchor.addEventListener('click', function(e) {
            if (location.pathname.replace(/^\//, '') === this.pathname.replace(/^\//, '') && location.hostname === this.hostname) {
                var target = document.querySelector(this.hash) || document.querySelector('[name="' + this.hash.slice(1) + '"]');
                if (target) {
                    window.scrollTo({
                        top: target.getBoundingClientRect().top + window.pageYOffset - offset,
                        behavior: 'smooth'
                    });
                    e.preventDefault();
                }
            }
        });
    });
});
</script>
