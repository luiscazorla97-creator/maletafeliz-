    <script data-cookieconsent="ignore" data-cmp-ab="2">
    const labels = {
        'LBL_NOME_ISTANZA': 'visittrento.it',
        'LBL_RIMUOVI_CAMERA': 'Remove room',
        'LBL_ETA_BAMBINO': 'Child age',
        'LBL_NON_CI_SONO_RISULTATI_PER_I_FILTRI_SELEZIONATI': 'Sorry, there are no results available for this search. Please enter a new search.',
        'LBL_RISULTATI': 'Results',
