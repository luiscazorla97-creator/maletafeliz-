div id="bgLayers_comp-ksflauoj1" data-hook="bgLayers" data-motion-part="BG_LAYER comp-ksflauoj1" class="ktMZav"><div data-testid="colorUnderlay" class="V9k0ll etGVsi"></div><div id="bgMedia_comp-ksflauoj1" data-motion-part="BG_MEDIA comp-ksflauoj1" class="etSQ9j"></div></div><div data-testid="columns" class="Ak0vpt"><div id="comp-ksflauol1" class="comp-ksflauol1 FDI5TK wixui-column-strip__column"><div id="bgLayers_comp-ksflauol1" data-hook="bgLayers" data-motion-part="BG_LAYER comp-ksflauol1" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-ksflauol1" data-motion-part="BG_MEDIA comp-ksflauol1" class="ROWgFb"></div></div><div data-mesh-id="comp-ksflauol1inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-ksflauol1inlineContent-gridContainer" data-testid="mesh-container-content"><div id="comp-ksflauoo" class="UwkEpO _v6ohL AWXfZq PO9MfV comp-ksflauoo wixui-rich-text" data-testid="richTextElement"><h1 class="font_0 wixui-rich-text__text" style="font-size:46px; text-align:center;"><span style="font-size:46px;" class="wixui-rich-text__text">Your Visit</span></h1></div><div id="comp-ksflauor" class="UwkEpO _v6ohL AWXfZq PO9MfV comp-ksflauor wixui-rich-text" data-testid="richTextElement"><p class="font_8 wixui-rich-text__text" style="font-size:17px; line-height:1.4em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-size:17px;" class="wixui-rich-text__text">You are very welcome to come and visit your Cathedral. </span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:17px; line-height:1.4em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-size:17px;" class="wixui-rich-text__text"><span class="wixui-rich-text__text">​</span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:17px; line-height:1.4em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-size:17px;" class="wixui-rich-text__text">Our opening hours are between 8:30am and 7pm (6pm in winter).</span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:17px; line-height:1.4em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-size:17px;" class="wixui-rich-text__text"><span class="wixui-rich-text__text">​</span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:17px; line-height:1.4em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-size:17px;" class="wixui-rich-text__text">In this section you will find out more about this amazing place, its friendly people and the faith behind it.&nbsp;</span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:17px; line-height:1.4em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-size:17px;" class="wixui-rich-text__text"><span class="wixui-rich-text__text">​</span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:17px; line-height:1.4em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-size:17px;" class="wixui-rich-text__text">All services, many events and general admission to your Cathedral are free.</span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:17px; line-height:1.4em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-size:17px;" class="wixui-rich-text__text"><span class="wixui-rich-text__text">​</span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:17px; line-height:1.4em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span style="font-size:17px;" class="wixui-rich-text__text">During your visit you may consider supporting us. Find out more about the different ways to support your Cathedral in our <a href="https://www.nelsoncathedral.nz/connect" target="_self" class="wixui-rich-text__text"><span style="font-family:wfont_03520a_c815340afe8d4b6fac8817e5b6fc1104,wf_c815340afe8d4b6fac8817e5b,orig_candara_bold;" class="wixui-rich-text__text"><span style="color:rgb(139, 0, 0);" class="wixui-rich-text__text">Connect&nbsp;</span></span></a>section, or make a&nbsp;<a href="https://www.justgiving.com/trurocathedral" target="_blank" rel="noreferrer noopener" class="wixui-rich-text__text">donation</a> <span style="color:#94066E;" class="wixui-rich-text__text"><a href="https://www.nelsoncathedral.nz/donate" target="_self" class="wixui-rich-text__text">here</a></span></span></span></p>

<p class="font_8 wixui-rich-text__text" style="font-size:18px; line-height:1.4em;"><span style="letter-spacing:normal;" class="wixui-rich-text__text"><span class="wixui-rich-text__text">​</span></span></p></div></div></div></div></div></section></div></div></section><section id="comp-ld6syur61" tabindex="-1" class="Le88gL comp-ld6syur61 wixui-section" data-block-level-container="ClassicSection"><div id="bgLayers_comp-ld6syur61" data-hook="bgLayers" data-motion-part="BG_LAYER comp-ld6syur61" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-ld6syur61" data-motion-part="BG_MEDIA comp-ld6syur61" class="ROWgFb"></div></div><div data-mesh-id="comp-ld6syur61inlineContent" data-testid="inline-content" class=""><div data-mesh-id="comp-ld6syur61inlineContent-gridContainer" data-testid="mesh-container-content"><section id="comp-ksflauot" class="comp-ksflauot CeUMmm wixui-column-strip"><div id="bgLayers_comp-ksflauot" data-hook="bgLayers" data-motion-part="BG_LAYER comp-ksflauot" class="ktMZav"><div data-testid="colorUnderlay" class="V9k0ll etGVsi"></div><div id="bgMedia_comp-ksflauot" data-motion-part="BG_MEDIA comp-ksflauot" class="etSQ9j"></div></div><div data-testid="columns" class="Ak0vpt"><div id="comp-ksflaup7" class="comp-ksflaup7 FDI5TK wixui-column-strip__column"><div id="bgLayers_comp-ksflaup7" data-hook="bgLayers" data-motion-part="BG_LAYER comp-ksflaup7" class="QG9w8P"><div data-testid="colorUnderlay" class="LNYVZi ayCf9D"></div><div id="bgMedia_comp-ksflaup7" data-motion-part="BG_MEDIA comp-ksflaup7" class="ROWgFb"><wow-image id="img_comp-ksflaup7" class="Qh0lWW ayCf9D fO4mKs NgeJ4N bgImage" data-image-info="{&quot;containerId&quot;:&quot;comp-ksflaup7&quot;,&quot;alignType&quot;:&quot;center&quot;,&quot;displayMode&quot;:&quot;fill&quot;,&quot;targetWidth&quot;:326,&quot;targetHeight&quot;:270,&quot;isLQIP&quot;:true,&quot;encoding&quot;:&quot;AVIF&quot;,&quot;imageData&quot;:{&quot;width&quot;:720,&quot;height&quo