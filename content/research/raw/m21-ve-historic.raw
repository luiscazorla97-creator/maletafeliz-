<link rel="stylesheet" href="https://descubre.veracruzmunicipio.gob.mx/css/fontawesome.css" />
<style>
    #map-preview {
        width: 100%;
        height: 100%;
        z-index: 0;
        background: rgb(var(--brand-cream));
    }

    /* Custom Marker Drops style for preview */
    .custom-marker {
        background: none !important;
        border: none !important;
    }

    .marker-pin-preview {
        width: 30px;
        height: 30px;
        border-radius: 50% 50% 50% 0;
        background: rgb(var(--brand-burgundy));
        position: absolute;
        transform: rotate(-45deg);
        left: 50%;
        top: 50%;
        margin: -24px 0 0 -15px;
        box-shadow: -1px 2px 4px rgba(0, 0, 0, 0.3);
        border: 2px solid #ffffff;
        display: flex;
        align-items: center;
        justify-content: center;
        transition: all 0.2s ease;
    }

    .marker-pin-preview i {
        transform: rotate(45deg);
        color: #ffffff;
        font-size: 10px;
        margin-top: -1px;
        margin-left: -1px;
    }

    /* Premium Styles for Leaflet Popups in Preview */
    .leaflet-popup-content-wrapper {
        border-radius: 12px !important;
        box-shadow: 0 8px 20px -5px rgba(0, 0, 0, 0.15) !important;
        padding: 0 !important;
        overflow: hidden;
        border: 1px solid rgba(0, 0, 0, 0.05);
    }

    .leaflet-popup-content {
        margin: 0 !important;
        width: 280px !important;
        height: 120px !important;
    }

    .leaflet-popup-tip-container {
        margin-top: -1px;
    }
</style>
    <style>
        /* CSS real (no utilidades de Tailwind) para lo que sostiene la rejilla:
           cada publicación es un iframe de alto variable que inserta X, y el
           Tailwind de este portal se compila en el navegador, así que dejar el
           ancho en clases lo vuelve frágil. */
        .vibra-x__cuenta {
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
            margin-bottom: 28px;
            color: rgb(var(--brand-burgundy));
            font-size: .82rem;
            font-weight: 600;
            letter-spacing: .04em;
        }

        .vibra-x__logo { width: 16px; height: 16px; flex: 0 0 16px; fill: currentColor; }
        .vibra-x__logo--pie { width: 16px; height: 16px; flex-basis: 16px; }

        .vibra-x__grid {
            display: grid;
            grid-template-columns: 1fr;
            gap: 24px;
            max-width: 380px;
            margin: 0 auto;
        }

        @media (min-width: 900px) {
            .vibra-x__grid {
                grid-template-columns: repeat(3, minmax(0, 1fr));
                max-width: 1140px;
                align-items: start;
            }
        }

        /* X trae el blockquote con márgenes propios en línea: se centran dentro
           de su columna en vez de pegarse a la izquierda. */
        .vibra-x__post .twitter-tweet { margin: 0 auto !important; }

        .vibra-x__aviso {
            padding: 56px 16px;
            text-align: center;
            font-size: .88rem;
            color: #8B7F86;
        }

        .vibra-x__pie { margin-top: 32px; text-align: center; }
    </style>
    <style>
        /* Todo va scopeado bajo .cx-clima para no colisionar con el resto del sitio. */
        .cx-clima { color: #fff; overflow: hidden; }

        /* Franja principal: el fondo se tiñe según la condición (clases cx-amb-*). */
        .cx-strip {
            position: relative;
            display: flex;
            align-items: center;
            gap: 34px;
            flex-wrap: wrap;
            padding: 34px 40px;
        }
        .cx-strip::after {
            content: "";
            position: absolute;
            inset: 0;
            pointer-events: none;
            background: radial-gradient(circle at 85% 120%, rgba(255,255,255,.14), transparent 55%);
        }

        /* Ambientes por condición. */
        .cx-amb-sunny  { background: linear-gradient(115deg, #c97b1e, #e6a53a 55%, #f0c14b); }
        .cx-amb-cloudy { background: linear-gradient(115deg, #4a5a6b, #6b7d8c 60%, #8fa0ad); }
        .cx-amb-rain   { background: linear-gradient(115deg, #1f3a52, #2b4d68 55%, #3d6178); }
        .cx-amb-storm  { background: linear-gradient(115deg, #241634, #3a2350 55%, #4a2d63); }
        .cx-amb-night  { background: linear-gradient(115deg, #101a33, #1c2a4d 55%, #2a3a63); }

        .cx-icon-box { width: 96px; height: 96px; flex-shrink: 0; filter: drop-shadow(0 8px 14px rgba(0,0,0,.25)); }
        .cx-icon { width: 100%; height: 100%; display: block; }

        .cx-lead { display: flex; flex-direction: column; gap: 2px; min-width: 180px; position: relative; }
        .cx-place {
            font-size: 12px; font-weight: 700; letter-spacing: .16em; text-transform: uppercase;
            opacity: .9; display: flex; align-items: center; gap: 7px;
        }
        .cx-temp { font-family: 'Playfair Display', serif; font-weight: 800; font-size: 64px; line-height: 1; letter-spacing: -.02em; }
        .cx-temp sup { font-size: 26px; top: -1.1em; font-weight: 700; opacity: .8; }
        .cx-cond { font-size: 16px; font-weight: 600; opacity: .95; text-transform: capitalize; }

        .cx-divider { width: 1px; align-self: stretch; background: rgba(255,255,255,.22); }

        .cx-metrics { display: flex; gap: 14px; flex-wrap: wrap; flex: 1; position: relative; }
        .cx-metric {
            background: rgba(255,255,255,.12); border: 1px solid rgba(255,255,255,.20);
            border-radius: 14px; padding: 12px 18px; min-width: 120px; backdrop-filter: blur(4px);
        }
        .cx-m-label { font-size: 11px; letter-spacing: .12em; text-transform: uppercase; opacity: .8; font-weight: 600; }
        .cx-m-value { font-size: 22px; font-weight: 700; font-variant-numeric: tabular-nums; margin-top: 2px; }

        .cx-stamp {
            margin-left: auto; text-align: right; font-size: 11px; opacity: .8; line-height: 1.5;
            display: flex; flex-direction: column; gap: 2px; align-self: flex-start; position: relative;
        }

        /* Transición suave al refrescar el contenido vía JS. */
        .cx-clima { transition: opacity .4s ease; }
        .cx-clima.cx-refreshing { opacity: .55; }

        /* Estado "no disponible": sobrio, sobre el crema institucional. */
        .cx-error { background: rgb(var(--brand-cream)); display: flex; justify-content: center; padding: 34px 24px; }
        .cx-error-card {
            display: flex; align-items: center; gap: 16px; max-width: 560px;
            background: #fff; border: 1px dashed rgba(92,17,60,.35);
            border-radius: 16px; padding: 20px 24px; color: rgb(var(--brand-burgundy));
        }
        .cx-error-icon { width: 40px; height: 40px; flex-shrink: 0; color: rgb(var(--brand-muted)); }
        .cx-error-card strong { display: block; font-family: 'Playfair Display', serif; font-size: 17px; margin-bottom: 2px; }
        .cx-error-card span { font-size: 13.5px; color: rgba(27,14,21,.6); }

        @media (max-width: 760px) {
            .cx-strip { padding: 26px 22px; gap: 18px; }
            .cx-divider { display: none; }
            .cx-temp { font-size: 52px; }
            .cx-icon-box { width: 72px; height: 72px; }

            /* La franja es una fila que se parte sola cuando no cabe, y en un
               teléfono se partía mal: las tres medidas se quedaban en una
               columna estrecha a la izquierda (cada tarjeta pide 120px de ancho
               mínimo, así que no entraban dos seguidas) y la fecha de
               actualización se subía al hueco que quedaba al lado.

               Aquí se les dice que ocupen renglón propio y completo: arriba el
               icono con la temperatura, debajo las tres medidas repartidas en
               partes iguales, y al final la línea de actualización. */
            /* El nombre del lugar es largo y pedía 180px de ancho mínimo, así
               que el icono se quedaba solo en el primer renglón. Dejándolo
               encoger, los dos caben al lado y el rótulo parte donde toque. */
            .cx-lead { min-width: 0; flex: 1; }

            .cx-metrics {
                flex-basis: 100%;
                display: grid;
                grid-template-columns: repeat(3, 1fr);
                gap: 10px;
            }
            .cx-metric { min-width: 0; padding: 10px 12px; }
            .cx-m-label { font-size: 10px; letter-spacing: .06em; }
            .cx-m-value { font-size: 19px; }

            .cx-stamp { flex-basis: 100%; margin-left: 0; text-align: left; }
        }

        /* Teléfonos estrechos: las tres siguen en fila, apretando la caja. Con
           tres columnas y 320px de pantalla cada tarjeta se queda en unos 86px,
           lo justo para "8 km/h". */
        @media (max-width: 400px) {
            .cx-strip { padding: 22px 16px; }
            .cx-metrics { gap: 8px; }
            .cx-metric { padding: 9px 8px; }
            .cx-m-value { font-size: 17px; }
        }
    </style>
    <link rel="stylesheet" href="https://descubre.veracruzmunicipio.gob.mx/module-assets/descubre-veracruz/css/descubrever/calendario-eventos.css?v=1787845637"/>
</head>
<body class="antialiased text-gray-800">

    <!-- Incluir Navegación -->
    <style>
    /* Clases utilitarias para el efecto diagonal */
    .skew-bg { transform: skewX(-20deg); }
    .unskew-content { transform: skewX(20deg); }

    /* Rótulos de la barra: los nombres de más de una palabra se parten en
       renglones en vez de estirar su apartado a lo ancho. min-content deja el
       ancho de la palabra más larga y el resto baja de línea. */
    .nav-rotulo {
        max-width: min-content;
        white-space: normal;
        text-align: center;
        line-height: 1.15;
    }

    /* Rótulos de varias palabras como Invierte en el Centro Histórico */
    .nav-rotulo-ancho {
        max-width: 18ch;
    }

    /* Acordeón de la barra: el apartado señalado se ensancha suavemente */
    a.nav-link {
        transition: padding 0.6s cubic-bezier(0.19, 1, 0.22, 1);
        will-change: padding;
    }

    @media (hover: hover) {
        a.nav-link:hover,
        a.nav-link:focus-visible {
            padding-left: 2.75rem;
            padding-right: 2.75rem;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        a.nav-link { transition: none; }
    }
</style>

<div class="w-full " v-scope="{ mobileMenuOpen: false }">
    <nav id="navbar" data-ms-locked data-ms-comun="navbar" class="relative w-full h-24 z-50 bg-[rgb(var(--brand-burgundy,92_17_60))] overflow-hidden">
        <div class="w-full h-full flex justify-between items-center">

            <!-- Marca / Logo institucional centrado en el espacio libre -->
            <div class="flex-1 min-w-0 flex items-center justify-center h-full z-20 px-4">
                <a href="https://descubre.veracruzmunicipio.gob.mx" class="flex items-center hover:opacity-95 transition">
                    <img src="https://descubre.veracruzmunicipio.gob.mx/images/identidad/iconoV42026_NoFont.png"
                         data-ms-field="navbar.logo"
                         alt="Descubre Veracruz"
