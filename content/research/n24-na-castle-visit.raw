    <section class="sectionVox" id="access">
      <header>
        <h2 class="headStyle06">Access</h2>
      </header>
      <div class="inner">
        <div class="contVox">
          <h3 class="headStyle07">Map around Nagoya Castle</h3>
          <div class="img">
            <figure>
              <img
                src="../assets/images/content/information/index_img01_20221226.jpg"
                alt=""
              />
              <figcaption class="ftGothicL">
                <div class="btnStyle02">
                  <a
                    href="../../downloads/shousai_english_20221226.pdf"
                    target="_blank"
                    >Map around Nagoya Castle(PDF:113KB)</a
                  >
                </div>
              </figcaption>
            </figure>
          </div>
        </div>
        <!-- /contVox -->

        <div class="contVox">
          <h3 class="headStyle07">Public Transportation</h3>
          <div class="accessVox">
            <h4 class="headStyle05">Subway</h4>
            <p class="mB40">
              Get off at the "Nagoyajo" or M07 stop of the Meijo Line.<br />
              Get off at the "Sengencho" or T05 stop of the Tsurumai Line.
            </p>
            <h4 class="headStyle05">Train</h4>
            <p>Get off at the "Higashi-ote" stop of the Meitetsu Seto Line</p>
          </div>
          <div class="accessVox">
            <h4 class="headStyle05">Bus</h4>
            <p>
              Get off at the "Nagoyajo Seimon-Mae" stop of Sakae No. 13.<br />
              Take a Nagoya Sightseeing Route Bus called "Me-guru".<br />
              Get off at the "Shiyakusho" stop of the Key Route Bus No. 2.
            </p>
          </div>
          <div class="accessVox">
            <h4 class="headStyle05">Horikawa Cruise</h4>
            <p>
               5 minutes walk from Nagoyajo Mae（Asahi-bashi）pier boarding area.<br />
               Please check the Horikawa Cruise website for operation details.
            </p>
                <div class="btnStyle02 mB10">
                <a
                  href="https://www.nagoya-horikawa-cruise.jp/wp-content/themes/horikawanews/pdf/timetable2024autumn.pdf"
                  target="_blank"
                  >Horikawa Cruise Information(PDF:300KB)</a
                >
              </div>
            <p>
              Please not Japanese only.
            </p>
          </div>
        </div>
        <!-- /contVox -->

        <div class="contVox">
          <h3 class="headStyle07">Car</h3>
          <div class="accessVox">
            <p class="mB40">
              8 min south of the Nagoya Express Way Route No. 1 Kusunoki-line
              "Kurokawa" exit.<br />
              5 min north of the Nagoya Express Way Ring Route "Marunouchi"
              exit.
            </p>
            <h4 class="headStyle05">Pay Parking</h4>
            <h5 class="s2-0r fwB">Main Gate Parking</h5>
            <p>
              Regular hours: 8:45 a.m. - 9:30 p.m.<br />
              Capacity: 319 passenger cars, 28 large vehicles<br />
              *Open until 10:00 p.m. during the Summer Night Festival.<br />
              *Motor bicycles are accepted.<br />
              *Closed on December 29 - January 1.
            </p>

            <h5 class="s2-0r fwB">East Gate Parking</h5>
            <p>
              Regular hours: 8:30 a.m. - 10:30 p.m.<br />
              Capacity: 202 passenger cars, 28 large vehicles<br />
              *Closed on December 29 - January 1.
            </p>

            <table class="tableStyle02 wAuto">
              <caption>
                Parking Fees
              </caption>
              <thead>
                <tr>
                  <th>Type</th>
                  <th>Unit of Time</th>
                  <th>Fee</th>
                </tr>
              </thead>
              <tbody>
                <tr>
                  <th>Passengers cars</th>
                  <td>Every 30 minutes</td>
                  <td>250<span class="yen">yen</span></td>
                </tr>
                <tr>
                  <th>Large vehicles</th>
                  <td>1 hour and every 30 minutes after the hour</td>
                  <td>600<span class="yen">yen</span></td>
                </tr>
                <tr>
                  <th>Motor bicycles Free</th>
                  <td>Every 30 minutes</td>
                  <td>150<span class="yen">yen</span></td>
                </tr>
              </tbody>
            </table>

            <p class="mB20">
              <span class="cRed">Overnight parking is not permitted. </span
              ><br />
              Please use the following parking lots for overnight parking of
              large vehicles. *Reservation required for all.
            </p>
            <ul class="listStyle01">
              <li>
                <span class="fwB">Hisaya-odori Koen Parking Plac</span>e Phone:
                052-971-8546
              </li>
              <li>
                <span class="fwB"
                  >Wakamiya-odori Koen Shirakawa-mae Parking Place</span
                >
                Phone: 052-231-1051
              </li>
              <li>
                <span class="fwB"
                  >Wakamiya-odori Koen Suzakibashi Parking Place</span
                >
                Phone: 052-231-1051
              </li>
              <li>
                <span class="fwB">MID Shimo-Hirai Parking</span> Phone:
                052-581-0969
              </li>
            </ul>
          </div>
        </div>
        <!-- /contVox -->
      </div>
    </section>
