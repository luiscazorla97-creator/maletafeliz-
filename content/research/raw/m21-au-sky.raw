<section class="sc-section sc-loc" id="location" aria-labelledby="sc-location-heading">
	<div class="sc-container">
		<div class="sc-loc__grid">

			<div class="sc-loc__intro">
				<span class="sc-loc__eyebrow">Visit us</span>
				<h2 class="sc-section__title" id="sc-location-heading">Location &amp; contact</h2>

					<address class="sc-loc__address">Corner Victoria and Federal Streets, Auckland CBD, Auckland 1010</address>
					<ul class="sc-loc__contact">
							<li><a href="tel:&#x2B;6493636000">&#x2B;64 9 363 6000</a></li>
							<li><a href="mailto:skytower@skycity.co.nz">skytower@skycity.co.nz</a></li>
					</ul>

					<div class="sc-loc__social">
							<a href="https://www.facebook.com/SkyTowerAKL" class="sc-loc__social-link" target="_blank" rel="noopener noreferrer" aria-label="Sky Tower on Facebook">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.956.925-1.956 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"/></svg>
							</a>
							<a href="https://www.instagram.com/skytower_nz/" class="sc-loc__social-link" target="_blank" rel="noopener noreferrer" aria-label="Sky Tower on Instagram">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
							</a>
							<a href="https://www.tripadvisor.com/Attraction_Review-g255106-d256867-Reviews-Sky_Tower-Auckland_Central_North_Island.html" class="sc-loc__social-link" target="_blank" rel="noopener noreferrer" aria-label="Sky Tower on TripAdvisor">
								<svg width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12.006 4.295c-2.67 0-5.338.67-7.69 2.008L0 6.34l2.846 2.775a5.693 5.693 0 00-.862 3.034c0 3.14 2.549 5.689 5.689 5.689a5.674 5.674 0 003.768-1.424l.565.817.565-.817a5.674 5.674 0 003.768 1.424c3.14 0 5.689-2.549 5.689-5.689a5.69 5.69 0 00-.862-3.034L24 6.34l-4.316-.037C17.332 4.964 14.675 4.295 12.006 4.295zM7.673 9.37a2.845 2.845 0 110 5.69 2.845 2.845 0 010-5.69zm8.666 0a2.845 2.845 0 110 5.69 2.845 2.845 0 010-5.69zm-8.666 1.423a1.422 1.422 0 100 2.844 1.422 1.422 0 000-2.844zm8.666 0a1.422 1.422 0 100 2.844 1.422 1.422 0 000-2.844z"/></svg>
							</a>
					</div>

				<a href="https://www.google.com/maps/place/?q=place_id:ChIJJdxLbfBHDW0Rh5OtgMO10QI" class="sc-btn sc-btn--dark sc-loc__cta" target="_blank" rel="noopener noreferrer">
					<span class="material-symbols-outlined" aria-hidden="true">location_on</span>
					Get Directions
				</a>
			</div>

			<div class="sc-loc__mapcol">
				<div class="sc-loc__map"
					id="sc-loc-map-1122"
					role="region"
					aria-label="Map showing the location of Sky Tower"
					data-sc-map
					data-lat="-36.8483946"
					data-lng="174.7624036"
					data-name="Sky Tower"
					data-card="sc-loc-card-1122"></div>

				<template id="sc-loc-card-1122">
					<div class="sc-loc__card">
						<p class="sc-loc__card-name">Sky Tower</p>
							<p class="sc-loc__card-row">
								<span class="material-symbols-outlined" aria-hidden="true">call</span>
								<a href="tel:&#x2B;6493636000">&#x2B;64 9 363 6000</a>
							</p>
							<p class="sc-loc__card-row">
								<span class="material-symbols-outlined" aria-hidden="true">mail</span>
								<a href="mailto:skytower@skycity.co.nz">skytower@skycity.co.nz</a>
							</p>
						<a class="sc-loc__card-link" href="https://www.google.com/maps/place/?q=place_id:ChIJJdxLbfBHDW0Rh5OtgMO10QI" target="_blank" rel="noopener noreferrer">
							Directions
							<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>
						</a>
					</div>
				</template>
			</div>

		</div>
	</div>
</section>

	<script>
	(function () {
		if (window.__scLocMapBound) { return; }
		window.__scLocMapBound = true;

		/* WebGL is a hard requirement, probed directly (maplibregl.supported() is gone in v5+); without it the map column never un-hides. */
		function hasWebGL() {
			try {
				var c = document.createElement('canvas');
				return !!(window.WebGLRenderingContext &&
					(c.getContext('webgl') || c.getContext('experimental-webgl')));
			} catch (e) { return false; }
		}

		/* Brand basemap authored per vector layer; plum is the surface, never black.
		   The dark label halo is load-bearing for contrast where labels cross road casings — do not remove it. */
		var LAND = '#3E1226', WATER = '#2A0A1A', BLD = '#4A1A30';
		var ROAD_MINOR = '#6B4155', ROAD_MAJOR = '#7E5266', ROAD_MOTORWAY = '#A9764E';
		var LABEL = '#E8DDE2', HALO = '#1C0512';

		function style() {
			return {
				version: 8,
				glyphs: '/fonts/{fontstack}/{range}.pbf',
				/* Glyphs are self-hosted at a RELATIVE path (same-origin, no CORS); never point at tiles.openfreemap.org — it lacks Montserrat and labels vanish.
				   Attribution is declared explicitly (licence condition) so it never depends on the TileJSON; text-font values must match existing fontstacks. */
				sources: {
					ofm: {
						type: 'vector',
						url: 'https://tiles.openfreemap.org/planet',
						attribution: '<a href="https://openfreemap.org" target="_blank" rel="noopener">OpenFreeMap</a> <a href="https://www.openmaptiles.org/" target="_blank" rel="noopener">&copy; OpenMapTiles</a> Data from <a href="https://www.openstreetmap.org/copyright" target="_blank" rel="noopener">OpenStreetMap</a>'
					}
				},
				layers: [
					{ id: 'bg', type: 'background', paint: { 'background-color': LAND } },
					{ id: 'landcover', type: 'fill', source: 'ofm', 'source-layer': 'landcover',
					  paint: { 'fill-color': '#45182C', 'fill-opacity': 0.5 } },
					{ id: 'park', type: 'fill', source: 'ofm', 'source-layer': 'park',
					  paint: { 'fill-color': '#3A1628', 'fill-opacity': 0.6 } },
					{ id: 'water', type: 'fill', source: 'ofm', 'source-layer': 'water',
					  paint: { 'fill-color': WATER } },
					{ id: 'building', type: 'fill', source: 'ofm', 'source-layer': 'building',
					  minzoom: 13, paint: { 'fill-color': BLD, 'fill-opacity': 0.7 } },
					{ id: 'road-minor', type: 'line', source: 'ofm', 'source-layer': 'transportation',
					  filter: ['!', ['in', ['get', 'class'], ['literal', ['motorway', 'trunk', 'primary']]]],
					  layout: { 'line-cap': 'round', 'line-join': 'round' },
					  paint: { 'line-color': ROAD_MINOR,
						'line-width': ['interpolate', ['linear'], ['zoom'], 10, 0.4, 14, 1.6, 18, 8] } },
					{ id: 'road-major', type: 'line', source: 'ofm', 'source-layer': 'transportation',
					  filter: ['in', ['get', 'class'], ['literal', ['primary', 'trunk']]],
					  layout: { 'line-cap': 'round', 'line-join': 'round' },
					  paint: { 'line-color': ROAD_MAJOR,
						'line-width': ['interpolate', ['linear'], ['zoom'], 10, 1, 14, 3, 18, 12] } },
					{ id: 'road-motorway', type: 'line', source: 'ofm', 'source-layer': 'transportation',
					  filter: ['==', ['get', 'class'], 'motorway'],
					  layout: { 'line-cap': 'round', 'line-join': 'round' },
					  paint: { 'line-color': ROAD_MOTORWAY,
						'line-width': ['interpolate', ['linear'], ['zoom'], 10, 1.4, 14, 4, 18, 16] } },
					{ id: 'road-label', type: 'symbol', source: 'ofm', 'source-layer': 'transportation_name',
					  minzoom: 12,
					  layout: { 'text-field': ['get', 'name'], 'text-font': ['Montserrat Regular'],
						'symbol-placement': 'line', 'text-size': 11, 'text-letter-spacing': 0.02 },
					  paint: { 'text-color': LABEL, 'text-halo-color': HALO, 'text-halo-width': 1.4 } },
					{ id: 'place-label', type: 'symbol', source: 'ofm', 'source-layer': 'place',
					  filter: ['in', ['get', 'class'], ['literal', ['city', 'town', 'suburb', 'neighbourhood']]],
					  layout: { 'text-field': ['get', 'name'], 'text-font': ['Montserrat Bold'],
						'text-size': ['interpolate', ['linear'], ['zoom'], 10, 11, 15, 14],
						'text-letter-spacing': 0.06, 'text-transform': 'uppercase' },
					  paint: { 'text-color': '#F2E8EC', 'text-halo-color': HALO, 'text-halo-width': 1.6 } }
				]
			};
		}

		function pin() {
			var el = document.createElement('div');
			el.className = 'sc-loc__pin';
			el.innerHTML =
				'<svg width="30" height="40" viewBox="0 0 30 40" aria-hidden="true">' +
				'<path d="M15 0C6.7 0 0 6.7 0 15c0 10.5 13.4 23.7 14 24.3a1.4 1.4 0 0 0 2 0C16.6 38.7 30 25.5 30 15 30 6.7 23.3 0 15 0z" fill="#DCB741"/>' +
				'<circle cx="15" cy="15" r="5.4" fill="#FFFFFF"/></svg>';
			return el;
		}

		function build(host) {
			var lat = parseFloat(host.getAttribute('data-lat'));
			var lng = parseFloat(host.getAttribute('data-lng'));
			if (!isFinite(lat) || !isFinite(lng)) { return; }

			/* UN-HIDE BEFORE CONSTRUCTING: MapLibre measures its container at construction; a hidden one gives a wrong-size canvas and a misplaced marker. */
			var section = host.closest('.sc-loc');
			if (section) { section.classList.add('sc-loc--ready'); }

			var map = new maplibregl.Map({
				container: host,
				style: style(),
				center: [lng, lat],
				/* ⚠️ The vector source's maxzoom is 14 — past that MapLibre overzooms and no
				   NEW detail appears. 15 reads as street level without pretending otherwise. */
				zoom: 15,
				attributionControl: { compact: false },
				cooperativeGestures: true
			});
			map.addControl(new maplibregl.NavigationControl({ showCompass: false }), 'top-right');

			/* If ever placed inside something collapsed at load, resize() on load re-measures once the real box exists. */
			map.on('load', function () { map.resize(); });

			/* Set only by the keydown handler, consumed by the popup's `open` event below, so
			   focus moves for a KEYBOARD open and never for a mouse one. */
			var kbdOpen = false;

			var tpl = document.getElementById(host.getAttribute('data-card'));
			var marker = new maplibregl.Marker({ element: pin(), anchor: 'bottom' })
				.setLngLat([lng, lat]).addTo(map);

			if (tpl && tpl.content) {
				/* closeButton:true gives a real labelled button; setPopup() makes marker clicks toggle, so a closed card always comes back.
				   focusAfterOpen: false — the default moves focus into the card on load and jumps the page to the map; keyboard focus is restored below. */
				var popup = new maplibregl.Popup({
					offset: 38, closeButton: true, closeOnClick: false,
					focusAfterOpen: false,
					className: 'sc-loc__popup', maxWidth: '330px'
				}).setDOMContent(tpl.content.cloneNode(true));
				/* Focus moves on MapLibre's own open EVENT, not a timer — the popup DOM is not attached within a frame.
				   `close` clears the flag so a closing toggle cannot steal focus on the next mouse open. */
				popup.on('open', function () {
					if (!kbdOpen) { return; }
					kbdOpen = false;
					var pop = map.getContainer().querySelector('.sc-loc__popup');
					var target = pop && pop.querySelector('a[href], button');
					if (target) { target.focus(); }
				});
				popup.on('close', function () { kbdOpen = false; });

				marker.setPopup(popup);
				/* Open on load via togglePopup(), not popup.addTo() — addTo() leaves the marker thinking it is closed, so the first click closes-and-reopens. */
				marker.togglePopup();
			}

			/* Keyboard: the marker is a real control, reachable by tab. Focus is NOT trapped
			   in the map — the container is role="region", not role="application". */
			var el = marker.getElement();
			el.setAttribute('tabindex', '0');
			el.setAttribute('role', 'button');
			el.setAttribute('aria-label', 'Show contact details for ' + (host.getAttribute('data-name') || 'this venue'));
			/* Keyboard-only focus move: arm the flag here and let the popup open event move focus — nothing fires on the closing half of the toggle. */
			el.addEventListener('keydown', function (e) {
				if (e.key !== 'Enter' && e.key !== ' ') { return; }
				e.preventDefault();
				kbdOpen = true;
				el.click();
			});

		}

		/* Lazy load near the viewport — parsing the library and WebGL setup are long tasks that hurt INP if run at DOMContentLoaded.
		   Observe the SECTION, never the map host: the host is display:none until ready and would never intersect. */
		var LIB_JS = 'https://cdn.jsdelivr.net/npm/maplibre-gl@5.6.1/dist/maplibre-gl.js';
		var LIB_CSS = 'https://cdn.jsdelivr.net/npm/maplibre-gl@5.6.1/dist/maplibre-gl.css';
		var libState = 'idle';
		var libWaiting = [];
		var webgl = null;

		function loadLib(done) {
			if (libState === 'ready') { done(true); return; }
			if (libState === 'failed') { done(false); return; }
			libWaiting.push(done);
			if (libState === 'loading') { return; }
			libState = 'loading';
			var pending = 2;
			function settle(ok) {
				if (libState !== 'loading') { return; }
				if (ok) {
					pending -= 1;
					if (pending > 0) { return; }
					libState = 'ready';
				} else {
					libState = 'failed';
				}
				var q = libWaiting;
				libWaiting = [];
				q.forEach(function (fn) { fn(libState === 'ready'); });
			}
			var css = document.createElement('link');
			css.rel = 'stylesheet';
			css.href = LIB_CSS;
			css.onload = function () { settle(true); };
			css.onerror = function () { settle(true); };
			document.head.appendChild(css);
			var js = document.createElement('script');
			js.src = LIB_JS;
			js.async = true;
			js.onload = function () { settle(typeof maplibregl !== 'undefined'); };
			js.onerror = function () { settle(false); };
			document.head.appendChild(js);
		}

		function start(section) {
			if (webgl === null) { webgl = hasWebGL(); }
			if (!webgl) { return; }
			var hosts = section.matches('[data-sc-map]') ? [section] : section.querySelectorAll('[data-sc-map]');
			if (!hosts.length) { return; }
			loadLib(function (ok) {
				if (!ok) { return; }
				Array.prototype.forEach.call(hosts, function (h) { try { build(h); } catch (e) { } });
			});
		}

		function init() {
			var hosts = document.querySelectorAll('[data-sc-map]');
			if (!hosts.length) { return; }
			var sections = [];
			Array.prototype.forEach.call(hosts, function (h) {
				var s = h.closest('.sc-loc') || h;
				if (sections.indexOf(s) === -1) { sections.push(s); }
			});
			if (!('IntersectionObserver' in window)) {
				sections.forEach(start);
				return;
			}
			var io = new IntersectionObserver(function (entries) {
				entries.forEach(function (en) {
					if (!en.isIntersecting) { return; }
					io.unobserve(en.target);
					start(en.target);
				});
			}, { rootMargin: '600px 0px' });
			sections.forEach(function (s) { io.observe(s); });
		}

		if (document.readyState === 'loading') {
			document.addEventListener('DOMContentLoaded', init);
		} else {
			init();
		}
	})();
	</script>


	<section class="sc-section sc-section--grey" id="faq">
		<div class="sc-container">
			
<section class="sc-faq" aria-labelledby="sc-faq-heading">
	<div class="sc-faq__inner">

		<div class="sc-faq__heading-block">
			<h2 class="sc-faq__heading" id="sc-faq-heading">Frequently Asked Questions</h2>
		</div>

		<div class="sc-faq__list" role="list">
					<div class="sc-faq__item" role="listitem" id="faq-90cf4cea507d47f28022775e80b4a597">
						<button class="sc-faq__question"
							type="button"
							id="sc-faq-q-0-0"
							aria-expanded="false"
							aria-controls="sc-faq-answer-0-0">
							<span>Can I request the Sky Tower to be lit for my cause?</span>
							<span class="material-symbols-outlined sc-faq__icon" aria-hidden="true">keyboard_arrow_down</span>
						</button>
						<div class="sc-faq__answer"
							id="sc-faq-answer-0-0"
							role="region"
							aria-labelledby="sc-faq-q-0-0"
							hidden>
<p>Every year the Sky Tower receives hundreds of requests to light up Auckland to support charities, mark national occasions and express solidarity with communities.</p><p>We are currently fulfilling established charity and partner commitments and will only reply if your request is successful due to the high demand we are experiencing.</p><p>To submit a request fill out this form:&nbsp;</p><button type="button" class="sc-btn sc-btn--gold sc-faq__form-trigger" data-dialog-target="sc-form-dlg-19731993d79e4f0391631db9e628b310">Request Sky Tower lighting</button>						</div>
					</div>
					<div class="sc-faq__item" role="listitem" id="faq-4ca9703e8b06479e856fb820e85348ee">
						<button class="sc-faq__question"
							type="button"
							id="sc-faq-q-0-1"
							aria-expanded="false"
							aria-controls="sc-faq-answer-0-1">
							<span>Can I hire the Sky Tower for a private event?</span>
							<span class="material-symbols-outlined sc-faq__icon" aria-hidden="true">keyboard_arrow_down</span>
						</button>
						<div class="sc-faq__answer"
							id="sc-faq-answer-0-1"
							role="region"
							aria-labelledby="sc-faq-q-0-1"
							hidden>
<p>Yes — New Zealand's most iconic landmark is available for private events 220 metres above Auckland. The Sky Tower has three hireable spaces: the Main Observation Area at 186 metres (Level 51), The Lookout at 192 metres (Level 53), and the Sky Deck at 220 metres (Level 60). Whether you're planning a sunrise corporate breakfast, cocktail reception, or evening celebration, our events team can help bring your vision to life above the Auckland skyline. To enquire, email <a href="mailto:events@skycity.co.nz">events@skycity.co.nz</a> or call +64 9 363 6000.</p>						</div>
					</div>
					<div class="sc-faq__item" role="listitem" id="faq-0776ea3186644ae7a821ec12dc326a20">
						<button class="sc-faq__question"
							type="button"
							id="sc-faq-q-0-2"
							aria-expanded="false"
							aria-controls="sc-faq-answer-0-2">
							<span>What are your casual parking rates?</span>
							<span class="material-symbols-outlined sc-faq__icon" aria-hidden="true">keyboard_arrow_down</span>
						</button>
						<div class="sc-faq__answer"
							id="sc-faq-answer-0-2"
							role="region"
							aria-labelledby="sc-faq-q-0-2"
							hidden>
<p>Our current casual, Super Saver and Early Bird rates for both the SkyCity Main Car Park and the NZICC &amp; Horizon by SkyCity Car Park are set out in the <a target="" data-router-slot="disabled" href="/about-us/car-parking/" title="Car Parking">parking rates table</a>.</p>						</div>
					</div>
					<div class="sc-faq__item" role="listitem" id="faq-f0f4f8ec88ec4eb3a4c8e5151f84f616">
						<button class="sc-faq__question"
							type="button"
							id="sc-faq-q-0-3"
							aria-expanded="false"
							aria-controls="sc-faq-answer-0-3">
							<span>Can I use my SHOW by SkyCity Rewards for parking?</span>
							<span class="material-symbols-outlined sc-faq__icon" aria-hidden="true">keyboard_arrow_down</span>
						</button>
						<div class="sc-faq__answer"
							id="sc-faq-answer-0-3"
							role="region"
							aria-labelledby="sc-faq-q-0-3"
							hidden>
<p>Yes, if you have sufficient SHOW by SkyCity Points or a car parking credit accrued on your card. Your SHOW by SkyCity Rewards card can be swiped at the parking machines to exit. Please note, some car parking credits are required to be activated at a SHOW by SkyCity Rewards Kiosk before redemption.</p>						</div>
					</div>
					<div class="sc-faq__item" role="listitem" id="faq-0a44f5784f02420f8c93f2c81e8bc2ba">
						<button class="sc-faq__question"
							type="button"
							id="sc-faq-q-0-4"
							aria-expanded="false"
							aria-controls="sc-faq-answer-0-4">
							<span>What is the height restriction for the car parks?</span>
							<span class="material-symbols-outlined sc-faq__icon" aria-hidden="true">keyboard_arrow_down</span>
						</button>
						<div class="sc-faq__answer"
							id="sc-faq-answer-0-4"
							role="region"
							aria-labelledby="sc-faq-q-0-4"
							hidden>
<p>The maximum height for vehicles in SkyCity Main Site car park is 2.1 metres and in SkyCity Grand Hotel car park is 2.1 metres.</p>						</div>
					</div>
					<div class="sc-faq__item" role="listitem" id="faq-79a2f3b9d1fa436784c3cd3d0662ea6c">
						<button class="sc-faq__question"
							type="button"
							id="sc-faq-q-0-5"
							aria-expanded="false"
							aria-controls="sc-faq-answer-0-5">
							<span>Where can I download my Sky Tower photos?</span>
							<span class="material-symbols-outlined sc-faq__icon" aria-hidden="true">keyboard_arrow_down</span>
						</button>
						<div class="sc-faq__answer"
							id="sc-faq-answer-0-5"
							role="region"
							aria-labelledby="sc-faq-q-0-5"
							hidden>
<p>Sky Tower photos can be downloaded from the <a target="_blank" data-router-slot="disabled" href="https://shop.magicmemories.com/" title="Magic Memories" type="external">Magic Memories website</a>.</p>						</div>
