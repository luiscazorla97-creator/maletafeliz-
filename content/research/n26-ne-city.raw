ckend.nelsontasman.nz%2Fassets%2Flistings%2Fvictus-coffee-and-eatery%2FBeth-and-Nick-VICTUS-credit-NelsonTasmanNZ__FocusFillMaxWyItMC4wMSIsIi0wLjI3Iiw2MDAsODAwXQ.jpg&amp;w=384&amp;q=85 384w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2Flistings%2Fvictus-coffee-and-eatery%2FBeth-and-Nick-VICTUS-credit-NelsonTasmanNZ__FocusFillMaxWyItMC4wMSIsIi0wLjI3Iiw2MDAsODAwXQ.jpg&amp;w=640&amp;q=85 640w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2Flistings%2Fvictus-coffee-and-eatery%2FBeth-and-Nick-VICTUS-credit-NelsonTasmanNZ__FocusFillMaxWyItMC4wMSIsIi0wLjI3Iiw2MDAsODAwXQ.jpg&amp;w=750&amp;q=85 750w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2Flistings%2Fvictus-coffee-and-eatery%2FBeth-and-Nick-VICTUS-credit-NelsonTasmanNZ__FocusFillMaxWyItMC4wMSIsIi0wLjI3Iiw2MDAsODAwXQ.jpg&amp;w=828&amp;q=85 828w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2Flistings%2Fvictus-coffee-and-eatery%2FBeth-and-Nick-VICTUS-credit-NelsonTasmanNZ__FocusFillMaxWyItMC4wMSIsIi0wLjI3Iiw2MDAsODAwXQ.jpg&amp;w=1080&amp;q=85 1080w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2Flistings%2Fvictus-coffee-and-eatery%2FBeth-and-Nick-VICTUS-credit-NelsonTasmanNZ__FocusFillMaxWyItMC4wMSIsIi0wLjI3Iiw2MDAsODAwXQ.jpg&amp;w=1200&amp;q=85 1200w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2Flistings%2Fvictus-coffee-and-eatery%2FBeth-and-Nick-VICTUS-credit-NelsonTasmanNZ__FocusFillMaxWyItMC4wMSIsIi0wLjI3Iiw2MDAsODAwXQ.jpg&amp;w=1920&amp;q=85 1920w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2Flistings%2Fvictus-coffee-and-eatery%2FBeth-and-Nick-VICTUS-credit-NelsonTasmanNZ__FocusFillMaxWyItMC4wMSIsIi0wLjI3Iiw2MDAsODAwXQ.jpg&amp;w=2048&amp;q=85 2048w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2Flistings%2Fvictus-coffee-and-eatery%2FBeth-and-Nick-VICTUS-credit-NelsonTasmanNZ__FocusFillMaxWyItMC4wMSIsIi0wLjI3Iiw2MDAsODAwXQ.jpg&amp;w=3840&amp;q=85 3840w" src="/_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2Flistings%2Fvictus-coffee-and-eatery%2FBeth-and-Nick-VICTUS-credit-NelsonTasmanNZ__FocusFillMaxWyItMC4wMSIsIi0wLjI3Iiw2MDAsODAwXQ.jpg&amp;w=3840&amp;q=85"/></div><div class="!absolute bottom-0 left-0 z-10 flex h-full w-full items-end p-4 pb-1 !text-white xl:px-8 xl:pb-4 rounded bg-gradient-to-t from-black/30 to-50% group-hover:from-black/50 transition-all duration-500 ease-in-out"><a class="after:absolute after:inset-0" href="/explore/features/nicks-top-picks-for-nelson/"><h3 class="mb-2 text-xs font-bold md:text-base lg:text-lg 2xl:text-xl">Beth &amp; Nick&#x27;s top picks for Nelson</h3></a></div></div></div></div></div></div></div></div></div></div></div><div class="ElementContent"><div class="relative"><div class="relative"><div class="container pt-6 md:pt-12 lg:pt-16 pb-6 md:pb-12 lg:pb-20"><div class="flex flex-wrap text-start justify-between max-w-none prose lg:prose-lg xl:prose-xl"><h3 class="w-full !text-xl lg:!leading-9 xl:w-1/4 shrink-0">Food, art and a creative spirit keep Nelson buzzing year round</h3><div class="w-full max-w-none justify-end text-start empty:hidden xl:w-2/3 [&amp;&gt;*:first-child]:!mt-0"><p>Alfresco dining spills onto city streets, waterfront restaurants make the most of the setting, and <a href="/explore/features/magical-markets">markets</a>, <a href="/explore/eat-and-drink/breweries">breweries </a>and tucked-away eateries give Nelson plenty of flavour. Add a lively calendar of events and <a href="/explore/features/listen-to-the-music">live music</a>, and there’s always something happening. Seek out local brews on Collingwood Street, wander the stalls and eateries of <a href="/eat-drink/kirby-lane">Kirby Lane</a>, or settle in somewhere sunny and watch the city go by.</p>
<p>Creativity runs deep here too. Nelson has a long-standing artistic legacy and a thriving community of artists, makers, galleries and performers. Three of the city’s cultural treasures — <a rel="noopener noreferrer" href="https://thesuter.org.nz/" target="_blank">The Suter Art Gallery</a>, <a rel="noopener noreferrer" href="https://www.theatreroyalnelson.co.nz/" target="_blank">Theatre Royal Nelson</a> and the <a rel="noopener noreferrer" href="https://ncma.nz/" target="_blank">Nelson Centre of Musical Arts</a> — put art, theatre and music right at the heart of the city, alongside independent galleries, studios and creative spaces that are well worth seeking out.</p></div></div></div></div></div></div><div class="ElementalImageGrid"><div class="relative"><div class="relative"><div class="pt-6 pb-6"><div class="container py-12 empty:hidden"></div><div class="container -mt-4"><div class="relative w-full overflow-hidden py-8 pb-4 md:overflow-visible" role="region" aria-roledescription="carousel"><div class=""><div class="flex -ml-4 overflow-visible md:mx-auto md:grid md:w-auto md:gap-4 lg:gap-8 lg:w-3/4 md:grid-cols-3"><div role="group" aria-roledescription="slide" class="min-w-0 grow-0 pl-4 relative shrink-0 basis-1/2 sm:basis-1/3 md:pl-0 -mt-8 md:-mt-8 md:col-span-2"><div class="group relative w-full shrink-0 grow-0 overflow-hidden h-56 md:h-64 md:w-full lg:h-96 xl:h-[420px]"><div class="relative flex h-full w-full items-center justify-center overflow-hidden rounded" style="width:100%;height:100%"><img alt="blurry placeholder" decoding="async" data-nimg="fill" class="absolute inset-0 z-0 h-full w-full bg-light object-cover rounded transition-all duration-500 ease-in-out" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;color:transparent" src="data:image/png;base64,"/><img alt="Go round and round, all year round, in Nelson City." loading="lazy" decoding="async" data-nimg="fill" class="object-cover rounded transition-all duration-500 ease-in-out z-[-10]" style="position:absolute;height:100%;width:100%;left:0;top:0;right:0;bottom:0;object-position:center;color:transparent" sizes="100%" srcSet="/_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2FHero%2FExplore%2Fnz-mtb-rally-2026%2FNZ-MTB-RALLY-2026-DAY-6-Nelson-Koata-Park-Mikhail-Huggins__FocusFillMaxWyItMC4zMSIsIjAuMTUiLDEwMDAsNjAwXQ.jpg&amp;w=16&amp;q=85 16w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2FHero%2FExplore%2Fnz-mtb-rally-2026%2FNZ-MTB-RALLY-2026-DAY-6-Nelson-Koata-Park-Mikhail-Huggins__FocusFillMaxWyItMC4zMSIsIjAuMTUiLDEwMDAsNjAwXQ.jpg&amp;w=32&amp;q=85 32w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2FHero%2FExplore%2Fnz-mtb-rally-2026%2FNZ-MTB-RALLY-2026-DAY-6-Nelson-Koata-Park-Mikhail-Huggins__FocusFillMaxWyItMC4zMSIsIjAuMTUiLDEwMDAsNjAwXQ.jpg&amp;w=48&amp;q=85 48w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2FHero%2FExplore%2Fnz-mtb-rally-2026%2FNZ-MTB-RALLY-2026-DAY-6-Nelson-Koata-Park-Mikhail-Huggins__FocusFillMaxWyItMC4zMSIsIjAuMTUiLDEwMDAsNjAwXQ.jpg&amp;w=64&amp;q=85 64w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2FHero%2FExplore%2Fnz-mtb-rally-2026%2FNZ-MTB-RALLY-2026-DAY-6-Nelson-Koata-Park-Mikhail-Huggins__FocusFillMaxWyItMC4zMSIsIjAuMTUiLDEwMDAsNjAwXQ.jpg&amp;w=96&amp;q=85 96w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2FHero%2FExplore%2Fnz-mtb-rally-2026%2FNZ-MTB-RALLY-2026-DAY-6-Nelson-Koata-Park-Mikhail-Huggins__FocusFillMaxWyItMC4zMSIsIjAuMTUiLDEwMDAsNjAwXQ.jpg&amp;w=128&amp;q=85 128w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2FHero%2FExplore%2Fnz-mtb-rally-2026%2FNZ-MTB-RALLY-2026-DAY-6-Nelson-Koata-Park-Mikhail-Huggins__FocusFillMaxWyItMC4zMSIsIjAuMTUiLDEwMDAsNjAwXQ.jpg&amp;w=256&amp;q=85 256w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2FHero%2FExplore%2Fnz-mtb-rally-2026%2FNZ-MTB-RALLY-2026-DAY-6-Nelson-Koata-Park-Mikhail-Huggins__FocusFillMaxWyIt