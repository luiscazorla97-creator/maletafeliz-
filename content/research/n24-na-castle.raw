        <script>
            const updateTime = {
                dateM: '11',
                dateD: '24',
                timeH: '16',
                timeM: '00'
            }
            // console.log(updateTime);
            const monthArr = ['Jan', 'Feb', 'Mar', 'Apr', 'May', 'Jun', 'Jul', 'Aug', 'Sept', 'Oct', 'Nov', 'Dec'];
            // console.log(monthArr[parseInt(updateTime.dateM) - 1]);
            const hour = parseInt(updateTime.timeH) > 12 ? String(parseInt(updateTime.timeH) - 12) : updateTime.timeH;
            const ampm = updateTime.timeH > 12 ? 'pm' : 'am';
            const dateTime = monthArr[parseInt(updateTime.dateM) - 1] + ' ' + updateTime.dateD + ' <span class="dspInlBlock mL10">' + hour + ':' + updateTime.timeM + '</span> ' + ampm;
        </script>
        
        <h2 class="title">Hommaru palace Admission Waiting Time;</h2>
        
        
          <div>Admissions have closed for today.</div>
        
        <span class="date">As of <script>document.write(dateTime);</script></span>
        
        
