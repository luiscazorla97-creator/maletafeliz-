        </div>

        <!-- Elegant Category Filters -->
        <div class="flex flex-wrap items-center justify-center gap-2 sm:gap-3 mb-10">
            <button
                class="principal-filter-btn active px-5 py-2 rounded-full text-xs sm:text-sm font-bold tracking-wider uppercase border border-brand-gold bg-brand-gold text-white shadow-md hover:shadow-lg transition-all duration-300 cursor-pointer"
                data-filter="todos">
                All            </button>
            <button
                class="principal-filter-btn px-5 py-2 rounded-full text-xs sm:text-sm font-bold tracking-wider uppercase border border-brand-burgundy/25 bg-brand-cream text-gray-700 hover:bg-white hover:text-brand-burgundy hover:border-brand-burgundy/50 shadow-sm hover:shadow-md transition-all duration-300 cursor-pointer"
                data-filter="museos">
                Museums            </button>
            <button
                class="principal-filter-btn px-5 py-2 rounded-full text-xs sm:text-sm font-bold tracking-wider uppercase border border-brand-burgundy/25 bg-brand-cream text-gray-700 hover:bg-white hover:text-brand-burgundy hover:border-brand-burgundy/50 shadow-sm hover:shadow-md transition-all duration-300 cursor-pointer"
                data-filter="edificios-emblematicos">
                Iconic Buildings            </button>
            <button
                class="principal-filter-btn px-5 py-2 rounded-full text-xs sm:text-sm font-bold tracking-wider uppercase border border-brand-burgundy/25 bg-brand-cream text-gray-700 hover:bg-white hover:text-brand-burgundy hover:border-brand-burgundy/50 shadow-sm hover:shadow-md transition-all duration-300 cursor-pointer"
                data-filter="plazas">
                Plazas &amp; Squares            </button>
            <button
                class="principal-filter-btn px-5 py-2 rounded-full text-xs sm:text-sm font-bold tracking-wider uppercase border border-brand-burgundy/25 bg-brand-cream text-gray-700 hover:bg-white hover:text-brand-burgundy hover:border-brand-burgundy/50 shadow-sm hover:shadow-md transition-all duration-300 cursor-pointer"
                data-filter="monumentos">
                Monuments            </button>
            <button
                class="principal-filter-btn px-5 py-2 rounded-full text-xs sm:text-sm font-bold tracking-wider uppercase border border-brand-burgundy/25 bg-brand-cream text-gray-700 hover:bg-white hover:text-brand-burgundy hover:border-brand-burgundy/50 shadow-sm hover:shadow-md transition-all duration-300 cursor-pointer"
                data-filter="callejones">
                Alleys            </button>
        </div>

