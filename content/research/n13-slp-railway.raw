            document.getElementById("abrenoti").onclick = function () {
                obj_noti.classList.toggle("fondo_abierto_noti");
                window.scrollTo(0, 0);
            };
            document.getElementById("boton_cancelar").onclick = function () {
                obj_noti.classList.toggle("fondo_abierto_noti");
            };
        </script>




        <!-- JS .GOB.MX-->
        <script src="//framework-gb.cdn.gob.mx/gobmx.js"></script>



    </body>
</html>
