					<fieldset style="border:0px;" role="group" aria-labelledby="dvgm-label_udf_659"  >
						<legend style="display:none;">udf_659</legend>
						<input class="sv_api_radio" id="dvgm-udf_659_1" name="udf_659" type="radio" value="1"><label class="sv_api_label" for="dvgm-udf_659_1"> Yes </label>
						<input class="sv_api_radio" id="dvgm-udf_659_0" name="udf_659" type="radio" value="0"><label class="sv_api_label" for="dvgm-udf_659_0"> No </label>
					</fieldset>
				</div>
				<script>
					document.addEventListener('DOMContentLoaded', function() {
						const conditionalDisplayElements = [...document.querySelectorAll('[data-conditional-on]')];
						conditionalDisplayElements.forEach(el => {
							const formEl = el.closest('form');
							const controllerFormFieldName = el.dataset['conditionalOn'];
							const controllerFormFieldElements = [...formEl.querySelectorAll(`[name="${controllerFormFieldName}"]`)];

							const onChange = (e) => {
								const formData = new FormData(formEl);
								const currentFieldValue = formData.get(controllerFormFieldName);
								if (currentFieldValue == 1) {
									reveal();
								} else {
									hide();
								}
							}
							const reveal = () => {
								el.removeAttribute('hidden')
							}
							const hide = () => {
								el.setAttribute('hidden', 'true')
							}

							controllerFormFieldElements.forEach(field => {
								hide();
								field.addEventListener('change', onChange);
							});
						})
					});
				</script>
				<!-- Address -->
				<div class="conditional-visibility" data-conditional-on="udf_659">
