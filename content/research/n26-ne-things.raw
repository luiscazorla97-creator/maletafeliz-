..cms%5D%5D/page-3f926ba3b63b5d92.js" async=""></script><link rel="preload" href="https://www.googletagmanager.com/gtm.js?id=GTM-WMX7W6RR" as="script"/><meta name="next-size-adjust" content=""/><title>Best Things to Do in Nelson City | Nelson Tasman Official Travel Guide</title><meta name="description" content="Discover the best things to do in Nelson City, from beaches, biking and nature walks to local markets, art, history, great food and family adventures."/><meta name="facebook-domain-verification" content="k28981i5wdkuxt3x73czldk4fglwoh"/><link rel="canonical" href="https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/things-to-do-nelson-city/"/><meta property="og:title" content="Best Things to Do in Nelson City | Nelson Tasman Official Travel Guide"/><meta property="og:description" content="Discover the best things to do in Nelson City, from beaches, biking and nature walks to local markets, art, history, great food and family adventures."/><meta property="og:image" content="https://backend.nelsontasman.nz/assets/listings/boat-shed-cafe/Boat-Shed-Cafe-seaside-dining-by-Oliver-Weber__FocusFillMaxWyItMC4yNCIsIjAuMDEiLDI4ODAsMTgwMF0.jpg"/><meta name="twitter:card" content="summary_large_image"/><meta name="twitter:title" content="Best Things to Do in Nelson City | Nelson Tasman Official Travel Guide"/><meta name="twitter:description" content="Discover the best things to do in Nelson City, from beaches, biking and nature walks to local markets, art, history, great food and family adventures."/><meta name="twitter:image" content="https://backend.nelsontasman.nz/assets/listings/boat-shed-cafe/Boat-Shed-Cafe-seaside-dining-by-Oliver-Weber__FocusFillMaxWyItMC4yNCIsIjAuMDEiLDI4ODAsMTgwMF0.jpg"/><link rel="icon" href="/favicon.ico" sizes="48x48" type="image/x-icon"/><link rel="icon" href="/favicon-32x32.png" sizes="32x32" type="image/png"/><link rel="icon" href="/favicon-16x16.png" sizes="16x16" type="image/png"/><link rel="apple-touch-icon" href="/