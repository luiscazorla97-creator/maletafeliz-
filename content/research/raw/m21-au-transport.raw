<noscript>
    <style>
        .at-dsn-boot-body { overflow: auto !important; }
        .at-dsn-boot__overlay { display: none !important; }
        .at-dsn-boot__content { visibility: visible !important; }
    </style>
</noscript>

<script nonce="f7fb3910-480d-e9e2-2fae-5b25a8ab1b83">
    (function () {
        var revealed = false;
        
        function revealDesignSystemPage() {
            if (revealed) return;
            revealed = true;
            document.body.classList.remove('at-dsn-boot-body');
            
            var shell = document.querySelector('.at-dsn-boot');
            if (shell) {
                shell.classList.add('at-dsn-boot--ready');
            }

            var content = document.getElementById('at-dsn-boot-content');
            if (content) {
                content.removeAttribute('inert');
            }

            var overlay = document.getElementById('at-dsn-boot-overlay');
            if (overlay && overlay.parentNode) {
                overlay.parentNode.removeChild(overlay);
            }
        }

        function trackHydrationTime() {
            try {
                var startTime = 0;
                
                var paintMetrics = performance.getEntriesByType("paint");
                if (paintMetrics && paintMetrics.length > 0) {
                    for (var i = 0; i < paintMetrics.length; i++) {
                        if (paintMetrics[i].name === 'first-contentful-paint' || paintMetrics[i].name === 'first-paint') {
                            startTime = paintMetrics[i].startTime;
                            break;
                        }
                    }
                }

                if (startTime === 0) {
                    var navEntries = performance.getEntriesByType("navigation");
                    if (navEntries.length > 0) {
                        startTime = navEntries[0].domContentLoadedEventEnd > 0 
                            ? navEntries[0].domContentLoadedEventEnd 
                            : navEntries[0].responseEnd;
                    } else if (window.performance && window.performance.timing) {
                        var t = window.performance.timing;
                        if (t.domContentLoadedEventEnd > 0) {
                            startTime = t.domContentLoadedEventEnd - t.navigationStart;
                        } else if (t.responseEnd > 0) {
                            startTime = t.responseEnd - t.navigationStart;
                        }
                    }
                }

                var trueHydrationTime = Math.round(performance.now() - startTime);
                
                trueHydrationTime = Math.max(0, trueHydrationTime);
                
                if (window.atTracking && typeof window.atTracking.pushDataLayerEvent === 'function') {
                    window.atTracking.pushDataLayerEvent('components_hydrated', {
                        timeToHydrate: trueHydrationTime,
                    }, false);
                } else {
                    window.dataLayer = window.dataLayer || [];
                    window.dataLayer.push({
                        event: 'components_hydrated',
                        timeToHydrate: trueHydrationTime,
                        _note: 'fallback_trigger' 
                    });
                }
            } catch (e) {
                console.warn('Hydration tracking failed', e);
            }
        }
        
        function onComponentsReady(event) {
            if (!event || !event.detail || !event.detail.success) {
                return;
            }
            
            trackHydrationTime();

            var hydratedStyle = document.querySelector('style[data-at-wc-styles-hydrated]');
            if (hydratedStyle) {
                hydratedStyle.remove();
            }
            requestAnimationFrame(revealDesignSystemPage);
        }
        
        window.addEventListener('at-components-ready', onComponentsReady, { once: true });
        window.setTimeout(revealDesignSystemPage, 1000);
    })();
</script>

    


