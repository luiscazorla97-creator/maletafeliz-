<script>
  $('.popup-close').click(function(){
    $('.h-pop-wrap').hide();
  })


  $(window).scroll(function(){
    console.log('scroll')
    if ($(window).scrollTop() >= 500) {
      console.log('Hi scroll')
      $('.home-popup').fadeIn();
    }
    else {
      $('.home-popup').fadeOut();
    }
  });


  $('.sub_hero_list').slick({
    infinite: true,
    arrows: false,
    dots: false,
    slidesToShow: 1,
    slidesToScroll: 1,
    autoplay: true,
    autoplaySpeed: 3000,
    focusOnSelect: false,
    pauseOnHover:false
  });

  $('.data_dote').on('click', function() {
    var dataNumber = $(this).attr('data-number');
    $('.sub_hero_list').slick('slickGoTo', dataNumber);
  });

  $(document).ready(function() {
    $('.data_dote:first-child').addClass('active');
  });

  $('.sub_hero_list').on('afterChange', function(event, slick, currentSlide) {
    var currentIndex = currentSlide;
    $('.data_dote').removeClass('active'); 
    $('.data_dote[data-number="' + currentIndex + '"]').addClass('active'); 
  });

</script>

