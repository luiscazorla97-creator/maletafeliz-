---
import { dictionary, type Locale } from '../i18n';
import { destinationUrl, type Destination } from '../data/destinations';
import { publishedArticles, photoFor, photoSrcSet } from '../lib/content';
import Scenery from './Scenery.astro';
import Icon from './Icon.astro';
interface Props {
  destination: Destination;
  lang: Locale;
  large?: boolean;
  href?: string;
  articleId?: string;
  imageSizes?: string;
}
const { destination: d, lang, large = false, href, articleId, imageSizes = '(max-width: 540px) 100vw, (max-width: 800px) 50vw, 33vw' } = Astro.props;
const t = dictionary[lang];
const article = publishedArticles.find(
  (a) => a.locale === lang && a.id === (articleId || d.id),
) || publishedArticles.find(
  (a) => a.destinationId === d.id && a.locale === lang,
);
const image = article && photoFor(article.coverImageId);
---

<a class:list={['destination-card', { large }]} href={href || destinationUrl(d, lang)}>
  <div class="card-image">
    {image ? (
      <img
        src={image.src}
        srcset={photoSrcSet(image)}
        sizes={imageSizes}
        alt={image.alt[lang]}
        width={image.width}
        height={image.height}
        loading="lazy"
        decoding="async"
      />
    ) : (
      <Scenery variant={d.id} />
    )}
    <span class="country-tag">
      <Icon name="pin" size={12} />
      {d.country[lang]}
    </span>
    <span class="card-arrow">
      <Icon />
    </span>
  </div>
  {image && (
    <span class="card-credit">
      {image.credit} · {image.license}
    </span>
  )}
  <div class="card-body">
    <span class="eyebrow">{article ? t.guide : t.preparing}</span>
    <h3>{d.city[lang]}</h3>
    <p>{articleId && article ? article.title : d.titles[lang]}</p>
  </div>
</a>
