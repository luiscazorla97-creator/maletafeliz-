				<div class="et_pb_blurb dwd-aio et_pb_module et_pb_bg_layout_light et_pb_text_align_  et_pb_aio_extended_0 et_pb_blurb_position_top aio-image-zoom-hover alignment-bottom dwd-show-fulloverlay dwd-show-overlay-none dwd-overlay-hover dwd-unhover dwd-cover-image-animation-zoom-in dwd-cover-image-transition-saturate et_pb_with_border" data-glare="false">
				<div class="dwd-cover-featured-image-wrapper dwd-cover-image-v-center dwd-cover-image-text-center"><div class="dwd-cover-featured-image-bg" style="background-image: url(https://stelmus.co.za/wp-content/uploads/2019/08/about_t1.jpg);"></div><div class="dwd-cover-overlay"></div></div>
				<div class="dwd-after-wrap">
					
					
					
					
					
					<div class="et_pb_blurb_content">
						<figure>
							<div class="aio-wrap">
								<div class="aio-wrap-inner">
									
									<div class="et_pb_aio_container" data-typing-loop=true>
										
										
										
										<h3 class="et_pb_module_header">Stellenbosch Museum </h3>
										
										<span class="et_pb_fullwidth_header_subhead"></span>
										<div class="et_pb_aio_description"><p><span class="style3">37 Ryneveld Street<br />Stellenbosch<br />7600</span></p>
<p>Tel. 021 887 2937<br /><span class="rightsidenav"><a class="leftsidenav" href="mailto:villagemuseum@stelmus.co.za"><span style="color: #008000;">villagemuseum@stelmus.co.za</span> </a></span><br /><span class="rightsidenav"><a class="leftsidenav" href="mailto:admin@stelmus.co.za"><span style="color: #008000;">admin@stelmus.co.za</span></a></span></p>
<p><span class="style3">GPS:<a href="https://www.google.com/maps/place/Stellenbosch+Museum/@-33.9374014,18.8609377,17z/data=!3m1!4b1!4m5!3m4!1s0x1dcdb25dceadf283:0x8712a7854498aa6d!8m2!3d-33.9374014!4d18.8631264"><span style="color: #008000;">33° 56&#8242; 06.70&#8243; S, 18° 51&#8242; 44.67&#8243; E</span></a></span></p>
<p><span style="color: #008000;"><strong>Village Museum</strong></span></p>
<p><strong>Monday – Saturday  09:00 – 17:00<br /></strong></p>
<p><strong>Sunday (May – August) 10:00 – 13:00<br /></strong><strong>                (September – April) 10:00 – 16:00</strong></p>
<p><strong>Public Holidays 09:00 – 17:00</strong></p>
<p><strong> </strong><span style="color: #008000;"><strong>Toy Museum</strong></span></p>
<p><strong>Monday – Friday  09:00 – 16:30<br /></strong><strong>Saturday &amp; Public Holidays  09:00 – 14:00</strong></p>
<p><strong>Closed: Christmas Day, Good Friday, Easter Sunday</strong></p></div>
										
									</div>
								</div>
							</div>
