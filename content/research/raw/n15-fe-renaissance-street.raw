<script>(function () {
    function fit(frame, h) {
        frame.style.setProperty('height', h + 'px', 'important');
        frame.style.setProperty('flex', '0 0 auto', 'important');
        frame.style.setProperty('align-self', 'flex-start', 'important');
        frame.style.setProperty('min-height', '0', 'important');
        var el = frame.parentElement, steps = 0;
        while (el && steps < 5) {
            if (el.classList && (el.classList.contains('flexcolfill')
                || el.classList.contains('contenuti_correlati'))) {
                el.style.setProperty('flex', '0 0 auto', 'important');
            }
            el = el.parentElement; steps++;
        }
    }
    window.addEventListener('message', function (e) {
        var d = e.data;
        if (typeof d === 'string') { try { d = JSON.parse(d); } catch (err) { return; } }
        if (!d || d.type !== 'resize') { return; }
        var h = parseInt(d.contentHeight, 10);
        if (!h) { return; }
        var frames = document.querySelectorAll('iframe[src*="siteintegration"]');
        for (var i = 0; i < frames.length; i++) {
            if (frames[i].contentWindow === e.source) { fit(frames[i], h); }
        }
    }, false);
})();</script>
<script>jQuery(function ($) {

// Bind to the resize event of the window object
$(window).on("resize", function () {
    // Set .right's width to the window width minus 480 pixels
    if($(window).width()<575){ 
        var gallery = $('.tmpl-container.gallery');
        var blocco_mobile = $('.mobile-first-column .tmpl-container.blocco-mobile');
        
        gallery.each(function(index, element) {
        
            var totEl=$(element).find('.item_container').length;
        
            var elToHide=totEl - 4;

            $(".gallery").addClass("gallery-mobile");
            if(elToHide>0)
                $(".gallery-mobile .item_container:nth-child(4) .item .locked-text").append("<span class='number'>+"+elToHide+"</span>");

        });
        
        blocco_mobile.each(function(index, element) {
  
            $(element).closest('.mceTemplate').show();
        
        });
        
    }else{
        $( ".gallery-mobile .number" ).remove();
        $(".gallery").removeClass("gallery-mobile");
        
        
    }
// Invoke the resize event immediately
}).resize();
dosamigos.gallery.registerLightBoxHandlers('#gallery-widget-6af9e77ed627f a', {"container":"#blueimp-gallery-6af9e77ed627f"});

var contentCommentSection = $("#comments-container").html();
$("#comments-container").html('<div class="container">' + contentCommentSection + '</div>');


    var bullet = "<small class='badge badge-pill badge-danger bullet-navbar'></small>";
    $('.cms-menu-container-default li .bullet-navbar').each(function(){

        var li = $(this).closest('li');
        $(li).parents('li').each(function(){
            $(this).children('a').children('.bullet-parent').html(bullet);
        });

        var isBullet = $('.btn-always-hamburger-menu .bullet-navbar');
        if(isBullet.length === 0 || isBullet === undefined){
        $('.btn-always-hamburger-menu').append(bullet);
        }
    });
var linkToTrigger=$("[title='Aggiorna esperienze manualmente']");
linkToTrigger.on( "click", function() {
    event.preventDefault();
    $( "#btn-refresh-experiences" ).trigger( "click" );
});


