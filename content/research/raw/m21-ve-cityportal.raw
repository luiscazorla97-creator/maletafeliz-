    <!-- Espacio para scripts adicionales por página -->
        <script>
        document.addEventListener('DOMContentLoaded', () => {
            const track = document.getElementById('hero-carousel');
            if (!track) return;
            const slides = track.children;
            const total = slides.length;
            const dots = document.querySelectorAll('#hero-dots button');
            const cardTitle = document.getElementById('hero-card-title');
            const cardText = document.getElementById('hero-card-text');
            const mini = document.getElementById('hero-mini');
            let index = 0;

            const update = () => {
                track.style.transform = `translateX(-${index * 100}%)`;
                dots.forEach((dot, i) => {
                    const active = i === index;
                    dot.classList.toggle('bg-brand-gold', active);
                    dot.classList.toggle('w-8', active);
                    dot.classList.toggle('w-5', !active);
                    dot.classList.toggle('bg-brand-cream/40', !active);
                });
                const slide = slides[index];
                if (cardTitle) {
                    // innerHTML (no textContent): el valor viene saneado del servidor y
                    // así se respeta el formato (negritas, cursivas) puesto en el CMS.
                    cardTitle.innerHTML = slide.dataset.title || '';
                    // La tarjeta muestra el contenido del slide activo: su clave editable
                    // debe seguirlo para que la vista previa elija el campo correcto.
                    cardTitle.dataset.msField = `hero.slide${index + 1}.title`;
                }
                if (cardText) {
                    cardText.innerHTML = slide.dataset.text || '';
                    cardText.dataset.msField = `hero.slide${index + 1}.text`;
                }

                // La mini imagen previsualiza el SIGUIENTE slide (con fundido breve).
                if (mini) {
                    const next = (index + 1) % total;
                    const nextImage = slides[next].dataset.image || '';
                    mini.dataset.msField = `hero.slide${next + 1}.image`;
                    mini.style.opacity = '0';
                    setTimeout(() => {
                        mini.style.backgroundImage = `url('${nextImage}')`;
                        mini.style.opacity = '1';
                    }, 200);
                }
            };

            const go = (n) => { index = (n + total) % total; update(); };

            // Autoplay con pausa al pasar el cursor (4 segundos = 4000ms), pausa manual y reinicio
            let isManualPaused = false;
            let timer = null;

            const startTimer = () => {
                if (isManualPaused) return;
                stopTimer();
                timer = setInterval(() => go(index + 1), 4000);
            };
            const stopTimer = () => {
                if (timer) {
                    clearInterval(timer);
                    timer = null;
                }
            };
            const restartTimer = () => {
                if (isManualPaused) return;
                stopTimer();
                startTimer();
            };

            const toggleAutoplayBtn = document.getElementById('hero-toggle-autoplay');
            const pauseIcon = document.getElementById('hero-toggle-pause-icon');
            const playIcon = document.getElementById('hero-toggle-play-icon');

            if (toggleAutoplayBtn) {
                toggleAutoplayBtn.addEventListener('click', () => {
                    isManualPaused = !isManualPaused;
                    if (isManualPaused) {
                        stopTimer();
                        if (pauseIcon) pauseIcon.classList.add('hidden');
                        if (playIcon) playIcon.classList.remove('hidden');
                        toggleAutoplayBtn.setAttribute('aria-label', 'Reanudar reproducción automática');
                    } else {
                        if (pauseIcon) pauseIcon.classList.remove('hidden');
                        if (playIcon) playIcon.classList.add('hidden');
                        toggleAutoplayBtn.setAttribute('aria-label', 'Pausar reproducción automática');
                        startTimer();
                    }
                });
            }

            document.getElementById('hero-next').addEventListener('click', () => { go(index + 1); restartTimer(); });
            document.getElementById('hero-prev').addEventListener('click', () => { go(index - 1); restartTimer(); });
            dots.forEach((dot, i) => dot.addEventListener('click', () => { go(i); restartTimer(); }));

            const heroContainer = track.closest('section') || track.parentElement;
            if (heroContainer) {
                heroContainer.addEventListener('mouseenter', stopTimer);
                heroContainer.addEventListener('mouseleave', () => {
                    if (!isManualPaused) startTimer();
                });
            }

            startTimer();

            // En la vista previa del CMS: si el editor enfoca un campo de un slide que
            // no es el visible (su título y su texto solo se ven en la tarjeta del
            // slide activo), gira el carrusel hasta él y reenvía el aviso para que el
            // puente lo resalte ya con el slide correcto en pantalla.
            if ('BroadcastChannel' in window) {
                const channel = new BroadcastChannel('ms-preview');
                channel.addEventListener('message', (event) => {
                    const message = event.data || {};
                    if (message.type !== 'highlight' || !message.key) return;
                    const slideKey = /^hero\.slide([1-5])\./.exec(message.key);
                    if (!slideKey) return;
                    const wanted = Number(slideKey[1]) - 1;
                    if (wanted === index) return; // ya visible: el puente lo resaltó
                    go(wanted); 
                    setTimeout(() => channel.postMessage(message), 80);
                });
            }
        });
    </script>
        <script>
            document.addEventListener('DOMContentLoaded', () => {
                const section = document.getElementById('mapa');
                if (!section) return;
                const stage = section.querySelector('.mapa-stage');
                const frame = section.querySelector('.mapa-frame');
                const canvas = section.querySelector('.mapa-canvas');
                const tip = section.querySelector('.mapa-tip');
                if (!canvas || !tip || !frame) return;

                const tipNum = tip.querySelector('.mapa-tip__num');
                const tipCat = tip.querySelector('.mapa-tip__cat');
                const tipTxt = tip.querySelector('.mapa-tip__txt');
                const tipDesc = tip.querySelector('.mapa-tip__desc');
                const tipArrow = tip.querySelector('.mapa-tip__arrow');
                const tipEye = tip.querySelector('.mapa-tip__eye');
                const pins = Array.from(canvas.querySelectorAll('.mapa-pin'));
                const legendItems = Array.from(section.querySelectorAll('.mapa-legend__item'));
                const canHover = window.matchMedia('(hover: hover)').matches;

                // Índices número → pines / ítem de leyenda (los duplicados comparten número).
                const pinsByNum = {};
                pins.forEach((p) => { (pinsByNum[p.dataset.num] = pinsByNum[p.dataset.num] || []).push(p); });
                const legendByNum = {};
                legendItems.forEach((li) => { legendByNum[li.dataset.legendNum] = li; });

                let activePin = null;
                let pinned = false; // true = fijado por clic; false = previsualización por hover

                const clearActive = () => {
                    if (activePin) {
                        activePin.classList.remove('is-active');
                        activePin.setAttribute('aria-expanded', 'false');
                        activePin = null;
                    }
                    canvas.classList.remove('is-spotlight');
                };

                const hide = () => {
                    tip.hidden = true;
                    pinned = false;
                    clearActive();
                };

                const show = (pin, doPin) => {
                    tipNum.textContent = pin.dataset.num;
                    tipCat.textContent = pin.dataset.cat || '';
                    tipTxt.textContent = pin.dataset.nombre || '';
                    tipDesc.textContent = pin.dataset.desc || '';
                    tipCat.style.display = pin.dataset.cat ? '' : 'none';
                    tipDesc.style.display = pin.dataset.desc ? '' : 'none';

                    // Se muestra (sin posición aún) para poder medirlo antes de colocarlo.
                    tip.hidden = false;
                    tip.classList.remove('mapa-tip--above', 'mapa-tip--below');

                    const gap = 8, pad = 6;
                    const cW = canvas.clientWidth;
                    const pinCX = pin.offsetLeft + pin.offsetWidth / 2;
                    const pinTop = pin.offsetTop;
                    const pinBottom = pin.offsetTop + pin.offsetHeight;
                    const tW = tip.offsetWidth;
                    const tH = tip.offsetHeight;

                    let top;
                    if (pinTop - gap - tH >= pad) {
                        top = pinTop - gap - tH;
                        tip.classList.add('mapa-tip--above');
                    } else {
                        top = pinBottom + gap;
                        tip.classList.add('mapa-tip--below');
                    }
                    const left = Math.max(pad, Math.min(pinCX - tW / 2, cW - tW - pad));
                    tip.style.left = left + 'px';
                    tip.style.top = top + 'px';
                    tipArrow.style.left = Math.max(12, Math.min(pinCX - left, tW - 12)) + 'px';

                    if (activePin && activePin !== pin) {
                        activePin.classList.remove('is-active');
                        activePin.setAttribute('aria-expanded', 'false');
                    }
                    pin.classList.add('is-active');
                    pin.setAttribute('aria-expanded', 'true');
                    activePin = pin;
                    canvas.classList.add('is-spotlight');
                    if (doPin) pinned = true;
                };

                // Desplaza el paneo para centrar un pin (útil cuando está ampliado).
                const scrollPinIntoView = (p) => {
                    const px = p.offsetLeft + p.offsetWidth / 2;
                    const py = p.offsetTop + p.offsetHeight / 2;
                    frame.scrollLeft = px - frame.clientWidth / 2;
                    frame.scrollTop = py - frame.clientHeight / 2;
                };

                // Pines: clic = fijar/desfijar; hover (solo escritorio) = previsualizar.
                pins.forEach((pin) => {
                    const li = legendByNum[pin.dataset.num];
                    pin.addEventListener('click', (e) => {
                        e.stopPropagation();
                        if (pinned && activePin === pin) hide();
                        else show(pin, true);
                    });
                    pin.addEventListener('mouseenter', () => {
                        if (li) li.classList.add('is-highlight');
                        if (canHover && !pinned) show(pin, false);
                    });
                    pin.addEventListener('mouseleave', () => {
                        if (li) li.classList.remove('is-highlight');
                        if (canHover && !pinned) hide();
                    });
                    pin.addEventListener('focus', () => { if (li) li.classList.add('is-highlight'); });
                    pin.addEventListener('blur', () => { if (li) li.classList.remove('is-highlight'); });
                });

                // Índice ↔ mapa: resaltar el/los pines al pasar el cursor o enfocar; clic centra y abre.
                legendItems.forEach((li) => {
                    const rel = pinsByNum[li.dataset.legendNum] || [];
                    const on = () => rel.forEach((p) => p.classList.add('is-highlight'));
                    const off = () => rel.forEach((p) => p.classList.remove('is-highlight'));
                    li.addEventListener('mouseenter', on);
                    li.addEventListener('mouseleave', off);
                    li.addEventListener('focus', on);
                    li.addEventListener('blur', off);
                    li.addEventListener('click', () => {
                        const p = rel[0];
                        if (!p) return;
                        frame.scrollIntoView({ behavior: 'smooth', block: 'nearest' });
                        scrollPinIntoView(p);
                        show(p, true);
                    });
                });

                // Cerrar al hacer clic fuera, con Escape o al redimensionar.
                document.addEventListener('click', (e) => {
                    if (!tip.hidden && !e.target.closest('.mapa-pin') && !e.target.closest('.mapa-legend__item') && !e.target.closest('.mapa-tip')) hide();
                });
                document.addEventListener('keydown', (e) => { if (e.key === 'Escape') hide(); });
                window.addEventListener('resize', hide);

                // Ojito: mantener presionado para "espiar" detrás del globo (se vuelve translúcido).
                if (tipEye) {
                    const peekOn = (e) => {
                        e.preventDefault(); e.stopPropagation();
                        tip.classList.add('is-peeking');
                        try { tipEye.setPointerCapture(e.pointerId); } catch (_) {}
                    };
                    const peekOff = () => tip.classList.remove('is-peeking');
                    tipEye.addEventListener('pointerdown', peekOn);
                    tipEye.addEventListener('pointerup', peekOff);
                    tipEye.addEventListener('pointercancel', peekOff);
                    // Evitar que el clic en el ojo cierre el globo o llegue al mapa.
                    tipEye.addEventListener('click', (e) => { e.stopPropagation(); e.preventDefault(); });
                }

                // --- Zoom, paneo, restablecer y pantalla completa ---
                const zoomInBtn = section.querySelector('[data-zoom="in"]');
                const zoomOutBtn = section.querySelector('[data-zoom="out"]');
                const resetBtn = section.querySelector('[data-zoom="reset"]');
                const fsBtn = section.querySelector('[data-fs]');
                const fsIcon = fsBtn ? fsBtn.querySelector('i') : null;
                const MIN_ZOOM = 1, MAX_ZOOM = 4, STEP = 0.5;
                let zoom = 1;

                const updateControls = () => {
                    if (zoomInBtn) zoomInBtn.disabled = zoom >= MAX_ZOOM - 0.001;
                    if (zoomOutBtn) zoomOutBtn.disabled = zoom <= MIN_ZOOM + 0.001;
                    if (resetBtn) resetBtn.disabled = zoom <= MIN_ZOOM + 0.001;
                };

                // nz = nuevo zoom; (fcx,fcy) = punto focal en coordenadas de pantalla (opcional).
                const setZoom = (nz, fcx, fcy) => {
                    nz = Math.min(MAX_ZOOM, Math.max(MIN_ZOOM, Math.round(nz * 100) / 100));
                    if (nz === zoom) return;
                    const rect = frame.getBoundingClientRect();
                    const fvx = (fcx != null) ? fcx - rect.left : frame.clientWidth / 2;
                    const fvy = (fcy != null) ? fcy - rect.top : frame.clientHeight / 2;
                    const prevW = canvas.offsetWidth || 1, prevH = canvas.offsetHeight || 1;
                    const cx = (frame.scrollLeft + fvx) / prevW;
                    const cy = (frame.scrollTop + fvy) / prevH;
                    zoom = nz;
                    canvas.style.setProperty('--zoom', zoom);
                    frame.classList.toggle('is-zoomed', zoom > 1);
                    hide();
                    const newW = canvas.offsetWidth, newH = canvas.offsetHeight;
                    frame.scrollLeft = cx * newW - fvx;
                    frame.scrollTop = cy * newH - fvy;
                    updateControls();
                };

                if (zoomInBtn) zoomInBtn.addEventListener('click', () => setZoom(zoom + STEP));
                if (zoomOutBtn) zoomOutBtn.addEventListener('click', () => setZoom(zoom - STEP));
                if (resetBtn) resetBtn.addEventListener('click', () => setZoom(1));
                updateControls();

                // Doble clic sobre el mapa (no sobre un pin) para acercar hacia el punto.
                frame.addEventListener('dblclick', (e) => {
                    if (e.target.closest('.mapa-pin')) return;
                    e.preventDefault();
                    setZoom(zoom + STEP, e.clientX, e.clientY);
                });

                // Rueda del ratón para acercar/alejar hacia el cursor (Ctrl+rueda = zoom del navegador).
                frame.addEventListener('wheel', (e) => {
                    if (e.ctrlKey) return;
                    e.preventDefault();
                    setZoom(zoom + (e.deltaY < 0 ? STEP : -STEP), e.clientX, e.clientY);
                }, { passive: false });

                // Teclado (con el mapa enfocado): flechas para desplazar, +/- para el zoom.
                frame.addEventListener('keydown', (e) => {
                    const panStep = 60;
                    switch (e.key) {
                        case 'ArrowLeft':  frame.scrollLeft -= panStep; e.preventDefault(); break;
                        case 'ArrowRight': frame.scrollLeft += panStep; e.preventDefault(); break;
                        case 'ArrowUp':    frame.scrollTop  -= panStep; e.preventDefault(); break;
                        case 'ArrowDown':  frame.scrollTop  += panStep; e.preventDefault(); break;
                        case '+': case '=': setZoom(zoom + STEP); e.preventDefault(); break;
                        case '-': case '_': setZoom(zoom - STEP); e.preventDefault(); break;
                    }
                });

                // Arrastrar para panear (ratón/lápiz) cuando hay zoom. El táctil usa su
                // scroll nativo. Si hay arrastre real, se cancela el clic para no abrir un pin.
                let dragging = false, dragMoved = false;
                let dsx = 0, dsy = 0, dsl = 0, dst = 0;
                const DRAG_MIN = 5;

                frame.addEventListener('pointerdown', (e) => {
                    if (e.pointerType === 'touch' || e.button !== 0 || zoom <= 1) return;
                    dragging = true; dragMoved = false;
                    dsx = e.clientX; dsy = e.clientY;
                    dsl = frame.scrollLeft; dst = frame.scrollTop;
                });
                frame.addEventListener('pointermove', (e) => {
                    if (!dragging) return;
                    const dx = e.clientX - dsx, dy = e.clientY - dsy;
                    if (!dragMoved && Math.hypot(dx, dy) > DRAG_MIN) {
                        dragMoved = true;
                        frame.classList.add('is-grabbing');
                        hide(); // limpia cualquier ficha/previsualización al empezar a arrastrar
                        try { frame.setPointerCapture(e.pointerId); } catch (_) {}
                    }
                    if (dragMoved) {
                        frame.scrollLeft = dsl - dx;
                        frame.scrollTop = dst - dy;
                        e.preventDefault();
                    }
                });
                const endDrag = (e) => {
                    if (!dragging) return;
                    dragging = false;
                    frame.classList.remove('is-grabbing');
                    if (dragMoved) {
                        try { frame.releasePointerCapture(e.pointerId); } catch (_) {}
                        // Cancelar el clic que el navegador dispara tras el arrastre.
                        const cancel = (ev) => { ev.stopPropagation(); ev.preventDefault(); };
                        frame.addEventListener('click', cancel, { capture: true, once: true });
                        setTimeout(() => frame.removeEventListener('click', cancel, true), 0);
                    }
                };
                frame.addEventListener('pointerup', endDrag);
                frame.addEventListener('pointercancel', endDrag);

                // Pantalla completa (con prefijos webkit para Safari).
                if (fsBtn && stage) {
                    const enterFs = stage.requestFullscreen || stage.webkitRequestFullscreen;
                    const exitFs = document.exitFullscreen || document.webkitExitFullscreen;
                    const isFs = () => (document.fullscreenElement || document.webkitFullscreenElement) === stage;

                    if (!enterFs) {
                        fsBtn.style.display = 'none';
                    } else {
                        fsBtn.addEventListener('click', () => {
                            if (isFs()) { if (exitFs) exitFs.call(document); }
                            else { enterFs.call(stage); }
                        });
                        const onFsChange = () => {
                            const fs = isFs();
                            if (fsIcon) fsIcon.className = fs ? 'pi pi-window-minimize' : 'pi pi-window-maximize';
                            fsBtn.setAttribute('aria-label', fs ? 'Salir de pantalla completa' : 'Pantalla completa');
                            hide();
                        };
                        document.addEventListener('fullscreenchange', onFsChange);
                        document.addEventListener('webkitfullscreenchange', onFsChange);
                    }
                }
            });
        </script>
    <script>
    function abrirModalHeroico() {
        const m = document.getElementById('modalHistoriaHeroica');
        if (m) {
            m.classList.remove('opacity-0', 'pointer-events-none');
            document.documentElement.style.overflow = 'hidden';
            document.body.style.overflow = 'hidden';
        }
    }
    function cerrarModalHeroico() {
        const m = document.getElementById('modalHistoriaHeroica');
        if (m) {
            m.classList.add('opacity-0', 'pointer-events-none');
            document.documentElement.style.overflow = '';
            document.body.style.overflow = '';
        }
    }

    document.addEventListener('DOMContentLoaded', function() {
        const m = document.getElementById('modalHistoriaHeroica');
        if (m) {
            m.addEventListener('click', function(e) {
                if (e.target === m) {
                    cerrarModalHeroico();
                }
            });
        }
        document.addEventListener('keydown', function(e) {
            if (e.key === 'Escape') {
                const modal = document.getElementById('modalHistoriaHeroica');
                if (modal && !modal.classList.contains('pointer-events-none')) {
                    cerrarModalHeroico();
                }
            }
        });
    });
</script>
