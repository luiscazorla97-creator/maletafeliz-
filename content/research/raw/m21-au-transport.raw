            <source slot="source" type="image/jpeg" media="(max-width: 1023px)" srcset="/media/do1kywld/auckland-transport-war-memorial-couple-walking.jpg?mode=crop&amp;width=1023&amp;format=jpg">
            <source slot="source" type="image/jpeg" media="(min-width: 1024px)" srcset="/media/do1kywld/auckland-transport-war-memorial-couple-walking.jpg?mode=crop&amp;width=1535&amp;format=jpg">
