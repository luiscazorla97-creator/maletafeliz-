    <div class="area-detail-hero__content-col">
        <h1 class="area-detail-hero__title">Orrido di Ponte Alto</h1>

                            <p class="area-detail-hero__subtitle">Fersina Canyon, waterfalls and water engineering just outside Trento</p>
        
                                                                                                                                                                                                                                                            
                            <ul class="area-detail-hero__highlights list-unstyled">
                                                                        <li class="area-detail-hero__highlight-item">
                                <span class="area-detail-hero__highlight-dot" aria-hidden="true"></span>
                                <span>Two waterfalls over 40 metres high</span>
                            </li>
                                                                                                <li class="area-detail-hero__highlight-item">
                                <span class="area-detail-hero__highlight-dot" aria-hidden="true"></span>
                                <span>Walkways and a balcony behind the waterfall</span>
                            </li>
                                                                                                <li class="area-detail-hero__highlight-item">
                                <span class="area-detail-hero__highlight-dot" aria-hidden="true"></span>
                                <span>16th-century hydraulic works</span>
                            </li>
                                                                                                        </ul>
            
            <div class="area-detail-hero__linkbar">
                <a href="#gallery" class="area-detail-hero__cta">
                    <span class="icon icon-camera" aria-hidden="true"></span>
                    <span>Images</span>
                </a>
