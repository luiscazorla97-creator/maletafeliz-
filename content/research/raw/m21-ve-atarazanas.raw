        <div class="absolute bottom-full left-1/2 -translate-x-1/2 mb-3 pointer-events-none opacity-0 group-hover/tooltip:opacity-100 group-hover/tooltip:-translate-y-1 transition-all duration-300 z-30 w-max max-w-[230px]">
            <div class="bg-gray-900 text-white text-xs font-medium py-1.5 px-3 rounded-lg shadow-xl text-center font-['Montserrat'] leading-snug">
                Consulta opiniones, fotos y la ruta para llegar            </div>
            
            <div class="w-2.5 h-2.5 bg-gray-900 rotate-45 mx-auto -mt-1 shadow-sm"></div>
        </div>
    </div>
</div>
