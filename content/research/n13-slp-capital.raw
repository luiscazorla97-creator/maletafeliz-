                                            <li id="ciudad-capital" class="inactive eael-tab-item-trigger eael-tab-nav-item" aria-selected="true" data-tab="1" role="tab" tabindex="0" aria-controls="ciudad-capital-tab" aria-expanded="false">
                            
                                                                <i class="fas fa-home"></i>                                                            
                                                            <span class="eael-tab-title title-after-icon" >Ciudad Capital</span>                            
                                                    </li>
