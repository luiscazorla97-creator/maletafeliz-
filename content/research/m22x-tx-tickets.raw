            typeof pageJson['prices'] !== 'undefined' && 
            typeof pageJson['prices'][0] !== 'undefined' && 
            typeof pageJson['prices'][0]['prices'] !== 'undefined'
        ){
            $.each(pageJson['prices'][0]['prices'], function(i,v){
                if(v['has_event_based_price'] == 1){
