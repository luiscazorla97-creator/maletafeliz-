                                        <div class="opt-box-one additional-side-info p-4">
        <h4>Opening hours </h4>
                <div id="single_date_picker" class="single-datepicker"></div>

        <div class="date-hours-wrapper mt-4 d-none">
            <span class="date-hours-title">
                <b>
                    <span class="date-hours-date-label">Times of </span>
                    <span class="date-hours-date"></span>
                </b>
            </span>
            <br>
            <span class="date-hours-time"></span>
        </div>
    </div>

    <script>
        // tutti i dati delle prossime date vengono salvati in un oggetto
        let dateHoursWrapper = document.querySelector('.date-hours-wrapper');
        let allDatesData = JSON.parse('[{"timestampMs":1795734000000,"descriptiveDate":"November 27, 2026","descriptiveTime":"10.00 am - 3.00 pm"},{"timestampMs":1795820400000,"descriptiveDate":"November 28, 2026","descriptiveTime":"10.00 am - 6.00 pm"},{"timestampMs":1795906800000,"descriptiveDate":"November 29, 2026","descriptiveTime":"10.00 am - 6.00 pm"}]');
        let allDates = allDatesData.map(event => event.timestampMs).map(a => parseInt(a));
        let datePicker;
        let datePickerElement = document.getElementById('single_date_picker');
        window.addEventListener('scriptsLoaded', () => {
            datePicker = createDatePicker('#single_date_picker', {
                defaultViewDate: new Date(allDatesData[0].timestampMs),
                beforeShowDay: function(date) {
                    let result = {};

                    // tutte le date che non sono appartenenti a questo evento vengono segnate come "chiuso"
                    // almeno che queste non siano dopo l'ultima data disponibile (in quel caso semplicemente non ci sono informazioni e viene disabilitato il giorno)
                    if(!allDates.includes(date.getTime())) {
                        if(date.getTime() <= allDates.at(-1)) {
                            result.classes = 'closed';
                        } else {
                            result.classes = 'disabled';
                        }
                    }

                    return result;
                }
            });
        })

        // CUSTOM - VISITTRENTO Apre la prima data disponibile
        datePickerElement.addEventListener('datepicker-load', function(event) {
            document.querySelector('span[data-date="'+ allDatesData[0].timestampMs +'"]')?.click();
        });

        // quando l'utente seleziona una delle prossime date nel date picker vengono mostrati i suoi orari sotto
        datePickerElement.addEventListener('click', function(event) {
            if(event.target.classList.contains('day')) {
                if(!event.target.classList.contains('disabled')) {
                    // ad ogni click il wrapper delle informazioni viene sempre svuotato e nascosto, e viene rimostrato se ci sono dati
                    dateHoursWrapper.classList.add('d-none');

                    let clickedCellTimestamp = event.target.dataset.date;

                    if(!clickedCellTimestamp) {
                        return;
                    }

                    let clickedCellEventData = allDatesData.find(eventData => eventData.timestampMs === parseInt(clickedCellTimestamp));

                    dateHoursWrapper.classList.remove('d-none');
                    if(clickedCellEventData) {
                        dateHoursWrapper.querySelector('.date-hours-date').textContent = clickedCellEventData.descriptiveDate;

                        if(clickedCellEventData.descriptiveTime) {
                            dateHoursWrapper.querySelector('.date-hours-date-label').classList.remove('d-none');
                            dateHoursWrapper.querySelector('.date-hours-time').innerHTML = `<span class="open">${clickedCellEventData.descriptiveTime}</span>`;
                        } else {
                            dateHoursWrapper.querySelector('.date-hours-date-label').classList.add('d-none');
                            dateHoursWrapper.querySelector('.date-hours-time').innerHTML = '<span class="open">Open</span>'
                        }

                    } else {
                        dateHoursWrapper.querySelector('.date-hours-date-label').classList.add('d-none');
                        dateHoursWrapper.querySelector('.date-hours-date').textContent = new Date(parseInt(clickedCellTimestamp)).toFormattedString();
                        dateHoursWrapper.querySelector('.date-hours-time').innerHTML = '<span class="closed">Close</span>';
                    }
                }

            }
        });
    </script>
                                </article>

                                
                                



                                    
            
                                                                

                                                <anchor id="page-widget"></anchor>
                <section class="standard-box b-padding-xl oa-section-wrapper">
                    <div class="container">
                        <script type="text/javascript" src="https://api-oa.com/jscr/loader.js?id=dcq1ok&lang=en" data-dp="ac7f7b0f-8828-4ef6-8d26-891226fd0702" data-cookieconsent="ignore" data-cmp-ab="2"></script>
                    </div>
                </section>
                <script>
                    window.addEventListener('load', () => {
                        if(window.dp && typeof window.dp.whenLoaded === 'function') {
                            window.dp.whenLoaded(function() {
                                setTimeout(() => {
                                    const detailsTab = document.querySelector('#oaxTabTourDetails a');
                                    if (detailsTab) {
                                        detailsTab.click();
                                    }
                                }, 500)
                            })
                        }
                    })
                </script>
                        
                
                            
                    

