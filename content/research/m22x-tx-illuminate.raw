<script>
document.addEventListener('DOMContentLoaded', function () {

	if (typeof Swiper === 'undefined') return;

	var MOBILE_MAX = 719;
	var AUTO_INTERVAL_MS = 3000;

	document.querySelectorAll('.acf-block--image-slider .imageSwiper').forEach(function (el) {

		var autoplayTimer = null;
		var resumeTimer = null;
		var directionNext = true;
		var interactionPaused = false;

		function stopYoYo() {
			if (autoplayTimer) {
				clearInterval(autoplayTimer);
				autoplayTimer = null;
			}
		}

		function prefersReducedMotion() {
			return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
		}

		function isMobileYoYoMode(sw) {
			return window.innerWidth <= MOBILE_MAX && sw.params && sw.params.loop === false;
		}

		function tick(sw) {
			if (!sw || sw.destroyed) return;
			if (interactionPaused) return;
			if (!isMobileYoYoMode(sw)) return;
			if (sw.isLocked) return;

			if (directionNext) {
				if (sw.isEnd) {
					directionNext = false;
					sw.slidePrev();
				} else {
					sw.slideNext();
				}
			} else {
				if (sw.isBeginning) {
					directionNext = true;
					sw.slideNext();
				} else {
					sw.slidePrev();
				}
			}
		}

		function startYoYo(sw) {
			stopYoYo();
			directionNext = true;
			if (prefersReducedMotion()) return;
			if (!isMobileYoYoMode(sw)) return;
			if (sw.isLocked) return;
			autoplayTimer = setInterval(function () {
				tick(sw);
			}, AUTO_INTERVAL_MS);
		}

		function pauseInteraction() {
			if (!isMobileYoYoMode(swiper)) return;
			interactionPaused = true;
			if (resumeTimer) {
				clearTimeout(resumeTimer);
				resumeTimer = null;
			}
		}

		function scheduleResumeInteraction() {
			if (!isMobileYoYoMode(swiper)) return;
			if (resumeTimer) clearTimeout(resumeTimer);
			resumeTimer = setTimeout(function () {
				interactionPaused = false;
				resumeTimer = null;
			}, 3200);
		}

		var swiper = new Swiper(el, {
			slidesPerView: 1.2,
			spaceBetween: 16,
			speed: 400,
			loop: false,

			breakpoints: {
				420: {
					slidesPerView: 2,
					loop: false,
				},
				720: {
					slidesPerView: 4,
					loop: true,
				},
				1920: {
					slidesPerView: 5,
				},
			},

			on: {
				init: function () {
					startYoYo(this);
				},
				resize: function () {
					stopYoYo();
					startYoYo(this);
				},
				breakpoint: function (sw) {
					stopYoYo();
					startYoYo(sw);
				},
				destroy: function () {
					stopYoYo();
					if (resumeTimer) clearTimeout(resumeTimer);
				},
			},
		});

		el.addEventListener('pointerdown', function () {
			if (!isMobileYoYoMode(swiper)) return;
			pauseInteraction();
			function onPointerEnd() {
				scheduleResumeInteraction();
				document.removeEventListener('pointerup', onPointerEnd);
				document.removeEventListener('pointercancel', onPointerEnd);
			}
			document.addEventListener('pointerup', onPointerEnd);
			document.addEventListener('pointercancel', onPointerEnd);
		});
	});

});
</script></div><div id="sabot-acf-block-4353-5" class="sabot-acf-block-anchor w-full">
