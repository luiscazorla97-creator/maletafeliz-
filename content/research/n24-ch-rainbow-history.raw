<div class="reveal visitors-guide-modal" id="visitors-guide-modal" data-reveal data-swiftype-index="false">
  <div class="vguide">
	<h2 class="vguide__header">Request a Visitors Guide</h2>
	<ul class="vguide__timeline">
		<li class="vguide__step vguide__step--1">About You</li>
		<li class="vguide__step vguide__step--2">Visit Details</li>
	</ul>
	<form id="vgm-visitors-guide" class="visitor-guide" action="https://charleston.simpleviewcrm.com/webapi/forms/sendform.cfm" method="POST">
		<input type="hidden" name="groupid" value="5">
		<input type="hidden" name="formid" value="2">
		<input type="hidden" name="savefrm" value="Submit">
		<input type="hidden" name="code_key" value="rO0ABXQABDhjd3I=">
		<input type="hidden" name="code" value="skip">
		<div class="visitor-guide__box">
			<div id="vgm-guide-step-1" class="visitor-guide__step">
				<div class="visitor-guide__beside">
					<div class="visitor-guide__img">
						<img src="/assets/images/visitors-guide.jpg?v=2026" />
					</div>
					<div>
						<div class="visitor-guide__intro">
							<div>
								<h3>Where should we send your visitor guide?</h3>
								<p><sup>*</sup>We will not sell or give away your personal information. Your privacy matters to us.</p>
							</div>
						</div>
						<div class="visitor-guide__half">
							<div class="text-field">
								<label for="vgm-contact_fname">First Name</label>
								<input type="text" name="contact_fname" id="vgm-contact_fname" required="">
							</div>
							<div class="text-field">
								<label for="vgm-contact_lname">Last Name</label>
								<input type="text" name="contact_lname" id="vgm-contact_lname" required="">
							</div>
						</div>
						<div class="visitor-guide__half">
							<div class="text-field">
								<label for="vgm-contact_email">Email</label>
								<input type="email"
									   name="contact_email"
									   id="vgm-contact_email"
									   required
									   data-parsley-required-message="Please enter your email address"
									   data-parsley-type-message="Please enter a valid email address" />
							</div>
							<div class="text-field">
								<label for="vgm-contact_phone">Phone Number</label>
								<input placeholder="(xxx) xxx-xxxx"
									   data-parsley-pattern="^\(\d{3}\) \d{3}-\d{4}$"
									   data-parsley-error-message="Phone must be formatted as (xxx) xxx-xxxx"
									   data-parsley-required-message="Phone number is required" id="vgm-contact_phone" name="contact_phone" type="text" maxlength="40" size="25" value="" onblur="fmtPhone(this,'(xxx) xxx-xxxx');">
							</div>
						</div>
						<div class="text-field">
							<label for="vgm-contact_addr1">Address</label>
							<input type="text" name="contact_addr1" id="vgm-contact_addr1" required="">
						</div>

						<div class="visitor-guide__quad">
							<div class="text-field">
								<label for="vgm-contact_country">Country</label>
