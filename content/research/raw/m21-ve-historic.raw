        <div
            class="relative bg-brand-cream rounded-[2rem] overflow-hidden shadow-md flex flex-col min-h-[350px] md:min-h-[400px]">

            <!-- Background Live Map Preview Container -->
            <div id="map-preview" class="absolute inset-0 w-full h-full z-0"></div>

            <!-- Top Left Cutout Overlay -->
            <div
                class="relative z-10 bg-brand-cream w-[90%] sm:w-[75%] md:w-[60%] lg:w-[50%] p-8 md:p-10 lg:p-12 rounded-br-[3rem]">
