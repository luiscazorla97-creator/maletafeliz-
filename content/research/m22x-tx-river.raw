</div><div data-civid="6ae7a9231846709166185821" class="contentRender contentRender_19 contentRender_type_widget contentRender_name_plugins_core_textbox" data-sv-time="13" data-sv-index="19" data-gtm-vars='{ "tCore" : { "contentNum" : "7" } }'><section data-sv-core-textbox  data-guid="fed8e100-297c-40cb-9444-8ce7e55cc61f">
	<h3>FAQs</h3>

</section></div><div data-civid="6ae7a9021846709166185809" class="contentRender contentRender_20 contentRender_type_widget contentRender_name_plugins_collections_type_custom_faq_question contentRender_name_plugins_collections_template_custom_faqs" data-sv-time="75" data-sv-index="20" data-gtm-vars='{ "tCore" : { "contentNum" : "1" } }'>





<section
	class="core-faqs expandable"
	data-guid="44559bf2-e201-429e-a978-ac7509d48e1f"
	data-js="plugins_collections_custom_faqs"
>
	
	
		
		
		<div data-sem-label="Is the San Antonio River Walk Open During the Holidays?">
			<details id="44559bf2-e201-429e-a978-ac7509d48e1f_0_1" class="faq-item" data-sem-faq="toggle" data-sem-text="Is the San Antonio River Walk Open During the Holidays?">
				<summary class="question">
					<p>Is the San Antonio River Walk Open During the Holidays?</p>
				</summary>
				<div class="answer">
					<p>Yes. The River Walk is a public park open 24 hours a day, seven days a week.</p>
					
				</div>
			</details>
			
		</div>
		
		<div data-sem-label="Where Are the Holiday Lights Located on the San Antonio River Walk?">
			<details id="44559bf2-e201-429e-a978-ac7509d48e1f_0_2" class="faq-item" data-sem-faq="toggle" data-sem-text="Where Are the Holiday Lights Located on the San Antonio River Walk?">
				<summary class="question">
					<p>Where Are the Holiday Lights Located on the San Antonio River Walk?</p>
				</summary>
				<div class="answer">
					<p>The holiday lights are displayed along the downtown portion of the River Walk.</p>
					
				</div>
			</details>
			
		</div>
		
		<div data-sem-label="How Long Do the River Walk Holiday Lights Stay Up?">
			<details id="44559bf2-e201-429e-a978-ac7509d48e1f_0_3" class="faq-item" data-sem-faq="toggle" data-sem-text="How Long Do the River Walk Holiday Lights Stay Up?">
				<summary class="question">
					<p>How Long Do the River Walk Holiday Lights Stay Up?</p>
				</summary>
				<div class="answer">
					<p>The lights typically remain illuminated nightly through early January.</p>
					
				</div>
			</details>
			
		</div>
		
		<div data-sem-label="When Do the River Walk Christmas Lights Turn On in 2026?">
			<details id="44559bf2-e201-429e-a978-ac7509d48e1f_0_4" class="faq-item" data-sem-faq="toggle" data-sem-text="When Do the River Walk Christmas Lights Turn On in 2026?">
				<summary class="question">
					<p>When Do the River Walk Christmas Lights Turn On in 2026?</p>
				</summary>
				<div class="answer">
					<p>The 2026 holiday lights begin Friday, November 27, during the Ford Holiday River Parade and Lighting Ceremony.</p>
					
				</div>
			</details>
			
		</div>
		
		<div data-sem-label="Are the San Antonio River Walk Holiday Lights Free?">
			<details id="44559bf2-e201-429e-a978-ac7509d48e1f_0_5" class="faq-item" data-sem-faq="toggle" data-sem-text="Are the San Antonio River Walk Holiday Lights Free?">
				<summary class="question">
					<p>Are the San Antonio River Walk Holiday Lights Free?</p>
				</summary>
				<div class="answer">
					<p>Yes. The holiday lights are free to enjoy along the downtown River Walk. No ticket is required to view the display.</p>
					
				</div>
			</details>
			
		</div>
		
	
		
			
		
		
	
</section>

