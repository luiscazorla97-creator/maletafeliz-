<style nonce="f7fb3910-480d-e9e2-2fae-5b25a8ab1b83">
    .at-dsn-boot-body {
        overflow: hidden;
    }

    .at-dsn-boot-body>header,
    .at-dsn-boot-body>.at-skip-navigation {
        position: relative;
        z-index: 1100;
    }

    .at-dsn-boot-body>#at-growler {
        position: relative;
        z-index: 1100;
    }

    .at-dsn-boot-body .at-dsn-boot {
        position: relative;
        z-index: 1000;
        width: 100%;
    }

    .at-dsn-boot__overlay {
        position: fixed;
        top: 0;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1;
        background-color: #fff;
        
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;

        padding-top: var(--at-header-height, 72px); 
    }

    .at-dsn-boot__content {
        visibility: hidden;
    }

    .at-dsn-boot.at-dsn-boot--ready .at-dsn-boot__content {
        visibility: visible;
    }

    .at-dsn-boot__spinner {
        flex-shrink: 0;
        max-width: 100%;
    }

    .at-dsn-boot__spinner {
        opacity: 0;
        visibility: hidden;
    
        animation: bootSpinnerFadeIn 0.1s forwards;
    
        animation-delay: 0.3s;
    }

    @keyframes bootSpinnerFadeIn {
        to {
            opacity: 1;
            visibility: visible;
        }
    }

    .atn-loading-spinner {
    font-family: var(--atn-fonts-font-family-primary);
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--atn-spacing-16);
    text-align: center;
  }

  .atn-loading-spinner__header {
    margin: 0;
    padding: 0;
    font-family: var(--atn-fonts-font-family-primary) !important;
    font-size: var(--atn-heading4-font-size) !important;
    color: var(--atn-colour-text-default) !important;
    font-weight: var(--atn-fonts-font-weight-700) !important;
    letter-spacing: var(--atn-heading4-letter-spacing) !important;
    line-height: var(--atn-heading4-line-height) !important;
    text-align: center;
  }

  .atn-loading-spinner__header:empty {
    display: none;
  }

  .atn-loading-spinner__body {
    display: flex;
    align-items: center;
    gap: var(--atn-spacing-16);
  }

  .atn-loading-spinner__ring {
    width: 4.5rem;
    height: 4.5rem;
    flex: 0 0 auto;
    position: relative;
  }

  .atn-loading-spinner__ring-svg {
    width: 100%;
    height: 100%;
    animation: atn-loading-spinner-rotate 1.5s linear infinite; 
  }

  .atn-loading-spinner__ring-track {
    stroke: #d9d9d9;
    stroke-width: 5.56;
  }

  .atn-loading-spinner__ring-indicator {
    stroke: var(--atn-colour-accents-shore-strong-2);
    stroke-width: 5.56;
    stroke-dasharray: 32, 95;
    stroke-dashoffset: -10;
    transform-origin: center;
  }

  .atn-loading-spinner__labels {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--atn-spacing-4);
    min-width: 0;
    text-align: left;
  }

  .atn-loading-spinner__label-secondary {
    font-size: var(--atn-body-default-font-size);
    color: var(--atn-colour-text-default);
    line-height: var(--atn-body-default-line-height);
    font-weight: var(--atn-fonts-font-weight-400);
    letter-spacing: var(--atn-body-default-letter-spacing);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .atn-loading-spinner__label-secondary:empty {
    display: none;
  }

  .atn-loading-spinner__visually-hidden {
    position: absolute;
    overflow: hidden;
    width: 1px;
    height: 1px;
    white-space: nowrap;
    clip: rect(0 0 0 0);
    clip-path: inset(50%);
  }

  @keyframes atn-loading-spinner-rotate {
    0% { transform: rotate(0deg); }
    100% { transform: rotate(360deg); }
  }
</style>

