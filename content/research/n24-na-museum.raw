<main class="l-main p-main">

	<div class="p-container">

		<header class="p-page-header js-fade-up">
			<hgroup>
				<p class="p-title" lang="en" translate="no">Visitor Information</p>
				<h1 class="p-jp">来館のご案内</h1>
			</hgroup>
		</header>

		<div class="p-lang-change">
			<span class="p-lang-change__text">This site is translated using the automatic translation service "DeepL".</span>
		</div>

		<div class="p-side-heading js-fade-up" lang="en" translate="no">
			Visitor information
		</div>

		<div class="p-main-contents">

			<div class="p-page-image js-fade-up"><img src="https://www.tokugawa-art-museum.jp/wp-content/themes/tokugawa-art/img/img_visitor_information.jpg" alt="来館のご案内" width="1066" height="442"></div>

			<div class="p-main-contents__body">


				<section id="s01" class="p-section">
					<header class="p-section__header js-fade-up">
						<hgroup>
							<h2 class="p-en p-title" lang="en" translate="no">Information</h2>
							<p class="p-jp">ご案内</p>
						</hgroup>
					</header>

					<dl class="p-dl">
						<div class="p-dl__item js-fade-up">
							<dt>
								<span>開館時間</span>
								<span lang="en" translate="no">Opening Hours</span>
							</dt>
							<dd class="translate-content">
								10:00 〜 17:00（入館は16:30まで）
							</dd>
						</div>

						<div class="p-dl__item js-fade-up">
							<dt>
								<span>休館日</span>
								<span lang="en" translate="no">Closed Days</span>
							</dt>
							<dd class="translate-content">
								月曜日（祝日・振替休日の場合は直後の平日）<br>
								2026年12月14日（月）～2027年1月4日（月）
							</dd>
						</div>

						<div class="p-dl__item js-fade-up">
							<dt>
								<span>観覧所要時間</span>
								<span lang="en" translate="no">Estimated Viewing Time</span>
							</dt>
							<dd class="translate-content">
								平均60分〜90分程度
							</dd>
						</div>

						<div class="p-dl__item js-fade-up">
							<dt>
								<span>美術館の概要解説</span>
								<span lang="en" translate="no">Brief Description</span>
							</dt>
							<dd class="translate-content">
								平日・土日祝<br>
								玄関ロビーにて各15分程度実施（予約不要）<br>
								10:30 ~ ／ 11:30 ~ ／ 13:30~ ／ 14:30~
							</dd>
						</div>

					</dl>
				</section>


				<section id="s02" class="p-section">
					<header class="p-section__header js-fade-up">
						<hgroup>
							<h2 class="p-en p-title" lang="en" translate="no">Admission Fee</h2>
							<p class="p-jp">入館料</p>
						</hgroup>
					</header>

					<dl class="p-dl js-fade-up">
						<div class="p-dl__item p-dl__item--fee">
							<dt>
								<span>徳川美術館・<br class="block lg:hidden">蓬左文庫入館料</span>
								<span lang="en" translate="no">Admission Fees</span>
							</dt>
							<dd>
								<div class="p-fee-table">
									<div>
										<table>
											<caption class="translate-content">個人</caption>
											<tr>
												<th class="translate-content">一般</th>
												<td class="translate-content">2,000 円</td>
											</tr>
											<tr>
												<th class="translate-content">高大生</th>
												<td class="translate-content">1,200 円</td>
											</tr>
											<tr>
												<th class="translate-content">小中生</th>
												<td class="translate-content">無料</td>
											</tr>
										</table>
										<a href="https://www.tokugawa-art-museum.jp/wp-content/uploads/2026/04/about_discount.pdf" target="_blank" class="p-inline-button translate-content">各種割引について</a>　　<!--小中高校生の減額申請書について　<a href="https://www.tokugawa-art-museum.jp/wp-content/uploads/2025/09/1115～1207観覧料減額申請書小・中）.pdf" target="_blank" class="p-inline-button translate-content">小・中学校</a>　<a href="https://www.tokugawa-art-museum.jp/wp-content/uploads/2025/09/1115～1207観覧料減額申請書高校）.pdf" target="_blank" class="p-inline-button translate-content">高校</a>-->
									</div>

									<div>
										<a href="https://www.e-tix.jp/tokugawa-art-museum/" target="_blank" class="p-button translate-content">チケット購入</a>
										<a href="https://form.run/@tokugawa-dantai" target="_blank" class="p-button translate-content">団体予約・お問い合わせ</a>
										<a href="https://www.tokugawa-art-museum.jp/wp-content/uploads/2026/05/パンフレット.pdf" target="_blank" class="p-button translate-content">パンフレット</a>
									</div>

								</div>
								<!--<ul>
									<li class="translate-content">*隣接する日本庭園・徳川園への入園は別途150円が必要となります。</li>
									<li class="translate-content">*毎週土曜日は高校生以下無料。</li>
								</ul>-->
							</dd>
						</div>
