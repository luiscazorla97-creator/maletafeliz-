<script nonce="f7fb3910-480d-e9e2-2fae-5b25a8ab1b83" type="text/javascript">
    (function () {
        window.dataLayer = window.dataLayer || [];
        const serverContext = {"isLoggedIn":false,"aucklandCouncil":false,"accountId":"","accountStatus":"anonymous","utmCampaign":"","utmMedium":"","utmSource":"","utmTerm":"","hashedEmailAddress":"","pageId":129773,"pagePath":"/bus-train-ferry/visitors-guide-to-public-transport-in-auckland/public-transport-trips-around-auckland","pageTitle":"Public transport trips around Auckland","previousPage":"","queryString":"","referrer":"","createdDate":"29/10/2025","modifiedDate":"14/09/2026","domain":"at.govt.nz","environment":"prod","services":"","userAgent":"MaletaFeliz editorial research/0.1 (\u002Bhttps://maletafeliz.com/)","siteSection":"Bus train ferry","sessionId":"f7fb3910-480d-e9e2-2fae-5b25a8ab1b83"};

        function getColorScheme() {
            if (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) {
                return 'dark';
            } else if (window.matchMedia && window.matchMedia('(prefers-color-scheme: light)').matches) {
                return 'light';
            }
            return 'no-preference';
        }

        function getDeviceType() {
            const width = window.innerWidth || document.documentElement.clientWidth;
            if (width < 768) return 'mobile';
            if (width < 1024) return 'tablet';
            return 'desktop';
        }

        function getHighContrast() {
            if (window.matchMedia) {
                return window.matchMedia('(prefers-contrast: high)').matches ||
                       window.matchMedia('(prefers-contrast: more)').matches;
            }
            return false;
        }

        function getInputMethod() {
            if (window.matchMedia && window.matchMedia('(pointer: fine)').matches) {
                return 'mouse';
            }
            return ('ontouchstart' in window || navigator.maxTouchPoints > 0) ? 'touch' : 'mouse';
        }

        function getOrientation() {
            return window.innerHeight > window.innerWidth ? 'portrait' : 'landscape';
        }

        function getPrefersContrast() {
            if (window.matchMedia && (window.matchMedia('(prefers-contrast: high)').matches || window.matchMedia('(prefers-contrast: more)').matches)) {
                return 'high';
            }
            return 'normal';
        }

        function getPrefersReducedMotion() {
            if (window.matchMedia) {
                return window.matchMedia('(prefers-reduced-motion: reduce)').matches;
            }
            return false;
        }

        function getDeviceId() {
            const STORAGE_KEY = 'at_device_id';
            const FALLBACK_ID = "6cac5231-0f7f-48d1-9d9a-140070a07844";
            
            try {
                let deviceId = localStorage.getItem(STORAGE_KEY);
                
                if (deviceId) {
                    return deviceId;
                }
                
                deviceId = FALLBACK_ID || generateUUID();
                
                try {
                    localStorage.setItem(STORAGE_KEY, deviceId);
                } catch (e) {
                    try {
                        sessionStorage.setItem(STORAGE_KEY, deviceId);
                    } catch (e2) {
                        console.warn('Could not store device ID:', e2);
                    }
                }
                
                return deviceId;
            } catch (e) {
                return FALLBACK_ID || generateUUID();
            }
        }

        function generateUUID() {
            return 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx'.replace(/[xy]/g, function(c) {
                const r = Math.random() * 16 | 0;
                const v = c === 'x' ? r : (r & 0x3 | 0x8);
                return v.toString(16);
            });
        }

        let pageCountValue = null;
        function getPageCount() {
            if (pageCountValue !== null) return pageCountValue;
            try {
                var count = parseInt(sessionStorage.getItem('at_page_count') || 0) + 1;
                sessionStorage.setItem('at_page_count', count);
                pageCountValue = count;
                return count;
            } catch (e) {
                return 1;
            }
        }

        function getDayOfWeek() {
            var days = ['Sunday', 'Monday', 'Tuesday', 'Wednesday', 'Thursday', 'Friday', 'Saturday'];
            return days[new Date().getDay()];
        }

        function getTimeOfDay() {
            var hour = new Date().getHours();
            if (hour >= 5 && hour < 12) return 'morning';
            if (hour >= 12 && hour < 17) return 'afternoon';
            if (hour >= 17 && hour < 21) return 'evening';
            return 'night';
        }

        function getOptimizelyVariant() {
            if (window.optimizely) {
                try {
                    const state = window.optimizely.get('state');
                    const variationMap = state.getVariationMap();
                    const experimentIds = Object.keys(variationMap);

                    if (experimentIds.length > 0) {
                        const firstId = experimentIds[0];
                        const decision = state.getDecisionObject({ experimentId: firstId });
                        return decision ? decision.variationKey : "";
                    }
                } catch (e) {
                    console.warn('Error getting Optimizely variant:', e);
                }
            }
            return '';
        }

        function getTextSize() {
            const div = document.createElement('div');
            div.style.width = '1rem';
            div.style.display = 'block';
            div.style.position = 'absolute';
            div.style.visibility = 'hidden';

            document.body.appendChild(div);

            const fontSizePx = parseFloat(window.getComputedStyle(div).width);

            document.body.removeChild(div);

            const scaleFactor = fontSizePx / 16;

            if (scaleFactor < 0.85) return "very small";
            if (scaleFactor < 0.95) return "small";
            if (scaleFactor < 1.1) return "medium";
            if (scaleFactor < 1.3) return "large";
            return "very large";
        }

        function getFontScale() {
            const dpr = window.devicePixelRatio || 1;
            if (dpr < 0.85) return "small";
            if (dpr < 1.1) return "normal";
            if (dpr < 1.4) return "large";
            if (dpr < 1.8) return "very large"
            return "high-density";
        }

        function getConnectionType() {
            const conn = navigator.connection || navigator.mozConnection || navigator.webkitConnection;
            return conn ? conn.effectiveType : 'unknown';
        }

        function checkCookiesEnabled() {
            if (navigator.cookieEnabled === false) return false;
            try {
                document.cookie = "at_test=1; SameSite=Lax";
                const isEnabled = document.cookie.indexOf("at_test=") !== -1;
                document.cookie = "at_test=1; expires=Thu, 01 Jan 1970 00:00:01 GMT; SameSite=Lax";
                return isEnabled;
            } catch (e) { return false; }
        }

        async function getFullContext(waitGeo = true) {
            let activeExperiments = "";
            if (window.optimizely) {
                    const state = window.optimizely.get('state');
                    const experimentIds = state.getVariationMap();
                    activeExperiments = Object.keys(experimentIds).join(',');
            }

            const clientContext = {
                experimentId: activeExperiments,
                deviceId: getDeviceId(),
                cookiesEnabled: checkCookiesEnabled(),
                pageCount: getPageCount(),
                userLanguage: navigator.language || navigator.userLanguage || 'en-NZ',
                variant: getOptimizelyVariant(),
                dayOfWeek: getDayOfWeek(),
                timestamp: new Date().toISOString(),
                timeOfDay: getTimeOfDay(),
                connectionType: getConnectionType(),
                timeToFirstByte: window.performance?.timing ? (window.performance.timing.responseStart - window.performance.timing.navigationStart) : null,
                domContentLoadedTime: window.performance?.timing ? (window.performance.timing.domContentLoadedEventEnd - window.performance.timing.navigationStart) : null,
                colorScheme: getColorScheme(),
                devicePixelRatio: window.devicePixelRatio || 1,
                deviceType: getDeviceType(),
                fontScale: getFontScale(),
                highContrast: getHighContrast(),
                innerHeight: window.innerHeight || 0,
                innerWidth: window.innerWidth || 0,
                inputMethod: getInputMethod(),
                orientation: getOrientation(),
                prefersContrast: getPrefersContrast(),
                prefersReducedMotion: getPrefersReducedMotion(),
                textSize: getTextSize(),
                zoomLevel: parseInt(window.outerWidth/window.innerWidth * 100) || 100,
                kioskMode: window.AT_KIOSK_MODE || false
            };

            return { ...serverContext, ...clientContext };
        }

        async function pushDataLayerEvent(eventName, interactionDetails = {}, wait = true) {
            const fullContext = await getFullContext(wait);
            const eventData = {
                event: eventName,
                ...fullContext,
                ...interactionDetails
            };

            window.dataLayer.push(eventData);
        }

        function schedulePageViewPush() {
            pushDataLayerEvent('page_view', {}, false);
        }
        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', () => {
                setTimeout(schedulePageViewPush, 0);
            });
        } else {
            setTimeout(schedulePageViewPush, 0);
        }

        if ('PerformanceObserver' in window) {
            async function pushMetricWithContext(eventName, metricData) {
                const context = await getFullContext(false);
                window.dataLayer.push({
                    event: eventName,
                    ...context,
                    ...metricData
                });
            }

            new PerformanceObserver((entryList) => {
                const entries = entryList.getEntries();
                const lastEntry = entries[entries.length - 1];
                pushMetricWithContext('web_vital_lcp', { largestContentfulPaint: Math.round(lastEntry.startTime) });
            }).observe({ type: 'largest-contentful-paint', buffered: true });

            new PerformanceObserver((entryList) => {
                const entry = entryList.getEntries()[0];
                pushMetricWithContext('web_vital_fid', { firstInputDelay: Math.round(entry.processingStart - entry.startTime) });
            }).observe({ type: 'first-input', buffered: true });

            let clsValue = 0;
            new PerformanceObserver((entryList) => {
                let sessionValue = 0;
                for (const entry of entryList.getEntries()) {
                    if (!entry.hadRecentInput) {
                        sessionValue += entry.value;
                    }
                }
                if (sessionValue > clsValue && sessionValue > 0) {
                    clsValue = sessionValue;
                    pushMetricWithContext('web_vital_cls', { 
                        cumulativeLayoutShift: parseFloat(clsValue.toFixed(4)) 
                    });
                }
            }).observe({ type: 'layout-shift', buffered: true });

            new PerformanceObserver((entryList) => {
                for (const entry of entryList.getEntries()) {
                    if (entry.interactionId) {
                        pushMetricWithContext('web_vital_inp', { interactionToNextPaint: Math.round(entry.duration) });
                    }
                }
            }).observe({ type: 'event', durationThreshold: 0, buffered: true });

            let tbt = 0;
            let tbtHasFired = false;

            new PerformanceObserver((entryList) => {
                for (const entry of entryList.getEntries()) {
                    tbt += (entry.duration - 50);
                }
            }).observe({ type: 'longtask', buffered: true });

            const sendTBT = () => {
                if (!tbtHasFired && tbt > 0) {
                    pushMetricWithContext('web_tbt_update', { totalBlockingTime: Math.round(tbt) });
                    tbtHasFired = true;
                }
            };

            ['mousedown', 'keydown', 'touchstart', 'visibilitychange'].forEach(type => {
                window.addEventListener(type, sendTBT, { once: true, capture: true });
            });
        }

        document.addEventListener('click', function (e) {
            const target = e.target.closest('a, button');
            if (!target) return;

            const rawLabel = target.innerText || target.getAttribute('aria-label') || target.id || "unnamed_action";
            const dynamicEventName = rawLabel.trim().toLowerCase().replace(/[^a-z0-9]+/g, '_');

            pushDataLayerEvent(dynamicEventName, {
                elementTag: target.tagName,
                targetUrl: target.href || 'none'
            });
        });
        
        window.atTracking = window.atTracking || {};
        window.atTracking.pushDataLayerEvent = pushDataLayerEvent;
    })();
</script>


