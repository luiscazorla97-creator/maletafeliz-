    <!-- Contenido Dinámico de la Página -->
    <main>
                                    
                <div class="antialiased overflow-x-hidden bg-brand-cream font-sans w-full">
    <section class="relative w-full">
        <div class="grid grid-cols-1 lg:grid-cols-2">

            
            <div class="relative overflow-hidden flex flex-col justify-center px-6 sm:px-10 lg:px-16 py-14 lg:py-24">
                <div class="relative z-10 max-w-xl">
                    
                    <div class="inline-flex items-center gap-2.5 px-4 py-1.5 rounded-full bg-[#5C113C]/10 border border-[#B19657]/40 mb-6 shadow-sm">
                        <span class="w-2 h-2 rounded-full bg-[#DDB304] animate-pulse"></span>
                        <span class="text-xs uppercase tracking-[0.25em] text-[#5C113C] font-extrabold" data-ms-field="hero.pretitle">Culture and History</span>
                    </div>

                    
                    <h1 class="cultura-hero-title font-extrabold text-[#5C113C] leading-[1.05] mb-6 tracking-tight fuente-titulos">
                        <span data-ms-field="hero.title">The art that</span>
                        <span class="bg-gradient-to-r from-[#B19657] via-[#DDB304] to-[#B19657] bg-clip-text text-transparent italic font-normal block mt-1" data-ms-field="hero.title_accent">defines us</span>
                    </h1>

                    
                    <div class="border-l-4 border-[#DDB304] pl-5 py-1 mb-9">
                        <p class="text-base md:text-lg text-gray-700/95 leading-relaxed font-light" data-ms-field="hero.subtitle">
                            Museums, flavors, and traditions of the port gathered in one place. Choose where to start your tour of Jarocho culture.
                        </p>
                    </div>

                    
                    <a href="https://descubre.veracruzmunicipio.gob.mx/cultura/conocenos" class="group relative block w-full max-w-lg p-5 sm:p-6 rounded-3xl bg-gradient-to-br from-white via-[#FFFDF9] to-[#F4F0E9] border-2 border-[#B19657]/40 shadow-[0_12px_35px_-6px_rgba(92,17,60,0.12)] hover:shadow-[0_20px_40px_-4px_rgba(92,17,60,0.22)] hover:border-[#5C113C] hover:-translate-y-1 transition-all duration-300">
                        
                        <div class="absolute top-0 right-0 w-24 h-24 bg-gradient-to-bl from-[#DDB304]/20 to-transparent rounded-tr-3xl pointer-events-none"></div>

                        <div class="flex items-center justify-between gap-4 relative z-10">
                            <div class="flex items-center gap-4 min-w-0">
                                
                                <div class="w-12 h-12 sm:w-14 sm:h-14 rounded-2xl bg-gradient-to-br from-[#5C113C] to-[#3F0B29] text-[#DDB304] flex items-center justify-center shadow-lg group-hover:scale-105 group-hover:from-[#DDB304] group-hover:to-[#B19657] group-hover:text-[#230616] transition-all duration-300 flex-shrink-0 border border-[#DDB304]/40">
                                    <i class="pi pi-building-columns text-xl sm:text-2xl"></i>
                                </div>

                                <div class="min-w-0">
                                    <div class="flex items-center gap-2">
                                        <span class="text-[10px] sm:text-xs font-bold uppercase tracking-widest text-[#B19657]">H. Ayuntamiento de Veracruz</span>
                                    </div>
                                    <h3 class="text-xl sm:text-2xl font-extrabold text-[#5C113C] fuente-titulos group-hover:text-[#3F0B29] transition-colors leading-tight" data-ms-field="hero.btn2">
                                        Conócenos
                                    </h3>
                                    <p class="text-xs text-gray-600 font-medium leading-snug mt-1">
                                        Dirección de Cultura del H. Ayuntamiento de la Ciudad de Veracruz
                                    </p>
                                </div>
                            </div>

                            
                            <div class="w-10 h-10 rounded-full bg-[#5C113C]/10 group-hover:bg-[#5C113C] text-[#5C113C] group-hover:text-white flex items-center justify-center transition-all duration-300 flex-shrink-0 shadow-sm">
                                <i class="pi pi-arrow-right text-sm group-hover:translate-x-0.5 transition-transform"></i>
                            </div>
                        </div>
                    </a>
                </div>
            </div>

            
            <div class="relative min-h-[420px] lg:min-h-[580px] bg-brand-burgundy-mid overflow-hidden">
                
                <div class="absolute inset-y-8 left-6 right-11 border-2 border-brand-muted z-10 hidden sm:block"></div>

                
                <div class="absolute inset-6 left-6 sm:left-11 z-20 overflow-hidden shadow-2xl">
