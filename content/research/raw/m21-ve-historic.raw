    <!-- Contenido Dinámico de la Página -->
    <main>
                                    <section class="relative h-screen bg-gray-900 overflow-hidden">
    <img src="https://descubre.veracruzmunicipio.gob.mx/images/Centro_Historico/lugares/Palacio_Municipal_Veracruz.jpg" alt="Vista aérea de Veracruz"
        data-ms-field="principal.hero_image"
        class="absolute inset-0 w-full h-full object-cover">

    <!-- Capa de degradado oscuro doble (horizontal + vertical) para máxima legibilidad de letras blancas -->
    <div class="absolute inset-0 bg-gradient-to-r from-black/85 via-black/55 to-black/35 z-10 pointer-events-none"></div>
    <div class="absolute inset-0 bg-gradient-to-t from-black/80 via-transparent to-black/50 z-10 pointer-events-none"></div>

    <div
        class="absolute inset-0 z-20 flex flex-col items-start justify-center pointer-events-none px-8 md:px-24 fuente-titulos">
        <div class="text-left max-w-5xl lg:max-w-6xl xl:max-w-7xl w-full">
            <!-- Title: 500 AÑOS DE HISTORIA -->
            <h2
                class="ch-hero-title text-white font-bold tracking-[0.1em] uppercase mb-2 drop-shadow-xl leading-tight">
                MORE THAN 500 YEARS OF HISTORY            </h2>

            <!-- Subtitle: VIVA EN CADA RINCÓN -->
                        <p
                class="ch-hero-subtitle text-brand-muted font-bold tracking-[0.25em] uppercase mb-8 drop-shadow-[0_4px_8px_rgba(0,0,0,0.9)] fuente-titulos">
                ALIVE IN EVERY CORNER            </p>
            
            <div class="mt-10 flex flex-wrap items-center gap-6">
                <a href="https://descubre.veracruzmunicipio.gob.mx/CentroHistorico/mapa"
                    class="pointer-events-auto inline-flex items-center px-11 py-[18px] bg-brand-gold hover:bg-[#c8a204] active:bg-[#b29003] text-white font-bold text-[15px] tracking-[0.2em] uppercase rounded-xl shadow-lg hover:shadow-2xl transition-all transform hover:-translate-y-0.5 active:translate-y-0 focus:outline-none border-b-2 border-[#c8a204]/80 hover:border-[#b29003] font-sans">
                    EXPLORE MAP                </a>
                <button id="openModalBtn"
                    class="pointer-events-auto inline-flex items-center px-11 py-[17px] bg-transparent hover:bg-white/10 border-2 border-white text-white font-bold text-[15px] tracking-[0.2em] uppercase rounded-xl shadow-md hover:shadow-lg transition-all transform hover:-translate-y-0.5 active:translate-y-0 focus:outline-none font-sans cursor-pointer">
                    <svg xmlns="http://www.w3.org/2000/svg" class="w-5 h-5 mr-3 fill-current text-white"
                        viewBox="0 0 24 24">
                        <path d="M8 5v14l11-7z" />
                    </svg>
                    WATCH VIDEO                </button>
            </div>
        </div>

        <!-- Títulos / Sellos Municipales (4 Elementos) -->
        <div
            class="mt-14 xl:mt-20 w-full max-w-[90rem] pointer-events-auto flex flex-wrap lg:flex-nowrap items-center gap-6 lg:gap-10 justify-start xl:justify-between font-sans">

            <!-- 4 VECES HEROICA -->
            <div class="flex items-center gap-3.5 group cursor-default">
                <svg xmlns="http://www.w3.org/2000/svg"
