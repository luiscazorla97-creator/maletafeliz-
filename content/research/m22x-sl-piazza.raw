			</button>
		</li>
		<li role="none">
			<a class="salerno-mobile-fab__action" role="menuitem" href="https://www.instagram.com/salernocultura_comunesalerno/" target="_blank" rel="noopener noreferrer" aria-label="Instagram">
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M7.8 2h8.4C19.4 2 22 4.6 22 7.8v8.4a5.8 5.8 0 0 1-5.8 5.8H7.8C4.6 22 2 19.4 2 16.2V7.8A5.8 5.8 0 0 1 7.8 2m-.2 2A3.6 3.6 0 0 0 4 7.6v8.8A3.6 3.6 0 0 0 7.6 20h8.8a3.6 3.6 0 0 0 3.6-3.6V7.6A3.6 3.6 0 0 0 16.4 4H7.6m9.65 1.5a1.25 1.25 0 1 1 0 2.5 1.25 1.25 0 0 1 0-2.5M12 7a5 5 0 1 1 0 10 5 5 0 0 1 0-10m0 2a3 3 0 1 0 0 6 3 3 0 0 0 0-6z"/></svg>				<span class="salerno-mobile-fab__sr-only">Instagram</span>
			</a>
		</li>
		<li role="none">
			<a class="salerno-mobile-fab__action" role="menuitem" href="https://www.facebook.com/culturasalerno" target="_blank" rel="noopener noreferrer" aria-label="Facebook">
				<svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false"><path d="M13.5 3H16V0h-2.5C10.4 0 9 1.4 9 4.5V7H6v3h3v10h3.5V10H16l.5-3h-3.5V5c0-.8.7-2 2-2z"/></svg>				<span class="salerno-mobile-fab__sr-only">Facebook</span>
			</a>
		</li>
	</ul>
	<button type="button" class="salerno-mobile-fab__toggle" aria-expanded="false" aria-controls="salerno-mobile-fab" data-label-open="Apri menu servizi" data-label-close="Chiudi menu servizi" aria-label="Apri menu servizi">
		<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>		<span class="salerno-mobile-fab__sr-only">Apri menu servizi</span>
	</button>
</div>
	<script id="salerno-consent-log">
(function () {
	document.addEventListener('cookieyes_consent_update', function (e) {
		var d = (e && e.detail) || {};
		var m = document.cookie.match(/(?:^|;\s*)cookieyes-consent=([^;]*)/);
		var id = '';
		if (m) {
			decodeURIComponent(m[1]).split(',').forEach(function (p) {
				var kv = p.split(':');
				if (kv[0] === 'consentid') { id = kv[1] || ''; }
			});
		}
		if (!id) { return; }
		var body = JSON.stringify({
			consentid: id,
			accepted: d.accepted || [],
			rejected: d.rejected || [],
			lang: document.documentElement.lang || ''
		});
		try {
			fetch("https:\/\/cultura.comune.salerno.it\/wp-json\/salerno\/v1\/consent", {
				method: 'POST',
				headers: { 'Content-Type': 'application/json' },
				body: body,
				keepalive: true,
				credentials: 'omit'
			});
		} catch (err) {}
	});
})();
</script>
	<script>
(function(){
	document.addEventListener('DOMContentLoaded', function(){
		var badges = document.querySelectorAll('.salerno-luogo-audio-badge');
		// Anche le card copiate dopo (es. scheda laterale della mappa opere) contengono il pallino.
		if (!badges.length && !document.querySelector('.salerno-luoghi-mappa')) return;

		var playerWrap = document.createElement('div');
		playerWrap.className = 'salerno-luogo-audio-mini-player';
		playerWrap.setAttribute('aria-label', 'Player audio luogo');
		playerWrap.innerHTML = '<audio class="salerno-luogo-audio-mini-player__audio" controls preload="metadata"></audio><button type="button" class="salerno-luogo-audio-mini-player__close" aria-label="Chiudi player">×</button>';
		document.body.appendChild(playerWrap);

		var audio = playerWrap.querySelector('audio');
		var closeBtn = playerWrap.querySelector('.salerno-luogo-audio-mini-player__close');

		function playUrl(url) {
			if (!url) return;
			audio.src = url;
			playerWrap.classList.add('salerno-luogo-audio-mini-player--open');
			audio.play().catch(function(){});
		}
		function closePlayer() {
			playerWrap.classList.remove('salerno-luogo-audio-mini-player--open');
			audio.pause();
			audio.currentTime = 0;
			audio.removeAttribute('src');
		}

		document.addEventListener('click', function(e){
			var btn = e.target.closest ? e.target.closest('.salerno-luogo-audio-badge') : null;
			if (!btn) return;
			e.preventDefault();
			e.stopPropagation();
			playUrl(btn.getAttribute('data-audio-url'));
		});
		closeBtn.addEventListener('click', closePlayer);
	});
})();
</script>
	<script>
(function () {
	var dlg = null, video = null, titleEl = null, lastBtn = null;
	function build() {
		dlg = document.createElement('dialog');
		dlg.className = 'salerno-lis-dialog';
		dlg.setAttribute('aria-labelledby', 'salerno-lis-dialog-title');
		dlg.innerHTML = '<div class="salerno-lis-dialog__inner"><div class="salerno-lis-dialog__head"><h2 id="salerno-lis-dialog-title" class="salerno-lis-dialog__title"></h2><button type="button" class="salerno-lis-dialog__close" aria-label="Chiudi video">&times;</button></div><video class="salerno-lis-dialog__video" controls playsinline preload="metadata"></video></div>';
		document.body.appendChild(dlg);
		video = dlg.querySelector('video');
		titleEl = dlg.querySelector('.salerno-lis-dialog__title');
		dlg.querySelector('.salerno-lis-dialog__close').addEventListener('click', function () { dlg.close(); });
		dlg.addEventListener('click', function (e) { if (e.target === dlg) { dlg.close(); } });
		dlg.addEventListener('close', function () {
			video.pause();
			video.removeAttribute('src');
			video.innerHTML = '';
			video.load();
			document.documentElement.classList.remove('salerno-lis-open');
			if (lastBtn) { lastBtn.focus(); }
		});
	}
	document.addEventListener('click', function (e) {
		var btn = e.target.closest ? e.target.closest('.salerno-lis-badge') : null;
		if (!btn) { return; }
		e.preventDefault();
		e.stopPropagation();
		if (!dlg) { build(); }
		lastBtn = btn;
		titleEl.textContent = 'LIS – ' + (btn.getAttribute('data-title') || '');
		video.innerHTML = '';
		video.src = btn.getAttribute('data-video-url');
		var vtt = btn.getAttribute('data-vtt-url');
		if (vtt) {
			var t = document.createElement('track');
			t.kind = 'subtitles'; t.srclang = 'it'; t.label = 'Italiano'; t.src = vtt;
			video.appendChild(t);
		}
		document.documentElement.classList.add('salerno-lis-open');
		dlg.showModal();
		dlg.querySelector('.salerno-lis-dialog__close').focus();
	});
})();
</script>
	<script id="salerno-mobile-fab-glass-js">
(function(){
	var toggle=document.querySelector('.salerno-mobile-fab__toggle');
	if(!toggle){return;}
	toggle.querySelectorAll('.salerno-mobile-fab__toggle-icon--close').forEach(function(el){el.remove();});
	if(toggle.querySelectorAll('svg').length>1){
		var keep=toggle.querySelector('svg');
		toggle.querySelectorAll('svg').forEach(function(el){if(el!==keep){el.remove();}});
	}
	if(!toggle.querySelector('svg')){
		var label=(toggle.querySelector('.salerno-mobile-fab__sr-only')||{}).textContent||toggle.getAttribute('aria-label')||'';
		var sr=toggle.querySelector('.salerno-mobile-fab__sr-only');
		toggle.innerHTML='<svg viewBox="0 0 24 24" fill="none" aria-hidden="true" focusable="false"><path d="M12 5v14M5 12h14" stroke="currentColor" stroke-width="2" stroke-linecap="round"/></svg>';
		if(sr){toggle.appendChild(sr);}else if(label){var span=document.createElement('span');span.className='salerno-mobile-fab__sr-only';span.textContent=label;toggle.appendChild(span);}
	}
})();
</script>
	<script>
(function(){
	document.addEventListener('DOMContentLoaded', function(){
		document.querySelectorAll('.guten-tabs').forEach(function(tabsEl){
			function hasMeaningfulContent(bodyEl) {
				if (!bodyEl) return false;
				if (bodyEl.querySelector('.salerno-spettacoli-luogo__empty, .salerno-evento-notizie__empty')) return true;
				if (bodyEl.querySelector('iframe')) return true;
				if (bodyEl.querySelector('.salerno-mappa-unica')) return true;
				var details = bodyEl.querySelectorAll('.salerno-details__value');
				for (var i = 0; i < details.length; i++) {
					if (details[i].textContent.replace(/\s+/g, ' ').trim().length > 0) return true;
				}
				var items = bodyEl.querySelectorAll('.salerno-details__item');
				for (var i = 0; i < items.length; i++) {
					var v = items[i].querySelector('.salerno-details__value, .text-content-inner');
					if (v && v.textContent.replace(/\s+/g, ' ').trim().length > 0) return true;
				}
				if (bodyEl.querySelector('.salerno-luogo-icone__grid .salerno-luogo-icone__item')) return true;
				var text = (bodyEl.innerText || bodyEl.textContent || '').replace(/\s+/g, ' ').trim();
				text = text.replace(/Nessun itinerario disponibile\.?/gi, '').trim();
				if (text.length > 0) return true; /* qualsiasi testo = contenuto valido (prima richiedeva > 15) */
				return false;
			}
			var bodyItems = tabsEl.querySelectorAll('.tab-body .tab-body-item');
			var hiddenIds = [];
			bodyItems.forEach(function(bodyItem){
				var dataId = bodyItem.dataset.id || bodyItem.getAttribute('data-id');
				if (!dataId) {
					dataId = bodyItem.className.match(/tab-([\w-]+)/);
					dataId = dataId ? dataId[1] : null;
				}
				if (!dataId) return;
				if (!hasMeaningfulContent(bodyItem)) {
					hiddenIds.push(dataId);
					bodyItem.style.display = 'none';
					var headingItem = tabsEl.querySelector('.tab-heading-item[data-id="' + dataId + '"]') || tabsEl.querySelector('.tab-heading-item#' + dataId);
					if (headingItem) headingItem.style.display = 'none';
					var optionItem = tabsEl.querySelector('.tab-option-item[data-id="' + dataId + '"]');
					if (optionItem) optionItem.style.display = 'none';
				}
			});
			if (hiddenIds.length > 0) {
				var activeBody = tabsEl.querySelector('.tab-body-item.active');
				var activeId = activeBody ? (activeBody.dataset.id || activeBody.getAttribute('data-id') || '') : '';
				if (activeId && hiddenIds.indexOf(activeId) >= 0) {
					var firstVisible = tabsEl.querySelector('.tab-body-item:not([style*="display: none"])');
					if (firstVisible) {
						var firstId = firstVisible.dataset.id || firstVisible.getAttribute('data-id') || (firstVisible.className.match(/\btab-[\w-]+/) || [])[0];
						if (firstId) {
							tabsEl.querySelectorAll('.tab-body-item, .tab-heading-item, .tab-option-item').forEach(function(el){
								el.classList.remove('active');
								var id = el.dataset.id || el.getAttribute('data-id') || el.id || '';
								if (id === firstId || el.classList.contains(firstId)) el.classList.add('active');
							});
						}
					}
				}
			}
		});
	});
})();
</script>
	<script id="salerno-cya11y-mobile-visible-js">
(function(){
	'use strict';
	var MOBILE=window.matchMedia('(max-width: 767px)');
	var Z_NORMAL="999998";
	var Z_OPEN="10000001";

	function isMenuOpen(container){
		if(!container||!container.shadowRoot){return false;}
		var menu=container.shadowRoot.querySelector('.cya11y-menu');
		var overlay=container.shadowRoot.querySelector('.cya11y-overlay');
		if(menu){
			var menuStyle=window.getComputedStyle(menu);
			if(menuStyle.display!=='none'&&menuStyle.visibility!=='hidden'&&menuStyle.opacity!=='0'){return true;}
		}
		if(overlay){
			var overlayStyle=window.getComputedStyle(overlay);
			if(overlayStyle.display!=='none'&&overlayStyle.visibility!=='hidden'&&overlayStyle.opacity!=='0'){return true;}
		}
		return false;
	}

	function restoreContainer(){
		if(!MOBILE.matches){return;}
		var container=document.getElementById('cya11y-container');
		if(!container){return;}
		container.style.setProperty('clip','auto','important');
		container.style.setProperty('-webkit-clip-path','none','important');
		container.style.setProperty('clip-path','none','important');
		container.style.setProperty('height','auto','important');
		container.style.setProperty('width','auto','important');
		container.style.setProperty('overflow','visible','important');
		container.style.setProperty('visibility','visible','important');
		container.style.setProperty('opacity','1','important');
		container.style.setProperty('position','fixed','important');
		container.style.setProperty('pointer-events','auto','important');
		var open=isMenuOpen(container);
		container.classList.toggle('salerno-cya11y-menu-open',open);
		container.style.setProperty('z-index',open?Z_OPEN:Z_NORMAL,'important');
	}

	function removeFabA11yItem(){
		var btn=document.querySelector('[data-salerno-fab-action="accessibility"]');
		if(!btn){return;}
		var item=btn.closest('li');
		if(item){item.remove();}
	}

	function run(){
		restoreContainer();
		removeFabA11yItem();
	}

	run();
	document.addEventListener('DOMContentLoaded',run);
	window.addEventListener('load',run);
	if(window.MutationObserver){
		var scheduled=false;
		var observer=new MutationObserver(function(){
			if(scheduled){return;}
			scheduled=true;
			window.requestAnimationFrame(function(){
				scheduled=false;
				run();
			});
		});
		observer.observe(document.documentElement,{childList:true,subtree:true,attributes:true,attributeFilter:['style','class']});
		var container=document.getElementById('cya11y-container');
		if(container&&container.shadowRoot){
			observer.observe(container.shadowRoot,{childList:true,subtree:true,attributes:true,attributeFilter:['style','class']});
		}else{
			setTimeout(function(){
				container=document.getElementById('cya11y-container');
				if(container&&container.shadowRoot){
					observer.observe(container.shadowRoot,{childList:true,subtree:true,attributes:true,attributeFilter:['style','class']});
				}
			},1000);
		}
	}
	setTimeout(run,500);
	setTimeout(run,1500);
})();
</script>
	<script id="salerno-mobile-fab-a11y-fix-js">
(function(){
	var btn=document.querySelector('[data-salerno-fab-action="accessibility"]');
	if(!btn){return;}
	var item=btn.closest('li');
	if(item){item.remove();}
})();
</script>
	<style id="matour-child-gutenverse-tabs">
.guten-tabs .tab-heading {
	gap: 10px !important;
}
.guten-tabs.horizontal .tab-heading .tab-heading-item,
.guten-tabs.horizontal-right .tab-heading .tab-heading-item {
	border-radius: 50px !important;
	transition: background 0.3s ease, border-color 0.3s ease, backdrop-filter 0.3s ease !important;
}
.guten-tabs.horizontal .tab-heading .tab-heading-item.active,
.guten-tabs.horizontal-right .tab-heading .tab-heading-item.active {
	background: #e6e6e600 !important;
	border-radius: 50px !important;
	backdrop-filter: blur(26px) !important;
	border: solid 1px !important;
	border-color: white !important;
	border-bottom-color: white !important;
}
@media (max-width: 781px) {
	.guten-tabs:has(.tab-heading .tab-heading-item:nth-child(3)) .tab-heading {
		overflow-x: auto !important;
		overflow-y: hidden !important;
		scroll-behavior: smooth !important;
		-webkit-overflow-scrolling: touch;
		flex-wrap: nowrap !important;
		-ms-overflow-style: none;
		scrollbar-width: none;
	}
	.guten-tabs:has(.tab-heading .tab-heading-item:nth-child(3)) .tab-heading::-webkit-scrollbar {
		display: none;
	}
	.guten-tabs:has(.tab-heading .tab-heading-item:nth-child(3)) .tab-heading .tab-heading-item {
		flex-shrink: 0 !important;
	}
}
/* Fix blur: overlay dietro al contenuto (z-index), così il blur resta solo sullo sfondo */
.section-wrapper .guten-section.guten-y21fUj .guten-background-overlay,
section.guten-element.guten-y21fUj .guten-background-overlay {
	z-index: 0 !important;
}
.section-wrapper .guten-section.guten-y21fUj .guten-container,
section.guten-element.guten-y21fUj .guten-container {
	z-index: 1 !important;
	position: relative !important;
}
</style><script>
(function(){
	document.addEventListener('DOMContentLoaded', function(){
		document.querySelectorAll('.guten-tabs .tab-heading-item').forEach(function(item){
			item.addEventListener('click', function(){
				var clickedTab = this;
				var heading = clickedTab.closest('.tab-heading');
				if (!heading || heading.scrollWidth <= heading.clientWidth) return;
				requestAnimationFrame(function(){
					clickedTab.scrollIntoView({ inline: 'center', block: 'nearest', behavior: 'smooth' });
				});
			});
		});
	});
})();
</script>
	</body>
</html>
