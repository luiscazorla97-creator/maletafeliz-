 	<li style="list-style-type: none;">
<ul class="c-sticky-nav__lists">
 	<li class="c-sticky-nav__list js-access-nav-list"><a class="c-sticky-nav__link js-access-nav-link" href="#description">Description</a></li>
 	<li class="c-sticky-nav__list js-access-nav-list"><a class="c-sticky-nav__link js-access-nav-link" href="#traveling-to-kamakura">Getting to Kamakura by train</a></li>
 	<li class="c-sticky-nav__list js-access-nav-list"><a class="c-sticky-nav__link js-access-nav-link" href="#transp-in-kamakura">Public transportation in Kamakura city</a></li>
</ul>
</li>
