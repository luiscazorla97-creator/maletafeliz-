    <div class="paragraph paragraph--type--gam-block paragraph--view-mode--default">
    <h2 class="gam-title h4">Promoted Content</h2>
    <div class="hero--max-width">
        
  <div id="block-sidebysideadblock" class="container">
  
    
        <div class="dfp-grid">
    <div class="left"><div class="container">
  
    
