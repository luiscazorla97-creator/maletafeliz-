<main  id="content" class="site-main post-4300 page type-page status-publish hentry">

	
	<div  class="page-content">
				<div  data-elementor-type="wp-page" data-elementor-id="4300" class="elementor elementor-4300" data-elementor-post-type="page">
				<div class="elementor-element elementor-element-3f0f9590 e-con-full e-flex e-con e-parent" data-id="3f0f9590" data-element_type="container" data-e-type="container">
		<div class="elementor-element elementor-element-69da8ae e-con-full e-flex e-con e-child" data-id="69da8ae" data-element_type="container" data-e-type="container" data-settings="{&quot;background_background&quot;:&quot;classic&quot;}">
		<div class="elementor-element elementor-element-dda4999 e-con-full e-flex e-con e-child" data-id="dda4999" data-element_type="container" data-e-type="container" data-settings="{&quot;sticky&quot;:&quot;top&quot;,&quot;sticky_on&quot;:[&quot;desktop&quot;,&quot;laptop&quot;],&quot;sticky_offset&quot;:300,&quot;sticky_parent&quot;:&quot;yes&quot;,&quot;sticky_offset_laptop&quot;:350,&quot;sticky_effects_offset&quot;:0,&quot;sticky_anchor_link_offset&quot;:0}">
				<div class="elementor-element elementor-element-1cc3d65d elementor-widget elementor-widget-heading" data-id="1cc3d65d" data-element_type="widget" data-e-type="widget" data-widget_type="heading.default">
					<h2 class="elementor-heading-title elementor-size-default">CONTENUTI UTILI<BR> NELLA PAGINA </h2>				</div>
				<div class="elementor-element elementor-element-95e8828 elementor-icon-list--layout-traditional elementor-list-item-link-full_width elementor-widget elementor-widget-icon-list" data-id="95e8828" data-element_type="widget" data-e-type="widget" data-widget_type="icon-list.default">
							<ul class="elementor-icon-list-items">
							<li class="elementor-icon-list-item">
											<a href="#mappa">

											<span class="elementor-icon-list-text">Mappa &gt;</span>
											</a>
									</li>
								<li class="elementor-icon-list-item">
											<a href="#vgls">

											<span class="elementor-icon-list-text">Videoguida in Lingua dei Segni &gt;</span>
											</a>
									</li>
								<li class="elementor-icon-list-item">
											<a href="#pt">

											<span class="elementor-icon-list-text">Percorso tattile &gt;</span>
											</a>
									</li>
								<li class="elementor-icon-list-item">
											<a href="#pms">

											<span class="elementor-icon-list-text">Pannelli multisensoriali &gt;</span>
											</a>
									</li>
								<li class="elementor-icon-list-item">
											<a href="#caa">

											<span class="elementor-icon-list-text">Guida in CAA &gt;</span>
											</a>
									</li>
								<li class="elementor-icon-list-item">
											<a href="#vt">

											<span class="elementor-icon-list-text">Video trimodale &gt;</span>
											</a>
									</li>
								<li class="elementor-icon-list-item">
											<a href="#storiasociale">

											<span class="elementor-icon-list-text">Storia Sociale &gt;</span>
											</a>
									</li>
								<li class="elementor-icon-list-item">
											<a href="#os">

											<span class="elementor-icon-list-text">Officina Schifanoia &gt;</span>
											</a>
									</li>
