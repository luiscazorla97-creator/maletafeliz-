<script>
    document.addEventListener('DOMContentLoaded', function () {
  var container = document.querySelector('.single-post-content');
  if (!container) return;

  var iframes = container.querySelectorAll('iframe');
  iframes.forEach(function (iframe) {
    if (iframe.parentElement && iframe.parentElement.classList.contains('bi-video-wrap')) {
      return;
    }

    var wrapper = document.createElement('div');
    wrapper.className = 'bi-video-wrap';
    iframe.parentNode.insertBefore(wrapper, iframe);
    wrapper.appendChild(iframe);
  });
});
</script>

<script>
// Play/pause control for decorative background videos (WCAG 2.2.2).
// Markup: <button type="button" class="bg-video-toggle" aria-controls="VIDEO_ID">
//           <span class="pause"></span><span class="play"></span>
//         </button>
// The button state follows the video's own play/pause events, so it stays
// correct if autoplay is blocked or the video is paused some other way.
class VideoToggle {
    constructor(toggle, pausedClass = 'is-paused'){
        this.toggle = toggle;
        this.video = document.getElementById(toggle.getAttribute('aria-controls'));
        this.pausedClass = pausedClass;
        if(!this.video){return;}

        this.toggle.addEventListener('click', this.togglePlay);
        this.video.addEventListener('play', this.sync);
        this.video.addEventListener('pause', this.sync);

        if(window.matchMedia('(prefers-reduced-motion: reduce)').matches){
            this.video.pause();
        }
        this.sync();
    }
    togglePlay = ()=>{
        if(this.video.paused){
            this.video.play();
        }else {
            this.video.pause();
        }
    }
    sync = ()=>{
        const paused = this.video.paused;
        this.toggle.classList.toggle(this.pausedClass, paused);
        this.toggle.setAttribute('aria-label', paused ? 'Play background video' : 'Pause background video');
    }
}
document.querySelectorAll('.bg-video-toggle').forEach(toggle => new VideoToggle(toggle));

</script>


