var IRISCollectionTheme = {"queriedObject":{"ID":81635,"post_author":"9","post_date":"2026-05-11 11:07:32","post_date_gmt":"2026-05-11 09:07:32","post_content":"\u003C!-- wp:heading --\u003E\n\u003Ch2 class=\"wp-block-heading\"\u003EDay 1: Nice, between sea, old town and first sensations\u003C/h2\u003E\n\u003C!-- /wp:heading --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ETo immerse yourself in Nice in a single day is first and foremost to surrender to the dazzling colours of its Baie des Anges. The blue of the sky, the yellow-orange of the rising sun to the east of the bay, the turquoise of the calm waters of the Mediterranean, the immaculate white of the pebbles on its beaches. And it's quite naturally on the \u003Cstrong\u003EPromenade des Anglais\u003C/strong\u003E that your walk begins in the early hours of the morning. Why not stroll past the legendary art-deco fa\u00e7ade of \u003Cstrong\u003Ethe H\u00f4tel Negresco\u003C/strong\u003E, the city's iconic luxury hotel?\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EThen head east along the Prom towards \u003Cstrong\u003ERauba Capeu and Port Lympia\u003C/strong\u003E. Past the \u003Cstrong\u003EPalais de la M\u00e9diterran\u00e9e and the Th\u00e9\u00e2tre de Verdure, then the south-facing fa\u00e7ade of the Opera House\u003C/strong\u003E, you'll find yourself walking along \u003Cstrong\u003ELes Ponchettes, \u003C/strong\u003Ea series of narrow little houses overlooked by a promenade-terrace that was very popular with winter visitors in the 19th century. Bars and restaurants welcome you here, while a little further on, elegantly renovated old fishermen's houses catch your eye with their balconies plunging into the Grande Bleue.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003E\u003Cbr\u003EIt's time to climb \u003Cstrong\u003Ethe castle hill\u003C/strong\u003E (by the stairs... or the lift), to enjoy the spectacular panorama over the town and the port, to get lost in the maze of paths drowned in greenery, and not forgetting to stop off in front of the huge waterfall.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:acf/iris-block-related-posts {\"name\":\"acf/iris-block-related-posts\",\"data\":{\"iris-block-related-posts-mode\":\"slider\",\"_iris-block-related-posts-mode\":\"field_iris-block-related-posts_iris-block-related-posts-mode\",\"iris-block-related-posts-background\":\"bg-default\",\"_iris-block-related-posts-background\":\"field_iris-block-related-posts_iris-block-related-posts-background\",\"iris-block-related-posts-overtitle\":\"\",\"_iris-block-related-posts-overtitle\":\"field_iris-block-related-posts_iris-block-related-posts-overtitle\",\"iris-block-related-posts-title\":\"\",\"_iris-block-related-posts-title\":\"field_iris-block-related-posts_iris-block-related-posts-title\",\"iris-block-related-posts-content\":\"\",\"_iris-block-related-posts-content\":\"field_iris-block-related-posts_iris-block-related-posts-content\",\"iris-block-related-posts-type\":\"manual\",\"_iris-block-related-posts-type\":\"field_iris-block-related-posts_iris-block-related-posts-type\",\"iris-block-related-posts-type-manual\":[\"65895\",\"65938\",\"65947\",\"66196\",\"63517\",\"65865\"],\"_iris-block-related-posts-type-manual\":\"field_iris-block-related-posts_iris-block-related-posts-type-manual\",\"iris-block-related-posts-manual-orderby\":\"selection\",\"_iris-block-related-posts-manual-orderby\":\"field_iris-block-related-posts_iris-block-related-posts-manual-orderby\",\"iris-block-related-posts-posts-per-page\":\"\",\"_iris-block-related-posts-posts-per-page\":\"field_iris-block-related-posts_iris-block-related-posts-posts-per-page\",\"iris-block-related-posts-link\":\"\",\"_iris-block-related-posts-link\":\"field_iris-block-related-posts_iris-block-related-posts-link\",\"iris-block-related-posts-title-size\":\"\",\"_iris-block-related-posts-title-size\":\"field_iris-block-related-posts_iris-block-related-posts-title-size\"},\"align\":false,\"mode\":\"preview\"} /--\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EThe old town is then reached via a series of staircases and alleyways. Head for the \u003Cstrong\u003ECours Saleya\u003C/strong\u003E and its flower market, which you can stroll around with a slice of socca in your hand. Time for lunch! Choose \u003Cstrong\u003Ea restaurant with the Cuisine Nissarde label\u003C/strong\u003E and feast on delicious local specialities.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:acf/iris-block-related-posts {\"name\":\"acf/iris-block-related-posts\",\"data\":{\"iris-block-related-posts-mode\":\"slider\",\"_iris-block-related-posts-mode\":\"field_iris-block-related-posts_iris-block-related-posts-mode\",\"iris-block-related-posts-background\":\"bg-default\",\"_iris-block-related-posts-background\":\"field_iris-block-related-posts_iris-block-related-posts-background\",\"iris-block-related-posts-overtitle\":\"\",\"_iris-block-related-posts-overtitle\":\"field_iris-block-related-posts_iris-block-related-posts-overtitle\",\"iris-block-related-posts-title\":\"\",\"_iris-block-related-posts-title\":\"field_iris-block-related-posts_iris-block-related-posts-title\",\"iris-block-related-posts-content\":\"\",\"_iris-block-related-posts-content\":\"field_iris-block-related-posts_iris-block-related-posts-content\",\"iris-block-related-posts-type\":\"manual\",\"_iris-block-related-posts-type\":\"field_iris-block-related-posts_iris-block-related-posts-type\",\"iris-block-related-posts-type-manual\":[\"66417\",\"65906\",\"57612\"],\"_iris-block-related-posts-type-manual\":\"field_iris-block-related-posts_iris-block-related-posts-type-manual\",\"iris-block-related-posts-manual-orderby\":\"selection\",\"_iris-block-related-posts-manual-orderby\":\"field_iris-block-related-posts_iris-block-related-posts-manual-orderby\",\"iris-block-related-posts-posts-per-page\":\"\",\"_iris-block-related-posts-posts-per-page\":\"field_iris-block-related-posts_iris-block-related-posts-posts-per-page\",\"iris-block-related-posts-link\":\"\",\"_iris-block-related-posts-link\":\"field_iris-block-related-posts_iris-block-related-posts-link\",\"iris-block-related-posts-title-size\":\"\",\"_iris-block-related-posts-title-size\":\"field_iris-block-related-posts_iris-block-related-posts-title-size\"},\"align\":false,\"mode\":\"preview\"} /--\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ETo start the afternoon, head to \u003Cstrong\u003EPlace Rossetti, in the heart of Vieux-Nice,\u003C/strong\u003E to visit the magnificent, baroque \u003Cstrong\u003Ecathedral of Sainte-Raparate,\u003C/strong\u003E not forgetting to treat yourself to a delicious home-made ice-cream in one of the many stalls adjoining the square. Lose yourself in the narrow streets of Vieux-Nice until you find \u003Cstrong\u003EPlace Garibaldi\u003C/strong\u003E and its superb trompe l'oeil. You can then reach \u003Cstrong\u003Ethe\u003C/strong\u003E \u003Cstrong\u003EPlace Mass\u00e9na\u003C/strong\u003E by strolling along \u003Cstrong\u003Ethe Promenade du Paillon\u003C/strong\u003E, the city's green lung. In the square, admire the perfect harmony between the pastel-coloured fa\u00e7ades and the modernism of \u003Cem\u003EConversation\u003C/em\u003E, the aerial work by Catalan artist Jaume Plensa. After a snack or refreshment on the terrace of one of the square's caf\u00e9s, it's time to indulge in some \u003Cstrong\u003Eshopping in the Carr\u00e9 d'Or boutiques\u003C/strong\u003E or on the majestic \u003Cstrong\u003EAvenue Jean-M\u00e9decin,\u003C/strong\u003E starting with the famous \u003Cstrong\u003EGaleries Lafayette\u003C/strong\u003E before making your way to \u003Cstrong\u003ENicetoile\u003C/strong\u003E. The day can end where it began, by the sea. And why not enjoy a romantic moonlit dinner on one of the many private beaches along the Promenade des Anglais?\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:acf/iris-block-related-posts {\"name\":\"acf/iris-block-related-posts\",\"data\":{\"iris-block-related-posts-mode\":\"slider\",\"_iris-block-related-posts-mode\":\"field_iris-block-related-posts_iris-block-related-posts-mode\",\"iris-block-related-posts-background\":\"bg-default\",\"_iris-block-related-posts-background\":\"field_iris-block-related-posts_iris-block-related-posts-background\",\"iris-block-related-posts-overtitle\":\"\",\"_iris-block-related-posts-overtitle\":\"field_iris-block-related-posts_iris-block-related-posts-overtitle\",\"iris-block-related-posts-title\":\"\",\"_iris-block-related-posts-title\":\"field_iris-block-related-posts_iris-block-related-posts-title\",\"iris-block-related-posts-content\":\"\",\"_iris-block-related-posts-content\":\"field_iris-block-related-posts_iris-block-related-posts-content\",\"iris-block-related-posts-type\":\"manual\",\"_iris-block-related-posts-type\":\"field_iris-block-related-posts_iris-block-related-posts-type\",\"iris-block-related-posts-type-manual\":[\"65933\",\"65841\",\"65930\",\"65932\",\"65894\",\"63223\",\"63264\",\"57661\"],\"_iris-block-related-posts-type-manual\":\"field_iris-block-related-posts_iris-block-related-posts-type-manual\",\"iris-block-related-posts-manual-orderby\":\"selection\",\"_iris-block-related-posts-manual-orderby\":\"field_iris-block-related-posts_iris-block-related-posts-manual-orderby\",\"iris-block-related-posts-posts-per-page\":\"\",\"_iris-block-related-posts-posts-per-page\":\"field_iris-block-related-posts_iris-block-related-posts-posts-per-page\",\"iris-block-related-posts-link\":\"\",\"_iris-block-related-posts-link\":\"field_iris-block-related-posts_iris-block-related-posts-link\",\"iris-block-related-posts-title-size\":\"\",\"_iris-block-related-posts-title-size\":\"field_iris-block-related-posts_iris-block-related-posts-title-size\"},\"align\":false,\"mode\":\"preview\"} /--\u003E\n\n\u003C!-- wp:heading --\u003E\n\u003Ch2 class=\"wp-block-heading\"\u003EDay 2: Nice's heritage, from the port to the Cimiez gardens\u003C/h2\u003E\n\u003C!-- /wp:heading --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EIf you're able to spend at least two days in Nice, take the Nice in 24 hours programme for your first day... and let us guide you! To start day 2, head for the \u003Cstrong\u003EPort Lympia\u003C/strong\u003E. Start your stroll by the \u003Cstrong\u003EQuai Infernet\u003C/strong\u003E and the city's spectacular Monument aux Morts. Then follow the \u003Cstrong\u003EQuai Lunel\u003C/strong\u003E, where you can visit the local fishermen and their stalls selling fresh fish from the day's catch. Past the \u003Cstrong\u003EQuai Papacino\u003C/strong\u003E (with its luxury yachts) and the \u003Cstrong\u003EQuai Cassini\u003C/strong\u003E (take a look at the Church of the Port) - in summer, you can cross the harbour on board Lou Passagin (free of charge) - let yourself be charmed, on the opposite side of the basin, by the shimmering colours of the Pointus, the small wooden boats that are the pride of Nice. On the way back, admire the multicoloured facades of the buildings surrounding the port. Stop off in the antiques district.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EHead for \u003Cstrong\u003ERauba Capeu\u003C/strong\u003E to return to the Promenade des Anglais. Take in the panoramic view over the city, and don't forget the souvenir photo against the backdrop of the Baie des Anges, the most photographed spot in the city! \u003Cstrong\u003EYou're in the UNESCO area.\u003C/strong\u003E To find out more, stop off at the \u003Cstrong\u003EWorld Heritage Centre\u003C/strong\u003E at Les Ponchettes and take a trip back to the end of the 19th century, when aristocrats from all over Europe took up winter residence in one of the Belle Epoque hotels on the Promenade des Anglais. You can also join the \u201cQuand Nice invente la Riviera\u201d guided tour, offered by the Centre du Patrimoine de Nice, and explore the UNESCO-listed districts that shaped the history of the French Riviera as a renowned winter resort. \u003Cstrong\u003EPalais de la M\u00e9diterran\u00e9e, H\u00f4tel Westminster, Le Negresco,\u003C/strong\u003E so many legendary establishments, most of which have been awarded the \u003Cem\u003ENice Historic Hotel\u003C/em\u003E label.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ETo round off your morning, make sure you visit the \u003Cstrong\u003EMass\u00e9na Museum\u003C/strong\u003E, dedicated to the history and art of the city from the 18th century to the Belle \u00c9poque. Time for a bite to eat. Have lunch on a private beach, or enjoy a slice of pissaladi\u00e8re or a succulent pan bagnat on the pebbles...\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:acf/iris-block-related-posts {\"name\":\"acf/iris-block-related-posts\",\"data\":{\"iris-block-related-posts-mode\":\"slider\",\"_iris-block-related-posts-mode\":\"field_iris-block-related-posts_iris-block-related-posts-mode\",\"iris-block-related-posts-background\":\"bg-default\",\"_iris-block-related-posts-background\":\"field_iris-block-related-posts_iris-block-related-posts-background\",\"iris-block-related-posts-overtitle\":\"\",\"_iris-block-related-posts-overtitle\":\"field_iris-block-related-posts_iris-block-related-posts-overtitle\",\"iris-block-related-posts-title\":\"\",\"_iris-block-related-posts-title\":\"field_iris-block-related-posts_iris-block-related-posts-title\",\"iris-block-related-posts-content\":\"\",\"_iris-block-related-posts-content\":\"field_iris-block-related-posts_iris-block-related-posts-content\",\"iris-block-related-posts-type\":\"manual\",\"_iris-block-related-posts-type\":\"field_iris-block-related-posts_iris-block-related-posts-type\",\"iris-block-related-posts-type-manual\":[\"66196\",\"65924\",\"65947\",\"66226\",\"66407\",\"65940\",\"66090\",\"65938\",\"65845\"],\"_iris-block-related-posts-type-manual\":\"field_iris-block-related-posts_iris-block-related-posts-type-manual\",\"iris-block-related-posts-manual-orderby\":\"selection\",\"_iris-block-related-posts-manual-orderby\":\"field_iris-block-related-posts_iris-block-related-posts-manual-orderby\",\"iris-block-related-posts-posts-per-page\":\"\",\"_iris-block-related-posts-posts-per-page\":\"field_iris-block-related-posts_iris-block-related-posts-posts-per-page\",\"iris-block-related-posts-link\":\"\",\"_iris-block-related-posts-link\":\"field_iris-block-related-posts_iris-block-related-posts-link\",\"iris-block-related-posts-title-size\":\"\",\"_iris-block-related-posts-title-size\":\"field_iris-block-related-posts_iris-block-related-posts-title-size\"},\"align\":false,\"mode\":\"preview\"} /--\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EThen take a step back in time. Head for the elegant \u003Cstrong\u003ECimiez district\u003C/strong\u003E, where you'll discover \u003Cstrong\u003Ethe former Hotel Regina\u003C/strong\u003E, specially built for Queen Victoria, followed by \u003Cstrong\u003Ea visit to the Monastery and its gardens\u003C/strong\u003E. Next stop is the \u003Cstrong\u003ENice Archaeological Museum\u003C/strong\u003E, with a stroll through the remains of the Roman arena, before finishing the afternoon with a \u003Cstrong\u003Evisit to the Matisse Museum or the Marc Chagall National Museum\u003C/strong\u003E, both located in the district.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EAt aperitif time, climb onto one of the \u003Cstrong\u003Ecity'\u003C/strong\u003Es many \u003Cstrong\u003Erooftops\u003C/strong\u003E to admire the sunset. Why not continue the evening in one of the restaurants in the Garibaldi district, then in the festive atmosphere of rue Bonaparte and Place du Pin, the Mecca of Nice nightlife.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:acf/iris-block-related-posts {\"name\":\"acf/iris-block-related-posts\",\"data\":{\"iris-block-related-posts-mode\":\"slider\",\"_iris-block-related-posts-mode\":\"field_iris-block-related-posts_iris-block-related-posts-mode\",\"iris-block-related-posts-background\":\"bg-default\",\"_iris-block-related-posts-background\":\"field_iris-block-related-posts_iris-block-related-posts-background\",\"iris-block-related-posts-overtitle\":\"\",\"_iris-block-related-posts-overtitle\":\"field_iris-block-related-posts_iris-block-related-posts-overtitle\",\"iris-block-related-posts-title\":\"\",\"_iris-block-related-posts-title\":\"field_iris-block-related-posts_iris-block-related-posts-title\",\"iris-block-related-posts-content\":\"\",\"_iris-block-related-posts-content\":\"field_iris-block-related-posts_iris-block-related-posts-content\",\"iris-block-related-posts-type\":\"manual\",\"_iris-block-related-posts-type\":\"field_iris-block-related-posts_iris-block-related-posts-type\",\"iris-block-related-posts-type-manual\":[\"65919\",\"65838\",\"65844\",\"65839\",\"65850\",\"57682\"],\"_iris-block-related-posts-type-manual\":\"field_iris-block-related-posts_iris-block-related-posts-type-manual\",\"iris-block-related-posts-manual-orderby\":\"selection\",\"_iris-block-related-posts-manual-orderby\":\"field_iris-block-related-posts_iris-block-related-posts-manual-orderby\",\"iris-block-related-posts-posts-per-page\":\"\",\"_iris-block-related-posts-posts-per-page\":\"field_iris-block-related-posts_iris-block-related-posts-posts-per-page\",\"iris-block-related-posts-link\":\"\",\"_iris-block-related-posts-link\":\"field_iris-block-related-posts_iris-block-related-posts-link\",\"iris-block-related-posts-title-size\":\"\",\"_iris-block-related-posts-title-size\":\"field_iris-block-related-posts_iris-block-related-posts-title-size\"},\"align\":false,\"mode\":\"preview\"} /--\u003E\n\n\u003C!-- wp:heading --\u003E\n\u003Ch2 class=\"wp-block-heading\"\u003EDay 3: sea air and a break in the vineyards\u003C/h2\u003E\n\u003C!-- /wp:heading --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EVisiting Nice in three days means enjoying the pleasure of wandering around as you please, while soaking up its unique atmosphere, where the charm of tradition blends harmoniously with the modernism of this great metropolis. To the programme for the first two days, why not add on day 3 \u003Cstrong\u003Ea sea trip on a coastal boat to Villefranche-sur-Mer\u003C/strong\u003E. If you prefer to walk, take \u003Cstrong\u003Ethe sublime coastal path linking the Cap de Nice to the divine harbour of Villefranche\u003C/strong\u003E, where the turquoise waters compete with the shimmering colours of the houses of this town with its feet in the water. On your return (on foot, by bus or by train), treat yourself to a lunch of fish or shellfish at the Port Lympia to enjoy the bustle of this ever-changing district.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EIn the afternoon, if you have a car, head off to \u003Cstrong\u003Ediscover a wine estate on the Bellet hill \u003C/strong\u003Eand taste one of the delicious vintages of this sun-drenched PDO. On your return to town, take advantage of the many shops and \u003Cstrong\u003Estroll through the pedestrian zone\u003C/strong\u003E, where you can dine and enjoy the cosmopolitan atmosphere of the area.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:acf/iris-block-related-posts {\"name\":\"acf/iris-block-related-posts\",\"data\":{\"iris-block-related-posts-mode\":\"slider\",\"_iris-block-related-posts-mode\":\"field_iris-block-related-posts_iris-block-related-posts-mode\",\"iris-block-related-posts-background\":\"bg-default\",\"_iris-block-related-posts-background\":\"field_iris-block-related-posts_iris-block-related-posts-background\",\"iris-block-related-posts-overtitle\":\"\",\"_iris-block-related-posts-overtitle\":\"field_iris-block-related-posts_iris-block-related-posts-overtitle\",\"iris-block-related-posts-title\":\"\",\"_iris-block-related-posts-title\":\"field_iris-block-related-posts_iris-block-related-posts-title\",\"iris-block-related-posts-content\":\"\",\"_iris-block-related-posts-content\":\"field_iris-block-related-posts_iris-block-related-posts-content\",\"iris-block-related-posts-type\":\"manual\",\"_iris-block-related-posts-type\":\"field_iris-block-related-posts_iris-block-related-posts-type\",\"iris-block-related-posts-type-manual\":[\"57553\",\"65599\",\"58145\"],\"_iris-block-related-posts-type-manual\":\"field_iris-block-related-posts_iris-block-related-posts-type-manual\",\"iris-block-related-posts-manual-orderby\":\"selection\",\"_iris-block-related-posts-manual-orderby\":\"field_iris-block-related-posts_iris-block-related-posts-manual-orderby\",\"iris-block-related-posts-posts-per-page\":\"\",\"_iris-block-related-posts-posts-per-page\":\"field_iris-block-related-posts_iris-block-related-posts-posts-per-page\",\"iris-block-related-posts-link\":\"\",\"_iris-block-related-posts-link\":\"field_iris-block-related-posts_iris-block-related-posts-link\",\"iris-block-related-posts-title-size\":\"\",\"_iris-block-related-posts-title-size\":\"field_iris-block-related-posts_iris-block-related-posts-title-size\"},\"align\":false,\"mode\":\"preview\"} /--\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EYou can, of course, personalise this 3rd day to suit your own wishes.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:list --\u003E\n\u003Cul class=\"wp-block-list\"\u003E\u003C!-- wp:list-item --\u003E\n\u003Cli\u003E\u003Cstrong\u003EFor more authenticity:\u003C/strong\u003E the Lib\u00e9ration market, the former Gare du Sud station and its listed fa\u00e7ade await you. \u003C/li\u003E\n\u003C!-- /wp:list-item --\u003E\n\n\u003C!-- wp:list-item --\u003E\n\u003Cli\u003E\u003Cstrong\u003EFor the more sporty and nature lovers:\u003C/strong\u003E take a walk to Cap de Nice and climb Mont Boron, where you'll enjoy a sublime view of Nice and the harbour of Villefranche-sur-Mer.\u003C/li\u003E\n\u003C!-- /wp:list-item --\u003E\n\n\u003C!-- wp:list-item --\u003E\n\u003Cli\u003E\u003Cstrong\u003EFor culture and heritage buffs: \u003C/strong\u003Eopt for one of the guided tours offered by the Centre du Patrimoine, discover the Palais Lascaris in Vieux-Nice, climb to the top of the Tour Saint-Fran\u00e7ois, or delve into the heart of Nice's Baroque heritage. \u003C/li\u003E\n\u003C!-- /wp:list-item --\u003E\n\n\u003C!-- wp:list-item --\u003E\n\u003Cli\u003E\u003Cstrong\u003EFor families:\u003C/strong\u003E the Phoenix Park is a must, with its lush greenhouses and numerous animals. For an even more adventurous experience, there's a rope park for children aged 3 and over, as well as a thrill-seeking park for older children.\u003C/li\u003E\n\u003C!-- /wp:list-item --\u003E\u003C/ul\u003E\n\u003C!-- /wp:list --\u003E\n\n\u003C!-- wp:acf/iris-block-related-posts {\"name\":\"acf/iris-block-related-posts\",\"data\":{\"iris-block-related-posts-mode\":\"slider\",\"_iris-block-related-posts-mode\":\"field_iris-block-related-posts_iris-block-related-posts-mode\",\"iris-block-related-posts-background\":\"bg-default\",\"_iris-block-related-posts-background\":\"field_iris-block-related-posts_iris-block-related-posts-background\",\"iris-block-related-posts-overtitle\":\"\",\"_iris-block-related-posts-overtitle\":\"field_iris-block-related-posts_iris-block-related-posts-overtitle\",\"iris-block-related-posts-title\":\"\",\"_iris-block-related-posts-title\":\"field_iris-block-related-posts_iris-block-related-posts-title\",\"iris-block-related-posts-content\":\"\",\"_iris-block-related-posts-content\":\"field_iris-block-related-posts_iris-block-related-posts-content\",\"iris-block-related-posts-type\":\"manual\",\"_iris-block-related-posts-type\":\"field_iris-block-related-posts_iris-block-related-posts-type\",\"iris-block-related-posts-type-manual\":[\"63988\",\"66116\",\"80428\",\"66226\",\"65827\",\"65862\"],\"_iris-block-related-posts-type-manual\":\"field_iris-block-related-posts_iris-block-related-posts-type-manual\",\"iris-block-related-posts-manual-orderby\":\"selection\",\"_iris-block-related-posts-manual-orderby\":\"field_iris-block-related-posts_iris-block-related-posts-manual-orderby\",\"iris-block-related-posts-posts-per-page\":\"\",\"_iris-block-related-posts-posts-per-page\":\"field_iris-block-related-posts_iris-block-related-posts-posts-per-page\",\"iris-block-related-posts-link\":\"\",\"_iris-block-related-posts-link\":\"field_iris-block-related-posts_iris-block-related-posts-link\",\"iris-block-related-posts-title-size\":\"\",\"_iris-block-related-posts-title-size\":\"field_iris-block-related-posts_iris-block-related-posts-title-size\"},\"align\":false,\"mode\":\"preview\"} /--\u003E\n\n\u003C!-- wp:separator --\u003E\n\u003Chr class=\"wp-block-separator has-alpha-channel-opacity\"/\u003E\n\u003C!-- /wp:separator --\u003E\n\n\u003C!-- wp:heading --\u003E\n\u003Ch2 class=\"wp-block-heading\"\u003EFind all the points of interest on the map\u003C/h2\u003E\n\u003C!-- /wp:heading --\u003E\n\n\u003C!-- wp:wp-etourisme-v3/list-sit {\"mode\":\"search\",\"display\":\"map\",\"idlist\":\"6a019aaf6fe0ec0959eeb807\",\"idsearch\":\"6a019b9123dbba526ec2dbf0\",\"lock\":{\"move\":true,\"remove\":false}} /--\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003E\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E","post_title":"What to do in Nice in 1, 2 or 3 days?","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"what-to-do-in-nice","to_ping":"","pinged":"","post_modified":"2026-08-06 11:49:01","post_modified_gmt":"2026-08-06 09:49:01","post_content_filtered":"","post_parent":60321,"guid":"https://www.explorenicecotedazur.com/?page_id=81635","menu_order":0,"post_type":"page","post_mime_type":"","comment_count":"0","filter":"raw"},"themeUrl":"https://www.explor