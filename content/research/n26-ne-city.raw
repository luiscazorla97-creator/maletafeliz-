webp\",\"Width\":571,\"Height\":600,\"Format\":\"preview\"}],\"Title\":\"Beth and Nick VICTUS credit NelsonTasmanNZ\",\"Caption\":null,\"Credits\":null},\"Link\":\"/explore/features/nicks-top-picks-for-nelson\",\"IsHero\":false}],\"displaySettings\":{\"showIntroText\":false,\"startsWith\":null,\"noOffset\":false,\"noSlide\":false,\"inContainer\":false,\"indentation\":null},\"isDarkBackground\":false}]]}]}]}]}]]}]\n"])</script><script>self.__next_f.push([1,"39:[\"$\",\"$1\",\"1293\",{\"children\":[false,[\"$\",\"div\",null,{\"className\":\"ElementContent\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative\",\"children\":[\"$\",\"div\",null,{\"className\":\"container pt-6 md:pt-12 lg:pt-16 pb-6 md:pb-12 lg:pb-20\",\"children\":[\"$\",\"div\",null,{\"className\":\"flex flex-wrap text-start justify-between max-w-none prose lg:prose-lg xl:prose-xl\",\"children\":[[\"$\",\"h3\",null,{\"className\":\"w-full !text-xl lg:!leading-9 xl:w-1/4 shrink-0\",\"children\":\"Food, art and a creative spirit keep Nelson buzzing year round\"}],[\"$\",\"div\",null,{\"className\":\"w-full max-w-none justify-end text-start empty:hidden xl:w-2/3 [\u0026\u003e*:first-child]:!mt-0\",\"children\":[null,[[\"$\",\"p\",\"0\",{\"children\":[\"Alfresco dining spills onto city streets, waterfront restaurants make the most of the setting, and \",[\"$\",\"a\",\"1\",{\"href\":\"/explore/features/magical-markets\",\"children\":\"markets\"}],\", \",[\"$\",\"a\",\"3\",{\"href\":\"/explore/eat-and-drink/breweries\",\"children\":\"breweries \"}],\"and tucked-away eateries give Nelson plenty of flavour. Add a lively calendar of events and \",[\"$\",\"a\",\"5\",{\"href\":\"/explore/features/listen-to-the-music\",\"children\":\"live music\"}],\", and there’s always something happening. Seek out local brews on Collingwood Street, wander the stalls and eateries of \",[\"$\",\"a\",\"7\",{\"href\":\"/eat-drink/kirby-lane\",\"children\":\"Kirby Lane\"}],\", or settle in somewhere sunny and watch the city go by.\"]}],\"\\n\",[\"$\",\"p\",\"2\",{\"children\":[\"Creativity runs deep here too. Nelson has a long-standing artistic legacy and a thriving community of artists, makers, galleries and performers. Three of the city’s cultural treasures — \",[\"$\",\"a\",\"1\",{\"rel\":\"noopener noreferrer\",\"href\":\"https://thesuter.org.nz/\",\"target\":\"_blank\",\"children\":\"The Suter Art Gallery\"}],\", \",[\"$\",\"a\",\"3\",{\"rel\":\"noopener noreferrer\",\"href\":\"https://www.theatreroyalnelson.co.nz/\",\"target\":\"_blank\",\"children\":\"Theatre Royal Nelson\"}],\" and the \",[\"$\",\"a\",\"5\",{\"rel\":\"noopener noreferrer\",\"href\":\"https://ncma.nz/\",\"target\":\"_blank\",\"children\":\"Nelson Centre of Musical Arts\"}],\" — put art, theatre and music right at the heart of the city, alongside independent galleries, studios and creative spaces that are well worth seeking out.\"]}]]]}]]}]}]}]}]}]]}]\n"])</script><script>self.__next_f.push([1,"3a:[\"$\",\"$1\",\"4861\",{\"children\":[false,[\"$\",\"div\",null,{\"className\":\"ElementalImageGrid\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative\",\"children\":[\"$\",\"div\",null,{\"className\":\"relative\",\"children\":[\"$\",\"div\",null,{\"className\":\"pt-6 pb-6\",\"children\":[[\"$\",\"div\",null,{\"className\":\"container py-12 empty:hidden\",\"children\":null}],[\"$\",\"$L2a\",null,{\"pages\":[{\"ID\":4320,\"Image\":{\"ID\":4320,\"BlurData\":\"U~DT;X%MoJtSyskrWBo~pyT0R*kX*0tRaeo}\",\"FocusPercentageX\":35,\"FocusPercentageY\":57,\"Formats\":[{\"ID\":4320,\"Url\":\"https://backend.nelsontasman.nz/assets/Hero/Explore/nz-mtb-rally-2026/NZ-MTB-RALLY-2026-DAY-6-Nelson-Koata-Park-Mikhail-Huggins__FocusFillMaxWyItMC4zMSIsIjAuMTUiLDEyMDAsNjMwXQ.jpg\",\"WebPUrl\":\"https://backend.nelsontasman.nz/assets/Hero/Explore/nz-mtb-rally-2026/NZ-MTB-RALLY-2026-DAY-6-Nelson-Koata-Park-Mikhail-Huggins__FocusFillMaxWyItMC4zMSIsIjAuMTUiLDEyMDAsNjMwXQ_ExtRewri