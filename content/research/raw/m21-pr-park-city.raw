<div id="calendari_lateral1" data-date="22/11/2026"></div>

<script>
    $(document).ready(function () {

        var culture = 'it-IT';
        var theMonths;
        var thDays;
        switch (culture) {
            case 'en-US':
                theMonths = ["January", "February", "March", "April", "May", "June", "July", "August", "September", "October","November","December"];
                theDays = ["Su", "Mo", "Tu", "We", "Th", "Fr", "Sa"];
                break;
            default:
                theMonths = ["Gennaio", "Febbraio", "Marzo", "Aprile", "Maggio", "Giugno", "Luglio", "Agosto", "Settembre", "Ottobre", "Novembre", "Dicembre"];
                theDays = ["Do", "Lu", "Ma", "Me", "Gi", "Ve", "Sa"];
                break;

        }

        $('#calendari_lateral1').calendar({
            months: theMonths,
            days: theDays,
            events: [{}],
            popover_options: { placement: 'top' },
            req_ajax: {
                type: 'get',
                url: '/handlers/CalendarFeed.ashx?Culture=it-IT'
            }
        });
    });
</script>
