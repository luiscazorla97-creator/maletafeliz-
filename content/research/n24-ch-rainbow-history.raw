SLANDS, U.S.","COUNTRYID":219},{"STATES":"&#x1F;**&#x1F;** - **","COUNTRYNAME":"Wales","COUNTRYID":226},{"STATES":"&#x1F;**&#x1F;** - **","COUNTRYNAME":"WALLIS AND FUTUNA","COUNTRYID":227},{"STATES":"&#x1F;**&#x1F;** - **","COUNTRYNAME":"WESTERN SAHARA","COUNTRYID":246},{"STATES":"&#x1F;**&#x1F;** - **","COUNTRYNAME":"Yap","COUNTRYID":229},{"STATES":"&#x1F;**&#x1F;** - **","COUNTRYNAME":"YEMEN","COUNTRYID":247},{"STATES":"&#x1F;**&#x1F;** - **","COUNTRYNAME":"Zaire","COUNTRYID":231},{"STATES":"&#x1F;**&#x1F;** - **","COUNTRYNAME":"ZAMBIA","COUNTRYID":232},{"STATES":"&#x1F;**&#x1F;** - **","COUNTRYNAME":"ZIMBABWE","COUNTRYID":233}];


[...document.querySelectorAll('[name=contact_country]')].forEach( e => {countryChanged(e)} );
function countryChanged(domElm){
	
    var state = domElm.form.querySelector('[name=contact_state]');
	var oldSelIndexVal = state.value;  //$F('contact_state');
	var myStates = new Array();

	 // $('contact_state').options.length = 0;
	state.options.length = 0;

	for (var i = 0; i < window.states.length; i++) {
		if (window.states[i].COUNTRYNAME == domElm.options[domElm.selectedIndex].value || window.states[i].COUNTRYNAME == '') {
			var myObj = new Object();

			var tmp = window.states[i].STATES.split('&#x1F;');
			for (var x = 0; x < tmp.length; x = x + 2) {
				var myObj = new Object();
				myObj.statecode = tmp[x - 1];
				myObj.statename = tmp[x];
				if (tmp[x - 1] == oldSelIndexVal) {
					myObj.selected = true;
				} else {
					myObj.selected = false;
				}

				if(!myObj.statecode){
					myObj.statecode = '';
				}
				myStates.push(myObj);
			}
		}
	}

	if (myStates.length > 0) {
		for (var i = 0; i < myStates.length; i++) {
			 // $('contact_state').options[$('state').options.length] = new Option(myStates[i].statename, myStates[i].statecode, myStates[i].selected, myStates[i].selected);
			 state.options[state.options.length] = new Option(myStates[i].statename, myStates[i].statecode, myStates[i].selected, myStates[i].selected);

		}
	} else {
		// $('contact_state').options.length = 0;
		state.options.length = 0;
		//$('contact_state').options[$('contact_state').options.length] = new Option("** - **", "");
		state.options[state.options.length] = new Option("** - **", "");
	}
}
</script>
    <button class="close-button" data-close aria-label="Close modal" type="button"><span aria-hidden="true">&times;</span></button>
</div><!-- .visitors-guide-modal -->

<div class="reveal visitors-guide-modal digital-visitors-guide-modal" id="digital-visitors-guide-modal" data-reveal data-swiftype-index="false">
  <div class="vguide">
	<h2 class="vguide__header">Request a Digital Visitors Guide</h2>
	<ul class="vguide__timeline">
		<li class="vguide__step vguide__step--1">About You</li>
		<li class="vguide__step vguide__step--2">Visit Details</li>
	</ul>
	<form  id="dvgm-visitors-guide" action="https://charleston.simpleviewcrm.com/webapi/forms/sendform.cfm" class="visitor-guide" method="post" id="dvgm-frm_21" name="frm_21">
		<input id="dvgm-formid" name="formid" type="hidden" value="21">
		<input id="dvgm-groupid" name="groupid" type="hidden" value="5">
		<input type="hidden" name="savefrm" value="Submit">
		<input id="dvgm-code_key" name="code_key" type="hidden" value="rO0ABXQABGdmcGU=">
		<input type="hidden" name="code" value="skip">
		<div class="visitor-guide__box">
			<div id="dvgm-guide-step-1" class="visitor-guide__step">
				<div class="visitor-guide__beside">
					<div class="visitor-guide__img">
						<img src="/assets/images/visitors-guide.jpg?v=24" />
					</div>
					<div class="visitor-guide__main">
						<!-- Name -->
						<div class="visitor-guide__half">
							<div class="text-field">
								<label for="dvgm-contact_fname">First Name</label>
								<input type="text" name="contact_fname" id="dvgm-contact_fname" data-parsley-required="true">
							</div>
							<div class="text-field">
								<label for="dvgm-contact_lname">Last Name</label>
								<input type="text" name="contact_lname" id="dvgm-contact_lname" data-parsley-required="true">
							</div>
						</div>

						<div class="visitor-guide__half">
							<div class="text-field">
								<label for="dvgm-contact_email">Email</label>
								<input type="email"
								       name="contact_email"
								       id="dvgm-contact_email"
								       required
								       data-parsley-required-message="Please enter your email address"
								       data-parsley-type-message="Please enter a valid email address" />
							</div>
							<div class="text-field">
								<label for="dvgm-contact_phone">Phone Number</label>
								<input placeholder="(xxx) xxx-xxxx"
								       data-parsley-pattern="^\(\d{3}\) \d{3}-\d{4}$"
								       data-parsley-error-message="Phone must be formatted as (xxx) xxx-xxxx"
								       data-parsley-required-message="Phone number is required" id="dvgm-contact_phone" name="contact_phone" type="text" maxlength="40" size="25" value="" onblur="fmtPhone(this,'(xxx) xxx-xxxx');">
							</div>
						</div>


						<div class="visitor-guide__half">
							<div class="text-field">
								<label id="dvgm-label_contact_sendemail" class="sv_api_label">Would you like to receive e-mail updates about deals and events in Charleston:</label>
								<fieldset style="border:0px;" role="group" aria-labelledby="dvgm-label_contact_sendemail" >
									<legend style="display:none;">contact_sendemail</legend>
									<input class="sv_api_radio" id="dvgm-contact_sendemail_1" name="contact_sendemail" type="radio" value="1" data-form-type="other"><label class="sv_api_label sv_api_field_required" for="dvgm-contact_sendemail_1"> Yes </label>
									<input class="sv_api_radio" id="dvgm-contact_sendemail_0" name="contact_sendemail" type="radio" value="0" data-form-type="other"><label class="sv_api_label sv_api_field_required" for="dvgm-contact_sendemail_0"> No </label>
								</fieldset>
							</div>
							<div class="text-field">
								<label id="dvgm-label_udf_544" class="sv_api_label">May we send you offers from our partners:</label>
								<fieldset style="border:0px;" role="group" aria-labelledby="dvgm-label_udf_544" >
									<legend style="display:none;">udf_544</legend>
									<input class="sv_api_radio" id="dvgm-udf_544_1" name="udf_544" type="radio" value="1" data-form-type="other">
									<label class="sv_api_label sv_api_field_required" for="dvgm-udf_544_1"> Yes </label>
									<input class="sv_api_radio" id="dvgm-udf_544_0" name="udf_544" type="radio" value="0" data-form-type="other">
									<label class="sv_api_label sv_api_field_required" for="dvgm-udf_544_0"> No </label>
								</fieldset>
							</div>
						</div>
						<div class="visitor-guide__half">
							<div class="text-field">
								<label for="dvgm-udf_449" id="dvgm-label_udf_449" class="sv_api_label">Start Visit Date:</label>
								<input class="sv_api_input" id="dvgm-udf_449" name="udf_449" type="text" maxlength="10" size="8" value="" onblur="fmtDate(this, '/'); " data-form-type="other">
							</div>
							<div class="text-field">
								<label for="dvgm-udf_451" id="dvgm-label_udf_451" class="sv_api_label">End Visit Date:</label>
								<input class="sv_api_input" id="dvgm-udf_451" name="udf_451" type="text" maxlength="10" size="8" value="" onblur="fmtDate(this, '/'); " data-form-type="other">
							</div>
						</div>
					</div>
				</div>
			</div>
			<div id="dvgm-guide-step-2" class="visitor-guide__step">

				<div class="field">
					<label id="dvgm-label_inquiry_interest" class="sv_api_label">Interests:</label>
                    <fieldset style="border:0px;" role="group" aria-labelledby="dvgm-label_inquiry_interest" >
                        <input class="sv_api_chkbox" id="dvgm-inquiry_interest_14" name="inquiry_interest" type="checkbox" value="14" data-parsley-multiple="inquiry_interest"><label class="label-checkbox " for="dvgm-inquiry_interest_14"> African American Interests </label><br>

                        <input class="sv_api_chkbox" id="dvgm-inquiry_interest_13" name="inquiry_interest" type="checkbox" value="13" data-parsley-multiple="inquiry_interest"><label class="label-checkbox " for="dvgm-inquiry_interest_13"> Arts/ Culture </label><br>

                        <input class="sv_api_chkbox" id="dvgm-inquiry_interest_15" name="inquiry_interest" type="checkbox" value="15" data-parsley-multiple="inquiry_interest"><label class="label-checkbox " for="dvgm-inquiry_interest_15"> Attractions &amp; Tours </label><br>

                        <input class="sv_api_chkbox" id="dvgm-inquiry_interest_20" name="inquiry_interest" type="checkbox" value="20" data-parsley-multiple="inquiry_interest"><label class="label-checkbox " for="dvgm-inquiry_interest_20"> Beach Rentals </label><br>

