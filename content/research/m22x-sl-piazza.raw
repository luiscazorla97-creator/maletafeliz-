					panel.querySelectorAll('.salerno-map-multi__container.leaflet-container').forEach(function(el) {
						if (el._leaflet_map && el._leaflet_map.invalidateSize) {
							el._leaflet_map.invalidateSize();
						}
					});
				}, 120);
			});
		});
	}
	function init() {
		hideEmptyGutenverseOverlays();
		hideEmptyEventoEdizioniBlocks(document);
		document.querySelectorAll('.gutena-tabs-block').forEach(initBlock);
		initGutenverseHideableTabs(document);
	}
	document.addEventListener('salerno-async-shortcode-loaded', init);
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', init);
	} else {
		init();
	}
	window.addEventListener('load', init);
})();
</script>
	<script>
(function(){
	if (!document.querySelector('.gutena-tabs-block, .salerno-mobilita-info__tabwrap')) return;
	function makeArrow(dir) {
		var btn = document.createElement('span');
		btn.className = 'salerno-tabs-arrow salerno-tabs-arrow--' + dir;
		btn.setAttribute('aria-hidden', 'true');
		btn.innerHTML = dir === 'prev'
			? '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 5l-7 7 7 7"/></svg>'
			: '<svg viewBox="0 0 24 24" aria-hidden="true"><path d="M9 5l7 7-7 7"/></svg>';
		return btn;
	}

	function setup(block) {
		var list = block.querySelector(':scope > .gutena-tabs-tab, :scope > .salerno-mobilita-info__tabs');
		if (!list) return;
		if (block._salernoScrollHint) {
			block._salernoScrollHint();
			return;
		}

		var prev = makeArrow('prev');
		var next = makeArrow('next');
		block.appendChild(prev);
		block.appendChild(next);

		var FADE = 56;
		// Sfuma ogni tab nella parte che cade entro FADE px dal bordo da cui si può ancora scorrere.
		function fadeTabs(canPrev, canNext) {
			var box = list.getBoundingClientRect();
			Array.prototype.forEach.call(list.children, function(tab) {
				var r = tab.getBoundingClientRect();
				var inPrev = canPrev && r.left < box.left + FADE;
				var inNext = canNext && r.right > box.right - FADE;
				var mask = '';
				if (r.width && (inPrev || inNext)) {
					var p0 = inPrev ? box.left - r.left : -2;
					var p1 = inPrev ? box.left + FADE - r.left : -1;
					var p3 = inNext ? box.right - r.left : r.width + 2;
					var p2 = inNext ? Math.max(p1, box.right - FADE - r.left) : r.width + 1;
					mask = 'linear-gradient(to right, transparent ' + p0 + 'px, #000 ' + p1 + 'px, #000 ' + p2 + 'px, transparent ' + p3 + 'px)';
				}
				if (tab._salernoMask !== mask) {
					tab._salernoMask = mask;
					tab.style.webkitMaskImage = mask;
					tab.style.maskImage = mask;
				}
			});
		}

		var frame = 0;
		function update() {
			frame = 0;
			var max = list.scrollWidth - list.clientWidth;
			var overflow = max > 2;
			var canPrev = overflow && list.scrollLeft > 2;
			var canNext = overflow && list.scrollLeft < max - 2;
			block.classList.toggle('salerno-tabs-overflow', overflow);
			block.classList.toggle('salerno-tabs-can-prev', canPrev);
			block.classList.toggle('salerno-tabs-can-next', canNext);
			fadeTabs(canPrev, canNext);
			if (overflow) {
				block.style.setProperty('--salerno-tabs-arrow-top', (list.offsetTop + list.offsetHeight / 2) + 'px');
			}
		}
		function schedule() {
			if (!frame) frame = requestAnimationFrame(update);
		}
		block._salernoScrollHint = schedule;

		function touched() {
			block.classList.add('salerno-tabs-touched');
		}
		list.addEventListener('scroll', schedule, { passive: true });
		list.addEventListener('touchstart', touched, { passive: true });
		list.addEventListener('scroll', touched, { passive: true });
		list.addEventListener('click', touched);
		window.addEventListener('resize', schedule);
		if (window.ResizeObserver) {
			new ResizeObserver(schedule).observe(list);
		}
		// Le tab vuote vengono nascoste dopo (classe gutena-tab-title-is-empty): la larghezza del contenuto cambia.
		// Solo 'class': lo style delle tab lo scrive fadeTabs (osservarlo creerebbe un ciclo).
		if (window.MutationObserver) {
			new MutationObserver(schedule).observe(list, { attributes: true, attributeFilter: ['class'], subtree: true, childList: true });
		}
		update();
	}

	function init() {
		document.querySelectorAll('.gutena-tabs-block, .salerno-mobilita-info__tabwrap').forEach(setup);
	}
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', init);
	} else {
		init();
	}
	document.addEventListener('salerno-async-shortcode-loaded', init);
	window.addEventListener('load', init);
	// Ritorno con "indietro" (bfcache): la posizione di scorrimento può essere ripristinata senza eventi scroll.
	window.addEventListener('pageshow', init);
})();
</script>
	<script>
(function(){
	if (!document.querySelector('.gutena-tabs-block')) return;
	var HASH_RE = /^#tab-(.+)$/i;
	var userMoved = false;
	// Nomi equivalenti IT / EN / FR (slug) delle tab fisse dei template single-evento e single-luogo.
	var TAB_ALIASES = [
		['evento', 'event', 'evenement'],
		['luogo', 'place', 'lieu'],
		['data-orario', 'date-hours', 'date-heure'],
		['biglietti', 'tickets', 'billets'],
		['mappa', 'map', 'carte'],
		['eventi-collegati', 'related-events', 'evenements-connexes'],
		['edizioni', 'editions'],
		['programma', 'programme'],
		['descrizione', 'description'],
		['eventi', 'events', 'evenements'],
		['contatti', 'contacts'],
		['orari', 'opening-hours', 'horaires-d-ouverture'],
		['itinerari', 'itineraries', 'itineraires']
	];

	function slugify(text) {
		return (text || '').toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '').replace(/[^a-z0-9]+/g, '-').replace(/^-+|-+$/g, '');
	}
	function titleSlug(title) {
		var label = title.querySelector('.gutena-tab-title-text');
		return slugify((label || title).textContent);
	}
	function visibleTitles() {
		return Array.prototype.filter.call(
			document.querySelectorAll('.gutena-tabs-block .gutena-tabs-tab .gutena-tab-title'),
			function(t) { return !t.classList.contains('gutena-tab-title-is-empty'); }
		);
	}
	function findTitle(hash) {
		var m = HASH_RE.exec(hash || '');
		if (!m) return null;
		var key;
		try { key = decodeURIComponent(m[1]); } catch (e) { key = m[1]; }
		key = slugify(key);
		if (!key) return null;
		var titles = visibleTitles();
		var slugs = titles.map(titleSlug);
		var idx = slugs.indexOf(key);
		if (idx !== -1) return titles[idx];
		// Nome in un'altra lingua: cerca gli equivalenti tra i titoli della pagina.
		for (var a = 0; a < TAB_ALIASES.length; a++) {
			if (TAB_ALIASES[a].indexOf(key) === -1) continue;
			for (var i = 0; i < titles.length; i++) {
				if (TAB_ALIASES[a].indexOf(slugs[i]) !== -1) return titles[i];
			}
		}
		if (/^\d+$/.test(key)) {
			for (var j = 0; j < titles.length; j++) {
				if (titles[j].getAttribute('data-tab') === key) return titles[j];
			}
		}
		return null;
	}
	function scrollToTabs(title) {
		var block = title.closest('.gutena-tabs-block');
		if (!block) return;
		var top = block.getBoundingClientRect().top + window.pageYOffset - 16;
		window.scrollTo(0, Math.max(0, top));
	}
	// Clic "vero" sulla tab: passa dagli handler esistenti (plugin + frontend-ui: pannello, mappe, centratura).
	function openFromHash(scroll) {
		var title = findTitle(window.location.hash);
		if (!title) return false;
		if (!title.classList.contains('active')) title.click();
		if (scroll) {
			setTimeout(function() { scrollToTabs(title); }, 120);
		}
		return true;
	}

	function bindTitles() {
		document.querySelectorAll('.gutena-tabs-block .gutena-tabs-tab .gutena-tab-title').forEach(function(title) {
			if (title.getAttribute('data-salerno-deep-link') === '1') return;
			title.setAttribute('data-salerno-deep-link', '1');
			title.addEventListener('click', function() {
				if (title.classList.contains('gutena-tab-title-is-empty') || !window.history || !history.replaceState) return;
				var hash = '#tab-' + (titleSlug(title) || title.getAttribute('data-tab'));
				if (window.location.hash !== hash) {
					history.replaceState(history.state, '', window.location.pathname + window.location.search + hash);
				}
			});
		});
	}

	// Gutenverse (corefrontend.js) al load con hash fa scrollTo(0,0) e dopo 300ms cerca un elemento con quell'id:
	// lo scroll verso le tab va fatto dopo, altrimenti viene annullato.
	var AFTER_GUTENVERSE_MS = 400;
	var opened = false;
	function start() {
		bindTitles();
		opened = openFromHash(document.readyState === 'complete');
	}
	['wheel', 'touchmove', 'keydown'].forEach(function(type) {
		window.addEventListener(type, function() { userMoved = true; }, { passive: true, once: true });
	});
	if (document.readyState === 'loading') {
		document.addEventListener('DOMContentLoaded', start);
	} else {
		start();
	}
	// Scroll alle tab dopo il load (immagini sopra le tab caricate, reset Gutenverse già avvenuto), se l'utente non ha già scrollato.
	window.addEventListener('load', function() {
		bindTitles();
		if (!opened) opened = openFromHash(false);
		if (!opened) return;
		setTimeout(function() {
			var title = findTitle(window.location.hash);
			if (title && !userMoved) scrollToTabs(title);
		}, AFTER_GUTENVERSE_MS);
	});
	document.addEventListener('salerno-async-shortcode-loaded', bindTitles);
	window.addEventListener('hashchange', function() { openFromHash(true); });
})();
</script>
