d.nelsontasman.nz%2Fassets%2Flistings%2Fthe-grove-scenic-reserve-walk%2FCentre-of-New-Zealand-Nelson-City-aerial-sunset__FocusFillMaxWyIwLjAwIiwiMC4wMCIsMTAwMCwxMDAwXQ.jpg&amp;w=1920&amp;q=85 1920w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2Flistings%2Fthe-grove-scenic-reserve-walk%2FCentre-of-New-Zealand-Nelson-City-aerial-sunset__FocusFillMaxWyIwLjAwIiwiMC4wMCIsMTAwMCwxMDAwXQ.jpg&amp;w=2048&amp;q=85 2048w, /_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2Flistings%2Fthe-grove-scenic-reserve-walk%2FCentre-of-New-Zealand-Nelson-City-aerial-sunset__FocusFillMaxWyIwLjAwIiwiMC4wMCIsMTAwMCwxMDAwXQ.jpg&amp;w=3840&amp;q=85 3840w" src="/_next/image/?url=https%3A%2F%2Fbackend.nelsontasman.nz%2Fassets%2Flistings%2Fthe-grove-scenic-reserve-walk%2FCentre-of-New-Zealand-Nelson-City-aerial-sunset__FocusFillMaxWyIwLjAwIiwiMC4wMCIsMTAwMCwxMDAwXQ.jpg&amp;w=3840&amp;q=85"/></div><div class="flex justify-between font-sans text-sm text-neutral rounded-b"><div class="p-4 empty:hidden md:truncate"></div><div class="hidden p-4 md:block">3<!-- -->/<!-- -->3</div></div></div></div></div><button class="no-underline font-sans inline-flex items-center justify-center whitespace-nowrap md:text-normal font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-white bg-transparent text-white hover:bg-sky hover:text-white hover:border-sky absolute h-10 w-10 rounded-full left-5 top-1/2 -translate-y-full disabled:hidden" disabled=""><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-left h-6 w-6"><path d="m12 19-7-7 7-7"></path><path d="M19 12H5"></path></svg><span class="sr-only">Previous slide</span></button><button class="no-underline font-sans inline-flex items-center justify-center whitespace-nowrap md:text-normal font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 border border-white bg-transparent text-white hover:bg-sky hover:text-white hover:border-sky absolute h-10 w-10 rounded-full right-5 top-1/2 -translate-y-full disabled:hidden" disabled=""><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-arrow-right h-6 w-6"><path d="M5 12h14"></path><path d="m12 5 7 7-7 7"></path></svg><span class="sr-only">Next slide</span></button></div></div><div class="mb-12 grid gap-16 md:grid-cols-4"><div class="prose col-span-3 lg:prose-lg xl:prose-xl"><p class="mb-12">A short but sweet 20-minute uphill walk under the canopy of poplar and kauri trees will land you at the viewing platform, marked with a giant white survey pin in the hills behind Nelson City. Offering panoramic views over Nelson, Tasman Bay, and the picturesque Kahurangi mountain ranges, the Centre of New Zealand is a walk that forms part of the daily routine for many Nelson Tasman locals, and it’s easy to see why.<br/><br/>How to get there: The walk begins from the Botanical Reserve, which has a unique history as the site of the first ever rugby game played in New Zealand. You can access Botanical Reserve via a blue footbridge at the end of Hardy Street (parking available by the footbridge), or via Tory Street or Milton Street.<br/></p><h4>Contact details</h4><p><strong>Address: </strong>Milton Street, <!-- -->Nelson<!-- --> <!-- -->7010<br/></p></div><div class="space-y-6"></div></div></div><div class="overflow-y-scroll bg-sky-light lg:flex lg:h-[500px] xl:h-[700px]"><div class="prose w-full p-4 md:p-8 lg:w-1/3 xl:w-1/4"><p><a class="no-underline font-sans inline-flex items-center justify-center whitespace-nowrap rounded md:text-normal font-medium ring-offset-background transition-colors focus-visible:outline-none focus-visible:ring-2 focus-visible:ring-ring focus-visible:ring-offset-2 disabled:pointer-events-none disabled:opacity-50 bg-transparent text-black border-black border hover:bg-black hover:text-white h-10 px-4 py-2" target="_blank" href="https://www.google.com/maps/search/?api=1&amp;query=-41.27270635,173.29954693">Directions<svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-external-link ms-2"><path d="M15 3h6v6"></path><path d="M10 14 21 3"></path><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path></svg></a></p></div><div class="h-[500px] grow xl:h-[700px]"><div style="position:relative;width:100%;height:100%"></div></div></div><div class="container prose prose-sm max-w-screen-lg py-12"><h4>The content on this page was created by <!-- -->Centre of New Zealand</h4><p>This website helps visitors connect with providers of great New Zealand tourism experiences. It is not intended to give any assurance that any particular provider meets certain quality standards or legal obligations.</p><p>Please contact this business for more information. See also<!-- --> <a target="_blank" href="/disclaimer/">nelsontasman.nz terms of use.</a></p></div><footer class="relative flex flex-col justify-center gap-12 bg-sky pt-12 text-white md:pt-20 lg:pt-28"><div class="container flex flex-col flex-wrap items-start justify-start gap-12 md:flex-row md:justify-between xl:flex-nowrap"><div class="flex basis-full flex-col gap-8 self-center xl:basis-1/4 xl:self-start"><a class="mx-auto inline-block w-64 sm:w-72" aria-label="Home" href="/"></a><div class="flex justify-center"><a target="_blank" class="no-underline font-sans inline-flex items-center justify-center white