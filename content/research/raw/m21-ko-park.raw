	<article id="detail">
		<hgroup id="title">
			<h2 data-kana="メリケンパーク">Meriken Park</h2>
			<p></p>
		</hgroup>
		<figure id="photo">
			<dl>
				<dt></dt>
				<dd><a href="/lsc/upfile/spot/0000/1006/1006_1_l.jpg" data-pswp-width="1280" data-pswp-height="869"><img src="/lsc/upfile/spot/0000/1006/1006_1_l.jpg" alt="" width="100" height="100"></a></dd>
