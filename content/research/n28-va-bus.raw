"@graph":[{"@type":"WebPage","@id":"https://international.ado.com.mx/ado-bus/bus-station-guide/valladolid-bus-station?locale=es-MX#webpage","url":"https://international.ado.com.mx/ado-bus/bus-station-guide/valladolid-bus-station?locale=es-MX","name":"Terminal ADO de Valladolid: ubicación y destinos | ADO","description":"Valladolid tiene una sola terminal ADO, Valladolid C.46, en la Calle 46, a unos 400 m del parque principal. Autobuses directos a Mérida, Cancún, Tulum y más.","inLanguage":"es-MX","primaryImageOfPage":{"@type":"ImageObject","url":"https://international.ado.com.mx/cms/api/media/file/343401_exp-r-valladolid-1200x630.webp?prefix=tenant-103"},"publisher":{"@type":"Organization","name":"ADO","url":"https://international.ado.com.mx/"},"about":{"@type":"BusStation","name":"Valladolid ADO bus station (Valladolid C.46)"}},{"@type":"BusStation","name":"Valladolid ADO bus station (Valladolid C.46)","geo":{"@type":"GeoCoordinates","latitude":20.691,"longitude":-88.205},"address":"Calle 46 #197, Centro, Valladolid, Yucatán, Mexico"},{"@type":"FAQPage","mainEntity":[{"@type":"Question","name":"¿Hay más de una terminal ADO en Valladolid?","acceptedAnswer":{"@type":"Answer","text":"No. Todos los autobuses ADO que se venden en este sitio usan Valladolid C.46, en la Calle 46 del centro."}},{"@type":"Question","name":"¿Dónde está la terminal de autobuses de Valladolid?","acceptedAnswer":{"@type":"Answer","text":"En la Calle 46 #197, a unos 400 m del parque principal, a 5 minutos a pie."}},{"@type":"Question","name":"¿Los autobuses ADO paran en la estación del Tren Maya de Valladolid?","acceptedAnswer":{"@type":"Answer","text":"No. La estación del Tren Maya está a unos 6 km al norte del centro y es solo para el tren."}},{"@type":"Question","name":"¿Cuánto tarda el autobús de Valladolid a Chichén Itzá?","acceptedAnswer":{"@type":"Answer","text":"Unos 50 minutos. Normalmente hay un autobús ADO directo al día, desde MX$118."}},{"@type":"Question","name":"¿Con cuánto tiempo debo llegar a la terminal?","acceptedAnswer":{"@type":"Answer","text":"Unos 30 minutos antes de la salida."}}]}]}</script><script id="ld-json-breadcrumbs-/ado-bus/bus-station-guide/valladolid-bus-station" type="application/ld+json">{"@context":"https://schema.org","@type":"BreadcrumbList","numberOfItems":3,"itemListOrder":"Ascending","itemListElement":[{"@type":"ListItem","position":1,"item":{"@id":"https://international.ado.com.mx/ado-bus","name":"Autobús ADO"}},{"@type":"ListItem","position":2,"item":{"@id":"https://international.ado.com.mx/ado-bus/bus-station-guide","name":"Guía de Estaciones de Autobuses"}},{"@type":"ListItem","position":3,"item":{"@id":"https://international.ado.com.mx/ado-bus/bus-station-guide/valladolid-bus-station","name":"Estación de autobuses de Valladolid (ADO)"}}]}</script><style data-mantine-styles="inline">:root{--app-shell-padding:0px;}</style><div style="--app-shell-transition-duration:200ms;--app-shell-transition-timing-function:ease" class="m_89ab340 mantine-AppShell-root" data-resizing="true" data-mode="fixed" id="mantine-_R_1alfiusqabsnpfivb_"><div style="position:relative" class=""><style data-mantine-styles="inline">.__m__-_R_2qllalfiusqabsnpfivb_{padding-inline:var(--mantine-spacing-s300);}@media(min-width: 768px){.__m__-_R_2qllalfiusqabsnpfivb_{padding-inline:var(--mantine-spacing-s600);}}</style><header style="background-color:var(--mantine-color-white);border-bottom:1px solid var(--mantine-color-gray-2);position:relative;z-index:100;height:var(--app-header-height, 60px)" class="__m__-_R_2qllalfiusqabsnpfivb_"><div style="--group-gap:var(--mantine-spacing-md);--group-align:center;--group-justify:space-between;--group-wrap:nowrap;margin-inline:auto;width:100%;max-width:calc(85rem * var(--mantine-scale));height:100%" class="m_4081bf90 mantine-Group-root"><div style="width:calc(2.5rem * var(--mantine-scale))" class="mantine-hidden-from-sm"><button style="--burger-color:var(--mantine-color-gray-7);--burger-size:var(--burger-siz