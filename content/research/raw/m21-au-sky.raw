		<div id="sc-search-error" class="sc-search-panel__error" hidden>
			Sorry, something went wrong. Please try again.
		</div>
	</div>
</div>


<script>
(function () {
	var PROXY_URL    = '/umbraco/api/search/query';

	var panel   = document.getElementById('sc-search-panel');
	var loading = document.getElementById('sc-search-loading');
	var answer  = document.getElementById('sc-search-answer');
	var error   = document.getElementById('sc-search-error');
	var form    = document.querySelector('.sc-nav__search-form');
	var input   = document.getElementById('sc-search-input');
	var clearBtn = document.getElementById('sc-search-clear');

	if (!form || !panel) return;

	// Hint arrives as a data attribute: a Razor expression inside this script HTML-encodes apostrophes into the JS string.
	// Never write a bare Razor transition character in this script, even in a comment — Razor parses it.
	var noResultsHint = (panel.getAttribute('data-noresults-hint') || '').trim() ||
		'Try searching for something else or use different keywords';

	// Full results page; empty when the site root is unroutable, and "See all results" is then not rendered.
	var searchPageUrl = (panel.getAttribute('data-search-url') || '').trim();

	// The search page resolved server-side as a node; arrives as '' when the site has none (null attributes render empty).
	// Empty: leave every path below exactly as it was.
	var searchPageNodeUrl = (panel.getAttribute('data-search-page-url') || '').trim();

	// Evaluated at submit time, never at load, so a resized window behaves correctly on its next search.
	// Twin of site.css's NAV BREAKPOINT (<=1024px) block — change one, change the other.
	var MOBILE_QUERY = '(max-width: 1024px)';

	// Panel budget: AI summary, the top hit with its facts card, then at most this many compact rows, then the link.
	var MAX_COMPACT_ROWS = 2;

	// Editor- and API-supplied strings land in innerHTML below; neither should be able
	// to inject markup.
	function esc(s) {
		return String(s == null ? '' : s)
			.replace(/&/g, '&amp;')
			.replace(/</g, '&lt;')
			.replace(/>/g, '&gt;')
			.replace(/"/g, '&quot;');
	}

	// ESCAPE FIRST, LINK SECOND: linkify() takes an already-escaped string; mailto: and tel: only, never http(s).
	// ASCII-explicit patterns and \u0040 on purpose: three copies (here, Search.cshtml's Linkify() and its fallback) must match.
	var LINK_EMAIL = /([A-Za-z0-9_.+-]+\u0040[A-Za-z0-9_-]+(?:\.[A-Za-z0-9_-]+)+)/g;

	// A number must open with a country code or a leading 0 — otherwise runs of years read as phone numbers.
	var LINK_PHONE = /(^|[^A-Za-z0-9_])((?:\+[0-9]{1,3}\s?(?:\(0\)\s?)?[0-9](?:[\s-]?[0-9]){6,11})|(?:0[0-9](?:[\s-]?[0-9]){5,11}))(?![A-Za-z0-9_])/g;

	// Split on anchors so the phone pass never runs inside an email anchor; odd indices are the anchors.
	var LINK_ANCHOR = /(<a\b[^>]*>[\s\S]*?<\/a>)/;

	// "+64 (0) 9 363 6000" -> "+6493636000". Digits and a leading + only; the (0) trunk
	// prefix is DROPPED, never carried into the href as a digit.
	function linkTel(label) {
		var plus = label.charAt(0) === '+';
		return (plus ? '+' : '') + label.replace(/\(0\)/g, '').replace(/[^0-9]/g, '');
	}

	// Input MUST already be escaped. Output is that string plus tel:/mailto: anchors.
	function linkify(escaped) {
		var s = String(escaped == null ? '' : escaped)
			.replace(LINK_EMAIL, '<a class="sc-search-panel__answer-link" href="mailto:$1">$1</a>');
		return s.split(LINK_ANCHOR).map(function (chunk, i) {
			return (i % 2) ? chunk : chunk.replace(LINK_PHONE, function (m, pre, num) {
				return pre + '<a class="sc-search-panel__answer-link" href="tel:' + linkTel(num) +
					'">' + num + '</a>';
			});
		}).join('');
	}

	// Stale-response guard: incremented on every search AND every dismiss; a response with a stale token is dropped.
	var reqToken = 0;

	function showPanel() { panel.hidden = false; }
	function hidePanel() { panel.hidden = true; }
	function setState(s) {
		loading.hidden = s !== 'loading';
		answer.hidden  = s !== 'answer';
		error.hidden   = s !== 'error';
	}

	function syncClear() {
		if (clearBtn) { clearBtn.hidden = !(input && input.value.length); }
	}

	// The × clears the query AND dismisses the panel. Hide the container, never blank it: emptying an aria-live region re-announces.
	function dismiss() {
		reqToken++;
		if (input) { input.value = ''; }
		hidePanel();
		setState(null);
		syncClear();
		if (input) { input.focus(); }
	}

	// Facts card: a fact with no value is OMITTED, so presence is the only test — a one-fact card is the common case.
	// notice must render above openingHours: hours without a closure notice mislead.
	var FACT_CHIPS = [
		{ key: 'phone',      icon: 'call',        label: 'Phone' },
		{ key: 'email',      icon: 'mail',        label: 'Email' },
		{ key: 'address',    icon: 'location_on', label: 'Address' },
		{ key: 'cuisine',    icon: 'restaurant',  label: 'Cuisine' },
		{ key: 'priceRange', icon: 'payments',    label: 'Price range' },
		{ key: 'dressCode',  icon: 'checkroom',   label: 'Dress code' },
		{ key: 'menus',      icon: 'menu_book',   label: 'Menus' }
	];

	var FACT_ACTIONS = [
		// Book now only — private dining was the wrong action on a restaurant hit. Gold = the primary action.
		{ key: 'bookingUrl', icon: 'calendar_month', label: 'Book now', cls: 'sc-btn sc-btn--gold sc-search-panel__facts-action--primary' }
	];

	function factIcon(name) {
		return '<span class="material-symbols-outlined sc-search-panel__facts-icon" aria-hidden="true">' + name + '</span>';
	}

	// Only http(s) and site-relative values become links. These URLs are editor-typed,
	// and esc() stops attribute injection but would happily carry a javascript: href.
	function factUrlOk(u) {
		return /^(https?:\/\/|\/)/i.test(String(u == null ? '' : u).trim());
	}

	// One line per "; " segment, with any ". Note: …" tail on a line of its own.
	// Lift the note off BEFORE the "; " split: it is free prose and can contain semicolons.
	function factHoursLines(v) {
		var body = String(v).trim();
		var note = '';
		var m = body.match(/^([\s\S]*?)\.\s*(Note:[\s\S]*)$/);
		if (m) { body = m[1]; note = m[2].trim(); }

		var out = body.split('; ').map(function (seg) { return seg.trim(); }).filter(Boolean);
		if (note) { out.push(note); }
		return out;
	}

	// Every value is editor text going into innerHTML — esc() all of it, hrefs included. '' when nothing renders.
	function renderFacts(f) {
		var html = '';

		if (f.notice) {
			html += '<div class="sc-search-panel__facts-notice">' +
						factIcon('warning') +
						'<span><span class="sr-only">Notice: </span>' + esc(f.notice) + '</span>' +
					'</div>';
		}

		if (f.openingHours) {
			var lines = factHoursLines(f.openingHours);
			if (lines.length) {
				html += '<div class="sc-search-panel__facts-hours">' +
							factIcon('schedule') +
							'<span><span class="sr-only">Opening hours: </span>' +
							lines.map(function (l) {
								return '<span class="sc-search-panel__facts-hours-line">' + esc(l) + '</span>';
							}).join('') +
							'</span>' +
						'</div>';
			}
		}

		var chips = '';
		FACT_CHIPS.forEach(function (c) {
			var v = f[c.key];
			if (!v) return;
			var body;
			if (c.key === 'phone') {
				// Spaces stripped from the href only — the label keeps the editor's formatting.
				body = '<a href="tel:' + esc(String(v).replace(/\s+/g, '')) + '">' + esc(v) + '</a>';
			} else if (c.key === 'email') {
				body = '<a href="mailto:' + esc(String(v).trim()) + '">' + esc(v) + '</a>';
			} else {
				// 🔴 `menus` is NAMES ONLY — the API sends no menu URLs. Do NOT linkify it.
				body = esc(v);
			}
			chips += '<span class="sc-search-panel__facts-chip">' + factIcon(c.icon) +
						'<span><span class="sr-only">' + c.label + ': </span>' + body + '</span></span>';
		});
		if (chips) { html += '<div class="sc-search-panel__facts-chips">' + chips + '</div>'; }

		return html;
	}

	// Action row: gold BOOK NOW when there is a booking URL, then VIEW PAGE; rendered for the top hit even with no facts.
	function renderActions(f, pageUrl, pageLabel) {
		var actions = '';
		f = f && typeof f === 'object' ? f : {};
		FACT_ACTIONS.forEach(function (a) {
			var v = f[a.key];
			if (!v || !factUrlOk(v)) return;
			var u = String(v).trim();
			var ext = /^https?:/i.test(u);
			actions += '<a class="' + a.cls + '" href="' + esc(u) + '"' +
						(ext ? ' target="_blank" rel="noopener"' : '') + '>' +
						factIcon(a.icon) + '<span>' + a.label + '</span></a>';
		});
		if (pageUrl && factUrlOk(pageUrl)) {
			actions += '<a class="sc-search-panel__facts-action" href="' + esc(String(pageUrl).trim()) + '">' +
						'<span>' + esc(pageLabel || 'View page') + '</span>' + factIcon('arrow_forward') + '</a>';
		}
		return actions ? '<div class="sc-search-panel__facts-actions">' + actions + '</div>' : '';
	}

	// One line of context for a compact row: today's hours first (the most-asked
	// fact), then address, cuisine, then the hit's own summary. '' when none.
	function compactLine(item) {
		var f = item.facts && typeof item.facts === 'object' ? item.facts : null;
		if (f) {
			if (f.openingHours) {
				var lines = factHoursLines(f.openingHours);
				if (lines.length) return lines[0];
			}
			if (f.address) return f.address;
			if (f.cuisine) return f.cuisine;
		}
		return item.summary || '';
	}

	function hitTitle(item) {
		return '<a href="' + esc(item.url || '#') + '" class="sc-search-panel__hit-title">' +
					esc(item.name || 'Link') +
				'</a>';
	}

	function renderAnswer(parsed) {
		var html = '';

		// AI Summary section
		if (parsed.aiStatus === 'rate_limited') {
			html += '<div class="sc-search-panel__summary-card sc-search-panel__summary-card--unavailable">' +
						'<div class="sc-search-panel__summary-header">' +
							'<span>AI Suggestions</span>' +
						'</div>' +
						'<div class="sc-search-panel__summary-text">' +
							'<p>AI suggestions are temporarily unavailable. Please try again in a moment.</p>' +
						'</div>' +
					'</div>';
		} else if (parsed.aiStatus === 'unavailable') {
			html += '<div class="sc-search-panel__summary-card sc-search-panel__summary-card--unavailable">' +
						'<div class="sc-search-panel__summary-header">' +
							'<span>AI Suggestions</span>' +
						'</div>' +
						'<div class="sc-search-panel__summary-text">' +
							'<p>AI suggestions are currently unavailable. Here are your search results:</p>' +
						'</div>' +
					'</div>';
		} else if (parsed.text) {
			// esc() BEFORE linkify(), and both before innerHTML — the answer is model output.
			var bodyParagraphs = parsed.text.split(/\n+/).filter(Boolean)
				.map(function(p) { return '<p>' + linkify(esc(p)) + '</p>'; }).join('');

			html += '<div class="sc-search-panel__summary-card">' +
						'<div class="sc-search-panel__summary-header">' +
							'<span class="material-symbols-outlined sc-search-panel__summary-icon" aria-hidden="true">lightbulb_2</span>' +
							'<span>AI Summary</span>' +
						'</div>' +
						'<div class="sc-search-panel__summary-text">' + bodyParagraphs + '</div>' +
					'</div>';
		}

		// Results section — top hit as a full card, then compact rows, then the link.
		if (parsed.items && parsed.items.length) {
			var count = parsed.items.length;
			var top = parsed.items[0];
			var compact = parsed.items.slice(1, 1 + MAX_COMPACT_ROWS);
			var shown = 1 + compact.length;

			var topFacts = top.facts && typeof top.facts === 'object' ? top.facts : null;
			var topFactsHtml = (topFacts && Object.keys(topFacts).length) ? renderFacts(topFacts) : '';

			html += '<div class="sc-search-panel__hits">';
			html += '<div class="sc-search-panel__hit">' +
						'<div class="sc-search-panel__hit-head">' + hitTitle(top) + '</div>';
			if (topFactsHtml) {
				html += '<div class="sc-search-panel__facts">' + topFactsHtml + '</div>';
			} else if (top.summary) {
				html += '<p class="sc-search-panel__hit-summary">' + esc(top.summary) + '</p>';
			}
			html += renderActions(topFacts, top.url, 'View page');
			html += '</div>';

			if (compact.length) {
				html += '<div class="sc-search-panel__rows">';
				compact.forEach(function (item) {
					var line = compactLine(item);
					html += '<a href="' + esc(item.url || '#') + '" class="sc-search-panel__row">' +
								'<span class="sc-search-panel__row-body">' +
									'<span class="sc-search-panel__row-title">' + esc(item.name || 'Link') + '</span>' +
									(line ? '<span class="sc-search-panel__row-meta">' + esc(line) + '</span>' : '') +
								'</span>' +
								'<span class="material-symbols-outlined sc-search-panel__row-icon" aria-hidden="true">chevron_right</span>' +
							'</a>';
				});
				html += '</div>';
			}
			html += '</div>';

			// Footer: only when there is more than the panel shows AND a page to send them to.
			if (count > shown && searchPageUrl) {
				var q = input ? input.value.trim() : '';
				html += '<div class="sc-search-panel__footer">' +
							'<span class="sc-search-panel__results-count">Showing ' + shown + ' of ' + count + '</span>' +
							'<a class="sc-btn sc-btn--gold sc-search-panel__all" href="' +
								esc(searchPageUrl + '?q=' + encodeURIComponent(q)) + '">' +
								'<span>See all ' + count + ' results</span>' +
								'<span class="material-symbols-outlined" aria-hidden="true">arrow_forward</span>' +
							'</a>' +
						'</div>';
			} else if (count > 1) {
				html += '<div class="sc-search-panel__footer">' +
							'<span class="sc-search-panel__results-count">' + count + ' results</span>' +
						'</div>';
			}
		} else if (!parsed.text) {
			// Show "no results" message if there are no items and no AI summary
			html += '<div class="sc-search-panel__no-results">' +
						'<span class="material-symbols-outlined sc-search-panel__no-results-icon" aria-hidden="true">search</span>' +
						'<p class="sc-search-panel__no-results-text">No results found</p>' +
						'<p class="sc-search-panel__no-results-hint">' + esc(noResultsHint) + '</p>' +
					'</div>';
		}

		answer.innerHTML = html;
		setState('answer');
	}

	function doSearch(query) {
		if (!query.trim()) return;
		var myToken = ++reqToken;
		showPanel();
		setState('loading');

		fetch(PROXY_URL + '?q=' + encodeURIComponent(query))
			.then(function(r) {
				if (!r.ok) throw new Error('Proxy returned ' + r.status);
				return r.json();
			})
			.then(function(d) {
				if (myToken !== reqToken) return;
				if (d.error) throw new Error(d.error);
				renderAnswer({
					text: d.answer || d.text || '',
					// Two response shapes on purpose: { answer, items: [{ name, url }] } and SearchController's { answer, sources: { links: [{ label, url }] } }.
					// Remove the sources.links arm only when nothing serves it — without it every source link silently disappears.
					items: d.items || d.results ||
						((d.sources && d.sources.links) || []).map(function (l) {
							return { name: l.label, url: l.url };
						}),
					aiStatus: d.aiStatus
				});
			})
			.catch(function(e) {
				if (myToken !== reqToken) return;
				console.error('Search error:', e);
				setState('error');
			});
	}

	// Mobile: navigate to the results page instead of opening the panel. Returns true when it navigated; both conditions re-read per call.
	function goToResultsPage(q) {
		if (!searchPageNodeUrl) return false;
		if (!window.matchMedia || !window.matchMedia(MOBILE_QUERY).matches) return false;
		// The URL comes from the NODE, never the form's action — that is a built string, which 404s on a site with no search node.
		var url = searchPageNodeUrl + '?q=' + encodeURIComponent(q);
		// Navigate after the next paint: a navigation started inside the tap runs every page-leave listener (analytics) inside it.
		var go = function () { setTimeout(function () { window.location.assign(url); }, 0); };
		if (window.requestAnimationFrame) { window.requestAnimationFrame(go); } else { go(); }
		return true;
	}

	// ONE GATE for both submit and Enter — gating only submit leaves Enter opening the panel on a phone.
	// The navigating path has no panel side effects.
	function submitQuery(q) {
		if (!q) return;
		if (goToResultsPage(q)) return;
		doSearch(q);
	}

	form.addEventListener('submit', function(e) {
		e.preventDefault();
		submitQuery(input ? input.value.trim() : '');
	});

	if (input) {
		input.addEventListener('keydown', function(e) {
			if (e.key === 'Enter') { e.preventDefault(); submitQuery(input.value.trim()); }
		});
		input.addEventListener('input', syncClear);
	}

	if (clearBtn) { clearBtn.addEventListener('click', dismiss); }

	// Run once at load — a browser-restored value must show the button immediately.
	syncClear();

	document.addEventListener('keydown', function(e) {
		if (e.key === 'Escape' && !panel.hidden) hidePanel();
	});

	document.addEventListener('click', function(e) {
		if (!panel.hidden && !panel.contains(e.target) && !form.contains(e.target)) hidePanel();
	});

	// Shared with Search.cshtml's client-side fallback so the results page renders the same facts markup.
	window.scSearch = { esc: esc, linkify: linkify, renderFacts: renderFacts, renderActions: renderActions, factHoursLines: factHoursLines };
})();
</script>


	

		<nav class="sc-breadcrumb" aria-label="Breadcrumb">
			<div class="sc-breadcrumb__inner">
				<ol class="sc-breadcrumb__list">
							<li class="sc-breadcrumb__item">
									<a href="/" class="sc-breadcrumb__link">SkyCity Auckland</a>
									<svg class="sc-breadcrumb__sep" width="12" height="12" viewBox="0 0 24 24" fill="none"
										stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
										aria-hidden="true" focusable="false">
										<polyline points="9 18 15 12 9 6"/>
									</svg>
							</li>
							<li class="sc-breadcrumb__item sc-breadcrumb__item--current">
									<span aria-current="page">Sky Tower</span>
							</li>
				</ol>
			</div>
		</nav>

</nav>

<script>
(function () {
	var toggles = Array.prototype.slice.call(document.querySelectorAll('.sc-nav__dropdown-toggle'));
	if (!toggles.length) return;

	function panelFor(btn) {
		var id = btn.getAttribute('aria-controls');
		return id ? document.getElementById(id) : null;
	}

	function close(btn) {
		var panel = panelFor(btn);
		if (!panel) return;
		panel.hidden = true;
		btn.setAttribute('aria-expanded', 'false');
	}

	function closeAll(except) {
		toggles.forEach(function (btn) {
			if (btn === except) return;
			close(btn);
		});
	}

	toggles.forEach(function (btn) {
		var panel = panelFor(btn);
		if (!panel) return;

		btn.addEventListener('click', function (e) {
			e.stopPropagation();
			var isOpen = btn.getAttribute('aria-expanded') === 'true';
			closeAll(btn);
			btn.setAttribute('aria-expanded', String(!isOpen));
			panel.hidden = isOpen;
		});
	});

	document.addEventListener('keydown', function (e) {
		if (e.key !== 'Escape') return;
		var focusTarget = null;
		toggles.forEach(function (btn) {
			var panel = panelFor(btn);
			if (panel && !panel.hidden) {
				close(btn);
				focusTarget = btn;
			}
		});
		if (focusTarget) focusTarget.focus();
	});

	document.addEventListener('click', function (e) {
		toggles.forEach(function (btn) {
			var panel = panelFor(btn);
			if (!panel || panel.hidden) return;
			if (panel.contains(e.target) || btn.contains(e.target)) return;
			close(btn);
		});
	});
})();
</script>

<div id="sc-mobile-drawer"
	class="sc-drawer"
	role="dialog"
	aria-modal="true"
	aria-label="Navigation menu"
	aria-hidden="true">

	<div class="sc-drawer__header">
		<button class="sc-drawer__close"
			type="button"
			aria-label="Close navigation menu">
			<svg width="24" height="24" viewBox="0 0 24 24" fill="none"
				stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
				aria-hidden="true" focusable="false">
				<line x1="18" y1="6" x2="6" y2="18"/>
				<line x1="6" y1="6" x2="18" y2="18"/>
			</svg>
		</button>
		<a href="/" class="sc-drawer__logo" tabindex="-1" aria-label="SkyCity Auckland — home">
			<img src="/media/4hgak43v/skycity_white_horizontal.svg" alt="SkyCity Auckland" width="120" height="32" loading="lazy" />
		</a>
	</div>

	<nav class="sc-drawer__nav" aria-label="Mobile navigation">
		<ul class="sc-drawer__links" role="list">

				<li>
					<a href="/whats-on/"
						class="sc-drawer__link"
						>
						What&#x27;s On
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none"
							stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
							aria-hidden="true" focusable="false">
							<polyline points="9 18 15 12 9 6"/>
						</svg>
					</a>
				</li>
				<li>
					<a href="/restaurants/"
						class="sc-drawer__link"
						>
						Eat &amp; Drink
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none"
							stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
							aria-hidden="true" focusable="false">
							<polyline points="9 18 15 12 9 6"/>
						</svg>
					</a>
				</li>
				<li>
					<a href="/hotels/"
						class="sc-drawer__link"
						>
						Hotels
						<svg width="16" height="16" viewBox="0 0 24 24" fill="none"
							stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"
							aria-hidden="true" focusable="false">
							<polyline points="9 18 15 12 9 6"/>
						</svg>
					</a>
				</li>
				<li>
					<a href="/casino/"
						class="sc-drawer__link"
						>
