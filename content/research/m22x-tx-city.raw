<!-- Relative Announcements Content List -->

<script type="text/javascript">
function buildAnnouncements( announcement ) {
	var outContainer = '<div class="oc-emergency-announcement-container relative"><div class="oc-emergency-undismissed max-severity-30"></div></div>';
	var inContainer = '<div id="' + announcement['Id'] + '" class="side-box message-box emergency-message-box ' + announcement['Importance'] + '"></div>';
	var title = '<h3 class="side-box-title">' + announcement['Title'] + '</h3>';
	var content = '<div class="side-box-content">' + announcement['Content'] + '</div>';
	var links = announcement['Links'];
	
	$('.main-inner-container').prepend(outContainer);
	$('.oc-emergency-announcement-container.relative').append(inContainer);
	$('.oc-emergency-announcement-container.relative .emergency-message-box').append(title);
	$('.oc-emergency-announcement-container.relative .emergency-message-box').append(content);
	
	if ( links.length > 0 ) {
		$('.oc-emergency-announcement-container.relative .emergency-message-box .side-box-content').append('<p class="oc-urls"></p>');
		links.forEach ( function(x) {
			var thisLink = $('<a>').attr('href', x.link).attr('target', x.target).text(x.property);
			
			$('.oc-emergency-announcement-container.relative .oc-urls').append(thisLink).append('&nbsp;&nbsp;');
		});
	}
}
