    <!-- Espacio para scripts adicionales por página -->
    <script>
    document.addEventListener('DOMContentLoaded', () => {
        // ==========================================
        // Lógica de Alternar / Ver Todos y Filtros
        // ==========================================
        const btn = document.getElementById('btnVerTodos');
        const cardWrappers = document.querySelectorAll('.card-item-wrapper');
        const btnVerTodosWrapper = btn ? btn.parentElement : null;
        let isExpanded = false;

        const INITIAL_LIMIT = 16; // 4 filas de 4 columnas

        function applyFilterAndPagination(filterValue, resetExpanded = false) {
            if (resetExpanded) {
                isExpanded = false;
            }

            // 1. Obtener tarjetas coincidentes
            const matchingCards = [];
            cardWrappers.forEach(card => {
                const categories = JSON.parse(card.getAttribute('data-categorias') || '[]');
                if (filterValue === 'todos' || categories.includes(filterValue)) {
                    matchingCards.push(card);
                }
            });

            // 2. Determinar si mostramos el botón de "Ver Más / Ver Menos"
            if (matchingCards.length > INITIAL_LIMIT) {
                if (btnVerTodosWrapper) btnVerTodosWrapper.classList.remove('hidden');
                
                // Actualizar textos e íconos en el botón
                if (btn) {
                    const txtCerrado = btn.querySelector('.txt-cerrado');
                    const txtAbierto = btn.querySelector('.txt-abierto');
                    if (txtCerrado && txtAbierto) {
                        if (isExpanded) {
                            txtCerrado.classList.replace('block', 'hidden');
                            txtAbierto.classList.replace('hidden', 'block');
                        } else {
                            txtCerrado.classList.replace('hidden', 'block');
                            txtAbierto.classList.replace('block', 'hidden');
                        }
                    }
                }

                // Mostrar/ocultar tarjetas coincidentes según paginación
                cardWrappers.forEach(card => {
                    if (!matchingCards.includes(card)) {
                        card.classList.add('hidden');
                        card.classList.remove('animate-fade-in');
                    } else {
                        const index = matchingCards.indexOf(card);
                        if (isExpanded || index < INITIAL_LIMIT) {
                            const wasHidden = card.classList.contains('hidden');
                            card.classList.remove('hidden');
                            if (wasHidden) {
                                void card.offsetWidth; // force reflow
                                card.classList.add('animate-fade-in');
                            }
                        } else {
                            card.classList.add('hidden');
                            card.classList.remove('animate-fade-in');
                        }
                    }
                });
            } else {
                // 16 o menos tarjetas: ocultar el botón y mostrar todas las coincidentes
                if (btnVerTodosWrapper) btnVerTodosWrapper.classList.add('hidden');

                cardWrappers.forEach(card => {
                    if (matchingCards.includes(card)) {
                        const wasHidden = card.classList.contains('hidden');
                        card.classList.remove('hidden');
                        if (wasHidden) {
                            void card.offsetWidth;
                            card.classList.add('animate-fade-in');
                        }
                    } else {
                        card.classList.add('hidden');
                        card.classList.remove('animate-fade-in');
                    }
                });
            }
        }

        // Registrar clicks de botones de filtros
        const filterBtns = document.querySelectorAll('.principal-filter-btn');
        filterBtns.forEach(btnFilter => {
            btnFilter.addEventListener('click', (e) => {
                e.preventDefault();

                // Cambiar clases activas en los botones de filtro
                filterBtns.forEach(b => {
                    b.classList.remove('active', 'bg-brand-gold', 'text-white', 'border-brand-gold');
                    b.classList.add('bg-brand-cream', 'text-gray-700', 'border-brand-burgundy/25');
                });
                btnFilter.classList.add('active', 'bg-brand-gold', 'text-white', 'border-brand-gold');
                btnFilter.classList.remove('bg-brand-cream', 'text-gray-700', 'border-brand-burgundy/25');

                const filterValue = btnFilter.getAttribute('data-filter');
                applyFilterAndPagination(filterValue, true);
            });
        });

        // Registrar click de botón Ver Todos / Ver Menos
        if (btn) {
            btn.addEventListener('click', (e) => {
                e.preventDefault();
                isExpanded = !isExpanded;

                const activeFilterBtn = document.querySelector('.principal-filter-btn.active');
                const filterValue = activeFilterBtn ? activeFilterBtn.getAttribute('data-filter') : 'todos';
                applyFilterAndPagination(filterValue, false);
            });
        }

        // Initialize state on load
        applyFilterAndPagination('todos', true);
    });
</script>
