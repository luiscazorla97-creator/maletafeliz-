---
import { dictionary, continents, type Locale } from '../i18n';
import { destinations } from '../data/destinations';
import { route } from '../lib/routes';
import { production } from '../lib/site';
import { forLocale, articlePath, photoFor } from '../lib/content';
import Icon from './Icon.astro';
import Scenery from './Scenery.astro';
import Card from './DestinationCard.astro';
const { lang } = Astro.props as { lang: Locale };
const t = dictionary[lang];
const articles = forLocale(lang);
const available = production
  ? destinations.filter((d) => articles.some((a) => a.destinationId === d.id))
  : destinations;
const chosen = ['tokyo', 'paris', 'bali']
  .map((id) => available.find((d) => d.id === id))
  .filter(Boolean);
const hero = articles.find((a) => a.destinationId === 'bali') || articles[0];
const photo = hero && photoFor(hero.coverImageId);
---

<section class="shell hero-wrap">
  <div class="hero">
    <div class="hero-picture">
      {photo ? (
        <img
          src={photo.src}
          alt={photo.alt[lang]}
          width={photo.width}
          height={photo.height}
          fetchpriority="high"
        />
      ) : (
        <Scenery
          variant="bali"
          label={
            lang === 'es'
              ? 'Ilustración de diseño · fotografía pendiente de verificación'
              : 'Design illustration · verified photograph pending'
          }
        />
      )}
    </div>
    <div class="hero-shade"></div>
    <div class="hero-copy">
      <span class="eyebrow">
        <span class="line"></span>
        {t.heroTag}
      </span>
      <h1>
        {t.heroTitle}
        <br />
        <em>{t.heroAccent}</em>
      </h1>
      <p>{t.heroText}</p>
      <a class="button button-orange" href={route(lang, 'destinations')}>
        {t.explore}
        <Icon />
      </a>
    </div>
    <div class="hero-bottom">
      <span>
        <Icon name="compass" size={16} />
        {lang === 'es'
          ? 'Menos rutina. Más mundo.'
          : 'Less routine. More world.'}
      </span>
      <span class="hero-pages">
        01 <i></i> 03
      </span>
    </div>
  </div>
  <form class="search-bar" action={route(lang, 'search')}>
    <Icon name="search" size={24} />
    <div>
      <label for="destination-search">{t.searchLabel}</label>
      <input
        id="destination-search"
        name="q"
        placeholder={t.searchPlaceholder}
        maxlength="100"
      />
    </div>
    <button class="button button-dark" type="submit">
      {t.search}
      <Icon />
    </button>
  </form>
</section>
<section class="shell section">
  <div class="section-heading">
    <div>
      <span class="eyebrow orange">
        {lang === 'es'
          ? 'LA INSPIRACIÓN VA EN LA MALETA'
          : 'PACK A LITTLE INSPIRATION'}
      </span>
      <h2>{t.featured}</h2>
      <p>{t.featuredText}</p>
    </div>
    <a class="text-link" href={route(lang, 'guides')}>
      {t.viewAll}
      <Icon />
    </a>
  </div>
  <div class="featured-grid">
    {chosen.map((d) => (
      <Card destination={d!} lang={lang} large />
    ))}
  </div>
  {!production && <p class="preview-explanation">{t.previewNote}</p>}
</section>
<section class="continent-band">
  <div class="shell">
    <div class="section-heading">
      <div>
        <span class="eyebrow orange">
          {lang === 'es'
            ? 'SIN FRONTERAS PARA LA CURIOSIDAD'
            : 'CURIOSITY HAS NO BORDERS'}
        </span>
        <h2>{t.continents}</h2>
        <p>{t.continentsText}</p>
      </div>
      <Icon name="globe" size={52} />
    </div>
    <div class="continent-grid">
      {Object.entries(continents).map(([key, names], i) => (
        <a href={route(lang, 'explore', key)} class="continent-tile">
          <span class="continent-number">0{i + 1}</span>
          <Icon
            name={
              ['compass', 'city', 'sun', 'mountain', 'globe', 'mountain'][i]
            }
            size={34}
          />
          <span>{names[lang]}</span>
          <Icon size={18} />
        </a>
      ))}
    </div>
  </div>
</section>
<section class="shell section">
  <div class="section-heading">
    <div>
      <span class="eyebrow orange">
        {lang === 'es'
          ? 'EL PRÓXIMO VIAJE EMPIEZA AQUÍ'
          : 'YOUR NEXT JOURNEY STARTS HERE'}
      </span>
      <h2>{t.destinationsTitle}</h2>
    </div>
    <a class="text-link" href={route(lang, 'destinations')}>
      {t.viewAll}
      <Icon />
    </a>
  </div>
  <div class="card-grid">
    {['miami', 'rome', 'queenstown', 'cape-town']
      .map((id) => available.find((d) => d.id === id))
      .filter(Boolean)
      .map((d) => (
        <Card destination={d!} lang={lang} />
      ))}
  </div>
</section>
<section
  class="shell category-strip"
  aria-label={lang === 'es' ? 'Categorías turísticas' : 'Travel categories'}
>
  {[
    ['cities', t.cities, 'city'],
    ['nature', t.nature, 'mountain'],
    ['culture', t.culture, 'book'],
    ['beaches', t.beaches, 'sun'],
  ].map(([key, label, icon]) => (
    <a href={route(lang, 'explore', `category-${key}`)}>
      <Icon name={icon} size={26} />
      <span>{label}</span>
      <Icon size={16} />
    </a>
  ))}
</section>
<section class="shell manifesto-wrap">
  <div class="manifesto">
    <div class="manifesto-mark">
      <img src="/brand/logo.svg" width="150" height="150" alt="" />
      <span class="orbit orbit-one"></span>
      <span class="orbit orbit-two"></span>
      <Icon name="compass" size={34} />
    </div>
    <div>
      <span class="eyebrow orange">{t.verified}</span>
      <h2>{t.manifesto}</h2>
      <p>{t.manifestoText}</p>
      <a class="text-link" href={route(lang, 'info', 'editorial')}>
        {t.manifestoLink}
        <Icon />
      </a>
    </div>
  </div>
</section>
<section class="shell section">
  <div class="section-heading">
    <div>
      <span class="eyebrow orange">
        {lang === 'es'
          ? 'PEQUEÑAS IDEAS, GRANDES VIAJES'
          : 'SMALL IDEAS, GREAT JOURNEYS'}
      </span>
      <h2>{t.countryTitle}</h2>
    </div>
  </div>
  <div class="country-grid">
    {[...new Map(available.map((d) => [d.countryId, d])).values()]
      .slice(0, 8)
      .map((d) => (
        <a href={route(lang, 'explore', `country-${d.countryId}`)}>
          <Icon name="pin" size={18} />
          <span>{d.country[lang]}</span>
          <Icon size={18} />
        </a>
      ))}
  </div>
</section>
{articles.length > 0 && (
  <section class="shell section">
    <h2>{t.latest}</h2>
    <div class="recent-list">
      {articles
        .slice(-6)
        .reverse()
        .map((a) => (
          <a href={articlePath(a)}>
            <span>{a.title}</span>
            <Icon />
          </a>
        ))}
    </div>
  </section>
)}
