    <script>
  $(document).ready(function() {
        
        
    /*  Media Carousel on modal */
$("#modal-gallery").owlCarousel({
  autoplay: false,
  nav: true,
  dots: true,
  mouseDrag: false,
  touchDrag: true,
  items: 1,
  animateIn: "none",
  animateOut: "none",
  navContainer: "#modalGalleryNav nav",
  animateOut: 'fadeOut',
  animateIn: 'fadeIn',
  navText: [
    '<svg class="icon icon-white" aria-label="prossimo elemento"><use xlink:href="https://cultura.gov.it/fe/mibact/image/sprite.svg#it-chevron-left"></use></svg>',
    '<svg class="icon icon-white" aria-label="elemento precedente"><use xlink:href="https://cultura.gov.it/fe/mibact/image/sprite.svg#it-chevron-right"></use></svg>'
  ],
});

/*  Media Carousel refresh on modal opening */
  $('#mediaModal').on("show.bs.modal", function() {
  $("#modal-gallery").trigger('refresh.owl.carousel');
});

/*  Set modal carousel to selected item */
$(".img-thumbnail").on("click", function(e){
  e.preventDefault();
  $index= $(this).attr("data-index");
  $("#modal-gallery").trigger('to.owl.carousel', [$index]);
  console.log($index);
});

/*  Show/hide media Carousel details */
$('#mediaModal').on("change.owl.carousel", function() {
  $(".media-modal .col-thumb").removeClass('focused');
  $(".media-modal .col-det").removeClass('focused');
});

/* Set focus on image or details of media carousel element */
$(".media-modal .col-thumb").on("click", function(){
	$(this).addClass('focused');
});
$(".media-modal .col-det").on("click", function(){
	$(this).siblings(".col-thumb").removeClass('focused');
});
	/*Copy link for sharing*/
    $('#copy-url').on("click", function(e) {
      e.preventDefault();
      var $temp = $("<input>");
      $("body").append($temp);
      $temp.val("https://cultura.gov.it/luogo/rocca-maggiore").select();
      document.execCommand("copy");
      $temp.remove();
    });
	/*Media Carousel on modal*/
    $("#modal-gallery").owlCarousel({
    autoplay: false,
    nav: true,
    dots: true,
    mouseDrag: false,
    touchDrag: true,
    items: 1,
    animateIn: "fadeIn",
    animateOut: "fadeOut",
    navContainer: "#modalGalleryNav nav",
    navText: [
      '<svg class="icon icon-secondary" aria-label="prossimo elemento"><use xlink:href="https://cultura.gov.it/fe/mibact/image/sprite.svg#it-chevron-left"></use></svg>',
      '<svg class="icon icon-secondary" aria-label="elemento precedente"><use xlink:href="https://cultura.gov.it/fe/mibact/image/sprite.svg#it-chevron-right"></use></svg>'
    ],
    });
    /*Media Carousel refresh on modal opening*/
    $('#mediaModal').on("show.bs.modal", function() {
		$("#modal-gallery").trigger('refresh.owl.carousel');
    });
    /*Set modal carousel to selected item*/
    $(".img-thumbnail").on("click", function(e){
        e.preventDefault();
        $index= $(this).attr("data-index");
        $("#modal-gallery").trigger('to.owl.carousel', [$index]);
        console.log($index);
    });
    /*Show/hide media Carousel details*/
    $('#mediaModal').on("change.owl.carousel", function() {
        $(".media-modal .col-thumb").removeClass('focused');
        $(".media-modal .col-det").removeClass('focused');
    });
    /* Set focus on image or details of media carousel element */
    $(".media-modal .col-thumb").on("click", function(){
      	$(this).addClass('focused');
    });
    $(".media-modal .col-det").on("click", function(){
      	$(this).siblings(".col-thumb").removeClass('focused');
    });
    /* Aside secondary carousel */
    $("#secondary").owlCarousel({
      autoplay: false,
      nav: true,
      dots: false,
      mouseDrag: false,
      touchDrag: true,
      items: 1,
      navText: [
      '<svg class="icon icon-secondary" aria-label="prossimo elemento"><use xlink:href="https://cultura.gov.it/fe/mibact/image/sprite.svg#it-chevron-left"></use></svg>',
      '<svg class="icon icon-secondary" aria-label="elemento precedente"><use xlink:href="https://cultura.gov.it/fe/mibact/image/sprite.svg#it-chevron-right"></use></svg>'
      ],
    });
    /*  Aside primary carousel */
    $("#primary").owlCarousel({
      loop: true,
      autoplay: true,
      nav: false,
      dots: true,
      mouseDrag: true,
      touchDrag: true,
      items: 1,
    });
    $('[data-toggle="popover"]').popover({
    container: 'body'
    });
        var map= L.map('content-map', {
        center: [43.0733700, 12.6152400],
        zoom: 13,
        });
        var tile= L.tileLayer('https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png?{foo}', {foo: 'bar', attribution: 'Map data © <a href="https://www.openstreetmap.org/">OpenStreetMap</a> contributors, <a href="https://creativecommons.org/licenses/by-sa/2.0/">CC-BY-SA</a>'}).addTo(map);
        var marker= L.marker([43.0733700, 12.6152400]).addTo(map);
    $('document').ready(function(){
  $('#main-search').on('keyup', function(){
	if($(this).val()) {
		$('#button-addon2-wrapper').html('<button class="btn px-3 rounded-0 d-flex align-items-center" type="submit" id="button-addon2"><span class="sr-only">Invio</span><svg class="icon  icon-sm icon-primary"><use xlink:href="https://cultura.gov.it/fe/mibact/image/sprite.svg#it-search"></use></svg></button>');
	} else {
		$('#button-addon2-wrapper').html('<span class="btn px-3 rounded-0 d-flex align-items-center" aria-hidden="true"><svg class="icon  icon-sm icon-secondary"><use xlink:href="https://cultura.gov.it/fe/mibact/image/sprite.svg#it-search"></use></svg></span>');
	}
  });
});
  });
</script>
