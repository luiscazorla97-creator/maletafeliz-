    <main>
        <div class="english-fv">
            <h1 class="english-fv__title--ja">
                <img src="https://houkokuji.or.jp/wp-content/themes/houkokuji/assets/images/fv-title-ja.png" alt="日本語のタイトル" loading="lazy">
            </h1>
