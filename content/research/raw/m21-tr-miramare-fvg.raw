    <!-- Sojern Pixel -->
<script src='https://static.sojern.com/sdk/latest/sojern.min.js'></script>
<script>
    let lastSelectedDate = null;

    function sendToSojernTracker(action, payload) {
        console.log(action);
        console.log(payload);
        window.sjn = window.sjn || function () { (sjn.q = sjn.q || []).push(arguments) };
        sjn('initAndFire',
            'advertiser',
            '58862',
            action,
            {
                context: { vertical: 'vacation' },
                params: payload
            })
    }

    var sendHomepageEvent = function () {
        sendToSojernTracker('homePage', {
            "pixelID": "428404"
        });
    }
    var sendProductPageEvent = function () {
        lastSelectedDate = null;
        sendToSojernTracker('product', {
            "pixelID": "428404"
        });
    }

    let shouldLoad

    if (document.querySelector("product-details-widget") != null) {
        //sono nella pagina di dettaglio
        sendProductPageEvent();
    } else if (document.querySelector("product-catalog-widget") != null) {
        //sto usando il catalogo, devo restare in ascolto per capire quando atterro nella pagina...
        sendHomepageEvent();

        let lastUrl = '';
        let lastProductId = 0;

        function checkUrl() {
            if (location.href === lastUrl) return;

            lastUrl = location.href;

            const url = new URL(location.href);
            const productId = url.searchParams.get('re-product-id');

            if (productId) {
                if (lastProductId != productId) {
                    lastProductId = productId;
                    sendProductPageEvent();
                }
            }
        }

        const originalPushState = history.pushState;

        history.pushState = function (...args) {
            originalPushState.apply(this, args);
            checkUrl();
        };

        const originalReplaceState = history.replaceState;

        history.replaceState = function (...args) {
            originalReplaceState.apply(this, args);
            checkUrl();
        };

        window.addEventListener('popstate', checkUrl);

        checkUrl(); //se atterro direttamente in una pagina con il parametro
    } else {
        //sono in una qualsiasi altra pagina
        sendHomepageEvent();
    }

    //altri eventi
    function parseMultilanguageDate(input) {
        var mesi = {
            // Italiano
            gennaio: '01', febbraio: '02', marzo: '03', aprile: '04',
            maggio: '05', giugno: '06', luglio: '07', agosto: '08',
            settembre: '09', ottobre: '10', novembre: '11', dicembre: '12',
            // Inglese
            january: '01', february: '02', march: '03', april: '04',
            may: '05', june: '06', july: '07', august: '08',
            september: '09', october: '10', november: '11', december: '12',
            // Tedesco
            januar: '01', februar: '02', märz: '03', maerz: '03',
            juni: '06', juli: '07', dezember: '12'
            // "april", "mai"->maggio già coperto sopra? attenzione ai duplicati
        };

        if (!input) return null;

        // Rimuove il giorno della settimana e l'eventuale virgola
        // es: "Thursday, 10 September 2026" -> "10 September 2026"
        //     "sabato 5 settembre 2026"     -> "5 settembre 2026"
        //     "Samstag, 5. September 2026"  -> "5. September 2026"
        var senzaGiornoSettimana = input.replace(/^[^\d,]*,?\s*/, '');

        // Estrae giorno (con eventuale punto tedesco), mese testuale, anno
        var match = senzaGiornoSettimana.match(/(\d{1,2})\.?\s+([A-Za-zÀ-ÿäöüÄÖÜß]+)\s+(\d{4})/);
        if (!match) return null;

        var giorno = match[1].padStart(2, '0');
        var meseTesto = match[2].toLowerCase()
            .replace(/ä/g, 'a').replace(/ö/g, 'o').replace(/ü/g, 'u'); // normalizza umlaut
        var anno = match[3];

        var mese = mesi[meseTesto];
        if (!mese) return null;

        return anno + '-' + mese + '-' + giorno;
    }
    function checkSelectedData() {
        var widget = document.querySelector("product-details-widget, product-catalog-widget")?.shadowRoot;
        if (widget == null) { return; }
        var dataString = widget.querySelector(".regiondo-step-date p")?.innerText;
        if (dataString != null) {
            var parsedDate = parseMultilanguageDate(dataString);
            if (parsedDate != lastSelectedDate) {
                lastSelectedDate = parsedDate;
                handleDataLayerItem({
                    event: 'regiondo_date_selected'
                });
            }
        }
    }
    function handleDataLayerItem(item) {
        if (!item || typeof item !== 'object') return;

        var ecommerceEvents = [
            'regiondo_date_selected', 'begin_checkout', 'purchase'
        ];

        if (ecommerceEvents.indexOf(item.event) !== -1) {
            var widget = document.querySelector("product-details-widget, product-catalog-widget").shadowRoot;
            var data = lastSelectedDate;
            var locationFrags = widget.querySelector(".regiondo-product-location-details p").textContent.split(',');
            var city = "";
            var state = "";
            var country = "Italia";
            if (locationFrags.length > 3) {
                city = locationFrags[locationFrags.length - 3].replace(/\d+/g, '').trim();
                state = locationFrags[locationFrags.length - 2];
                country = locationFrags[locationFrags.length - 1];
            }
            var action = "";
            var params = {
                "pixelID": "428405",
                "departureDate": data, /* Departure Date. Format yyyy-mm-dd. Ex: 2015-02-14 */
                "returnDate": data, /* Return Date. Format yyyy-mm-dd. Ex: 2015-02-14 */
                "destinationCity": city, /* Destination City */
                "destinationState": state, /* Destination State */
                "destinationCountry": country, /* Destination Country */
                "attractionName": widget.querySelector("h1").innerText /* Attraction Code */
            }
            if (item.event == 'regiondo_date_selected') {
                action = "search";
            }
            else if (item.event == 'begin_checkout') {
                action = "shoppingCart";
            }
            else if (item.event == 'purchase') {
                //const price = parseFloat(
                //    widget.querySelector(".regiondo-totals--grand-total .regiondo-totals__value").textContent
                //        .replace(/\s*€.*$/, '')
                //        .replace(',', '.')
                //        .trim()
                //);
                action = "conversion";
                params.discountCode = item.ecommerce?.coupon; /* Discount Code */
                params.price = item.ecommerce?.value; /* Purchase Price */
                params.confirmationNumber = item.ecommerce?.transaction_id; /* Confirmation Number */
                params.currency = item.ecommerce?.currency; /* Purchase Currency */
            }
            sendToSojernTracker(action, params);
            return;
        }
    }

    window.dataLayer = window.dataLayer || [];

    if (!window.dataLayer.__myTrackerHooked) {
        // Processa eventuali push già avvenuti prima di noi
        window.dataLayer.forEach(handleDataLayerItem);

        var originalPush = window.dataLayer.push;
        window.dataLayer.push = function () {
            var args = Array.prototype.slice.call(arguments);
            args.forEach(handleDataLayerItem);
            setTimeout(checkSelectedData, 100);
            // richiama SEMPRE l'originale, invariato: GTM/GA4
            // devono continuare a ricevere tutto come prima
            return originalPush.apply(window.dataLayer, args);
        };
        window.dataLayer.__myTrackerHooked = true;
    }
</script>
<!-- End Sojern Pixel -->
