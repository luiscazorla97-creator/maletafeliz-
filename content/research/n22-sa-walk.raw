    <div class="glide__inner-wrap">
      
        
  <figure class="media media-image carousel-square-aspect ma-0 carousel-square-aspect--view-mode media-caption media-location">

    <div class="square-aspect"></div>
      
    <img loading="lazy" src="/sites/default/files/styles/carousel_image/public/2025-06/foley-house-inn.jpg.webp?itok=T87g23oD" width="640" height="640" alt="A historic four-level home in Savannah, GA restored as a B&amp;B." class="image-style-carousel-image scale-with-grid" />




