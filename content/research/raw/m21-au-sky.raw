	<section class="sc-section sc-section--tight sc-section--grey" id="attractions" aria-labelledby="sc-attractions-heading">
		<div class="sc-hp-inner">
			<div class="sc-hp-section-hdr">
				<div>
					<span class="sc-section__eyebrow">Thrills</span>
					<h2 class="sc-hp-section-title" id="sc-attractions-heading">Sky Tower Experiences</h2>
				</div>
			</div>
			<div class="sc-hp-grid-exp">
					<a href="/attractions/skywalk/" target="_blank" rel="noopener noreferrer" class="sc-hp-card" aria-label="SkyWalk">
						<div class="sc-hp-card__img">
							<span class="sc-hp-card__cat">Attraction</span>
								<img src="/media/ndzbw02d/skycity-auckland-sky-tower-skywalk-hero.jpg?rxy=0.456,0.401123595505618&amp;width=800&amp;format=webp&amp;v=1dd45d9a7ef98e0" alt="SkyWalk" loading="lazy" style="object-position: 45.6% 40.1%;" />
						</div>
						<div class="sc-hp-card__body">
							<h3 class="sc-hp-card__title">SkyWalk</h3>
								<p class="sc-hp-card__excerpt">Walk the outside ring of the Sky Tower, 192m above Auckland with no handrails &#x2014; an AJ Hackett experience with a free Sky Tower pass.</p>
						</div>
					</a>
					<a href="/attractions/skyjump/" target="_blank" rel="noopener noreferrer" class="sc-hp-card" aria-label="SkyJump">
						<div class="sc-hp-card__img">
							<span class="sc-hp-card__cat">Attraction</span>
								<img src="/media/bo3pn3zm/skycity-auckland-sky-tower-skyjump-hero.jpg?rxy=0.588,0.2548719176442423&amp;width=800&amp;format=webp&amp;v=1dd45d9a4b8b0d0" alt="SkyJump" loading="lazy" style="object-position: 58.8% 25.5%;" />
						</div>
						<div class="sc-hp-card__body">
							<h3 class="sc-hp-card__title">SkyJump</h3>
								<p class="sc-hp-card__excerpt">Leap from 192m at up to 85kph on New Zealand&#x2019;s highest jump &#x2014; base jumping by wire from the Sky Tower, with a free Sky Tower pass.</p>
						</div>
					</a>
					<a href="/attractions/skyride/" target="_blank" rel="noopener noreferrer" class="sc-hp-card" aria-label="SkyRide">
						<div class="sc-hp-card__img">
							<span class="sc-hp-card__cat">Attraction</span>
								<img src="/media/ldknlulq/skyride_sky_tower_skycity_auckland.jpg?width=800&amp;format=webp&amp;v=1dd45d9ad88daf0" alt="SkyRide" loading="lazy" style="object-position: 50% 50%;" />
						</div>
						<div class="sc-hp-card__body">
							<h3 class="sc-hp-card__title">SkyRide</h3>
								<p class="sc-hp-card__excerpt">The world&#x27;s highest lift-and-descent ride has officially landed in the SkyCity precinct. The SkyRide is unlike anything Auckland has seen before.</p>
						</div>
					</a>
			</div>
		</div>
	</section>
