<script>var yiiOptions = {"idScope":""};
var map_indirizzo = null;
var input_indirizzo = null;
var autocomplete_indirizzo = null;
var infowindow_indirizzo = null;
var marker_indirizzo = null;
var geocoder_indirizzo = null;

function initMap_indirizzo() {
    //init map
    map_indirizzo = new google.maps.Map(document.getElementById('map-indirizzo'), {
        center: {lat: 44.8362929, lng: 11.5652464},
        zoom: 10
    });

    //init the geocoder
    geocoder_indirizzo = new google.maps.Geocoder;
    
    //bind the input for the autocomplete and put it in the map
    input_indirizzo = document.getElementById('pac-input-indirizzo');
    autocomplete_indirizzo = new google.maps.places.Autocomplete(input_indirizzo);
    autocomplete_indirizzo.bindTo('bounds', map_indirizzo);
    map_indirizzo.controls[google.maps.ControlPosition.TOP_LEFT].push(input_indirizzo);

    infowindow_indirizzo = new google.maps.InfoWindow();
    marker_indirizzo = new google.maps.Marker({
        map: map_indirizzo
    });
    marker_indirizzo.addListener('click', function() {
        infowindow_indirizzo.open(map_indirizzo, marker_indirizzo);
    });

    if(document.getElementById('place-id-indirizzo').value){
        var placeId = document.getElementById('place-id-indirizzo').value;
        updateMarkerByPlaceId(placeId, 'indirizzo');
    }

    google.maps.event.addListenerOnce(map_indirizzo, 'idle', function(){
        document.getElementById('map-loader-indirizzo').classList.add("hidden");
        document.getElementById('pac-input-indirizzo').classList.remove("hidden");
    });
    
    autocomplete_indirizzo.addListener('place_changed', function() {
        infowindow_indirizzo.close();
        var place = autocomplete_indirizzo.getPlace();
        if (!place.geometry) {
            return;
        }

        //save the new place value
        document.getElementById('place-id-indirizzo').value = place.place_id;
        updateMarkerInfo('indirizzo', place.place_id, place.geometry.location);

        //update the marker
        marker_indirizzo.setVisible(true);
        updateInfoWindow('indirizzo', place.formatted_address);
    });
    
    addCurrentLocationButton('indirizzo');
}</script>            <script type="text/javascript" src="https://cdn.datagest.it/plugins/dg-webbooking-api/1.1/dg-webbooking-api.min.js"></script>

