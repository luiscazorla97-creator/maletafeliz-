<!-- ハンバーガーメニュー -->
<script>
    (function($) {
        $(function() {
            var $header = $('#header');

            // Nav Fixed
            $(window).scroll(function() {
                if ($(window).scrollTop() > 100) {
                    $header.addClass('fixed');
                } else {
                    $header.removeClass('fixed');
                }

                // スクロール時に .open を削除
                $header.removeClass('open');
                $('.toggle_contents_all, .toggle_contents_zh-hant').slideUp();
                $('.toggle_switch_all, .toggle_switch_zh-hant').removeClass('open');
            });

            // Nav Toggle Button
            $('#nav_toggle').click(function() {
                $('header').toggleClass('open');
                $('.toggle_contents_all, .toggle_contents_zh-hant').slideUp();
                $('.toggle_switch_all, .toggle_switch_zh-hant').removeClass('open');
            });

            // 画面サイズ変更時に .open を削除
            $(window).resize(function() {
                $('header').removeClass('open');
                $('.toggle_contents_all, .toggle_contents_zh-hant').slideUp();
                $('.toggle_switch_all, .toggle_switch_zh-hant').removeClass('open');
            });
        });
    })(jQuery);
</script>

<!--to_page_top-->
<script>
    $("#to_page_top").hide();

    $(function() {
        $(window).scroll(function() {
            //50pxスクロールしたら
            if ($(this).scrollTop() > 50) {
                //フェードインで表示
                $('#to_page_top').fadeIn();
            } else {
                $('#to_page_top').fadeOut();
            }
        });
        //ここからクリックイベント
        $('#to_page_top a').click(function() {
            $('body,html').animate({
                scrollTop: 0
            }, 500);
            return false;
        });
    });
</script><!--/to_page_top-->

