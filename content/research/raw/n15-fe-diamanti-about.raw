				<div class="elementor-widget-container">
					<h2 class="elementor-heading-title elementor-size-default">/ History</h2>				</div>
				</div>
				<div class="elementor-element elementor-element-cb7e82a animated-slow elementor-invisible elementor-widget elementor-widget-icon-box" data-id="cb7e82a" data-element_type="widget" data-e-type="widget" data-settings="{&quot;_animation&quot;:&quot;fadeInLeft&quot;}" data-widget_type="icon-box.default">
				<div class="elementor-widget-container">
							<div class="elementor-icon-box-wrapper">

			
						<div class="elementor-icon-box-content">

									<h3 class="elementor-icon-box-title">
						<span  >
							1494						</span>
					</h3>
				
									<p class="elementor-icon-box-description">
						Some documents attest that the construction works of the building, designed by Biagio Rossetti, have already begun.					</p>
				
			</div>
			
		</div>
						</div>
				</div>
				<div class="elementor-element elementor-element-536d218 elementor-widget-divider--view-line elementor-widget elementor-widget-divider" data-id="536d218" data-element_type="widget" data-e-type="widget" data-widget_type="divider.default">
				<div class="elementor-widget-container">
							<div class="elementor-divider">
			<span class="elementor-divider-separator">
						</span>
		</div>
						</div>
				</div>
				<div class="elementor-element elementor-element-7000646 animated-slow elementor-invisible elementor-widget elementor-widget-icon-box" data-id="7000646" data-element_type="widget" data-e-type="widget" data-settings="{&quot;_animation&quot;:&quot;fadeInRight&quot;}" data-widget_type="icon-box.default">
				<div class="elementor-widget-container">
							<div class="elementor-icon-box-wrapper">

			
						<div class="elementor-icon-box-content">

									<h3 class="elementor-icon-box-title">
						<span  >
							1496						</span>
					</h3>
				
									<p class="elementor-icon-box-description">
						The facade of the building is already decorated "with marble and diamonds".					</p>
				
			</div>
			
		</div>
						</div>
				</div>
				<div class="elementor-element elementor-element-e59eeab elementor-widget-divider--view-line elementor-widget elementor-widget-divider" data-id="e59eeab" data-element_type="widget" data-e-type="widget" data-widget_type="divider.default">
