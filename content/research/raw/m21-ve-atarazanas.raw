    <div class="relative group/tooltip inline-block w-full sm:w-auto">
        <a href="https://www.google.com/maps/search/?api=1&amp;query=19.19830,-96.13420" target="_blank" rel="noopener noreferrer"
            class="group inline-flex items-center justify-center gap-2.5 w-full sm:w-auto bg-gradient-to-r from-brand-burgundy to-brand-burgundy-mid text-white px-7 py-3.5 rounded-full font-bold shadow-md hover:shadow-xl hover:-translate-y-0.5 transition-all duration-300 font-['Montserrat'] text-sm sm:text-base">
            <i class="pi pi-map-marker text-lg text-brand-gold transition-transform group-hover:scale-125"></i>
            <span>Ver en Google Maps</span>
