<div id="videoModal" class="fixed inset-0 z-50 hidden flex items-center justify-center p-4">
    <!-- Backdrop -->
    <div id="modalBackdrop"
        class="absolute inset-0 bg-black/85 backdrop-blur-sm transition-opacity duration-300 opacity-0 pointer-events-auto">
