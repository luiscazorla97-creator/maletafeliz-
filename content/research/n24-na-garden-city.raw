        $.ajax({
            headers: {'X-CSRF-Token': csrfToken},
            type: 'POST',
            dataType: 'json',
            url: '/top/ajaxAdvertisementLog',
            data: {
                language_id: languageId,
                advertisement_type: advertisementType,
                advertisement_id: advertisementId
            },
            cache: false,
        })
        .done(function(data){
