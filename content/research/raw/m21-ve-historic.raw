<section id="seccion-qr" class="py-6 lg:py-8 bg-white">
    <div class="max-w-7xl mx-auto px-4 md:px-8">
        <div
            class="relative bg-gradient-to-br from-brand-burgundy via-[#4A0D30] to-[#2B041A] rounded-[2.5rem] overflow-hidden shadow-2xl p-8 md:p-12 lg:p-14 flex flex-col md:flex-row md:justify-center items-center gap-10 md:gap-16 lg:gap-24 xl:gap-32 min-h-[300px] border border-[#faeec8]/15">

            <!-- Ambient Glow Spots -->
            <div class="absolute -top-32 -left-32 w-96 h-96 rounded-full bg-brand-muted/10 blur-[110px] pointer-events-none z-0"></div>
            <div class="absolute top-1/2 -right-24 transform -translate-y-1/2 w-[28rem] h-[28rem] rounded-full bg-[#faeec8]/5 blur-[130px] pointer-events-none z-0"></div>

            <!-- Left Column: Text Content + CTA Button -->
            <div class="flex flex-col items-center md:items-start text-center md:text-left max-w-8xl z-10">
    
                <h2
                    class="text-white text-2xl sm:text-3xl md:text-4xl lg:text-[2.5rem] font-bold uppercase tracking-[0.12em] mb-5 fuente-titulos drop-shadow-[0_4px_12px_rgba(0,0,0,0.4)] leading-[1.15]">
                    SCAN AND DISCOVER                </h2>
                <p class="text-[#F4F0E9]/85 text-base md:text-lg lg:text-[19px] leading-relaxed md:leading-[1.8] tracking-wide mb-8 font-sans font-normal max-w-3xl">
                    Scan the QR codes on monuments and points of interest to learn about their history, photos, videos, and more.                </p>
                <a href="#"
                    class="group inline-flex items-center gap-3.5 px-10 py-4 bg-gradient-to-r from-brand-gold via-brand-muted to-[#9A8047] hover:from-[#f6e2b3] hover:to-brand-muted text-[#4A0D30] font-extrabold text-xs md:text-sm tracking-[0.2em] rounded-xl shadow-[0_4px_20px_rgba(221,179,4,0.3)] hover:shadow-[0_8px_30px_rgba(221,179,4,0.55)] border border-[#fffde2]/20 transition-all duration-300 transform hover:-translate-y-0.5 active:translate-y-0 active:shadow-md font-sans uppercase">
                    <span>SCAN NOW!</span>
                    <svg class="w-4 h-4 transition-transform duration-300 transform group-hover:translate-x-1" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round">
                        <line x1="5" y1="12" x2="19" y2="12"></line>
                        <polyline points="12 5 19 12 12 19"></polyline>
                    </svg>
                </a>
            </div>

            <!-- Right Column: Premium Physical Plaque styled QR Container -->
            <div class="relative flex-shrink-0 z-10 w-64 h-64 sm:w-96 sm:h-96 rounded-2xl shadow-[0_15px_35px_rgba(0,0,0,0.4),_inset_0_2px_4px_rgba(255,255,255,0.4)] border border-[#faeec8] bg-gradient-to-br from-[#f6e2b3] via-[#bda05a] to-[#8a6f37] p-1 flex items-center justify-center hover:-translate-y-1.5 hover:shadow-[0_25px_50px_rgba(0,0,0,0.65),_0_0_40px_rgba(221,179,4,0.25)] transition-all duration-500 ease-out">
                
                <!-- Corner Screws (Dome head rivets style) -->
                <!-- Top-Left Screw -->
                <div class="absolute top-2 left-2 sm:top-3 sm:left-3 w-3 h-3 sm:w-3.5 sm:h-3.5 rounded-full bg-gradient-to-tl from-[#6d5122] via-[#B19657] to-[#fffde2] shadow-[0_2px_3px_rgba(0,0,0,0.3),_inset_0_1px_1px_rgba(255,255,255,0.5)]">
                    <div class="w-full h-full rounded-full flex items-center justify-center opacity-40">
                        <div class="w-2 h-[1.5px] bg-[#4a3411] rotate-45"></div>
                    </div>
                </div>
                <!-- Top-Right Screw -->
                <div class="absolute top-2 right-2 sm:top-3 sm:right-3 w-3 h-3 sm:w-3.5 sm:h-3.5 rounded-full bg-gradient-to-tl from-[#6d5122] via-[#B19657] to-[#fffde2] shadow-[0_2px_3px_rgba(0,0,0,0.3),_inset_0_1px_1px_rgba(255,255,255,0.5)]">
                    <div class="w-full h-full rounded-full flex items-center justify-center opacity-40">
                        <div class="w-2 h-[1.5px] bg-[#4a3411] -rotate-12"></div>
                    </div>
                </div>
                <!-- Bottom-Left Screw -->
                <div class="absolute bottom-2 left-2 sm:bottom-3 sm:left-3 w-3 h-3 sm:w-3.5 sm:h-3.5 rounded-full bg-gradient-to-tl from-[#6d5122] via-[#B19657] to-[#fffde2] shadow-[0_2px_3px_rgba(0,0,0,0.3),_inset_0_1px_1px_rgba(255,255,255,0.5)]">
                    <div class="w-full h-full rounded-full flex items-center justify-center opacity-40">
                        <div class="w-2 h-[1.5px] bg-[#4a3411] rotate-[115deg]"></div>
                    </div>
                </div>
                <!-- Bottom-Right Screw -->
                <div class="absolute bottom-2 right-2 sm:bottom-3 sm:right-3 w-3 h-3 sm:w-3.5 sm:h-3.5 rounded-full bg-gradient-to-tl from-[#6d5122] via-[#B19657] to-[#fffde2] shadow-[0_2px_3px_rgba(0,0,0,0.3),_inset_0_1px_1px_rgba(255,255,255,0.5)]">
                    <div class="w-full h-full rounded-full flex items-center justify-center opacity-40">
                        <div class="w-2 h-[1.5px] bg-[#4a3411] rotate-45"></div>
                    </div>
                </div>

                <!-- Burgundy Plate (SVG Shape for top arch + gold stroke) -->
                <div class="absolute inset-0 w-full h-full pointer-events-none p-3 sm:p-4">
                    <svg class="w-full h-full drop-shadow-[0_2px_4px_rgba(0,0,0,0.4)]" viewBox="0 0 320 320" fill="none" xmlns="http://www.w3.org/2000/svg">
                        <!-- Burgundy plate shape -->
                        <path d="M 60 45 L 120 45 C 126 45, 138 15, 160 15 C 182 15, 194 45, 200 45 L 260 45 C 270 45, 280 55, 280 65 L 280 265 C 280 275, 270 285, 260 285 L 60 285 C 50 285, 40 275, 40 265 L 40 65 C 40 55, 50 45, 60 45 Z" fill="#5C113C" />
                        <!-- Inner Gold Inset Line -->
                        <path d="M 65 50 L 122 50 C 128 50, 139 20, 160 20 C 181 20, 192 50, 198 50 L 255 50 C 265 50, 275 60, 275 70 L 275 260 C 275 270, 265 280, 255 280 L 65 280 C 55 280, 45 270, 45 260 L 45 70 C 45 60, 55 50, 65 50 Z" stroke="#E2C98A" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" />
                        
                        <!-- Fingerprint/Q Logo Inside Arch (centered at x=160, y=34) -->
                        <g transform="translate(148, 18)" stroke="#E2C98A" stroke-width="1.5" stroke-linecap="round" fill="none">
                            <!-- Ridge 1 (Center loop) -->
                            <path d="M13 10 C13 8.8 11.8 8.8 11.8 10 C11.8 11.6 14.2 13.2 14.2 15.6 C14.2 17.2 13 18.4 13 19.6" />
                            <!-- Ridge 2 -->
                            <path d="M10.6 10 C10.6 7.2 13.8 7.2 14.2 9.2 C14.6 11.2 11.8 13.6 11.8 16.4 C11.8 18.4 13.4 20 15 21.2" />
                            <!-- Ridge 3 -->
                            <path d="M8.6 10.8 C8.6 6 15 5.6 15.8 9.2 C16.6 12.4 12.2 14.8 12.2 18 C12.2 20.8 14.6 23.2 16.2 23.6" />
                            <!-- Ridge 4 -->
                            <path d="M6.6 12.4 C6.6 4.8 17 4.4 17.8 10 C18.2 14 13.4 20.4 C13.4 23.2 15.8 25.2 17.4 26" />
                            <!-- The outer 'Q' oval -->
                            <path d="M18.6 20 C20 18.4 20.6 16.4 20.6 14.4 C20.6 9.6 16.8 6 12.2 6 C7.6 6 3.8 9.6 3.8 14.4 C3.8 19.2 7.6 22.8 12.2 22.8 C13.8 22.8 15.2 22.2 16.4 21.4" />
                            <!-- Q-tail/handle -->
                            <path d="M17.8 22.2 L 21 26.2" stroke-width="2.2" />
                        </g>
                    </svg>
                </div>

                <!-- Golden QR Code Box (Overlay centered) -->
                <div class="absolute w-[58%] aspect-square top-[51.5%] left-1/2 transform -translate-x-1/2 -translate-y-1/2 rounded-xl overflow-hidden border-[2.5px] border-[#D4AF37] bg-[#F4F0E9] p-1.5 shadow-[0_4px_10px_rgba(0,0,0,0.5),_inset_0_1px_3px_rgba(0,0,0,0.2)]">
                    
                    <img src="data:image/svg+xml;base64,"
                        data-ms-field="principal.qr.target"
                        alt="QR Explora el Centro Histórico" class="w-full h-full object-contain select-none">
                </div>

            </div>

        </div>
    </div>
</section>
