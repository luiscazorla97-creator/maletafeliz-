uot;,&quot;mp_account_creation_error_msg&quot;:&quot;&quot;,&quot;mp_disable_renewal&quot;:0,&quot;multi_step_checkout&quot;:0,&quot;address_req&quot;:0,&quot;cancellation_ins&quot;:&quot;&quot;,&quot;cover_the_fees&quot;:&quot;{\&quot;cover_xtl_fees\&quot;:\&quot;0\&quot;,\&quot;cover_xtl_designation_id\&quot;:\&quot;0592d860-a0db-45e9-8e96-aab1f7ad5b3c\&quot;,\&quot;cover_proc_fees\&quot;:\&quot;0\&quot;,\&quot;cover_proc_designation_id\&quot;:\&quot;0592d860-a0db-45e9-8e96-aab1f7ad5b3c\&quot;,\&quot;cover_proc_amount\&quot;:\&quot;\&quot;,\&quot;cover_proc_perc\&quot;:\&quot;\&quot;,\&quot;cover_xtl_markup\&quot;:\&quot;\&quot;,\&quot;cover_xtl_label\&quot;:\&quot;\&quot;,\&quot;cover_proc_label\&quot;:\&quot;\&quot;,\&quot;cover_prompt_image\&quot;:\&quot;\&quot;,\&quot;cover_prompt_title\&quot;:\&quot;\&quot;,\&quot;cover_prompt_button\&quot;:\&quot;\&quot;,\&quot;cover_prompt_details\&quot;:\&quot;\&quot;,\&quot;cover_allow_custom\&quot;:\&quot;0\&quot;}&quot;,&quot;sales_method_id&quot;:&quot;5b5ba755-d07a-4f77-b952-e0c9a09a2ff6&quot;,&quot;sales_method_id_zero_dollar&quot;:&quot;5b5ba755-d07a-4f77-b952-e0c9a09a2ff6&quot;,&quot;delivery_method_id&quot;:&quot;4421f714-a106-4907-8664-33144206900e&quot;}"></div>
<div id="pageJson" class="data_div" data-json="{&quot;id&quot;:975,&quot;portal_id&quot;:4,&quot;sequence&quot;:6,&quot;type&quot;:7,&quot;route&quot;:&quot;tickets&quot;,&quot;program_id&quot;:&quot;afb3bb68-3823-4a98-b3d4-2687c6327d0d&quot;,&quot;level_id&quot;:&quot;&quot;,&quot;custom_name&quot;:&quot;Illuminate 2026 options&quot;,&quot;img_path&quot;:&quot;ITEM|tickets|afb3bb68-3823-4a98-b3d4-2687c6327d0d|-sabg illuminate XTL.png&quot;,&quot;blurb&quot;:&quot;November 20, 2026 \u2013 January 10, 2027\nClosed: Thanksgiving, Christmas, and New Year's Day | Sensory-Friendly Night: Tuesday, December 1, 2026 5:30 - 7:00 p.m. enjoy the trail without sound.&quot;,&quot;details&quot;:&quot;&lt;p&gt;Step into a glowing wonderland filled with all-new handcrafted lanterns, dazzling light displays, and larger-than-life illuminated sculptures. Wander through radiant trails that wind through the beauty of the Garden, creating unforgettable moments for families, date nights, and holiday outings with friends.&lt;\/p&gt;\n&lt;h2&gt;General Admission Illuminate Tickets (Mon &amp;ndash; Sun)&lt;\/h2&gt;\n&lt;ul&gt;\n&lt;li&gt;&lt;strong&gt;Public Ticket Pricing:&lt;\/strong&gt; $29.99 for adults and $26.99 for children (children under 3 are free), plus applicable fees.&lt;\/li&gt;\n&lt;li&gt;&lt;strong&gt;Member Ticket Pricing*:&lt;\/strong&gt; $24.99 for both adults and children (children under 3 are free), with no added fees.&lt;\/li&gt;\n&lt;\/ul&gt;\n&lt;p&gt;Tickets are sold in 30-minute time slots, which serve as your designated entry time to the exhibition. A limited number of walk-up tickets may be available at the front kiosk, depending on remaining inventory. Ticket prices do not include parking.&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\&quot;color: #000000; background-color: #eccafa;\&quot;&gt;&lt;em&gt;All discounts are applied automatically at checkout. Please note that when member fees are waived, &lt;strong&gt;the discount is deducted from the ticket price&lt;\/strong&gt;, but the fee line item will still appear in the order summary.&lt;\/em&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\&quot;color: #000000; background-color: #eccafa;\&quot;&gt;&lt;em&gt;&lt;strong&gt;General admission ticket sales end 3 hours before each time slot&lt;\/strong&gt;; &lt;\/em&gt;afterward, only Same-Day tickets will be available online for an additional $5 per ticket. General admission sales close 3 hours before each time slot&amp;mdash;after that, only Same-Day tickets are available online with a $5\/ticket premium (available day-of only, not in advance).&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\&quot;font-size: 18pt;\&quot;&gt;&lt;strong&gt;&lt;span style=\&quot;color: #000000; background-color: #ffffff;\&quot;&gt;Meet Santa Add-On&lt;\/span&gt;&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;span style=\&quot;color: #000000; background-color: #ffffff;\&quot;&gt;Let Santa know what's on your wish list this holiday season and add extra magic to your Illuminate experience with a visit with Santa add-on! On select dates, families can spend time with Santa and enjoy a special treat. Families are welcome to take personal photos with Santa.&lt;\/span&gt;&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;&lt;u&gt;Dates &amp;amp; Times: &lt;\/u&gt;&lt;\/strong&gt;&lt;\/p&gt;\n&lt;ul&gt;\n&lt;li&gt;November 27 | 5:30 p.m. &amp;ndash; 8:00 p.m.&lt;\/li&gt;\n&lt;li&gt;November 28 | 6:00 p.m. &amp;ndash; 8:00 p.m.&lt;\/li&gt;\n&lt;li&gt;December 5 | 5:30 p.m. -8:00 p.m.&lt;\/li&gt;\n&lt;li&gt;December 13 | 5:30 p.m. &amp;ndash; 8:00 p.m.&lt;\/li&gt;\n&lt;li&gt;December 21 | 5:30 p.m. &amp;ndash; 8:00 p.m.&lt;\/li&gt;\n&lt;\/ul&gt;\n&lt;p&gt;1 ticket includes the whole family! Only Illuminate ticket holders are eligible for this exclusive opportunity.&lt;\/p&gt;\n&lt;hr \/&gt;\n&lt;h2&gt;Parking&lt;\/h2&gt;\n&lt;p&gt;Parking is available on-site for $20 and must be purchased online in advance. The Garden has taken additional steps to improve your parking and entry experience. Full parking and traffic instructions will be available at &lt;a href=\&quot;https:\/\/sabgtx.org\/exhibition\/illuminate\/\&quot; target=\&quot;_blank\&quot; rel=\&quot;noopener\&quot;&gt;sabgtx.org\/illuminate&lt;\/a&gt;.&lt;\/p&gt;\n&lt;p&gt;Reserve your parking up to 15 minutes before your exhibit time for easy entry.&lt;\/p&gt;\n&lt;hr \/&gt;\n&lt;h2&gt;Flex Tickets&lt;\/h2&gt;\n&lt;p&gt;Experience the enchantment of &lt;em&gt;Illuminate&lt;\/em&gt; at the San Antonio Botanical Garden on any day you choose, with no need to commit to a specific date. Great for gift-giving!&lt;\/p&gt;\n&lt;p&gt;&lt;strong&gt;2026 Illuminate Flex Any Day Single Ticket:&lt;\/strong&gt;&lt;\/p&gt;\n&lt;ul&gt;\n&lt;li&gt;Available at a flat rate of $39.99 for both adults and children. Please note that member discounts do not apply to flex tickets.&lt;\/li&gt;\n&lt;\/ul&gt;\n&lt;p&gt;Tickets are non-refundable. A $10 rescheduling fee applies to all date or time changes. The Garden is closed for Thanksgiving, Christmas, and New Year's Day.&lt;\/p&gt;\n&lt;hr \/&gt;\n&lt;p&gt;&lt;span style=\&quot;background-color: #eccafa;\&quot;&gt;&lt;strong&gt;For December 1st only, ticket holders who pick timed entry between 5:30 &amp;ndash; 7 p.m. have the choice to enjoy the trail without sound or can bring their own headphones for an individual audio experience. The Garden is also partnering with DisabilitySA to have universal changing stations available.&lt;\/strong&gt;&lt;\/span&gt;&lt;\/p&gt;&quot;,&quot;members_only&quot;:0,&quot;hidden&quot;:0,&quot;disabled&quot;:0,&quot;visible_products&quot;:&quot;[]&quot;,&quot;disable_custom_donation&quot;:0,&quot;donation_designation_amounts&quot;:&quot;&quot;,&quot;enable_recurring_donations&quot;:0,&quot;recurring_donation_settings&quot;:&quot;&quot;,&quot;custom_data&quot;:[{&quot;type&quot;:2,&quot;program_id&quot;:&quot;3e971777-a675-46c0-a480-e451f112d6a0&quot;,&quot;level_id&quot;:&quot;&quot;,&quot;term_id&quot;:&quot;194b862f-4afe-41b2-a857-3c47d65cb9a3&quot;,&quot;member_only&quot;:0},{&quot;type&quot;:2,&quot;program_id&quot;:&quot;5d4bf1bf-47c7-41fa-b6d6-6f4b98509969&quot;,&quot;level_id&quot;:&quot;&quot;,&quot;term_id&quot;:&quot;8a9e89ff-77bf-47c7-80a9-ea910593240d&quot;,&quot;member_only&quot;:0},{&quot;type&quot;:2,&quot;program_id&quot;:&quot;5d4bf1bf-47c7-41fa-b6d6-6f4b98509969&quot;,&quot;level_id&quot;:&quot;&quot;,&quot;term_id&quot;:&quot;42a32a5c-8696-47a2-a2db-0cb4d63dfec5&quot;,&quot;member_only&quot;:0},{&quot;type&quot;:2,&quot;program_id&quot;:&quot;b37ae422-93a7-4f6b-8a55-8a66470ceb84&quot;,&quot;level_id&quot;:&quot;&quot;,&quot;term_id&quot;:&quot;722a6248-7e7a-438f-8b24-08b928caae67&quot;,&quot;member_only&quot;:0},{&quot;type&quot;:2,&quot;program_id&quot;:&quot;53edbbda-d400-4b91-8b04-28dc1a0dbe5d&quot;,&quot;level_id&quot;:&quot;&quot;,&quot;term_id&quot;:&quot;070badd9-5d86-4d3c-b7e8-8f17583fb17b&quot;,&quot;member_only&quot;:0},{&quot;type&quot;:2,&quot;program_id&quot;:&quot;53edbbda-d400-4b91-8b04-28dc1a0dbe5d&quot;,&quot;level_id&quot;:&quot;&quot;,&quot;term_id&quot;:&quot;27b4d10d-843b-4cdf-b8aa-6ec0a2f58ee1&quot;,&quot;member_only&quot;:0},{&quot;type&quot;:2,&quot;program_id&quot;:&quot;7776a82e-08b7-4b8d-bf41-066295bacd32&quot;,&quot;level_id&quot;:&quot;&quot;,&quot;term_id&quot;:&quot;8a9e89ff-77bf-47c7-80a9-ea910593240d&quot;,&quot;member_only&quot;:0},{&quot;type&quot;:2,&quot;program_id&quot;:&quot;7776a82e-08b7-4b8d-bf41-066295bacd32&quot;,&quot;level_id&quot;:&quot;&quot;,&quot;term_id&quot;:&quot;42a32a5c-8696-47a2-a2db-0cb4d63dfec5&quot;,&quot;member_only&quot;:0}],&quot;layout_type&quot;:0,&quot;variable_price_display&quot;:0,&quot;event_list_type&quot;:0,&quot;event_list_days&quot;:0,&quot;event_list_range_start&quot;:&quot;0000-00-00&quot;,&quot;event_list_range_end&quot;:&quot;0000-00-00&quot;,&quot;event_list_detail&quot;:&quot;&quot;,&quot;upsell_status&quot;:0,&quot;upsell_title&quot;:&quot;&quot;,&quot;upsell_image&quot;:&quot;&quot;,&quot;upsell_rules&quot;:&quot;&quot;,&quot;order_notes&quot;:null,&quot;crosssales&quot;:[{&quot;index&quot;:0,&quot;status&quot;:1,&quot;title&quot;:&quot;2 Add on options for a perfect evening - Visit Santa &amp; Parking&quot;,&quot;source_id&quot;:&quot;5d4bf1bf-47c7-41fa-b6d6-6f4b98509969&quot;,&quot;source_type&quot;:2,&quot;targets_id_one&quot;:&quot;950&quot;,&quot;targets_detail_one&quot;:&quot;Reserve your parking up to 15 minutes before your exhibit entry time.&quot;,&quot;targets_id_two&quot;:&quot;1021&quot;,&quot;targets_detail_two&quot;:&quot;Elevate your Experience! Meet Santa and have a cookie.  1 ticket includes the whole family on select nights. Only Illuminate ticket holders are eligible for this exclusive opportunity.&quot;,&quot;target_list&quot;:[{&quot;ui&quot;:&quot;Tickets - Illuminate 2026 Onsite Parking&quot;,&quot;id&quot;:950},{&quot;ui&quot;:&quot;Tickets - Illuminate 2026 Flex&quot;,&quot;id&quot;:961},{&quot;ui&quot;:&quot;Tickets - Illuminate 2026&quot;,&quot;id&quot;:965},{&quot;ui&quot;:&quot;Tickets - Dough &amp; Glow&quot;,&quot;id&quot;:972},{&quot;ui&quot;:&quot;Tickets - Pizza: The dough before the glow&quot;,&quot;id&quot;:974},{&quot;ui&quot;:&quot;Tickets - Illuminate 2026 options&quot;,&quot;id&quot;:975},{&quot;ui&quot;:&quot;Tickets - Illuminate 2026 Mahncke Park&quot;,&quot;id&quot;:985},{&quot;ui&quot;:&quot;Tickets - 2026 Illuminate HEB Employee Night&quot;,&quot;id&quot;:996},{&quot;ui&quot;:&quot;Tickets - 2026 Illuminate HEB Employee Parking Reservation&quot;,&quot;id&quot;:997},{&quot;ui&quot;:&quot;Tickets - 2026 Illuminate HEB Flex&quot;,&quot;id&quot;:998},{&quot;ui&quot;:&quot;Tickets - Illuminate 2026 Flex Savings&quot;,&quot;id&quot;:1007},{&quot;ui&quot;:&quot;Tickets - 2026 ILLUMINATE VIP NIGHT&quot;,&quot;id&quot;:1008},{&quot;ui&quot;:&quot;Tickets - 2026 ILLUMINATE VIP FLEX&quot;,&quot;id&quot;:1011},{&quot;ui&quot;:&quot;Tickets - 2026 ILLUMINATE VIP Parking&quot;,&quot;id&quot;:1012},{&q