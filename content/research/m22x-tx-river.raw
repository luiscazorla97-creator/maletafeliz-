<script>
	require([
		'plugins_common_custom_utils',
		'sv_load!site_tripbuilder',
		'domReady!'
	], function(
		utils,
		tripbuilder,
	) {
		const page = document.querySelector('[data-panel-page]');
		const root = document.querySelector('[data-guid="95768f90-1585-4294-9495-0a63c4c6708b"]');
		const headerContainer = document.querySelector('[data-header-container]');
		const tbLink = root.querySelector('[data-tripbuilder-sticky-link]');
		let headerHeight = 0;

		function resizeHandler() {
			const height = headerContainer.offsetHeight;

			scrollHandler();

			if (height === headerHeight) return;

			page.style.paddingTop = `${height}px`;
			headerHeight = height;
		}

		function scrollHandler() {
			if (window.scrollY >= 100 && !root.classList.contains('scrolled')) {
				root.classList.add('scrolled');
			}
			else if (window.scrollY < 100 && root.classList.contains('scrolled')) {
				root.classList.remove('scrolled');
			}
		}

		resizeHandler();
		scrollHandler();
		['resize', 'orientationchange'].forEach(ev => window.addEventListener(ev, utils.debounce(resizeHandler, 200)));
		window.addEventListener('scroll', scrollHandler);

		if (tbLink && tripbuilder?.enabled) tbLink.setAttribute('href', tripbuilder.path);
	});
</script></div>
