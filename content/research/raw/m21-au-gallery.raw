import("/assets/entry.client-DijddSRx.js");</script><!--$?--><template id="B:0"></template><!--/$--><script id="_R_">requestAnimationFrame(function(){$RT=performance.now()});</script><div hidden id="S:0"><script>window.__reactRouterContext.streamController.enqueue("[{\"_1\":2,\"_340\":-5,\"_341\":-5},\"loaderData\",{\"_3\":4,\"_42\":43},\"root\",{\"_5\":6,\"_26\":27},\"globalFields\",[7,14,18,22],{\"_8\":9,\"_10\":11,\"_12\":13},\"id\",2,\"name\",\"opening_hours_desktop\",\"fields\",\"We’re open every day from 10am to 5pm, except Christmas Day\",{\"_8\":15,\"_10\":16,\"_12\":17},3,\"opening_hours_mobile\",\"Open every day from 10am to 5pm\",{\"_8\":19,\"_10\":20,\"_12\":21},1,\"notification\",\"\",{\"_8\":23,\"_10\":24,\"_12\":25},4,\"notification_enabled\",\"false\",\"seasonalEventsOptions\",[28,33,36,39],{\"_29\":30,\"_31\":32},\"value\",\"matariki\",\"label\",\"Mātariki\",{\"_29\":34,\"_31\":35},\"te-wiki-o-te-reo-maori\",\"Te Wiki o Te Reo Māori\",{\"_29\":37,\"_31\":38},\"pride\",\"Pride\",{\"_29\":40,\"_31\":41},\"picasso-designed-by-paul-smith\",\"Picasso Designed by Paul Smith\",\"routes/ContentPage.catch-all\",{\"_8\":44,\"_45\":46,\"_47\":48,\"_339\":82},\"38\",\"slug\",\"plan-your-visit\",\"attributes\",{\"_8\":49,\"_50\":51,\"_52\":53,\"_54\":55,\"_56\":57,\"_58\":-5,\"_59\":60,\"_10\":61,\"_45\":46,\"_62\":63,\"_64\":65,\"_66\":67,\"_68\":69,\"_70\":71,\"_286\":287,\"_288\":82,\"_289\":290,\"_291\":292,\"_293\":-5,\"_294\":295,\"_332\":333},38,\"entity\",\"page\",\"seo_title\",\"Plan Your Visit to Auckland Art Gallery | Free Entry Guide\",\"seo_keywords\",\"Auckland Art Gallery, plan your visit Auckland Art Gallery, Auckland Art Gallery tickets, Auckland Art Gallery opening hours, free art gallery Auckland, Auckland Art Gallery parking, Auckland Art Gallery map, Auckland CBD art gallery, Auckland Art Gallery\",\"seo_description\",\"Plan your visit to Auckland Art Gallery with free entry details, opening hours, tickets, directions, parking, maps and visitor facilities.\",\"page_type\",\"url\",\"/visit/plan-your-visit\",\"Plan your visit\",\"subtitle\",\"Everything you need to know to plan your visit including getting here, ticketing and admission and a Gallery map.\",\"main_image\",\"https://cdn.aucklandunlimited.com/aag/assets/media/visit-auckland-art-gallery-3.jpg\",\"thumbnail_image\",\"https://cdn.aucklandunlimited.com/aag/assets/media/visit-auckland-art-gallery-thumbnail-web.jpg\",\"mobile_hero_image\",\"https://cdn.aucklandunlimited.com/aag/assets/media/visit-auckland-art-gallery-mobile.jpg\",\"blocks\",[72,101,113,143,158,208,216,226,247,253,261],{\"_73\":74,\"_75\":76},\"type\",\"calltoaction\",\"data\",{\"_77\":78,\"_79\":80,\"_81\":82,\"_83\":21,\"_84\":85,\"_86\":87,\"_88\":89,\"_90\":91,\"_92\":93,\"_94\":95,\"_96\":97,\"_98\":99,\"_100\":97},\"image\",\"https://cdn.aucklandunlimited.com/aag/assets/media/auckland-art-gallery-building-entrance.jpg\",\"content\",\"\u003ch4\u003eLocation and opening hours\u003c/h4\u003e\\n\\n\u003cp\u003eCorner of Wellesley Street East and Kitchener Street, Auckland, Aotearoa New Zealand 1010\u003c/p\u003e\\n\\n\u003cp\u003eEnter through the main doors at 1 Kitchener Street.\u003c/p\u003e\\n\\n\u003cp\u003eOpen every day from 10am to 5pm, except Christmas Day.\u003c/p\u003e\\n\",\"has_dot\",true,\"image_alt\",\"button_link\",\"https://www.google.com/maps/place/Auckland+Art+Gallery/@-36.851354,174.7636621,17z/data=!3m2!4b1!5s0x6d0d47e4cf20b07b:0x6b79e1629f710530!4m6!3m5!1s0x6d0d47fb2e12486d:0x3e90bef6528b7215!8m2!3d-36.851354!4d174.766237!16zL20vMDlzeHpf?entry=tts\u0026g_ep=EgoyMDI2MDEyNy4wIPu8ASoASAFQAw%3D%3D\u0026skid=5d008306-f3dd-44ef-ac8a-82094d198a6f\",\"image_ratio\",\"50/50\",\"button_label\",\"Get directions\",\"button_style\",\"default\",\"body_font_size\",\"body-large\",\"image_position\",\"right\",\"has_arrow_style\",false,\"background_color\",\"#C1BFCB\",\"button_full_width\",{\"_73\":102,\"_75\":103},\"richtext\",{\"_104\":105,\"_79\":106,\"_107\":21,\"_108\":109,\"_110\":21,\"_111\":21,\"_112\":21},\"title\",\"Ticketing and admission\",\"\u003cp\u003eAdmission to our general collection exhibitions is \u003cstrong\u003efree for all\u003c/strong\u003e. Children under the age of 14 must be accompanied by an adult.\u0026nbsp;\u003c/p\u003e\\n\\n\u003cp\u003eCharges may apply for special exhibitions and events. Check our \u003ca href=\\\"/visit/events\\\"\u003eevents page\u003c/a\u003e\u0026nbsp;and \u003ca href=\\\"/visit/exhibitions\\\"\u003eexhibitions page\u003c/a\u003e for more information.\u003c/p\u003e\\n\",\"button_url\",\"style_type\",\"rich_text_1\",\"button_text\",\"quote_content\",\"right_content\",{\"_73\":114,\"_75\":115},\"gallery\",{\"_116\":117,\"_104\":137,\"_138\":82,\"_139\":97,\"_108\":140,\"_141\":142},\"items\",[118,125,129,133],{\"_119\":120,\"_121\":122,\"_123\":124},\"file\",\"https://cdn.aucklandunlimited.com/aag/assets/media/auckland-art-gallery-kitchener-street-entrance.jpg\",\"file_alt\",\"auckland-art-gallery-kitchener-street-entrance.jpg\",\"creditline\",\"\u003cp\u003eEnter Auckland Art Gallery Toi o Tāmaki on Kitchener Street, under the architectural kauri canopy.\u003c/p\u003e\\n\",{\"_119\":126,\"_121\":127,\"_123\":128},\"https://cdn.aucklandunlimited.com/aag/assets/media/auckland-art-gallery-light-filled-atrium.jpg\",\"auckland-art-gallery-light-filled-atrium.jpg\",\"\u003cp\u003eTe\u0026nbsp;Ātea | North Atrium on the mezzanine floor\u0026nbsp;at Auckland Art Gallery.\u003c/p\u003e\\n\",{\"_119\":130,\"_121\":131,\"_123\":132},\"https://cdn.aucklandunlimited.com/aag/assets/media/auckland-art-gallery-historic-art-gallery.jpg\",\"auckland-art-gallery-historic-art-gallery.jpg\",\"\u003cp\u003eThe Gallery has 4 floors of exhibition spaces to discover.\u003c/p\u003e\\n\",{\"_119\":134,\"_121\":135,\"_123\":136},\"https://cdn.aucklandunlimited.com/aag/assets/media/plan-your-visit-welcome-carousel-5.jpg\",\"plan-your-visit-welcome-carousel-5.jpg\",\"\u003cp\u003eThe historic clock tower at Auckland Art Gallery, in the heart of Auckland\u0026#39;s CBD.\u0026nbsp;\u003c/p\u003e\\n\",\"Welcome to Auckland Art Gallery\",\"border_top\",\"full_bleed\",\"2-image-carousel\",\"description\",\"\u003cp\u003eAuckland Art Gallery hosts\u0026nbsp;one of Aotearoa New Zealand\u0026rsquo;s largest and most inspiring collections of visual art.\u0026nbsp;From the moment you enter,\u0026nbsp;you\u0026rsquo;ll\u0026nbsp;be greeted by our friendly gallery assistants, who are available throughout the building to help with anything you need.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\\n\\n\u003cp\u003eHoused in one of the city\u0026rsquo;s most iconic buildings,\u0026nbsp;Auckland Art Gallery\u0026nbsp;Toi o\u0026nbsp;Tāmaki\u0026nbsp;includes 4 floors of exhibition\u0026nbsp;spaces\u0026nbsp;and\u0026nbsp;showcases\u0026nbsp;some of the best in New Zealand,\u0026nbsp;Māori\u0026nbsp;and Pacific art.\u0026nbsp;\u003c/p\u003e\\n\\n\u003cp\u003e\u003ca class=\\\"small primary button custom-btn\\\" href=\\\"/connect/about-us\\\" target=\\\"_blank\\\"\u003eAbout us\u003c/a\u003e\u003c/p\u003e\\n\",{\"_73\":144,\"_75\":145},\"accordion\",{\"_116\":146,\"_156\":157,\"_138\":82},[147,150,153],{\"_104\":148,\"_79\":149},\"By bus, train or ferry\",\"\u003cp\u003eThe closest train station to the Gallery is Te Waihorotiu, which is less than 10 minutes away on foot. The\u0026nbsp;Waitematā train station and the Auckland CBD Ferry Terminal are a 15-minute walk away.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\\n\\n\u003cp\u003eAuckland City Centre is serviced by Link buses to help you get around the CBD.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\\n\\n\u003cul\u003e\\n\\t\u003cli\u003e\\n\\t\u003cp\u003eThe OuterLink bus stops on Wellesley Street East near the corner of Lorne Street, which is a 1-minute walk to the Gallery.\u0026nbsp;\u003c/p\u003e\\n\\t\u003c/li\u003e\\n\\t\u003cli\u003e\\n\\t\u003cp\u003eThe CityLink bus stops on Queen Street near the corner of Wellesley Street East, which is a 3-minute walk to the Gallery.\u0026nbsp;\u003c/p\u003e\\n\\t\u003c/li\u003e\\n\u003c/ul\u003e\\n\\n\u003cp\u003ePlan your journey using the \u003ca href=\\\"https://at.govt.nz/bus-train-ferry/journey-planner/?timeMode=Leaving+now\u0026amp;date=2026-09-11T13%3A06%3A49%2B12%3A00\u0026amp;time=1%3A10pm\u0026amp;transportMode=bus%2Cferry%2Ctrain%2Cschoolbus\u0026amp;fareType=ADULT\u0026amp;maxWalkingTime=20\u0026amp;walkingSpeed=4.5\u0026amp;routeFilter=\u0026amp;showExternalProviders=true\u0026amp;preferredRoute=FASTEST\u0026amp;tab=pt\u0026amp;isCRLPreviewOn=false\\\"\u003eAuckland Transport journey planner\u003c/a\u003e for the\u0026nbsp;most up to date information about buses, trains and ferries.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\\n\\n\u003cp\u003eAuckland Transport also has the handy AT Mobile app to help you plan, save and track journeys across Auckland. Download the app from the \u003ca href=\\\"https://itunes.apple.com/nz/app/at-mobile/id1207704356?mt=8\\\" target=\\\"_blank\\\"\u003eApp Store\u003c/a\u003e\u0026nbsp;or the \u003ca href=\\\"https://play.google.com/store/apps/details?id=nz.govt.at.atmobile\u0026amp;hl=en\\\" target=\\\"_blank\\\"\u003eGoogle Play\u003c/a\u003e store.\u003c/p\u003e\\n\",{\"_104\":151,\"_79\":152},\"By car or taxi\",\"\u003cp\u003eYou\u0026rsquo;ll find many public and private car parks nearby.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\\n\\n\u003cp\u003eThe closest public car park is Auckland Transport\u0026rsquo;s \u003ca href=\\\"https://at.govt.nz/driving-and-parking/find-parking/parking-in-central-auckland/victoria-street-car-park\\\" target=\\\"_blank\\\"\u003eVictoria Street East car park\u003c/a\u003e,\u0026nbsp;which is a 4-minute walk from the Gallery. Rates start from $2.50 per hour on evenings, weekends and public holidays and $5.50 per hour on weekdays.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\\n\\n\u003cp\u003eParking rates vary based on time and location. Check the \u003ca href=\\\"https://at.govt.nz/driving-and-parking/find-parking/parking-in-central-auckland\\\" target=\\\"_blank\\\"\u003eAuckland Transport website\u003c/a\u003e\u0026nbsp;for more nearby parking options and pricing.\u0026nbsp;\u003c/p\u003e\\n\\n\u003cp\u003eTaxis can pick up and drop off from the loading bays in front of the Gallery on Kitchener Street.\u0026nbsp;\u003c/p\u003e\\n\",{\"_104\":154,\"_79\":155},\"By bike\",\"\u003cp\u003eAuckland City Centre is well connected to other parts of the city by shared paths and dedicated cycleways. Check the \u003ca href=\\\"https://mahere.at.govt.nz/portal/apps/experiencebuilder/experience/?id=0547bd817663487f9c148da9da284933\u0026amp;_gl=1*1cqk3ly*_gcl_au*MjQxMzkwNTgxLjE3NjQxOTM5Mzg.*_ga*NTU1MDIyMjYuMTc2NDE5MzkzOA..*_ga_WNC2W47P8Y*czE3Njk3MjMxMDkkbzckZzEkdDE3Njk3MjUwMzUkajU4JGwwJGgw\\\" target=\\\"_blank\\\"\u003eAuckland Transport cycleway map\u003c/a\u003e for routes and information.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\\n\\n\u003cp\u003eThere are bike racks for parking directly opposite the Gallery\u0026rsquo;s main entrance on Kitchener Street.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\\n\",\"heading\",\"Getting here\",{\"_73\":159,\"_75\":160},\"contentset\",{\"_161\":162,\"_116\":163,\"_104\":206,\"_138\":82,\"_107\":21,\"_108\":207,\"_110\":21,\"_141\":21},\"rows\",\"1\",[164,171,178,185,192,199],{\"_8\":165,\"_10\":166,\"_73\":51,\"_75\":167},\"page-43\",\"Tours and group visits\",{\"_10\":166,\"_62\":168,\"_59\":169,\"_66\":170,\"_58\":-5},\"Find out more about our free general collection tours, plus exhibition tours and other group visits to the Gallery.\",\"/visit/tours-and-group-visits\",\"https://cdn.aucklandunlimited.com/aag/assets/media/tours-auckland-art-gallery-thumbnail-web.jpg\",{\"_8\":172,\"_10\":173,\"_73\":51,\"_75\":174},\"page-69\",\"Café\",{\"_10\":173,\"_62\":175,\"_59\":176,\"_66\":177,\"_58\":-5},\"Discover the café at Auckland Art Gallery Toi o Tāmaki, serving delicious food and coffee daily in our sunny space just off Albert Park.\",\"/visit/cafe\",\"https://cdn.aucklandunlimited.com/aag/assets/media/cafe-670x450.jpg\",{\"_8\":179,\"_10\":180,\"_73\":51,\"_75\":181},\"page-74\",\"Education programmes\",{\"_10\":180,\"_62\":182,\"_59\":183,\"_66\":184,\"_58\":-5},\"The Gallery has free education programmes and resources for students of all ages. Find out more and book the learning experience that’s right for your class.\",\"/explore/education-programmes\",\"https://cdn.aucklandunlimited.com/aag/assets/media/education-programmes-auckland-art-gallery-web.jpg\",{\"_8\":186,\"_10\":187,\"_73\":51,\"_75\":188},\"page-39\",\"Accessibility\",{\"_10\":187,\"_62\":189,\"_59\":190,\"_66\":191,\"_58\":-5},\"If you have accessibility needs and want to get more involved or visit us, find out how the Gallery can support you.\",\"/visit/accessibility\",\"https://cdn.aucklandunlimited.com/aag/assets/media/accessibility-at-auckland-art-gallery-thumbnail-mobile.jpg\",{\"_8\":193,\"_10\":194,\"_73\":51,\"_75\":195},\"page-42\",\"Members lounge\",{\"_10\":194,\"_62\":196,\"_59\":197,\"_66\":198,\"_58\":-5},\"Find out more about the Members lounge including opening hours, access and private hire.\",\"/visit/members-lounge\",\"https://cdn.aucklandunlimited.com/aag/assets/media/auckland-art-gallery-members-lounge-web-thumbnail.jpg\",{\"_8\":200,\"_10\":201,\"_73\":51,\"_75\":202},\"page-53\",\"Library and archive\",{\"_10\":201,\"_62\":203,\"_59\":204,\"_66\":205,\"_58\":-5},\"Find opening hours, contact details and collection information for the E H McCormick Research Library and Archive at Auckland Art Gallery.\",\"/explore/library-and-archive\",\"https://cdn.aucklandunlimited.com/aag/assets/media/auckland-art-gallery-research-library-web.jpg\",\"Explore Auckland Art Gallery\",\"3up_card\",{\"_73\":74,\"_75\":209},{\"_77\":210,\"_79\":211,\"_81\":82,\"_83\":21,\"_84\":212,\"_86\":87,\"_88\":213,\"_90\":91,\"_92\":93,\"_94\":95,\"_96\":97,\"_214\":21,\"_98\":215,\"_100\":97},\"https://cdn.aucklandunlimited.com/aag/assets/media/auckland-art-gallery-shop-gifts.jpg\",\"\u003ch2\u003eVisit our shop\u003c/h2\u003e\\n\\n\u003cp\u003eDiscover beautifully designed pieces, New Zealand art prints and locally made taonga at Auckland Art Gallery\u0026rsquo;s design store. Open every day from 10am to 5pm, except Christmas Day.\u0026nbsp;\u003c/p\u003e\\n\",\"https://shop.aucklandartgallery.com/\",\"Shop online\",\"section_heading\",\"#5F98AD\",{\"_73\":74,\"_75\":217},{\"_77\":218,\"_79\":219,\"_81\":97,\"_83\":21,\"_138\":97,\"_84\":220,\"_86\":91,\"_88\":221,\"_90\":91,\"_222\":82,\"_92\":223,\"_94\":224,\"_96\":97,\"_100\":97,\"_225\":221},\"https://cdn.aucklandunlimited.com/aag/assets/media/visit-auckland-art-gallery-map.jpg\",\"\u003ch3\u003eGallery map\u003c/h3\u003e\\n\\n\u003cp\u003eExplore our interactive gallery map online.\u003c/p\u003e\\n\",\"/visit/plan-your-visit/interactive-gallery-map\",\"See the map\",\"image_no_crop\",\"body-medium\",\"left\",\"header_button_label\",{\"_73\":159,\"_75\":227},{\"_161\":162,\"_116\":228,\"_104\":243,\"_244\":245,\"_138\":82,\"_107\":21,\"_108\":246,\"_110\":21,\"_141\":21},[229,236],{\"_8\":230,\"_10\":231,\"_73\":51,\"_75\":232},\"page-52\",\"Exhibitions\",{\"_10\":231,\"_62\":233,\"_59\":234,\"_66\":235,\"_58\":-5},\"See what's currently on display at Auckland Art Gallery Toi o Tāmaki and explore past exhibitions.\",\"/visit/exhibitions\",\"https://cdn.aucklandunlimited.com/aag/assets/media/exhibitions-auckland-art-gallery-search-thumbnail.jpg\",{\"_8\":237,\"_10\":238,\"_73\":51,\"_75\":239},\"page-51\",\"Events\",{\"_10\":238,\"_62\":240,\"_59\":241,\"_66\":242,\"_58\":-5},\"Explore what's on at Auckland Art Gallery Toi o Tāmaki. Find talks, tours, workshops, family-friendly events and more.\",\"/visit/events\",\"https://cdn.aucklandunlimited.com/aag/assets/media/events-auckland-art-gallery-thumbnail.jpg\",\"What's on\",\"up_layout\",\"grid\",\"2up_card\",{\"_73\":102,\"_75\":248},{\"_104\":249,\"_79\":250,\"_138\":82,\"_107\":251,\"_108\":109,\"_110\":252,\"_111\":21,\"_112\":21},\"Get in touch\",\"\u003cp\u003e\u003cstrong\u003eHave questions?\u003c/strong\u003e We\u0026rsquo;re happy to help. Fill out the form to contact us and we\u0026rsquo;ll get back to you as soon as possible.\u0026nbsp;\u003c/p\u003e\\n\",\"/connect/get-in-touch\",\"Contact us\",{\"_73\":254,\"_75\":255},\"ctabannerpattern\",{\"_79\":256,\"_138\":82,\"_107\":257,\"_110\":258,\"_259\":260},\"\u003ch3\u003eBecome a Member today\u003c/h3\u003e\\n\\n\u003cp\u003eGet more from the Gallery. Membership comes with tons of benefits like free entry to all exhibitions, 10% off in the shop, access to the Members lounge and much more.\u003c/p\u003e\\n\",\"/membership\",\"Become a Member\",\"image_color\",\"Peony\",{\"_73\":144,\"_75\":262},{\"_116\":263,\"_156\":285,\"_138\":82},[264,267,270,273,276,279,282],{\"_104\":265,\"_79\":266},\"Is free Wi-Fi available at the Gallery?\",\"\u003cp\u003eFree Wi-Fi access is available inside the Gallery. It is capped at 1GB of free data per calendar day.\u0026nbsp;\u0026nbsp;\u003c/p\u003e\\n\\n\u003cp\u003eTo connect:\u0026nbsp;\u003c/p\u003e\\n\\n\u003cul\u003e\\n\\t\u003cli\u003eEnable Wi-Fi on your device\u0026nbsp;\u003c/li\u003e\\n\\t\u003cli\u003eSelect \u0026lsquo;Auckland Art Gallery\u0026rsquo; \u0026ndash; a login page will automatically open\u0026nbsp;\u003c/li\u003e\\n\\t\u003cli\u003eClick \u0026lsquo;Accept\u0026rsquo; to get online.\u0026nbsp;\u003c/li\u003e\\n\u003c/ul\u003e\\n\",{\"_104\":268,\"_79\":269},\"What can I bring into the Gallery with me?\",\"\u003cp\u003eWe require visitors to check umbrellas, backpacks, shopping bags and large bags into our free cloakroom. To ensure the safety of artworks, the Gallery does not permit visitors to wear bags on their backs in the galleries. The Gallery reserves the right to refuse other items and is not responsible for items held in the cloakroom.\u0026nbsp;\u003c/p\u003e\\n\",{\"_104\":271,\"_79\":272},\"Where can I eat or drink in the Gallery?\",\"\u003cp\u003eNo food or drink is permitted in the Gallery, so we recommend a visit to our caf\u0026eacute; on level 1. If you have brought your own lunch, a nice spot to eat is in our amphitheatre behind the Gallery or in Albert Park.\u0026nbsp;\u003c/p\u003e\\n\\n\u003cp\u003ePeople who breastfeed are welcome to feed their babies on any of the public seating in the galleries. If you wish for a more private spot, there is a chair available in the accessible bathroom on the mezzanine floor.\u0026nbsp;\u003c/p\u003e\\n\\n\u003cp\u003eDue to restrictions on food and drink around artworks, bottle feeding for babies or toddlers can only take place in the seating areas in our North Atrium, South Atrium, up on the East Terrace or in the entrance foyer. Likewise, if children need a top-up of food during their visit, please use these areas only. We can assist in guiding you to the right area, so please ask the nearest gallery assistant for help.\u003c/p\u003e\\n\",{\"_104\":274,\"_79\":275},\"Can I smoke or vape in the Gallery?\",\"\u003cp\u003eSmoking and vaping are not permitted anywhere in the Gallery.\u0026nbsp;\u003c/p\u003e\\n\",{\"_104\":277,\"_79\":278},\"Can I host an event or party in the Gallery?\",\"\u003cp\u003eWhile we encourage you to celebrate birthdays and other special events with a visit, large groups should contact the Gallery prior to arrival to see if we can facilitate your request.\u0026nbsp;\u003c/p\u003e\\n\\n\u003cp\u003ePlease note: Parties are not permitted in the galleries or public spaces. Celebrations may only be held in a pre-booked venue within the Gallery. To find out more about venue hire in the Gallery spaces, visit the\u003ca href=\\\"https://www.aucklandconventions.co.nz/venues/auckland-art-gallery\\\" target=\\\"_blank\\\"\u003e Auckland Conventions, Venues \u0026amp; Events website\u003c/a\u003e.\u003c/p\u003e\\n\",{\"_104\":280,\"_79\":281},\"Can I photograph or film inside the Gallery?\",\"\u003cp\u003eWe encourage visitors to capture their favourite works and memories of visiting our exhibitions on display. However, to preserve the artworks and visitor experience, please adhere to the following photography and filming guidelines:\u003c/p\u003e\\n\\n\u003cul\u003e\\n\\t\u003cli\u003ePhotos and videos can be taken with\u0026nbsp;hand-held cameras for personal use only.\u003c/li\u003e\\n\\t\u003cli\u003eFilming and photography should not disrupt other visitors or be disrespectful to artworks or exhibitions.\u0026nbsp;\u003c/li\u003e\\n\\t\u003cli\u003eLivestreaming is not permitted without the Gallery\u0026#39;s prior permission.\u0026nbsp;\u003c/li\u003e\\n\\t\u003cli\u003eTo reduce the risk of damage to the art, the use of tripods, selfie sticks, external stabilising devices or other camera attachments, flash or additional lighting is not permitted without the permission of the Gallery. A request must be made and granted before such equipment can be used in any Gallery spaces.\u0026nbsp;\u0026nbsp;\u003c/li\u003e\\n\\t\u003cli\u003eAny images taken should not be reproduced or displayed on personal or company websites and must not be sold commercially or displayed publicly in any way that disrespects the subjects in the artworks or causes offence to any individuals or groups.\u0026nbsp;\u0026nbsp;\u003c/li\u003e\\n\\t\u003cli\u003ePlease follow any \u0026lsquo;No photography\u0026rsquo; signage as this indicates objects, exhibitions or events that cannot be filmed or photographed. This restriction may be for cultural reasons, due to copyright law, privacy, or to protect the people or objects involved.\u0026nbsp;\u0026nbsp;\u003c/li\u003e\\n\u003c/ul\u003e\\n\\n\u003cp\u003eIf these guidelines are not followed, you may be asked to stop taking photos and/or filming.\u0026nbsp;\u003c/p\u003e\\n\\n\u003cp\u003eTo request permission for photography or filming, please contact us via \u003ca href=\\\"mailto:marketing@aucklandartgallery.com?subject=Photography%20and%20filming%20enquiry\\\"\u003emarketing@aucklandartgallery.com\u003c/a\u003e. Please allow at least 5 working days for a response. Filming and photography are not always possible and may incur a fee. See our \u003ca href=\\\"https://www.aucklandartgallery.com/page/privacy-policy\\\" target=\\\"_blank\\\"\u003ecopyright\u003c/a\u003e\u003ca href=\\\"https://www.aucklandartgallery.com/page/privacy-policy\\\"\u003e\u0026nbsp;and privacy policy\u003c/a\u003e for more information.\u0026nbsp;\u003c/p\u003e\\n\",{\"_104\":283,\"_79\":284},\"Can I hold my wedding or engagement photoshoot in the Gallery?\",\"\u003cp\u003eThe Gallery does not allow wedding or engagement photography inside the building unless you have hired the venue for a wedding reception or ceremony. To find out more about venue hire in the Gallery spaces, visit the \u003ca href=\\\"https://www.aucklandconventions.co.nz/venues/auckland-art-gallery\\\" target=\\\"_blank\\\"\u003eAuckland Conventions, Venues \u0026amp; Events website\u003c/a\u003e.\u003c/p\u003e\\n\",\"Visitor FAQs\",\"tags\",[],\"is_published\",\"status\",\"published\",\"publish_at\",-62170025944000,\"expires_at\",\"hero_config\",{\"_296\":297,\"_156\":61,\"_324\":21,\"_139\":97,\"_325\":77,\"_326\":327,\"_328\":329,\"_330\":331},\"anchors\",[298,303,305,307,310,314,317,320],{\"_8\":299,\"_10\":300,\"_301\":302},\"location-and-hours-0\",\"Location and hours\",\"blockIndex\",0,{\"_8\":304,\"_10\":105,\"_301\":19},\"ticketing-and-admission-1\",{\"_8\":306,\"_10\":157,\"_301\":15},\"getting-here-3\",{\"_8\":308,\"_10\":309,\"_301\":23},\"explore-the-gallery-4\",\"Explore the Gallery\",{\"_8\":311,\"_10\":312,\"_301\":313},\"gallery-map-5\",\"Gallery map\",6,{\"_8\":315,\"_10\":243,\"_301\":316},\"whats-on-6\",7,{\"_8\":318,\"_10\":249,\"_301\":319},\"get-in-touch-8\",8,{\"_8\":321,\"_10\":322,\"_301\":323},\"faq-10\",\"FAQ\",10,\"video_url\",\"media_type\",\"subheading\",\"Located in the heart of Auckland CBD, Auckland Art Gallery Toi o Tāmaki is free to visit and open 10am to 5pm every day, except Christmas Day. Here’s everything you need to know to plan your visit to the Gallery.\",\"content_order\",\"text_top\",\"heading_maori\",\"Whakarite mai\",\"breadcrumbs\",[334,338],{\"_156\":335,\"_336\":337},\"Visit\",\"path\",\"/visit\",{\"_156\":61,\"_336\":60},\"isProduction\",\"actionData\",\"errors\"]\n");</script><!--$?--><template id="B:1"></template><!--/$--></div><script>$RB=[];$RV=function(a){$RT=performance.now();for(var b=0;b<a.length;b+=2){var c=a[b],e=a[b+1];null!==e.parentNode&&e.parentNode.removeChild(e);var f=c.parentNode;if(f){var g=c.previousSibling,h=0;do{if(c&&8===c.nodeType){var d=c.data;if("/$"===d||"/&"===d)if(0===h)break;else h--;else"$"!==d&&"$?"!==d&&"$~"!==d&&"$!"!==d&&"&"!==d||h++}d=c.nextSibling;f.removeChild(c);c=d}while(c);for(;e.firstChild;)f.insertBefore(e.firstChild,c);g.data="$";g._reactRetry&&requestAnimationFrame(g._reactRetry)}}a.length=0};
$RC=function(a,b){if(b=document.getElementById(b))(a=document.getElementById(a))?(a.previousSibling.data="$~",$RB.push(a,b),2===$RB.length&&("number"!==typeof $RT?requestAnimationFrame($RV.bind(null,$RB)):(a=performance.now(),setTimeout($RV.bind(null,$RB),2300>a&&2E3<a?2300-a:$RT+300-a)))):b.parentNode.removeChild(b)};$RC("B:0","S:0")</script><div hidden id="S:1"><script>window.__reactRouterContext.streamController.close();</script></div><script>$RC("B:1","S:1")</script></body></html>