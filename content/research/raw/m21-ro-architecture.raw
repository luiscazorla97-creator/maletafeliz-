        {"@graph": [{"@type": "Article", "author": {"name": "Rotterdam Partners", "@type": "Organization"}, "headline": "Architecture Rotterdam: top 10 must-sees for architecture lovers", "publisher": {"name": "Rotterdam Partners", "@type": "Organization"}, "description": "Discover ten architectural highlights that define Rotterdam's reputation as one of Europe's most innovative architecture cities, from De Rotterdam and the Erasmus Bridge to the Van Nelle Factory."}, {"@type": "BreadcrumbList", "itemListElement": [{"item": "https://www.rotterdam.info/en", "name": "Home", "@type": "ListItem", "position": 1}, {"item": "https://www.rotterdam.info/en/visit", "name": "Visit", "@type": "ListItem", "position": 2}, {"item": "https://www.rotterdam.info/en/visit/guide", "name": "Guide", "@type": "ListItem", "position": 3}, {"name": "Architecture Rotterdam: top 10 must-sees for architecture lovers", "@type": "ListItem", "position": 4}]}, {"name": "Architecture Rotterdam: top 10 must-sees for architecture lovers", "@type": "ItemList", "description": "A curated list of Rotterdam's most significant architectural landmarks, modern icons and design highlights.", "itemListOrder": "https://schema.org/ItemListOrderAscending", "numberOfItems": 10, "itemListElement": [{"item": {"@id": "https://www.rotterdam.info/en/visit/finder-locations/de-rotterdam#building", "url": "https://www.rotterdam.info/en/visit/finder-locations/de-rotterdam", "name": "De Rotterdam", "@type": "LandmarksOrHistoricalBuildings", "description": "A mixed-use skyscraper complex designed by OMA and Rem Koolhaas, completed in 2013 on the Wilhelminapier and often described as a vertical city.", "additionalProperty": [{"name": "Architect", "@type": "PropertyValue", "value": "OMA / Rem Koolhaas"}, {"name": "Completed", "@type": "PropertyValue", "value": "2013"}]}, "@type": "ListItem", "position": 1}, {"item": {"@id": "https://www.rotterdam.info/en/visit/finder-locations/de-zalmhaven#building", "url": "https://www.rotterdam.info/en/visit/finder-locations/de-zalmhaven", "name": "De Zalmhaven", "@type": "LandmarksOrHistoricalBuildings", "description": "The tallest residential building in the Netherlands, designed by Dam & Partners and completed in 2022 in Rotterdam's Scheepvaartkwartier.", "additionalProperty": [{"name": "Architect", "@type": "PropertyValue", "value": "Dam & Partners"}, {"name": "Completed", "@type": "PropertyValue", "value": "2022"}]}, "@type": "ListItem", "position": 2}, {"item": {"@id": "https://www.rotterdam.info/en/visit/finder-locations/erasmusbrug#bridge", "url": "https://www.rotterdam.info/en/visit/finder-locations/erasmusbrug", "name": "Erasmus Bridge", "@type": "Bridge", "description": "An iconic cable-stayed bridge designed by UNStudio that connects Rotterdam city centre with Kop van Zuid and is recognised by its distinctive swan-like pylon.", "alternateName": "Erasmusbrug", "additionalProperty": [{"name": "Architect", "@type": "PropertyValue", "value": "UNStudio"}, {"name": "Opened", "@type": "PropertyValue", "value": "1996"}]}, "@type": "ListItem", "position": 3}, {"item": {"@id": "https://www.rotterdam.info/en/visit/finder-locations/fenix#building", "url": "https://www.rotterdam.info/en/visit/finder-locations/fenix", "name": "Fenix", "@type": ["Museum", "LandmarksOrHistoricalBuildings"], "description": "A transformed harbour warehouse on Katendrecht featuring the Tornado staircase by MAD Architects and combining Rotterdam's maritime heritage with contemporary architecture.", "additionalProperty": [{"name": "Architect", "@type": "PropertyValue", "value": "MAD Architects"}, {"name": "Original building year", "@type": "PropertyValue", "value": "1923"}, {"name": "Opened as cultural building", "@type": "PropertyValue", "value": "2025"}]}, "@type": "ListItem", "position": 4}, {"item": {"@id": "https://www.rotterdam.info/en/visit/finder-locations/kubuswoningen-kijk-kubus-museumwoning#building", "url": "https://www.rotterdam.info/en/visit/finder-locations/kubuswoningen-kijk-kubus-museumwoning", "name": "Cube Houses", "@type": ["TouristAttraction", "LandmarksOrHistoricalBuildings"], "description": "Piet Blom's iconic tilted cube houses from 1984, representing one of Rotterdam's most innovative and internationally recognised housing concepts.", "alternateName": "Kubuswoningen", "additionalProperty": [{"name": "Architect", "@type": "PropertyValue", "value": "Piet Blom"}, {"name": "Completed", "@type": "PropertyValue", "value": "1984"}]}, "@type": "ListItem", "position": 5}, {"item": {"@id": "https://www.rotterdam.info/en/visit/finder-locations/kunsthal-rotterdam#museum", "url": "https://www.rotterdam.info/en/visit/finder-locations/kunsthal-rotterdam", "name": "Kunsthal Rotterdam", "@type": ["Museum", "LandmarksOrHistoricalBuildings"], "description": "A landmark museum building designed by Rem Koolhaas and OMA, celebrated for its unconventional circulation routes and innovative use of glass, steel and concrete.", "additionalProperty": [{"name": "Architect", "@type": "PropertyValue", "value": "Rem Koolhaas / OMA"}, {"name": "Opened", "@type": "PropertyValue", "value": "1992"}]}, "@type": "ListItem", "position": 6}, {"item": {"@id": "https://www.rotterdam.info/en/visit/finder-locations/centraal-station-rotterdam#station", "url": "https://www.rotterdam.info/en/visit/finder-locations/centraal-station-rotterdam", "name": "Rotterdam Central Station", "@type": "CivicStructure", "description": "A major transportation hub designed by Team CS, featuring a dramatic angular roof canopy and serving as the contemporary gateway to Rotterdam.", "alternateName": "Rotterdam Centraal", "additionalProperty": [{"name": "Architect", "@type": "PropertyValue", "value": "Team CS"}, {"name": "Opened", "@type": "PropertyValue", "value": "2014"}]}, "@type": "ListItem", "position": 7}, {"item": {"@id": "#rotterdam-city-hall", "name": "Rotterdam City Hall", "@type": "GovernmentBuilding", "description": "A monumental government building completed in 1920 by architect Henri Evers and one of the few major buildings that survived the bombing of Rotterdam in 1940.", "alternateName": "Stadhuis", "additionalProperty": [{"name": "Architect", "@type": "PropertyValue", "value": "Henri Evers"}, {"name": "Completed", "@type": "PropertyValue", "value": "1920"}]}, "@type": "ListItem", "position": 8}, {"item": {"@id": "https://www.rotterdam.info/en/visit/finder-locations/stadion-feyenoord-de-kuip#stadium", "url": "https://www.rotterdam.info/en/visit/finder-locations/stadion-feyenoord-de-kuip", "name": "Stadion Feyenoord De Kuip", "@type": "StadiumOrArena", "description": "A landmark stadium completed in 1937 and designed by Leendert van der Vlugt, widely recognised as a major example of Nieuwe Bouwen architecture.", "alternateName": "De Kuip", "additionalProperty": [{"name": "Architect", "@type": "PropertyValue", "value": "Leendert van der Vlugt / Van der Vlugt & Stam"}, {"name": "Completed", "@type": "PropertyValue", "value": "1937"}, {"name": "Architectural style", "@type": "PropertyValue", "value": "Nieuwe Bouwen"}]}, "@type": "ListItem", "position": 9}, {"item": {"@id": "https://www.rotterdam.info/en/visit/finder-locations/van-nelle-fabriek#building", "url": "https://www.rotterdam.info/en/visit/finder-locations/van-nelle-fabriek", "name": "Van Nelle Factory", "@type": ["LandmarksOrHistoricalBuildings", "TouristAttraction"], "description": "A UNESCO World Heritage Site and masterpiece of industrial modernism, designed by Brinkman and Van der Vlugt and completed in 1931 as a pioneering example of Nieuwe Bouwen architecture.", "alternateName": "Van Nellefabriek", "additionalProperty": [{"name": "Architect", "@type": "PropertyValue", "value": "Brinkman and Van der Vlugt"}, {"name": "Completed", "@type": "PropertyValue", "value": "1931"}, {"name": "Architectural style", "@type": "PropertyValue", "value": "Nieuwe Bouwen"}, {"name": "Heritage status", "@type": "PropertyValue", "value": "UNESCO World Heritage"}]}, "@type": "ListItem", "position": 10}]}], "@context": "https://schema.org"}
