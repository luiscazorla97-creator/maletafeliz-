ck.blend:last-child,.main-content__text colour-block.transparent:last-child{padding-bottom:0!important}.main-content__text colour-block.collapsed--top{padding-top:calc(var(--block-padding)*.25)!important}.main-content__text colour-block.collapsed--bottom{padding-bottom:calc(var(--block-padding)*.25)!important}.main-content__meta{align-items:center;display:flex;flex-direction:row;flex-wrap:wrap;gap:2rem;justify-content:space-between;margin-bottom:5rem;padding-left:2rem;padding-right:2rem;width:100%}.main-content__meta-divider{font-size:2rem}@media only screen and (max-width:639px){.main-content__meta-divider{display:none}}.main-content__data,.main-content__tags{align-items:center;display:flex;flex-direction:row;flex-wrap:wrap;margin-bottom:0}.main-content__data{gap:1.5rem}.main-content__tags{gap:.5rem 1.5rem}.main-content__tag{color:var(--colour-primary,#000);display:block;font-weight:600;margin-bottom:0;text-transform:capitalize}.main-content__authors,.main-content__date,.main-content__share{display:block;font-size:var(--p-size,1.6rem)}.main-content__date{font-weight:700;margin-bottom:0}.main-content__authors{margin-bottom:3rem}.main-content__share{align-items:center;display:flex;flex-direction:row;flex-wrap:wrap;gap:.5rem}.main-content__share a,.main-content__share button{background-color:var(--colour-primary,#000);display:block;height:4rem;position:relative;transition:background-color .3s ease;width:4rem}.main-content__share a:active,.main-content__share a:focus-visible,.main-content__share a:hover,.main-content__share button:active,.main-content__share button:focus-visible,.main-content__share button:hover{background-color:var(--colour-tertiary,#bfbfbf)}.main-content__share a:active:before,.main-content__share a:focus-visible:before,.main-content__share a:hover:before,.main-content__share button:active:before,.main-content__share button:focus-visible:before,.main-content__share button:hover:before{background-color:var(--colour-tertiary-contrast,#000)}.main-content__share a[data-network=email],.main-content__share button[data-network=email]{--_icon-url:url(/_resources/mysite/client/images/svg/social/email.svg?v=1792532929713)}.main-content__share a[data-network=facebook],.main-content__share button[data-network=facebook]{--_icon-url:url(/_resources/mysite/client/images/svg/social/facebook.svg?v=1792532929713)}.main-content__share a[data-network=twitter],.main-content__share button[data-network=twitter]{--_icon-url:url(/_resources/mysite/client/images/svg/social/twitter.svg?v=1792532929713)}.main-content__share a[data-network=linkedin],.main-content__share button[data-network=linkedin]{--_icon-url:url(/_resources/mysite/client/images/svg/social/linkedin.svg?v=1792532929713)}.main-content__share a:before,.main-content__share button:before{background-color:var(--colour-primary-contrast,#fff);content:"";display:block;height:100%;left:0;mask:var(--_icon-url) no-repeat center/contain;position:absolute;top:0;transition:background-color .3s ease;width:100%}</style>

