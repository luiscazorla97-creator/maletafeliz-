    #nprogress {
        pointer-events: none;
      }
      #nprogress .bar {
        background: #4B78D2;
        position: fixed;
        z-index: 9999;
        top: 0;
        left: 0;
        width: 100%;
        height: 5px;
      }
      #nprogress .peg {
        display: block;
        position: absolute;
        right: 0px;
        width: 100px;
        height: 100%;
        box-shadow: 0 0 10px #4B78D2, 0 0 5px #4B78D2;
        opacity: 1;
        -webkit-transform: rotate(3deg) translate(0px, -4px);
        -ms-transform: rotate(3deg) translate(0px, -4px);
        transform: rotate(3deg) translate(0px, -4px);
      }
      #nprogress .spinner {
        display: block;
        position: fixed;
        z-index: 1031;
        top: 15px;
        right: 15px;
      }
      #nprogress .spinner-icon {
        width: 18px;
        height: 18px;
        box-sizing: border-box;
        border: solid 2px transparent;
        border-top-color: #4B78D2;
        border-left-color: #4B78D2;
        border-radius: 50%;
        -webkit-animation: nprogresss-spinner 400ms linear infinite;
        animation: nprogress-spinner 400ms linear infinite;
      }
      .nprogress-custom-parent {
        overflow: hidden;
        position: relative;
      }
      .nprogress-custom-parent #nprogress .spinner,
      .nprogress-custom-parent #nprogress .bar {
        position: absolute;
      }
      @-webkit-keyframes nprogress-spinner {
        0% {
          -webkit-transform: rotate(0deg);
        }
        100% {
          -webkit-transform: rotate(360deg);
        }
      }
      @keyframes nprogress-spinner {
        0% {
          transform: rotate(0deg);
        }
        100% {
          transform: rotate(360deg);
        }
      }</style><!--$!--><template data-dgst="BAILOUT_TO_CLIENT_SIDE_RENDERING"></template><!--/$--><!--$?--><template id="B:0"></template><!--/$--><div class="sticky header-group group top-0 z-50 w-full"><div class="flex h-20 w-full items-center justify-between transition-all hover:bg-white hover:bg-none hover:text-black md:h-36 md:pe-4 bg-white text-black shadow group-[.scrolled]:h-16 group-[.scrolled]:bg-white group-[.scrolled]:bg-none group-[.scrolled]:text-black group-[.scrolled]:shadow group-[.scrolled]:md:h-24"><a aria-label="Home" href="/"></a><nav aria-label="Main" data-orientation="horizontal" dir="ltr" class="static z-10 h-full w-max items-center hidden flex-grow justify-center lg:flex"><div style="position:relative"><ul data-orientation="horizontal" class="flex flex-1 list-none items-center justify-center space-x-1" dir="ltr"><li><button id="radix-_R_kinpftb_-trigger-radix-_R_bkinpftb_" data-state="closed" aria-expanded="false" aria-controls="radix-_R_kinpftb_-content-radix-_R_bkinpftb_" class="group inline-flex h-full w-max items-center justify-center rounded-md px-4 py-2 font-medium transition-colors hover:text-accent-foreground focus:text-accent-foreground focus:outline-none disabled:pointer-events-none disabled:opacity-50 relative after:content(&quot;&quot;) after:absolute after:bottom-0 after:me-3 after:h-1 after:w-12 after:rounded after:bg-white after:transition-all group-hover:after:bg-sky group-[.bg-white]:after:bg-sky" data-radix-collection-item=""><a href="/explore/">Explore</a> <svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="lucide lucide-chevron-down relative top-[1px] ml-1 h-3 w-3 transition duration-200 group-data-[state=open]:rotate-180" aria-hidden="true"><path d="m6 9 6 6 6-6"></path></svg></button></li><li><button id="radix-_R_kinpftb_-trigger-radix-_R_jkinpftb_" data-state="closed" aria-expanded="fa