<script>
    document.addEventListener('DOMContentLoaded', () => {
        // ==========================================
        // Modal del Video
        // ==========================================
        const openModalBtn = document.getElementById('openModalBtn');
        const videoModal = document.getElementById('videoModal');
        const modalBackdrop = document.getElementById('modalBackdrop');
        const modalContent = document.getElementById('modalContent');
        const closeModalBtn = document.getElementById('closeModalBtn');
        const modalVideo = document.getElementById('modalVideo');

        const openModal = (e) => {
            if (e) e.preventDefault();
            videoModal.classList.remove('hidden');
            void videoModal.offsetWidth; // Reflow
            modalBackdrop.classList.remove('opacity-0');
            modalBackdrop.classList.add('opacity-100');
            modalContent.classList.remove('scale-95', 'opacity-0');
            modalContent.classList.add('scale-100', 'opacity-100');
            modalVideo.play().catch(err => {
                console.log("Autoplay bloqueado:", err);
            });
        };

        const closeModal = () => {
            modalBackdrop.classList.remove('opacity-100');
            modalBackdrop.classList.add('opacity-0');
            modalContent.classList.remove('scale-100', 'opacity-100');
            modalContent.classList.add('scale-95', 'opacity-0');
            modalVideo.pause();
            modalVideo.currentTime = 0;
            setTimeout(() => {
                videoModal.classList.add('hidden');
            }, 300);
        };

        if (openModalBtn) openModalBtn.addEventListener('click', openModal);
        if (closeModalBtn) closeModalBtn.addEventListener('click', closeModal);
        if (modalBackdrop) modalBackdrop.addEventListener('click', closeModal);
    });
</script>
    <script async src="https://platform.twitter.com/widgets.js" charset="utf-8"></script>
    <script>
        /* Las publicaciones llegan ya con su texto desde el servidor (oEmbed), así
           que la sección se lee aunque X no cargue. Este script hace dos cosas:
           traerlas si la portada se sirvió con la caché fría, y pedirle a
           widgets.js que convierta los blockquotes en las tarjetas nativas. */
        (function () {
            var seccion = document.getElementById('vibra-x');

            if (!seccion) {
                return;
            }

            var ENDPOINT = "https:\/\/descubre.veracruzmunicipio.gob.mx\/publicaciones-x";

            // Cola de arranque oficial de widgets.js: sirve tanto si el script ya
            // cargó como si todavía va en camino.
            window.twttr = window.twttr || { _e: [], ready: function (f) { this._e.push(f); } };

            function pintarTarjetas() {
                window.twttr.ready(function (twttr) {
                    twttr.widgets.load(seccion);
                });
            }

            async function traerPublicaciones() {
                try {
                    var resp = await fetch(ENDPOINT, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        cache: 'no-store',
                    });

                    if (!resp.ok) {
                        return;
                    }

                    seccion.innerHTML = await resp.text();
                    pintarTarjetas();
                } catch (e) {
                    /* Silencioso: se queda el aviso que ya estaba pintado. */
                }
            }

            /* La portada nunca le pregunta a X: solo pinta lo que ya estaba en
               caché. Si vino sin datos, se piden aquí, con la página ya cargada,
               para no hacer esperar a nadie. */
            if (seccion.dataset.pendiente === '1') {
                delete seccion.dataset.pendiente;
                traerPublicaciones();
            } else {
                pintarTarjetas();
            }
        })();
    </script>
    <script>
        /* Auto-refresco del estado del tiempo cada hora, sin recargar la página.
           El servidor cachea 1 h, así que esto solo repinta el bloque (incluido el
           texto "Actualizado hace…") y, cuando la caché expira, trae datos nuevos. */
        (function () {
            const seccion = document.getElementById('climasection');
            if (!seccion) return;

            const ENDPOINT = "https:\/\/descubre.veracruzmunicipio.gob.mx\/descubre-veracruz\/clima";
            const INTERVALO_MS = 60 * 60 * 1000; // 1 hora

            async function refrescarClima() {
                // No refrescar si la pestaña está oculta (se hará al volver a ella).
                if (document.hidden) return;

                try {
                    const resp = await fetch(ENDPOINT, {
                        headers: { 'X-Requested-With': 'XMLHttpRequest' },
                        cache: 'no-store',
                    });
                    if (!resp.ok) return;

                    const html = await resp.text();
                    seccion.classList.add('cx-refreshing');
                    // Pequeña transición antes de sustituir el contenido.
                    setTimeout(() => {
                        seccion.innerHTML = html;
                        seccion.classList.remove('cx-refreshing');
                    }, 200);
                } catch (e) {
                    /* Silencioso: si falla, se conserva lo que ya se mostraba. */
                }
            }

            /* La portada nunca consulta la API: solo pinta lo que ya estaba en
               caché. Si vino sin datos (caché fría), se piden aquí, con la
               página ya cargada, para no hacer esperar a nadie. */
            if (seccion.dataset.pendiente === '1') {
                delete seccion.dataset.pendiente;
                refrescarClima();
            }

            setInterval(refrescarClima, INTERVALO_MS);

            // Al volver a la pestaña tras >1 h, refrescar de inmediato.
            let ultimoRefresco = Date.now();
            document.addEventListener('visibilitychange', () => {
                if (!document.hidden && Date.now() - ultimoRefresco >= INTERVALO_MS) {
                    ultimoRefresco = Date.now();
                    refrescarClima();
                }
            });
        })();
    </script>
    <script>
        calendarioResponsive();

        document.addEventListener('DOMContentLoaded', function() {
            const currentLocale = "en";
            let nombresMeses = [
                "Enero", "Febrero", "Marzo", "Abril", "Mayo", "Junio",
                "Julio", "Agosto", "Septiembre", "Octubre", "Noviembre", "Diciembre"
            ];

            if (typeof flatpickr !== 'undefined' && flatpickr.l10ns) {
                const targetL10n = flatpickr.l10ns[currentLocale] || flatpickr.l10ns.es;
                if (targetL10n) {
                    flatpickr.localize(targetL10n);
                    if (targetL10n.months && targetL10n.months.longhand) {
                        nombresMeses = targetL10n.months.longhand;
                    }
                }
            }

            const urlParams = new URLSearchParams(window.location.search);
            const fechaSeleccionadaUrl = urlParams.get('fecha');
            const fechaSeleccionadaServidor = null;

            /*
             * Dirección del FRAGMENTO de la lista. Es distinta de la de la página
             * a propósito: la lista se pide aquí y la barra de direcciones sigue
             * mostrando la página. Antes se pedían las dos a la misma dirección y
             * el servidor decidía qué devolver según una cabecera, con lo que
             * cualquier petición de fondo a la portada recibía la lista suelta.
             */
            const ENDPOINT_LISTA = "https:\/\/descubre.veracruzmunicipio.gob.mx\/descubre-veracruz\/agenda\/lista";
            const fechaActiva = (fechaSeleccionadaUrl && fechaSeleccionadaUrl !== 'todos') ? fechaSeleccionadaUrl : fechaSeleccionadaServidor;

            /*
             * Los días que llevan punto: los que TIENEN eventos (ver
             * IndexController). Vienen todos de una vez, de cualquier mes, para
             * que pasar de mes no tenga que ir al servidor a preguntar.
             */
            const diasConEventos = new Set(["2026-07-03","2026-07-07","2026-07-16","2026-07-17","2026-07-18","2026-07-19","2026-07-20","2026-07-21","2026-07-22","2026-07-26","2026-07-27","2026-07-28","2026-07-29","2026-07-31","2026-08-01","2026-08-02","2026-08-03","2026-08-04","2026-08-05","2026-08-06","2026-08-07","2026-08-08","2026-08-09","2026-08-10","2026-08-11","2026-08-12","2026-08-13","2026-08-14","2026-08-15","2026-08-16","2026-08-17","2026-08-18","2026-08-19","2026-08-20","2026-08-21","2026-08-22","2026-08-23","2026-08-24","2026-08-25","2026-08-26","2026-08-27","2026-08-28","2026-08-29","2026-08-30","2026-08-31","2026-09-23","2026-09-24"]);

            /*
             * Destacados por mes. TIENE que declararse antes de crear el
             * calendario: flatpickr llama a onReady mientras se construye, y
             * onReady lo lee (actualizarEventoDestacadoMes). Declarado más abajo,
             * esa lectura lanzaba «Cannot access 'mapaDestacados' before
             * initialization»; flatpickr se tragaba el error y devolvía una lista
             * vacía en vez del calendario, así que las flechas de mes y los días
             * no hacían nada.
             */
            const mapaDestacados = [];

            /* Mes que pidió la dirección (?mes=AAAA-MM), para abrir el calendario ahí. */
            const mesUrl = /^\d{4}-\d{2}$/.test(urlParams.get('mes') || '') ? urlParams.get('mes') : null;

            /*
             * La fecha del día que pinta el calendario, en el mismo formato que
             * usa la lista (Y-m-d).
             *
             * Se arma a mano y NO con toISOString(), que pasa a UTC: en México,
             * seis horas por detrás, un evento del día 19 acabaría marcado en el
             * 18 durante buena parte de la tarde.
             */
            function claveDeFecha(fecha) {
                const mes = String(fecha.getMonth() + 1).padStart(2, '0');
                const dia = String(fecha.getDate()).padStart(2, '0');

                return `${fecha.getFullYear()}-${mes}-${dia}`;
            }

            const flatpickrConfig = {
                inline: true,
                dateFormat: "Y-m-d",
                locale: {
                    firstDayOfWeek: 1,
                    weekdays: {
                        shorthand: ['DOM', 'LUN', 'MAR', 'MIÉ', 'JUE', 'VIE', 'SÁB'],
                        longhand: ['Domingo', 'Lunes', 'Martes', 'Miércoles', 'Jueves', 'Viernes', 'Sábado']
                    },
                    months: {
                        shorthand: ['Ene', 'Feb', 'Mar', 'Abr', 'May', 'Jun', 'Jul', 'Ago', 'Sep', 'Oct', 'Nov', 'Dic'],
                        longhand: ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre']
                    }
                },
                
                // Marca cada día que tiene eventos. El punto lo pinta el CSS
                // sobre esta clase, y se vuelve a ejecutar en cada cambio de mes
                // porque flatpickr rehace las celdas.
                onDayCreate: function(fechasElegidas, cadena, instancia, celda) {
                    if (celda.dateObj && diasConEventos.has(claveDeFecha(celda.dateObj))) {
                        celda.classList.add('con-eventos');
                    }
                },

                onReady: function(selectedDates, dateStr, instance) {
                    actualizarCabeceraPersonalizada(instance);
                },
                
                onMonthChange: function(selectedDates, dateStr, instance) {
                    actualizarCabeceraPersonalizada(instance);
                },
                onYearChange: function(selectedDates, dateStr, instance) {
                    actualizarCabeceraPersonalizada(instance);
                },
                
                onChange: function(selectedDates, dateStr, instance) {
                    if (!dateStr) return;

                    let currentUrl = new URL(window.location.href);
                    currentUrl.searchParams.set('fecha', dateStr);
                    currentUrl.searchParams.delete('ver_todos');
                    currentUrl.searchParams.delete('page'); 
                    
                    cargarEventosAjax(currentUrl.toString());
                }
            };

            if (fechaActiva) {
                flatpickrConfig.defaultDate = fechaActiva;
            }

            const fp = flatpickr("#calendario", flatpickrConfig);

            if (!fechaActiva && mesUrl) {
                fp.jumpToDate(mesUrl + '-01');
                actualizarCabeceraPersonalizada(fp);
            }

            /**
             * Lleva el calendario a un mes y repinta la lista con TODOS los
             * eventos de ese mes. Lo usan las flechas: antes cambiaban el mes del
             * calendario pero la lista se quedaba en el mes en curso.
             */
            function cargarMes(delta) {
                fp.changeMonth(delta);
                fp.clear(false, false);
                actualizarCabeceraPersonalizada(fp);

                const mes = `${fp.currentYear}-${String(fp.currentMonth + 1).padStart(2, '0')}`;
                const url = new URL(window.location.href);
                url.searchParams.set('ver_todos', '1');
                url.searchParams.set('mes', mes);
                url.searchParams.delete('fecha');
                url.searchParams.delete('page');

                cargarEventosAjax(url.toString());
            }

            /** Sin fecha elegida: al mes de ?mes= o, si no viene, al de hoy. */
            function irAlMesDe(urlObj) {
                const mes = urlObj.searchParams.get('mes');
                fp.clear(false, false);
                fp.jumpToDate(/^\d{4}-\d{2}$/.test(mes || '') ? mes + '-01' : new Date());
                actualizarCabeceraPersonalizada(fp);
            }

            /**
             * Reescribe una dirección al origen por el que se está navegando,
             * conservando ruta y parámetros.
             *
             * Hace falta porque los enlaces de esta lista los construye el
             * servidor a partir de la PETICIÓN (el paginador usa
             * request()->url(), y el botón de quitar filtro también). Detrás de
             * un proxy que termina el HTTPS, Laravel no se entera de que la
             * petición venía cifrada y los escribe como http:// aunque la página
             * sea https. Eso rompe dos cosas de golpe:
             *   · el fetch queda fuera de connect-src 'self' y la CSP lo bloquea,
             *   · history.pushState con otro origen lanza SecurityError y se
             *     lleva por delante el resto del manejador.
             *
             * Normalizando aquí, el calendario funciona igual en local, en el
             * servidor de pruebas y en producción, sin depender de cómo esté
             * configurado el proxy de cada sitio.
             */
            function alOrigenActual(urlStr) {
                const url = new URL(urlStr, window.location.href);

                url.protocol = window.location.protocol;
                url.host = window.location.host;

                return url.toString();
            }

            /**
             * La dirección del fragmento, con los mismos parámetros de filtro que
             * lleve la dirección que se está mostrando.
             *
             * Se copia la CADENA DE CONSULTA y no la ruta: los enlaces del
             * paginador y de los botones de filtro los pinta el servidor contra
             * la página que los hospeda (la portada o /inicio), y lo único que
             * necesita el fragmento de ellos es el filtro.
             */
            function urlDelFragmento(urlStr) {
                const origen = new URL(alOrigenActual(urlStr));
                const destino = new URL(ENDPOINT_LISTA, window.location.href);

                destino.search = origen.search;

                return destino.toString();
            }

            /**
             * Repinta la lista de eventos.
             *
             * Las dos direcciones que se manejan aquí son distintas y no hay que
             * confundirlas:
             *   - la de la PÁGINA, que es la que se empuja al historial y la que
             *     ve el visitante en la barra de direcciones, para que la vista
             *     filtrada se pueda compartir y guardar en marcadores;
             *   - la del FRAGMENTO, que es la que se pide de verdad.
             */
            function cargarEventosAjax(urlStr, updateHistory = true) {
                const container = document.getElementById('contenedor-eventos-ajax');
                if (!container) return;

                const url = alOrigenActual(urlStr);

                if (updateHistory) {
                    window.history.pushState({}, '', url);
                }

                container.classList.add('opacity-40', 'pointer-events-none');

                fetch(urlDelFragmento(url), {
                    headers: {
                        'X-Requested-With': 'XMLHttpRequest'
                    }
                })
                .then(response => {
                    // Sin esto, un 500 o una página de error se colaba tal cual
                    // dentro de la lista: el .catch de abajo solo salta si falla
                    // la red, no si el servidor responde con un error.
                    if (!response.ok) {
                        throw new Error('El servidor respondió ' + response.status);
                    }

                    return response.text();
                })
                .then(html => {
                    if (html.includes('<!DOCTYPE') || html.includes('<html') || html.includes('<main')) {
                        console.warn('Respuesta AJAX no es un fragmento parcial, recargando página.');
                        window.location.href = url;
                        return;
                    }
                    container.innerHTML = html;
                    container.classList.remove('opacity-40', 'pointer-events-none');
                })
                .catch(err => {
                    console.error('Error al cargar eventos via AJAX:', err);
                    container.classList.remove('opacity-40', 'pointer-events-none');
                });
            }

            const ajaxContainer = document.getElementById('contenedor-eventos-ajax');
            if (ajaxContainer) {
                ajaxContainer.addEventListener('click', function(e) {
                    // Solo los enlaces de NAVEGAR la lista: el botón de quitar
                    // filtro y los del paginador (Laravel los pinta dentro de un
                    // <nav>). Antes se interceptaba cualquier <a> del contenedor,
                    // así que el día que una tarjeta lleve enlace a la ficha del
                    // evento o a un sitio externo, el clic se cancelaría y el
                    // destino se volcaría aquí dentro en vez de abrirse.
                    const link = e.target.closest('a.btn-ajax-filter, nav a, .pagination a');

                    if (link && link.href) {
                        e.preventDefault();
                        const urlObj = new URL(link.href, window.location.href);
                        const f = urlObj.searchParams.get('fecha');
                        if (!f || f === 'todos') {
                            irAlMesDe(urlObj);
                        } else {
                            fp.setDate(f, false);
                            actualizarCabeceraPersonalizada(fp);
                        }
                        cargarEventosAjax(link.href);
                    }
                });
            }

            window.addEventListener('popstate', function() {
                const currentUrl = window.location.href;
                const urlParams = new URLSearchParams(window.location.search);
                const fecha = urlParams.get('fecha');
                if (fecha && fecha !== 'todos') {
                    fp.setDate(fecha, false);
                    actualizarCabeceraPersonalizada(fp);
                } else {
                    irAlMesDe(new URL(currentUrl));
                }
                cargarEventosAjax(currentUrl, false);
            });

            function actualizarEventoDestacadoMes(ano, mesIdx) {
                const mesNumero = String(mesIdx + 1).padStart(2, '0');
                const claveMes = `${ano}-${mesNumero}`;
                const evento = mapaDestacados[claveMes];

                const tarjeta = document.getElementById('tarjeta-evento-destacado');
                if (!tarjeta) return;

                if (!evento) {
                    tarjeta.classList.add('hidden');
                    tarjeta.removeAttribute('data-evento');
                    return;
                }

                tarjeta.classList.remove('hidden');
                tarjeta.dataset.evento = JSON.stringify(evento);

                const tituloEl = document.getElementById('destacado-titulo');
                if (tituloEl) tituloEl.textContent = evento.titulo || '';

                const tagEl = document.getElementById('destacado-tag');
                if (tagEl) {
                    const tagNombre = (evento.etiquetas && evento.etiquetas[0] && evento.etiquetas[0].nombre)
                        ? evento.etiquetas[0].nombre
                        : "Schedule";
                    tagEl.textContent = tagNombre;
                }

                const metaEl = document.getElementById('destacado-meta');
                if (metaEl) {
                    let metaHtml = '';
                    if (evento.fecha_larga) {
                        metaHtml += `<span><i class="pi pi-calendar mr-1 text-[10px]"></i>${evento.fecha_larga}</span>`;
                    }
                    if (evento.hora) {
                        metaHtml += `<span><i class="pi pi-clock mr-1 text-[10px]"></i>${evento.hora}</span>`;
                    }
                    metaEl.innerHTML = metaHtml;
                }

                const descEl = document.getElementById('destacado-desc');
                if (descEl) {
                    const rawDesc = evento.descripcion || '';
                    const temp = document.createElement('div');
                    temp.innerHTML = rawDesc;
                    descEl.textContent = temp.textContent || temp.innerText || '';
                }
            }

            function actualizarCabeceraPersonalizada(instance) {
                const mesIdx = instance.currentMonth;
                const ano = instance.currentYear;
                const nombreMes = nombresMeses[mesIdx];
                
                const display = document.getElementById('mesAnoDisplay');
                if (display) {
                    display.innerHTML = `<span class="uppercase font-bold text-brand-gold">${nombreMes}</span> <span class="font-normal text-brand-cream/80 text-base">${ano}</span>`;
                }

                actualizarEventoDestacadoMes(ano, mesIdx);
            }

            const tarjetaDestacada = document.getElementById('tarjeta-evento-destacado');
            if (tarjetaDestacada) {
                tarjetaDestacada.addEventListener('click', function () {
                    const dataStr = this.dataset.evento;
                    if (!dataStr) return;
                    try {
                        const evt = JSON.parse(dataStr);
                        if (typeof window.abrirModalEventoGlobal === 'function') {
                            const primeraEtiqueta = (evt.etiquetas && evt.etiquetas[0]) || {};
                            window.abrirModalEventoGlobal({
                                titulo: evt.titulo || '',
                                descripcion: evt.descripcion || '',
                                fecha: evt.fecha || '',
                                dia: evt.dia || '',
                                mes: evt.mes || '',
                                hora: evt.hora ? evt.hora + ' HRS' : 'TODO EL DÍA',
                                lugar: evt.lugar || '',
                                costo: evt.costo_label || (evt.costo > 0 ? '$' + Number(evt.costo).toFixed(2) + ' MXN' : 'GRATUITO'),
                                categoria: primeraEtiqueta.nombre || '',
                                color: primeraEtiqueta.color || '#B19657',
                                img: evt.imagen || '',
                                hoy: Boolean(evt.hoy)
                            });
                        }
                    } catch (e) {
                        console.error('Error al abrir modal del evento destacado:', e);
                    }
                });
            }

            document.getElementById('prevMonth').addEventListener('click', () => cargarMes(-1));
            document.getElementById('nextMonth').addEventListener('click', () => cargarMes(1));

            const todayBtn = document.getElementById('todayBtn');
            if (todayBtn) {
                todayBtn.addEventListener('click', () => {
                    const todayStr = "2026-11-21";
                    fp.setDate(todayStr, true);
                });
            }

            window.addEventListener('resize', calendarioResponsive);

            const btnOpen = document.getElementById('btn-open');
            const closeBtn = document.getElementById('close-btn');
            const overlay = document.getElementById('overlay-calendario');

            if (btnOpen) btnOpen.addEventListener('click', () => toggleDrawer());
            if (closeBtn) closeBtn.addEventListener('click', () => toggleDrawer());
            if (overlay) overlay.addEventListener('click', () => toggleDrawer());
        });

        function calendarioResponsive(){
            const windowWidth = window.innerWidth;

            const contenedorPrincipal = document.getElementById('contenedor-principal');
            const contenedorCalendario = document.getElementById('contenedor-calendario');

            if (!contenedorPrincipal || !contenedorCalendario) return;

            if(windowWidth <= 1248){
                contenedorPrincipal.classList.add(...['static','top-auto', 'z-0']);
                contenedorPrincipal.classList.remove(...['sticky','top-20', 'z-50']);

                const isOpened = contenedorCalendario.classList.contains('translate-x-0');

                contenedorCalendario.classList.add(...['fixed', 'top-0', 'right-0', 'z-[9999]', 'h-full', 'w-[400px]', 'max-w-[92vw]', 'bg-brand-burgundy', 'shadow-2xl', 'transform', 'transition-transform', 'duration-300', 'ease-in-out', 'flex', 'flex-col', 'p-4', 'sm:p-6', 'overflow-y-auto']);
                // 'relative' TIENE que irse aquí. Viene puesto de fábrica en el
                // HTML del calendario y no basta con añadir 'fixed' al lado:
                // las dos reglas pesan igual, y en la hoja de Tailwind la de
                // 'relative' va escrita después, así que gana ella. El cajón se
                // quedaba entonces dentro del flujo de la página: invisible y
                // desplazado a la derecha, pero reservando su hueco (582px en
                // un teléfono), que era el vacío enorme bajo los botones de
                // «Anterior» y «Siguiente».
                contenedorCalendario.classList.remove(...['relative', 'w-full', 'rounded-3xl', 'shadow-3xl', 'border', 'border-brand-gold/30']);

                if (!isOpened) {
                    contenedorCalendario.classList.add('translate-x-full', 'pointer-events-none', 'invisible');
                    contenedorCalendario.classList.remove('translate-x-0');
                }
            } else {
                contenedorPrincipal.classList.add(...['sticky','top-20', 'z-50']);
                contenedorPrincipal.classList.remove(...['static','top-auto', 'z-0']);

                contenedorCalendario.classList.remove(...['fixed', 'top-0', 'right-0', 'z-[9999]', 'h-full', 'w-[400px]', 'w-[380px]', 'max-w-[92vw]', 'bg-brand-burgundy', 'shadow-2xl', 'transform', 'translate-x-full', 'translate-x-0', 'transition-transform', 'duration-300', 'ease-in-out', 'overflow-y-auto', 'pointer-events-none', 'invisible']);
                // Se devuelve 'relative' al volver a pantalla grande: ahí el
                // calendario es una tarjeta más de la columna derecha y vuelve
                // a ser el marco de referencia de lo que lleva dentro.
                contenedorCalendario.classList.add(...['relative', 'w-full', 'flex', 'flex-col', 'rounded-3xl', 'shadow-3xl', 'border', 'border-brand-gold/30', 'bg-brand-burgundy/95', 'p-5', 'sm:p-6']);
            }
        }

        function toggleDrawer() {
            const drawer = document.getElementById('contenedor-calendario');
            const overlay = document.getElementById('overlay-calendario');

            if (!drawer || !overlay) return;

            const isOpening = drawer.classList.contains('translate-x-full') || drawer.classList.contains('invisible');

            // El botón ya no se esconde al abrir. Cuando flotaba sobre el
            // contenido había que quitarlo de en medio; ahora está en la
            // cabecera de la sección, debajo del cajón y de su fondo oscuro.
            if (isOpening) {
                drawer.classList.remove('invisible', 'pointer-events-none', 'translate-x-full');
                drawer.classList.add('translate-x-0');
                overlay.classList.remove('hidden');
                setTimeout(() => overlay.classList.remove('opacity-0'), 10);
            } else {
                drawer.classList.remove('translate-x-0');
                drawer.classList.add('translate-x-full');
                overlay.classList.add('opacity-0');
                setTimeout(() => {
                    overlay.classList.add('hidden');
                    if (window.innerWidth <= 1248) {
                        drawer.classList.add('invisible', 'pointer-events-none');
                    }
                }, 300);
            }
        }
    </script>
</body>
</html>
