1,"35:[\"$\",\"div\",null,{\"className\":\"h-80 bg-huapae-pattern bg-cover\"}]\n36:T2e1b,"])</script><script>self.__next_f.push([1,"{\"@context\":\"https://schema.org\",\"@graph\":[{\"@type\":[\"WebPage\",\"FAQPage\"],\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#webpage\",\"url\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/\",\"name\":\"Discover Nelson City | Nelson Tasman Official Travel Guide\",\"headline\":\"Official visitor guide to Nelson City New Zealand\",\"description\":\"Known as a vibrant and welcoming city, Nelson is (quite literally) at the heart of New Zealand. \",\"inLanguage\":\"en-NZ\",\"dateModified\":\"2026-10-09T10:56:14+13:00\",\"primaryImageOfPage\":{\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#primaryimage\"},\"breadcrumb\":{\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#breadcrumb\"},\"mainEntity\":[{\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-94\"},{\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-95\"},{\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-96\"},{\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-97\"},{\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-98\"},{\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-99\"},{\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-100\"},{\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-101\"},{\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-102\"},{\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-103\"},{\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-130\"},{\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-131\"},{\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-132\"}],\"isPartOf\":{\"@id\":\"https://www.nelsontasman.nz/#website\"}},{\"@type\":\"ImageObject\",\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#primaryimage\",\"contentUrl\":\"https://backend.nelsontasman.nz/assets/Uploads/191630-upper-trafalgar-street-dining__FocusFillMaxWyItMC4yMiIsIjAuMDMiLDI4ODAsMTgwMF0.jpg\",\"url\":\"https://backend.nelsontasman.nz/assets/Uploads/191630-upper-trafalgar-street-dining__FocusFillMaxWyItMC4yMiIsIjAuMDMiLDI4ODAsMTgwMF0.jpg\",\"width\":2560,\"height\":1600,\"caption\":\"Trafalgar Street serves up some of the best dining in Nelson.\",\"creditText\":\"Trafalgar Square, Nelson City\"},{\"@type\":\"BreadcrumbList\",\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#breadcrumb\",\"itemListElement\":[{\"@type\":\"ListItem\",\"position\":1,\"name\":\"Home\",\"item\":\"https://www.nelsontasman.nz/\"},{\"@type\":\"ListItem\",\"position\":2,\"name\":\"Explore\",\"item\":\"https://www.nelsontasman.nz/explore/\"},{\"@type\":\"ListItem\",\"position\":3,\"name\":\"Places to go\",\"item\":\"https://www.nelsontasman.nz/explore/places-to-go/\"},{\"@type\":\"ListItem\",\"position\":4,\"name\":\"Cities \u0026 towns\",\"item\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/\"},{\"@type\":\"ListItem\",\"position\":5,\"name\":\"Nelson City\",\"item\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/\"}]},{\"@type\":\"Question\",\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-94\",\"name\":\"Where is Nelson City and how do I get there?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nelson sits at the top of New Zealand’s South Island, looking out across Tasman Bay. Nelson Airport is around 15 minutes from the city centre, with regular domestic flights connecting to major New Zealand cities like Auckland, Wellington and Christchurch. Driving is another great option, especially if Nelson is part of a wider South Island road trip.\"}},{\"@type\":\"Question\",\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-95\",\"name\":\"What does Whakatū mean?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Whakatū is the Māori name for Nelson. The name is commonly interpreted as meaning ‘to build’, ‘to establish’ or ‘to set up’. Using Whakatū acknowledges the deep Māori history and identity of this place, which stretches back long before the establishment of the European settlement of Nelson.\"}},{\"@type\":\"Question\",\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-96\",\"name\":\"What is Nelson City known for?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nelson is known for sunshine, creativity, great food and incredible access to the outdoors. With three national parks surrounding the region and world-class mountain biking right on the city’s doorstep, adventure is never far away. Add galleries and studios, independent shops, excellent local produce, wine and craft beer, and you’ve got a small city with plenty packed into it.\"}},{\"@type\":\"Question\",\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-97\",\"name\":\"What are the best things to do in Nelson City?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Start in the compact city centre, where you can browse galleries, independent shops and cafés before exploring the riverside and heritage streets. Visit the Nelson Market on a Saturday, discover local art at The Suter, wander through Queens Gardens, or hit one of the walking and cycling trails close to town. Explore our Things to do in Nelson City story for more inspiration.\"}},{\"@type\":\"Question\",\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-98\",\"name\":\"Is Nelson worth visiting and how many days should I spend?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Absolutely! Nelson Tasman was voted #1 for traveler satisfaction in 2025 and it's easy to see why. We recommend spending at least three to four days in Nelson to explore the city at a relaxed pace. Stay longer and use Nelson as your base to discover the wider region, from golden beaches and boutique wineries to creative communities and three spectacular national parks. There's plenty to keep you here.\"}},{\"@type\":\"Question\",\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-99\",\"name\":\"What is the best time of year to visit Nelson?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nelson is a year-round destination, with each season bringing something different. Summer is made for beaches, outdoor dining and long days outside, while autumn brings settled days and beautiful colour. Winter is quieter and well suited to galleries, food and nearby walks, while spring brings longer days and great conditions for getting back out on the hiking trails.\"}},{\"@type\":\"Question\",\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-100\",\"name\":\"Can I explore Nelson City without a car?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Yes. Central Nelson is compact and easy to explore on foot, with shops, galleries, cafés, parks and the river all close together. Bikes are another good option, and local buses can take you further afield. Heading to Abel Tasman National Park? Many tour operators offer transport from Nelson, and during summer and autumn, the Better Bus connects Nelson with Kaiteriteri, Mārahau and Motueka. A car is handy for exploring further afield, but you can see plenty of Nelson Tasman without one.\"}},{\"@type\":\"Question\",\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-101\",\"name\":\"Where are the best places to eat and drink in Nelson?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"You’re spoilt for choice. Nelson has everything from relaxed cafés and neighbourhood eateries to restaurants celebrating local seafood and seasonal produce. The wider region is also well known for its craft breweries, wineries and artisan producers, so arriving hungry is a solid strategy.\"}},{\"@type\":\"Question\",\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-102\",\"name\":\"What can I do in Nelson on a rainy day?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Rain is a good excuse to explore Nelson’s creative side. Visit The Suter Art Gallery, browse local galleries and studios, discover the city’s shops, settle into a café or sample some locally made beer. And when the clouds clear, you’re never far from a walk or a waterfront wander. Visiting with the kids? Check out our Rainy day family fun story for more ideas to keep everyone entertained.\"}},{\"@type\":\"Question\",\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-103\",\"name\":\"Is there a visitor information centre in Nelson?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nelson City doesn’t have a traditional isite anymore, but you can still find plenty of help when you arrive. YHA Nelson offers visitor information and local advice.\"}},{\"@type\":\"Question\",\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-130\",\"name\":\"How many people live in Nelson?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nelson is home to approximately 52,584 people, according to Stats NZ's 2025 population estimates.\"}},{\"@type\":\"Question\",\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-131\",\"name\":\"Where is the Centre of New Zealand?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"The Centre of New Zealand is a popular landmark on Botanical Hill in Nelson, just a short walk from the city centre. A 20–30 minute uphill walk takes you to the summit, where you'll enjoy panoramic views over Nelson, Tasman Bay and the surrounding mountains. It's a favourite local walk that's both family-friendly and dog-friendly, making it a great outing for all ages and four-legged companions. Despite its name, it's not the exact geographical centre of the country. The site was used as a central survey point in the 1800s and remains one of Nelson's most-loved short walks.\"}},{\"@type\":\"Question\",\"@id\":\"https://www.nelsontasman.nz/explore/places-to-go/cities-towns/nelson-city/#faq-132\",\"name\":\"What are the best restaurants in Nelson City?\",\"acceptedAnswer\":{\"@type\":\"Answer\",\"text\":\"Nelson City is home to some of the best dining in the region, with talented chefs making the most of fresh local produce, seafood and wines. Local favourites include Hopgoods and Eight Plates for seasonal fine dining, Arden for creative sharing plates, Hawker House for bold Asian flavours and Urban Oyster Bar \u0026 Eatery for seafood and lively dining. For a meal with a view, head to the Boat Shed Café on Nelson's waterfront. From relaxed eateries to award-winning restaurants, there's plenty to satisfy every appetite. And if brunch is more your style, check out our best brunch spots story for more delicious local favourites.\"}},{\"@type\":\"WebSite\",\"@id\":\"https://www.nelsontasman.nz/#website\",\"url\":\"https://www.nelsontasman.nz/\",\"name\":\"Nelson Tasman\",\"inLanguage\":\"en-NZ\",\"publisher\":{\"@id\":\"https://www.nelsontasman.nz/#organization\"},\"potentialAction\":{\"@type\":\"SearchAction\",\"target\":{\"@type\":\"EntryPoint\",\"urlTemplate\":\"https://www.nelsontasman.nz/search/?q={search_term_string}\"},\"query-input\":\"required name=search_term_string\"}},{\"@type\":\"Organization\",\"@id\":\"https://www.nelsontasman.nz/#organization\",\"name\":\"Nelson Tasman\",\"description\":\"The Official Tourism Guide \u0026 Trusted Business Hub\",\"url\":\"https://www.nelsontasman.nz/\",\"logo\":{\"@type\":\"ImageObject\",\"url\":\"https://www.nelsontasman.nz/images/nelson-tasman-logo-nrda.svg\"},\"sameAs\":[\"https://www.facebook.com/nelsontasmannz/\",\"https://www.instagram.com/nelsontasmannz/\",\"https://www.youtube.com/@NelsonTasmanNZ\",\"https://www.linkedin.com/company/nelsontasman/\"]}]}"])</script><script>self.__next_f.push([1,"2c:[\"$\",\"script\",null,{\"type\":\"application/ld+json\",\"dangerouslySetInnerHTML\":{\"__html\":\"$36\"}}]\n"])</script><script>self.__next_f.push([1,"2d:[\"$\",\"$L21\",null,{\"className\":\"fixed header-group group top-0 z-50 w-full\",\"children\":[[\"$\",\"$L22\",null,{\"banners\":[],\"iconList\":\"$undefined\"}],[\"$\",\"div\",null,{\"className\":\"flex h-20 w-full items-center justify-between transition-all hover:bg-white hover:bg-none hover:text-black md:h-36 md:pe-4 bg-transparent bg-gradient-to-b from-black/40 text-white group-[.scrolled]:h-16 group-[.scrolled]:bg-white group-[.scrolled]:bg-none group-[.scrolled]:text-black group-[.scrolled]:shadow group-[.scrolled]:md:h-24\",\"children\":[[\"$\",\"$L17\",null,{\"href\":\"/\",\"aria-label\":\"Home\",\"children\":[\"$\",\"$L18\",null,{\"src\":\"/images/nelson-tasman-logo.svg\",\"className\":\"h-auto w-32 fill-current ps-4 md:w-40 md:ps-8 lg:w-48\"}]}],[\"$\",\"$L23\",null,{\"menuWithSubMenus\":\"$15:props:children:1:props:children:1:props:menuWithSubMenus\"}],[\"$\",\"div\",null,{\"className\":\"ms-auto flex flex-row\",\"children\":[[[\"$\",\"$L17\",\"search\",{\"href\":\"/search\",\"aria-label\":\"Search\",\"children\":[\"$\",\"$L18\",null,{\"src\":\"\u003csvg xmlns=\\\"http://www.w3.org/2000/svg\\\" viewBox=\\\"0 0 512 512\\\"\u003e\u003c!--!Font Awesome Free 6.5.2 by @fontawesome - https://fontawesome.com License - https://fontawesome.com/license/free Copyright 2024 Fo