<!-- SwiperのJavaScript -->
<script src="https://www.kankou-shimane.com/en/wp-content/themes/navi_en/js/common/swiper8/swiper-bundle.min.js"></script>
<script>
  const main_swiper = new Swiper('#main_swiper', {
    loop: true,
    slidesPerView: 1,
    watchOverflow: false, // スライド数不足でもボタンをロックしない
    navigation: {
      nextEl: '.swiper-button-prev',
      prevEl: '.swiper-button-next',
    },
  
  });

</script>
<script>
// ブレイクポイント設定
const breakpoints = [
  { breakpoint: 960, slidesPerView: 4, spaceBetween: 25, centeredSlides: false },
  { breakpoint: 560, slidesPerView: 2, spaceBetween: 20, centeredSlides: false },
  { breakpoint: 0, slidesPerView: 1, spaceBetween: 20, centeredSlides: true },
];

// Swiper用のブレイクポイント変換関数
const generateSwiperBreakpoints = (breakpoints) => {
  return breakpoints.reduce((acc, bp) => {
    acc[bp.breakpoint] = {
      slidesPerView: bp.slidesPerView,
      spaceBetween: bp.spaceBetween,
      centeredSlides: bp.centeredSlides,
    };
    return acc;
  }, {});
};

const swiperBreakpoints = generateSwiperBreakpoints(breakpoints);

let mySwipers = []; // Swiperインスタンス格納
let isInited = [false, false, false]; // 各スライダーの初期化状態

const initSwiper = (index) => {
  mySwipers[index] = new Swiper(`.swiper-${index + 1}`, {
    slidesPerView: 1,
    centeredSlides: false,
    spaceBetween: 20,
    loop: true,
    grabCursor: true,
    navigation: {
      nextEl: `.rec_swiper .rec-pagination-${index + 1} .rec-swiper-button-next`,
      prevEl: `.rec_swiper .rec-pagination-${index + 1} .rec-swiper-button-prev`,
    },
    breakpoints: swiperBreakpoints,
  });
};

const checkBreakpoints = (index) => {
  const currentSlideLength = document.querySelectorAll(`.swiper-${index + 1} .swiper-slide:not(.swiper-slide-duplicate)`).length;
  const activeBreakpoint = breakpoints.find(bp => window.matchMedia(`(min-width: ${bp.breakpoint}px)`).matches);
  const slidesPerView = activeBreakpoint ? activeBreakpoint.slidesPerView : 1;

  if (currentSlideLength > slidesPerView) {
    if (!isInited[index]) {
      initSwiper(index);
      isInited[index] = true;
    }
  } else if (isInited[index]) {
    mySwipers[index].destroy(false, true);
    isInited[index] = false;
  }
};

// 画像の高さを取得して対応するDIVに適用
const adjustDivHeight = (imageSelector, divSelector) => {
  const targetImage = document.querySelector(imageSelector);
  const targetDiv = document.querySelector(divSelector);

  if (targetImage && targetDiv) {
    const setHeight = () => {
      const imageHeight = targetImage.offsetHeight;
      targetDiv.style.height = `${imageHeight - 16}px`;
    };

    targetImage.onload = setHeight;
    if (targetImage.complete) {
      setHeight();
    }
  }
};

// swiper-initializedがない場合に.rec-paginationを非表示
const updateSwiperVisibility = () => {
  [1, 2, 3].forEach((num) => {
    const swiperElements = document.querySelectorAll(`.swiper-${num}`);
    const recPaginationElement = document.querySelector(`.rec-pagination-${num}`);
    swiperElements.forEach((swiperElement) => {
      if (!swiperElement.classList.contains('swiper-initialized') && recPaginationElement) {
        recPaginationElement.style.display = 'none';
      } else {
        recPaginationElement.style.display = 'block';
      }
    });
  });
};

// 初期化
const handleResize = () => {
  [0, 1, 2].forEach(index => checkBreakpoints(index));
};

// 初期化処理
handleResize();
adjustDivHeight('.target-image-1', '.rec-pagination-1');
adjustDivHeight('.target-image-2', '.rec-pagination-2');
updateSwiperVisibility();

// リサイズ時にも初期化を再度行いたい場合
window.addEventListener('resize', () => {
  clearTimeout(window.resizeTimer);
  window.resizeTimer = setTimeout(() => {
    // 初期化処理を行う
    handleResize();
    // 高さ調整も行う
    adjustDivHeight('.target-image-1', '.rec-pagination-1');
    adjustDivHeight('.target-image-2', '.rec-pagination-2');
    updateSwiperVisibility();
  }, 100); // デバウンス
});
</script><!-- レコメンド 終了 -->


