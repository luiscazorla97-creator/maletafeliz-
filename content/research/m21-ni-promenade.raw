on {\"level\":1,\"format\":\"sticky\",\"expandOnMobile\":true,\"useSemanticHeadings\":false} --\u003E\n\u003C!-- wp:wp-etourisme-v3/section-header /--\u003E\n\n\u003C!-- wp:wp-etourisme-v3/section-body --\u003E\n\u003C!-- wp:wp-etourisme-v3/section {\"level\":2,\"expandOnMobile\":true,\"useSemanticHeadings\":false} --\u003E\n\u003C!-- wp:wp-etourisme-v3/section-header /--\u003E\n\n\u003C!-- wp:wp-etourisme-v3/section-body {\"format\":\"no-space\"} --\u003E\n\u003C!-- wp:wp-etourisme-v3/map /--\u003E\n\n\u003C!-- wp:wp-etourisme-v3/address /--\u003E\n\u003C!-- /wp:wp-etourisme-v3/section-body --\u003E\n\u003C!-- /wp:wp-etourisme-v3/section --\u003E\n\n\u003C!-- wp:iris-collection-etourisme/communication {\"fields\":[{\"label\":\"Mail\",\"value\":\"mail\"},{\"label\":\"Page Facebook\",\"value\":\"page-facebook\"},{\"label\":\"Site web (URL)\",\"value\":\"site-web-url\"},{\"label\":\"T\u00e9l\u00e9phone\",\"value\":\"telephone\"},{\"label\":\"Page Twitter\",\"value\":\"page-twitter\"},{\"label\":\"Instagram\",\"value\":\"instagram\"},{\"label\":\"Tripadvisor\",\"value\":\"tripadvisor\"},{\"label\":\"Youtube\",\"value\":\"youtube\"}]} /--\u003E\n\n\u003C!-- wp:wp-etourisme-v3/html {\"field\":{\"label\":\"Identifiant Tripadvisor\",\"value\":\"identifiant-tripadvisor\"},\"complexFieldKey\":null,\"htmlContent\":\"\\u003cdiv class=\\u0022wpet-tripadvisor\\u0022\\u003e\\n\\u003cdiv id=\\u0022TA_cdsratingsonlywide341\\u0022 class=\\u0022TA_cdsratingsonlywide\\u0022\\u003e\\n    \\u003cul id=\\u0022qhPkcXhy\\u0022 class=\\u0022TA_links xozUurlhjp\\u0022\\u003e\\n        \\u003cli id=\\u0022TbFwcq7\\u0022 class=\\u00226UltqkQx4dV3\\u0022\\u003e\\n            \\u003ca target=\\u0022_blank\\u0022 href=\\u0022https://www.tripadvisor.fr/\\u0022\\u003e\\n                \\u003cimg src=\\u0022https://www.tripadvisor.fr/img/cdsi/img2/branding/tripadvisor_logo_transp_340x80-18034-2.png\\u0022 alt=\\u0022TripAdvisor\\u0022 /\\u003e\\n            \\u003c/a\\u003e\\n        \\u003c/li\\u003e\\n    \\u003c/ul\\u003e\\n\\u003c/div\\u003e \\n\\n\\u003c/div\\u003e\"} /--\u003E\n\n\u003C!-- wp:wp-etourisme-v3/section {\"level\":2,\"expandOnMobile\":true,\"useSemanticHeadings\":false} --\u003E\n\u003C!-- wp:wp-etourisme-v3/section-header /--\u003E\n\n\u003C!-- wp:wp-etourisme-v3/section-body {\"format\":\"no-space\"} --\u003E\n\u003C!-- wp:wp-etourisme-v3/icon-label-value {\"field\":{\"label\":\"FairGuest Note\",\"value\":\"fairguest-note\"},\"icon\":{\"label\":\"Note\",\"value\":\"note\",\"class\":\"ei ei-thumb-up-o\"},\"suffix\":\"/ 10\",\"excludedValues\":[],\"format\":\"bold\"} /--\u003E\n\n\u003C!-- wp:wp-etourisme-v3/icon-label-value {\"field\":{\"label\":\"FairGuest Label\",\"value\":\"fairguest-label\"},\"excludedValues\":[],\"format\":\"bold\"} /--\u003E\n\n\u003C!-- wp:wp-etourisme-v3/icon-label-value {\"field\":{\"label\":\"FairGuest Nombre d'avis\",\"value\":\"fairguest-nbavis\"},\"label\":\"Moyenne sur\",\"suffix\":\" avis d\u00e9pos\u00e9s sur + de  20 sites d'avis\",\"excludedValues\":[],\"format\":\"meta\"} /--\u003E\n\u003C!-- /wp:wp-etourisme-v3/section-body --\u003E\n\u003C!-- /wp:wp-etourisme-v3/section --\u003E\n\u003C!-- /wp:wp-etourisme-v3/section-body --\u003E\n\u003C!-- /wp:wp-etourisme-v3/section --\u003E\n\u003C!-- /wp:wp-etourisme-v3/layout-zone --\u003E\n\u003C!-- /wp:wp-etourisme-v3/wrapper --\u003E\n\n\u003C!-- wp:wp-etourisme-v3/layout-zone {\"type\":\"footer\",\"class\":\"wpet-zone-footer\",\"label\":\"Contenu pied de page\"} --\u003E\n\u003C!-- wp:wp-etourisme-v3/cross-selling /--\u003E\n\u003C!-- /wp:wp-etourisme-v3/layout-zone --\u003E\n\u003C!-- /wp:wp-etourisme-v3/layout --\u003E","post_title":"Promenade des Anglais","post_excerpt":"","post_status":"publish","comment_status":"open","ping_status":"closed","post_password":"","post_name":"promenade-des-anglais","to_ping":"","pinged":"","post_modified":"2026-07-27 16:56:39","post_modified_gmt":"2026-07-27 14:56:39","post_content_filtered":"","post_parent":0,"guid":"https://www.explorenicecotedazur.com/patrimoine-culturel/promenade-des-anglais/","menu_order":0,"post_type":"patrimoine-culturel","post_mime_type":"","comment_count":"0","filter":"raw","wpetContext":true,"detailPageTemplateId":18622,"wpetFields":{"adresse-1":"Promenade des Anglais","animaux-acceptes":"ACCEPTES","code-postal":"06000","commune":"Nice","complement-accueil-animaux":"Animaux accept\u00e9s tenus en laisse.","contact-referent-nom":"NICE CONVENTION","contact-referent-prenom":"Bureau","criteres-internes":["Offre Pet Friendly","Pas de questionnaire"],"date-de-modification":"2026-11-17T02:07:41.000Z","date-modification-apidae":"2026-04-21 14:57:25","descriptif-prive-type":[{"nom":"2013_Application","descriptif":"Elle voit le jour en 1822 gr\u00e2ce au r\u00e9v\u00e9rend Lewis Way qui lance une souscription aupr\u00e8s des hivernants anglais afin de secourir les habitants sans travail en leur faisant niveler une chauss\u00e9e de 2 m\u00e8tres de large du Paillon \u00e0 l\u2019actuelle rue Meyerbeer, avec l\u2019accord de la municipalit\u00e9. Soucieuse de venir en aide aux paysans ni\u00e7ois r\u00e9duits \u00e0 la mis\u00e8re par de mauvaises r\u00e9coltes, la communaut\u00e9 leur confie les travaux initiaux qui sont achev\u00e9s en 1824 par des terrassiers. Si les actes publics la d\u00e9nomment \u00ab Strada del litorale \u00bb, la population d\u00e9signe la nouvelle chauss\u00e9e \u00ab Camin dei Ingl\u00e8s \u00bb (chemin des Anglais). Avec le d\u00e9veloppement rapide des quartiers ouest, la municipalit\u00e9 int\u00e8gre la Promenade dans son plan d\u2019urbanisme, le Consiglio d\u2019Ornato. En 1844, le Conseil communal donne \u00e0 la nouvelle voie le nom officiel de \u00ab Promenade des Anglais \u00bb, la fait prolonger jusqu\u2019aux Baumettes et ordonne la plantation d\u2019arbres et d\u2019arbustes \u00e0 fleurs. En 1856, la Promenade atteint Magnan et mesure d\u00e9sormais 8 m de largeur."},{"nom":"descr_Otm","descriptif":"Longue de 7 kilom\u00e8tres, la Promenade des Anglais longe la Baie des Anges et ses plages de galets. Construite en 1824 \u00e0 l\u2019initiative du R\u00e9v\u00e9rend Anglais Lewis Way, elle d\u00e9marre entre le Parc Phoenix et l\u2019A\u00e9roport Nice C\u00f4te d\u2019Azur, pour se prolonger jusqu\u2019au Quai des Etats Unis, au pied de la colline du Ch\u00e2teau. Elle est un lieu de passage incontournable des visiteurs mais aussi des habitants qui aiment s\u2019y retrouver. En roller ou \u00e0 v\u00e9lo, en marchant ou en courant, seul ou accompagn\u00e9, toutes les raisons sont bonnes pour aller y admirer la mer \u00e0 perte de vue et ses \u00e9blouissants levers de soleil.\nSur sa route, on y croise les plus beaux h\u00f4tels de luxe comme le Palais de la M\u00e9diterran\u00e9e, l\u2019H\u00f4tel West End ou encore le mythique H\u00f4tel Negresco, tout comme les b\u00e2timents culturels\u00a0: le CUM (Centre Universitaire M\u00e9diterran\u00e9en) et le Mus\u00e9e Mass\u00e9na. Tout au long du parcours se succ\u00e8dent \u00e9galement des \u0153uvres d\u2019art, des pergolas et des chaises bleues, devenues un v\u00e9ritable symbole de la ville de Nice."}],"description-courte":"Face \u00e0 la Baie des Anges, la Promenade des Anglais est l'un des symboles de Nice. \u00c0 toute heure de la journ\u00e9e, habitants et visiteurs s'y retrouvent pour marcher, courir, p\u00e9daler ou simplement profiter d'un moment au bord de la M\u00e9diterran\u00e9e.","description-longue":"S'\u00e9tendant le long de la Baie des Anges sur pr\u00e8s de 7 kilom\u00e8tres, la Promenade des Anglais accompagne le littoral ni\u00e7ois entre palmiers, plages et c\u00e9l\u00e8bres chaises bleues. \u00c0 toute heure de la journ\u00e9e, elle rassemble les Ni\u00e7ois comme les visiteurs, venus s'y promener, pratiquer une activit\u00e9 sportive ou simplement prendre le temps de contempler la mer.\n\nSon histoire d\u00e9bute en 1824, lorsque le r\u00e9v\u00e9rend britannique Lewis Way encourage la cr\u00e9ation d'un chemin longeant le rivage afin d'offrir du travail aux habitants touch\u00e9s par un hiver particuli\u00e8rement rigoureux. Tr\u00e8s vite adopt\u00e9e par les hivernants anglais, la promenade s'agrandit progressivement et prend le nom de Promenade des Anglais en hommage \u00e0 cette communaut\u00e9 qui a contribu\u00e9 \u00e0 son d\u00e9veloppement.\n\nAu fil du XX\u1d49 si\u00e8cle, elle est \u00e9largie et modernis\u00e9e pour accompagner l'\u00e9volution de Nice. Aujourd'hui, elle accueille de grands rendez-vous qui rythment la vie de la ville, parmi lesquels le Carnaval de Nice, des \u00e9v\u00e9nements sportifs et de nombreuses manifestations culturelles.\n\nDu matin jusqu'au coucher du soleil, la Promenade des Anglais vit au rythme de celles et ceux qui la parcourent. On y marche, on y court, on s'y retrouve ou l'on s'accorde simplement une pause sur les c\u00e9l\u00e8bres chaises bleues face \u00e0 la Baie des Anges. Entre mer, lumi\u00e8re m\u00e9diterran\u00e9enne et animation du front de mer, elle accompagne aussi bien le quotidien des Ni\u00e7ois que les d\u00e9couvertes des visiteurs.","devise":"EUR","entite-information":"Office de Tourisme M\u00e9tropolitain Nice C\u00f4te d'Azur","gratuit":"1","identifiant":"5016481","identifiant-secondaire":"SITRA2_PCU_5016481","indications-periode-saisonnalite":["Automne","Et\u00e9","Hiver","Printemps"],"indications-tarifs":"ACCES_LIBRE","langues-parlees":["Fran\u00e7ais"],"latitude":"43.693612","longitude":"7.255834","mail-signaler-une-erreur":["sylvie.ardino@explorenca.com","jonathan.durussel@explorenca.com"],"membre-proprietaire":"Office de Tourisme M\u00e9tropolitain Nice C\u00f4te d'Azur","nom":"Promenade des Anglais","ouvert-toute-lannee":"OUVERT_TOUTE_L_ANNEE","perimetre":["Nice"],"periodes":[{"type":"opening","touslesans":true,"datedebut":"2026-01-01T00:00:00.000Z","datefin":"2026-12-31T00:00:00.000Z","jour":["LUNDI","MARDI","MERCREDI","JEUDI","VENDREDI","SAMEDI","DIMANCHE"],"horaires":{"LUNDI":[{"debut":"","fin":""}],"MARDI":[{"debut":"","fin":""}],"MERCREDI":[{"debut":"","fin":""}],"JEUDI":[{"debut":"","fin":""}],"VENDREDI":[{"debut":"","fin":""}],"SAMEDI":[{"debut":"","fin":""}],"DIMANCHE":[{"debut":"","fin":""}]},"complement":""}],"periodes-en-clair":"Toute l'ann\u00e9e tous les jours.","photos":[{"url":{"full":"https://www.explorenicecotedazur.com/app/uploads/2026/05/bord-de-mer-nice-vdn-julien-veran.webp","default":"https://www.explorenicecotedazur.com/app/uploads/2026/05/bord-de-mer-nice-vdn-julien-veran-380x480.webp","large":"https://www.explorenicecotedazur.com/app/uploads/2026/05/bord-de-mer-nice-vdn-julien-veran-800x520.webp","small":"https://www.explorenicecotedazur.com/app/uploads/2026/05/bord-de-mer-nice-vdn-julien-veran-380x250.webp","square":"https://www.explorenicecotedazur.com/app/uploads/2026/05/bord-de-mer-nice-vdn-julien-veran-335x335.webp","auto":"https://cdn.iris-etourism.io/uploads/nice/sizes/8b5/76-141-40734028-380x0.webp"},"nom":"bord-de-mer-nice-vdn-julien-veran","copyright":"VDN - JULIEN VERAN","legende":"bord de mer promenade des anglais nice plage ponchettes palmier vieux nice montagne"},{"url":{"full":"https://www.explorenicecotedazur.com/app/uploads/2025/09/promenadedesanglais-bounceproduction.webp","default":"https://www.explorenicecotedazur.com/app/uploads/2025/09/promenadedesanglais-bounceproduction-380x480.webp","large":"https://www.explorenicecotedazur.com/app/uploads/2025/09/promenadedesanglais-bounceproduction-800x520.webp","small":"https://www.explorenicecotedazur.com/app/uploads/2025/09/promenadedesanglais-bounceproduction-380x250.webp","square":"https://www.explorenicecotedazur.com/app/uploads/2025/09/promenadedesanglais-bounceproduction-335x335.webp","auto":"https://cdn.iris-etourism.io/uploads/nice/sizes/8b5/76-141-40734028-380x0.webp"},"nom":"PROMENADE DES ANGLAIS","copyright":"BOUNCE PRODUCTION","legende":"PLAGE NICE"},{"url":{"full":"https://www.explorenicecotedazur.com/app/uploads/2025/09/borddemer-agencemedia-h265.webp","default":"https://www.explorenicecotedazur.com/app/uploads/2025/09/borddemer-agencemedia-h265-380x480.webp","large":"https://www.explorenicecotedazur.com/app/uploads/2025/09/borddemer-agencemedia-h265-800x520.webp","small":"https://www.explorenicecotedazur.com/app/uploads/2025/09/borddemer-agencemedia-h265-380x250.webp","square":"https://www.explorenicecotedazur.com/app/uploads/2025/09/borddemer-agencemedia-h265-335x335.webp","auto":"https://cdn.iris-etourism.io/uploads/nice/sizes/8b5/76-141-40734028-380x0.webp"},"nom":"BORDDEMER_-_AGENCEMEDIA-H265","copyright":"RIPOLL"},{"url":{"full":"https://www.explorenicecotedazur.com/app/uploads/2025/09/promenadedesanglais-otmnca2fa.issock.webp","default":"https://www.explorenicecotedazur.com/app/uploads/2025/09/promenadedesanglais-otmnca2fa.issock-380x480.webp","large":"https://www.explorenicecotedazur.com/app/uploads/2025/09/promenadedesanglais-otmnca2fa.issock-800x520.webp","small":"https://www.explorenicecotedazur.com/app/uploads/2025/09/promenadedesanglais-otmnca2fa.issock-380x250.webp","square":"https://www.explorenicecotedazur.com/app/uploads/2025/09/promenadedesanglais-otmnca2fa.issock-335x335.webp","auto":"https://cdn.iris-etourism.io/uploads/nice/sizes/8b5/76-141-40734028-380x0.webp"},"nom":"PROMENADEDESANGLAIS_-_OTMNCA2FA.ISSOCK","copyright":""}],"selection-apidae":["192255","197690","197755","206827"],"services":["Animaux accept\u00e9s"],"site-web-url":["https://www.explorenicecotedazur.com/explorer/unesco-et-patrimoine/inscription-unesco/"],"supplement-animaux-acceptes":"SANS_SUPPLEMENT","tarif-mode-de-generation":"AUTOMATIQUE","tarifs-en-clair":"Acc\u00e8s libre.","telephone":["04 92 14 46 14"],"territoire":["GR\u00ae5-Alpes","Chemins du Soleil","Route des Grandes Alpes","Alpes Maritimes","Provence Alpes C\u00f4te d'Azur","P'tites Routes du Soleil","C\u00f4te d'Azur","M\u00e9tropole Nice C\u00f4te d'Azur","Littoral autour de Nice","Ville de Nice","Nice","POC Sherpa Lyon - Nice"],"themes":["Patrimoine historique","Rue"],