    <img loading="lazy" src="/sites/default/files/styles/large_vertical_promo/public/mercer_house_0.jpg.webp?h=54b4a651&amp;itok=7GjQHVbC" width="1024" height="1536" alt="Mercer House in Savannah" title="Mercer House" class="image-style-large-vertical-promo scale-with-grid" />




          <figcaption class="caption-basic text-align-right z-2">
          <span class="field--text-long">
    <p>Mercer Williams House</p>

  </span>

      </figcaption>
    
  </figure>

</div>
