	/* blog - shared */
	.blog-container a{--border-color:var(--gray-light);--link-color:var(--teal-alt);--text-color:var(--gray-dark);--title-color:var(--gray-dark);color:var(--link-color);font-weight:bold}.blog-container .author{max-width:966px;margin:auto;display:flex;align-items:flex-start;gap:var(--space-8);border-bottom:var(--space-px) solid var(--border-color);padding:var(--space-8) 0 var(--space-8);margin-bottom:var(--space-8)}.blog-container.blog-single .author{border-top:var(--space-px) solid var(--border-color)}.blog-container .author .image-holder{flex:0 0 var(--space-24)}.blog-container .author-img{width:100%;aspect-ratio:1;border-radius:var(--rounded-circle);overflow:hidden;object-fit:cover}.blog-container .author p:last-of-type{margin-bottom:0}.blog-container .author .author-title{font-style:italic;color:var(--title-color);font-size:var(--text-sm);margin-bottom:var(--space-1)}.blog-container .author h5{font-size:var(--text-2xl);font-weight:bold;margin-top:0;line-height:var(--leading-tight);margin-bottom:var(--space-1)}.blog-container .author p{font-size:var(--text-base);color:var(--text-color)}@media(hover:hover){.blog-container a:hover{text-decoration:none;color:var(--link-color)}}

	/* Hide stuff */
			.panel-footer,
			.panel-social,
			.panel-header .sticky-links {
				display:none;
			}
		
			.panel-header .sticky-links .hover-label {
				transform: translateX(100%);
				transition: none;
			}
		
			/* Riverwalk */
			[data-sitename="riverwalk"] .panel-header {
				--surface-foreground: var(--teal);
				--surface-background: var(--teal);
				--surface-mobile-nav: var(--teal);
			}
		
			[data-sitename="riverwalk"] .scroll-button {
				background: var(--red);
			}
		
			/* The minified sections above come from the client-root CSS, which is primary's theme. Riverwalk
			overrides those files at site level, but its copies load deferred and sit earlier in the head, so
			they cannot win a specificity tie against this block until it is removed on window.load. Casing is
			the property that leaks: primary sets lowercase on h1/h3/h6 and riverwalk sets capitalize on h1 and
			nothing on h3/h6, so riverwalk headings render lowercase until load and then jump. Values below
			match the settled render measured on riverwalk. */
			[data-sitename="riverwalk"] :is(.core-styles, .contentRender_name_plugins_core_textbox) h1 {
				text-transform: capitalize;
			}
		
			[data-sitename="riverwalk"] :is(.core-styles, .contentRender_name_plugins_core_textbox) :is(h3, h6) {
				text-transform: none;
			}
		</style>
		
		<script>
			// Visit Widget is third-party and is not needed for first paint, so the three vendor scripts are
			// injected after window.load instead of blocking the parser at the top of <head>. They must stay in
			// order: the core widget first, then the banner config it reads, then the banner runtime.
			(function() {
				var visitWidgetScripts = [
					'https://scripts.visitwidget.com/visitsanantonio.visitwidget.com/San_Antonio_Widget_Button/visit_widget.js',
					'https://scripts.visitwidget.com/visitsanantonio.visitwidget.com/app_banner_config.js',
					'https://scripts.visitwidget.com/app_banner_v2.min.js'
				];
		
				function loadVisitWidgetScript(index) {
					if (index >= visitWidgetScripts.length) {
						return;
					}
		
					var script = document.createElement('script');
					script.src = visitWidgetScripts[index];
		
					// The vendor and legacy integrations look this element up by id.
					if (index === 0) {
						script.id = 'visit_widget_script_tag';
					}
		
					function loadNext() {
						loadVisitWidgetScript(index + 1);
					}
		
					// Continue on failure so one unavailable script cannot strand the rest, which is how the
					// original independent <script> tags behaved.
					script.onload = loadNext;
					script.onerror = loadNext;
		
					document.head.appendChild(script);
				}
		
				window.addEventListener('load', function() {
					loadVisitWidgetScript(0);
				});
			})();
		</script>
		
														
	</head>															
