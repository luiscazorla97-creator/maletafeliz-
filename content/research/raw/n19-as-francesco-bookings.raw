    <p class="mb-0 fw-bold">Benvenuto nell'area dedicata alla registrazione.<br>N.B. Per le Agenzie di Viaggio la registrazione è obbligatoria.</p>
</div>
<style>
    /* Ensure form groups are relative so we can position the flag */
    .form-group {
        position: relative;
    }

    /* Make the intl container take full width and not overflow */
    .iti {
        display: block;
        width: 100%;
        box-sizing: border-box;
    }

    /* Position the flag/prefix inside the form-group and allow clicks */
    .iti__flag-container {
        position: absolute;
        left: 12px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 3;
        pointer-events: auto;
        cursor: pointer;
    }

    /* Give space on the left of the input so the flag/prefix doesn't overlap */
    .intl-cell-input {
        padding-left: 64px !important;
    }

    /* Slight adjustment for selected dial code if present */
    .iti__selected-dial-code {
        margin-left: 6px;
        margin-right: 6px;
    }

    /* Make the country list scrollable and nicely padded */
    .iti__country-list {
        max-height: 220px;
        overflow: auto;
        padding: 0;
    }

    /* Reduce excessive padding inside country items */
    .iti__country {
        padding: 6px 10px !important;
    }
</style>
