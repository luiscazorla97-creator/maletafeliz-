<script>
	require(['plugins_common_custom_utils', 'domReady!'], function(utils) {
		const scrollButton = document.querySelector('[data-scroll-button]');
		const contentSection = document.querySelector('[data-main-content]');

		if (!scrollButton) return;

		function scrollButtonClickHandler() {
			const contentTop = contentSection.getBoundingClientRect().top + window.scrollY;
	
			window.scroll({
				left: 0,
				top: contentTop,
				behavior: 'smooth',
			});
		}

		function scrollHandler() {
			if (window.scrollY > 200 && !scrollButton.classList.contains('bye')) scrollButton.classList.add('bye');
		}

		function bindEventListeners() {
			// click the scroll button, scroll down to content
			scrollButton.addEventListener('click', scrollButtonClickHandler);

			// disapparate scroll button when scrolling down
			window.addEventListener('scroll', scrollHandler);
			['resize', 'orientationchange'].forEach(ev => window.addEventListener(ev, utils.debounce(scrollHandler, 200)));
		}

		// init
		scrollHandler();
		bindEventListeners();
	});
</script>
