    <script src="https://www.comune.assisi.pg.it/contatta_inclusione.html"></script>
<script>
    let iframe = '<iframe src="https://www.google.com/maps/embed?pb=!1m14!1m12!1m3!1d3465.931568692042!2d12.615557530631666!3d43.07320471178246!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!5e0!3m2!1sit!2sit!4v1755585712990!5m2!1sit!2sit" width="600" height="450" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>';
</script>
    <div id="footer1"></div>
    <script src="https://www.comune.assisi.pg.it/schiocciola.js"></script>
    <script src="https://www.comune.assisi.pg.it/footer.html"></script>
    <script src="https://www.comune.assisi.pg.it/Footer_js.js"></script>
    <script src="https://www.comune.assisi.pg.it/linkfooter.js"></script>
    <script>
        function checkCookie() {
            let cookieConsent = leggiCookie('cookies_consent');
            let refCookies = leggiCookie('ref_cookies');

            if (!refCookies && cookieConsent) {
                let divMappa = document.getElementById('mappa');
                divMappa.innerHTML = iframe;
                divMappa.querySelector('iframe').setAttribute('width','100%');
            }
        }

        var passo = 0;
        function bottone(valmessa) {
            passo++;
            if (passo ==2) {
                inviaValutazione(valmessa);
            }
        }
        
        let stella;
        function leggiStella(star) {
                stella = star.value;
            }
        
        function inviaValutazione(valmessa) {  
            let valpos = document.forms.myForm.rating1.value;
            let valneg = document.forms.myForm.rating2.value;
            let dettaglio = document.getElementById('formGroupExampleInputWithHelp').value;
            var valmessa= valmessa += "&VALPOS=" + valpos + "&VALNEG=" + valneg + "&STAR=" + stella + "&DETT=" + dettaglio ; 
            SCHIOCCIOLA(valmessa,'EG0/EGVALPG.HBL');
        }

        
    const url = encodeURIComponent(window.location.href);
    let titolo_social = document.getElementById('titolo_social').innerHTML;
    let descrizione_social = document.getElementById('descrizione_social').innerHTML;
    let immagine_social = document.getElementById('immagine_social').src;
    
    let urlfb = document.querySelector('meta[property="og:url"]');
    let titlefb = document.querySelector('meta[property="og:title"]');
    let descriptionfb = document.querySelector('meta[property="og:description"]');
    let imagefb = document.querySelector('meta[property="og:image"]');  
    
    const twitterOG = document.querySelectorAll('meta[name^="twitter:"]');
    
    urlfb.content = url;
    titlefb.content = titolo_social;
    descriptionfb.content = descrizione_social;
    imagefb.content = immagine_social;
    
    twitterOG.forEach(meta => {
        let metaTW = meta.getAttribute('name');
        switch(metaTW) {
            case 'twitter:title': 
                meta.content = titolo_social;
                break;
            case 'twitter:description': 
                meta.content = descrizione_social;
                break;
            case 'twitter:image': 
                meta.content = immagine_social;
                break;
        }
    });
    
    document.getElementById('condividi_fb').href = "https://www.facebook.com/sharer/sharer.php?u=" + url;
    document.getElementById('condividi_tw').href = "https://twitter.com/intent/tweet?url=" + url;
    document.getElementById('condividi_li').href = "https://www.linkedin.com/shareArticle?url=" + url;
    document.getElementById('condividi_wa').href = "https://api.whatsapp.com/send?text=" + url;
    </script> 
