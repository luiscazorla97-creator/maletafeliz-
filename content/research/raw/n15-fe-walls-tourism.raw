<div class="pages-basic-info" style="clear: both; overflow: hidden;"><span class="am am-bookmark set-color" style="font-size: 50px; color: #a91a2d; position: absolute; left: 31px; top: -15px;"></span>
<div class="col-xs-12 col-sm-6 col-md-6 " style="margin-top: 10px; padding-left: 0px; padding-right: 0px;">
<p class="basic-info-title" style="color: #a91a2d;">Information</p>
<div class="m-t-10 m-b-10 nop locked-text"><span class="am am-pin" style="margin-right: 10px;"></span> <span><strong><span class="postal-code">44121</span> <span class="locality">Ferrara</span>, <span class="region">Province of Ferrara</span>, <span class="country-name">Italy</span></strong></span></div>
