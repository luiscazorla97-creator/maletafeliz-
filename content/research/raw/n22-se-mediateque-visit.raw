<script>
(function($){
var $contentWysiwyg = $('main.content > .wysiwyg');
var $asideSide = $('aside.side');
// add side classes.
$asideSide
.find('> div').addClass('side-inner').end()
.find('> div > h2').addClass('side-header').end()
.find('> div > div').addClass('side-content');
var $sideContent = $asideSide.find('.side-content');
var _pageUrl = '/info/visit/';
// add $sideContent nav classes.
$sideContent
.find('> ul').addClass('side-nav01').end()
.find('> ul > li > ul').addClass('side-nav02').end()
.find('> ul > li > ul > li > ul').addClass('side-nav03');
// add .is-current to closest li elements.
$sideContent.find('a[href="' + _pageUrl + '"]')
.closest('.side-nav03 > li').addClass('is-current').end()
.closest('.side-nav02 > li').addClass('is-current is-open').end()
.closest('.side-nav01 > li').addClass('is-current');
// remove extra class.
$sideContent.find('.side-nav03 > .is-current').closest('.side-nav02 > .is-current').removeClass('is-current');
// replace url to smartphone page.
$asideSide.find('a[href^="/info/"]').each(function(){
var _url = $(this).attr('href');
_url = '/sp' + _url;
$(this).attr('href', _url);
});
// hide pagetop links
$contentWysiwyg.find('a[href="#top"]').parent('p').hide();
// resize thumbnail size
$contentWysiwyg.find('.with-sample .sample img[width="30"]').attr({'width': '38', 'height': '38'});
})(jQuery);
</script>
