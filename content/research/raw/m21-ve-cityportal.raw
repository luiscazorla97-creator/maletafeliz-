            const track = document.getElementById(P + 'Track');
            const dotsBox = document.getElementById(P + 'Dots');
            const prevBtn = document.getElementById(P + 'Prev');
            const nextBtn = document.getElementById(P + 'Next');
            const carousel = document.getElementById(P + 'Carousel');
            const emptyEl = document.getElementById(P + 'Empty');
            const pauseBtn = document.getElementById(P + 'Pause');
            const pauseIcon = document.getElementById(P + 'PauseIcon');
            const pauseText = document.getElementById(P + 'PauseText');
            const monthSelector = document.getElementById(P + 'MonthSelector');
            const monthText = document.getElementById(P + 'MonthLabel');
            const monthPrev = document.getElementById(P + 'MonthPrev');
            const monthNext = document.getElementById(P + 'MonthNext');

            const esc = (s) => String(s == null ? '' : s).replace(/[&<>"']/g, (c) => (
                { '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' }[c]
            ));

            const icoPin = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>';
            const icoClock = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>';
            const icoCal = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>';

            const clockEl = document.getElementById(P + 'LiveClock');
            if (clockEl) {
                const updateClock = () => {
                    const d = new Date();
                    const dias = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
                    const meses = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
                    const diaSem = dias[d.getDay()];
                    const diaNum = d.getDate();
                    const mesNom = meses[d.getMonth()];
                    const hrs = String(d.getHours()).padStart(2, '0');
                    const mins = String(d.getMinutes()).padStart(2, '0');
                    const diaCap = diaSem.charAt(0).toUpperCase() + diaSem.slice(1);

                    clockEl.innerHTML = `<span class="av-clock-dot"></span><span class="av-clock-text">${esc(diaCap)}, ${diaNum} de ${esc(mesNom)}</span><span class="av-clock-time">${hrs}:${mins} hrs</span>`;
                };
                updateClock();
                setInterval(updateClock, 10000);
            }

            const MESES = ['Enero', 'Febrero', 'Marzo', 'Abril', 'Mayo', 'Junio', 'Julio', 'Agosto', 'Septiembre', 'Octubre', 'Noviembre', 'Diciembre'];
            const DIAS = ['domingo', 'lunes', 'martes', 'miércoles', 'jueves', 'viernes', 'sábado'];
            const p2 = (n) => String(n).padStart(2, '0');
            const ymd = (s) => { const p = String(s).split('-'); return { y: +p[0], m: +p[1] - 1, d: +p[2] }; };

            const ahora = new Date();
            let calY = ahora.getFullYear();
            let calM = ahora.getMonth();
            const hoyF = `${ahora.getFullYear()}-${p2(ahora.getMonth() + 1)}-${p2(ahora.getDate())}`;

            /*
             * Cada día en que ocurre un evento, como una tarjeta propia con su
             * fecha y su hora (Evento::carruselPortal manda la lista en `fechas`).
             * Un taller de ocho sesiones son ocho ocurrencias: así aparece en
             * todos sus meses y el calendario lo marca en todos sus días. Si
             * `fechas` no viene, se usa la fecha única de siempre.
             */
            const ocurrenciasDe = (e) => {
                const lista = (Array.isArray(e.fechas) && e.fechas.length)
                    ? e.fechas
                    : (e.fecha ? [{ fecha: e.fecha, dia: e.dia, mes: e.mes, hora: e.hora }] : []);

                return lista.map((f) => ({ ...e, fecha: f.fecha, dia: f.dia, mes: f.mes, hora: f.hora || e.hora, hoy: f.fecha === hoyF }));
            };

            let eventosMesActual = [];
            let totalSlots = 0;
            let indice = 0;
            let autoplayId = null;
            let isManualPaused = false;
            const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

            const itemsVisibles = () => window.innerWidth < 768 ? 1 : 3;
            const limite = () => Math.max(0, totalSlots - itemsVisibles());

            const tarjetaVerMas = () => {
                const url = null;
                const attr = url ? `href="${esc(url)}"` : 'data-ver-mas="1"';
                return `
                    <div class="av-slot">
                        <div class="av-card av-card-more" ${attr}>
                            <div class="av-more-circle">
                                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><path d="M5 12h14M13 6l6 6-6 6"/></svg>
                            </div>
                            <h3 class="av-more-title">Ver más eventos</h3>
                            <p class="av-more-sub">Explora la agenda completa</p>
                        </div>
                    </div>`;
            };

            const tarjeta = (e, idx) => {
                const color = e.color || '#5C113C';
                const cover = e.img
                    ? `<img class="av-img" src="${esc(e.img)}" alt="${esc(e.titulo)}" loading="lazy">`
                    : `<div class="av-ph" style="background:${esc(color)}">${icoCal}</div>`;
                const cat = e.categoria
                    ? `<span class="av-cat" style="background:${esc(color)}">${esc(e.categoria)}</span>` : '';
                const hoy = e.hoy ? '<span class="av-hoy">HOY</span>' : '';
                return `
                    <div class="av-slot">
                        <article class="av-card" data-idx="${idx}">
                            <div class="av-cover">
                                ${cover}
                                <span class="av-veil"></span>
                                <div class="av-date"><b>${esc(e.dia)}</b><span>${esc(e.mes)}</span></div>
                                ${cat}
                                ${hoy}
                            </div>
                            <div class="av-body">
                                <div>
                                    <h3 class="av-title">${esc(e.titulo)}</h3>
                                    <div class="av-place">${icoPin}<span>${esc(e.lugar)}</span></div>
                                </div>
                                <div class="av-foot">
                                    <span class="av-time">${icoClock}${esc(e.hora)}</span>
                                    <span class="av-cost">${esc(window.formatCostoGlobal(e.costo))}</span>
                                </div>
                            </div>
                        </article>
                    </div>`;
            };

            const pintarDots = () => {
                if (!dotsBox) return;
                const lim = limite();
                if (lim <= 0) { dotsBox.innerHTML = ''; return; }
                dotsBox.innerHTML = Array.from({ length: lim + 1 }, (_, i) =>
                    `<button type="button" class="av-dot${i === indice ? ' on' : ''}" data-i="${i}" aria-label="Ir al grupo ${i + 1}"></button>`
                ).join('');
                dotsBox.querySelectorAll('.av-dot').forEach((b) => {
                    b.addEventListener('click', () => { indice = +b.dataset.i; posicionar(); reiniciar(); });
                });
            };

            const marcarDots = () => {
                if (!dotsBox) return;
                dotsBox.querySelectorAll('.av-dot').forEach((b, i) => b.classList.toggle('on', i === indice));
            };

            const posicionar = () => {
                if (!track || !track.firstElementChild) return;
                const lim = limite();
                if (indice > lim) indice = 0;
                if (indice < 0) indice = lim;
                const ancho = track.firstElementChild.offsetWidth + 16;
                track.style.transform = `translateX(-${indice * ancho}px)`;
                const visible = lim > 0;
                if (prevBtn) prevBtn.style.display = visible ? '' : 'none';
                if (nextBtn) nextBtn.style.display = visible ? '' : 'none';
                marcarDots();
            };

            const siguiente = () => { const l = limite(); if (l <= 0) return; indice = indice < l ? indice + 1 : 0; posicionar(); };
            const anterior = () => { const l = limite(); if (l <= 0) return; indice = indice > 0 ? indice - 1 : l; posicionar(); };

            const arrancar = () => { if (reduceMotion || isManualPaused || limite() <= 0) return; parar(); autoplayId = setInterval(siguiente, 4000); };
            const parar = () => { if (autoplayId) { clearInterval(autoplayId); autoplayId = null; } };
            const reiniciar = () => { if (isManualPaused) return; parar(); arrancar(); };

            if (nextBtn) nextBtn.addEventListener('click', () => { siguiente(); reiniciar(); });
            if (prevBtn) prevBtn.addEventListener('click', () => { anterior(); reiniciar(); });

            if (pauseBtn) {
                pauseBtn.addEventListener('click', () => {
                    isManualPaused = !isManualPaused;
                    if (isManualPaused) {
                        parar();
                        if (pauseIcon) pauseIcon.innerHTML = '<path d="M8 5v14l11-7z"/>';
                        if (pauseText) pauseText.textContent = 'Reanudar';
                        pauseBtn.setAttribute('aria-label', 'Reanudar reproducción automática');
                    } else {
                        if (pauseIcon) pauseIcon.innerHTML = '<rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/>';
                        if (pauseText) pauseText.textContent = 'Pausar';
                        pauseBtn.setAttribute('aria-label', 'Pausar reproducción automática');
                        arrancar();
                    }
                });
            }

            if (carousel) {
                carousel.addEventListener('mouseenter', parar);
                carousel.addEventListener('mouseleave', () => { if (!isManualPaused) arrancar(); });
            }

            if (track) {
                track.addEventListener('click', (ev) => {
                    const cardMore = ev.target.closest('.av-card-more');
                    if (cardMore) {
                        const href = cardMore.getAttribute('href');
                        if (href) {
                            window.location.href = href;
                        } else {
                            setVista('calendario');
                        }
                        return;
                    }

                    const card = ev.target.closest('.av-card');
                    if (card && card.dataset.idx !== undefined) {
                        const e = eventosMesActual[card.dataset.idx];
                        if (e && window.abrirModalEventoGlobal) {
                            window.abrirModalEventoGlobal(e);
                        }
                    }
                });
            }

            /*
             * Una tarjeta por evento del mes, con el día que toca enseñar: el
             * próximo (hoy o después) o, si en ese mes ya pasaron todos, el
             * último. Primero van los que vienen, en orden; al final los que ya
             * pasaron, del más reciente al más viejo.
             *
             * Antes, en el mes en curso solo entraban los eventos de hoy ±5 días:
             * uno del día 25 no salía el día 8 aunque fuera de ese mes.
             */
            const actualizarEventosMes = () => {
                const targetYm = calY + '-' + p2(calM + 1);

                const delMes = eventos.map((e) => {
                    const enMes = ocurrenciasDe(e).filter((o) => o.fecha.startsWith(targetYm));
                    if (!enMes.length) return null;

                    return enMes.find((o) => o.fecha >= hoyF) || enMes[enMes.length - 1];
                }).filter(Boolean);

                const proximos = delMes.filter((o) => o.fecha >= hoyF).sort((a, b) => a.fecha.localeCompare(b.fecha));
                const pasados = delMes.filter((o) => o.fecha < hoyF).sort((a, b) => b.fecha.localeCompare(a.fecha));

                // Limitar a máximo 10 eventos para no saturar el carrusel; la
                // tarjeta «Ver más» lleva al calendario, que los enseña todos.
                eventosMesActual = [...proximos, ...pasados].slice(0, 10);
                totalSlots = eventosMesActual.length + (eventosMesActual.length > 0 ? 1 : 0);
                indice = 0;
                parar();

                if (monthText) {
                    monthText.textContent = `${MESES[calM]} ${calY}`;
                }

                if (eventosMesActual.length > 0) {
                    if (track) {
                        track.style.display = 'flex';
                        let html = eventosMesActual.map((e, idx) => tarjeta(e, idx)).join('');
                        html += tarjetaVerMas();
                        track.innerHTML = html;
                    }
                    if (emptyEl) emptyEl.style.display = 'none';
                    if (pauseBtn) pauseBtn.style.display = (vista === 'carrusel') ? '' : 'none';
                    pintarDots();
                    posicionar();
                    arrancar();
                } else {
                    if (track) {
                        track.style.display = 'none';
                        track.innerHTML = '';
                    }
                    if (emptyEl) emptyEl.style.display = 'block';
                    if (pauseBtn) pauseBtn.style.display = 'none';
                    if (dotsBox) dotsBox.innerHTML = '';
                    if (prevBtn) prevBtn.style.display = 'none';
                    if (nextBtn) nextBtn.style.display = 'none';
                }
            };

            const cambiarMes = (delta) => {
                calM += delta;
                if (calM < 0) { calM = 11; calY--; }
                if (calM > 11) { calM = 0; calY++; }
                actualizarEventosMes();
                if (calListo) {
                    seleccion = null;
                    if (calDay) calDay.style.display = 'none';
                    renderCal();
                }
            };

            if (monthPrev) monthPrev.addEventListener('click', () => cambiarMes(-1));
            if (monthNext) monthNext.addEventListener('click', () => cambiarMes(1));

            let t;
            window.addEventListener('resize', () => { clearTimeout(t); t = setTimeout(() => { pintarDots(); posicionar(); }, 150); });

            // ---- Vista de Calendario ----
            const toggleBtn = document.getElementById(P + 'ViewToggle');
            const calEl = document.getElementById(P + 'Calendar');
            let calListo = false;
            let seleccion = null;

            const porFecha = {};
            eventos.forEach((e) => ocurrenciasDe(e).forEach((o) => { (porFecha[o.fecha] = porFecha[o.fecha] || []).push(o); }));
            const fechas = Object.keys(porFecha).sort();

            const viewIcon = document.getElementById(P + 'ViewIcon');
            const viewText = document.getElementById(P + 'ViewText');
            const calGrid = document.getElementById(P + 'CalGrid');
            const calLabel = document.getElementById(P + 'CalLabel');
            const calDay = document.getElementById(P + 'CalDay');
            const calPrev = document.getElementById(P + 'CalPrev');
            const calNext = document.getElementById(P + 'CalNext');

            const ICO_CAL = '<rect x="3" y="4" width="18" height="18" rx="2"></rect><path d="M16 2v4M8 2v4M3 10h18"></path>';
            const ICO_CARR = '<rect x="3" y="6" width="12" height="12" rx="2"></rect><path d="M18 8v8M21 10v4"></path>';

            const panelDia = (fecha) => {
                const evs = porFecha[fecha] || [];
                if (!evs.length) { if (calDay) calDay.style.display = 'none'; return; }
                const o = ymd(fecha);
                const dow = DIAS[new Date(o.y, o.m, o.d).getDay()];
                let titulo = `${dow} ${o.d} de ${MESES[o.m].toLowerCase()}`;
                titulo = titulo.charAt(0).toUpperCase() + titulo.slice(1);
                const cuenta = `<span class="c">· ${evs.length} evento${evs.length > 1 ? 's' : ''}</span>`;
                if (calDay) {
                    calDay.innerHTML = `<h4>${titulo} ${cuenta}</h4>` + evs.map((e, subIdx) => {
                        const color = e.color || '#5C113C';
                        const thumb = e.img
                            ? `<div class="av-cal-thumb"><img src="${esc(e.img)}" alt="${esc(e.titulo)}" class="av-cal-thumb-img" loading="lazy"></div>`
                            : `<div class="av-cal-thumb"><div class="av-cal-thumb-ph" style="background:${esc(color)}">${icoCal}</div></div>`;
                        return `<div class="av-cal-di" style="--c:${esc(color)}" data-sub-idx="${subIdx}"><div class="info"><h5>${esc(e.titulo)}</h5><div class="mr"><span>${icoClock}${esc(e.hora)}</span><span>${icoPin}${esc(e.lugar)}</span></div></div><span class="cost">${esc(window.formatCostoGlobal(e.costo))}</span>${thumb}</div>`;
                    }).join('');
                    calDay.style.display = '';

                    calDay.querySelectorAll('.av-cal-di').forEach((el) => {
                        el.addEventListener('click', () => {
                            const subIdx = el.dataset.subIdx;
                            if (evs[subIdx] && window.abrirModalEventoGlobal) {
                                window.abrirModalEventoGlobal(evs[subIdx]);
                            }
                        });
                    });
                }
            };

            const renderCal = () => {
                if (!calGrid || !calLabel) return;
                calLabel.textContent = `${MESES[calM]} ${calY}`;

                // Offset para calendario con lunes como primer día de la semana (LUN=0, ..., DOM=6)
                const dFirst = new Date(calY, calM, 1).getDay(); // 0=DOM, 1=LUN, ..., 6=SÁB
                const inicio = (dFirst + 6) % 7;
                const dim = new Date(calY, calM + 1, 0).getDate();
                const dimPrev = new Date(calY, calM, 0).getDate();

                let html = '';
                for (let i = 0; i < 42; i++) {
                    const d = i - inicio + 1;
                    if (d < 1) {
                        const prevD = dimPrev + d;
                        html += `<div class="av-cal-cell dim"><div class="av-cal-top-row"><span class="av-cal-dn">${prevD}</span></div></div>`;
                        continue;
                    }
                    if (d > dim) {
                        const nextD = d - dim;
                        html += `<div class="av-cal-cell dim"><div class="av-cal-top-row"><span class="av-cal-dn">${nextD}</span></div></div>`;
                        continue;
                    }

                    const fecha = `${calY}-${p2(calM + 1)}-${p2(d)}`;
                    const evs = porFecha[fecha] || [];
                    let chips = '';
                    evs.slice(0, 2).forEach((e, subIdx) => {
                        chips += `<span class="av-cal-ev" style="--c:${esc(e.color || '#5C113C')}" data-sub-idx="${subIdx}"><span class="t">${esc(e.titulo)}</span></span>`;
                    });
                    if (evs.length > 2) chips += `<span class="av-cal-more">+${evs.length - 2} más</span>`;
                    const cls = ['av-cal-cell'];
                    const isToday = (fecha === hoyF);
                    if (isToday) cls.push('today');
                    if (evs.length) cls.push('has');
                    if (fecha === seleccion) cls.push('sel');
                    const hoyBadge = isToday ? '<span class="av-cal-hoy-chip">HOY</span>' : '';
                    html += `<div class="${cls.join(' ')}" data-f="${fecha}"><div class="av-cal-top-row"><span class="av-cal-dn">${d}</span>${hoyBadge}</div>${chips}</div>`;
                }
                calGrid.innerHTML = html;
                calGrid.querySelectorAll('.av-cal-cell.has').forEach((c) => {
                    c.addEventListener('click', () => {
                        seleccion = c.dataset.f;
                        calGrid.querySelectorAll('.av-cal-cell').forEach((x) => x.classList.toggle('sel', x.dataset.f === seleccion));
                        panelDia(seleccion);
                    });
                });

                calGrid.querySelectorAll('.av-cal-ev').forEach((chip) => {
                    chip.addEventListener('click', (ev) => {
                        ev.stopPropagation();
                        const cell = chip.closest('.av-cal-cell');
                        if (cell && cell.dataset.f) {
                            const f = cell.dataset.f;
                            const subIdx = chip.dataset.subIdx;
                            if (porFecha[f] && porFecha[f][subIdx] && window.abrirModalEventoGlobal) {
                                window.abrirModalEventoGlobal(porFecha[f][subIdx]);
                            }
                        }
                    });
                });
            };

            if (calPrev) calPrev.addEventListener('click', () => cambiarMes(-1));
            if (calNext) calNext.addEventListener('click', () => cambiarMes(1));

            let vista = 'carrusel';
            const setVista = (v) => {
                vista = v;
                const cal = v === 'calendario';
                if (carousel) carousel.style.display = cal ? 'none' : '';
                if (dotsBox) dotsBox.style.display = cal ? 'none' : '';
                if (calEl) calEl.style.display = cal ? '' : 'none';
                if (monthSelector) monthSelector.style.display = cal ? 'none' : '';
                if (pauseBtn) pauseBtn.style.display = (cal || eventosMesActual.length === 0) ? 'none' : '';
                if (viewText) viewText.textContent = cal ? 'Carrusel' : 'Calendario';
                if (viewIcon) viewIcon.innerHTML = cal ? ICO_CARR : ICO_CAL;
                if (toggleBtn) toggleBtn.setAttribute('aria-label', cal ? 'Cambiar a vista de carrusel' : 'Cambiar a vista de calendario');
                if (cal) {
                    parar();
                    if (!calListo) { renderCal(); const enM = fechas.filter((f) => { const o = ymd(f); return o.y === calY && o.m === calM; }); seleccion = enM.includes(hoyF) ? hoyF : (enM[0] || null); if (seleccion) panelDia(seleccion); calListo = true; }
                } else if (!isManualPaused && eventosMesActual.length > 0) {
                    arrancar();
                }
            };
            if (toggleBtn) toggleBtn.addEventListener('click', () => setVista(vista === 'carrusel' ? 'calendario' : 'carrusel'));

            // Inicializar carrusel para el mes actual
            actualizarEventosMes();
        })();
    </script>
</body>
</html>
