<div class="mw-heading mw-heading2"><h2 id="Assessment"><span id="Assessment"></span>Assessment</h2><span class="mw-editsection"><span class="mw-editsection-bracket">[</span><a href="/w/index.php?title=File:Nagoya_Castle(Larger).jpg&amp;action=edit&amp;section=2" title="Edit section: Assessment"><span>edit</span></a><span class="mw-editsection-bracket">]</span></span></div>
<div id="assessments" dir="ltr" lang="en">
