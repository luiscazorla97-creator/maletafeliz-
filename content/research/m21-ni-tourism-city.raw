var IRISCollectionTheme = {"queriedObject":{"ID":60321,"post_author":"4","post_date":"2026-03-06 12:11:26","post_date_gmt":"2026-03-06 11:11:26","post_content":"\u003C!-- wp:columns --\u003E\n\u003Cdiv class=\"wp-block-columns\"\u003E\u003C!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"66.66%\"} --\u003E\n\u003Cdiv class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:66.66%\"\u003E\u003C!-- wp:iris/advanced-title {\"title\":\"Visit Nice\",\"reverse\":true,\"alignment\":\"center\"} --\u003E\n\u003Cdiv class=\"wp-block-iris-advanced-title has-text-align-center wp-block-iris-advanced-title--inversed\" id=\"\"\u003E\u003Cp class=\"iris-over-title\"\u003EWith the Nice C\u00f4te d'Azur Convention &amp; Visitors Bureau\u003C/p\u003E\u003Ch2 class=\"h2\"\u003EVisit Nice\u003C/h2\u003E\u003C/div\u003E\n\u003C!-- /wp:iris/advanced-title --\u003E\u003C/div\u003E\n\u003C!-- /wp:column --\u003E\n\n\u003C!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"33.33%\"} --\u003E\n\u003Cdiv class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:33.33%\"\u003E\u003C!-- wp:image {\"id\":33864,\"width\":\"84px\",\"height\":\"auto\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"center\"} --\u003E\n\u003Cfigure class=\"wp-block-image aligncenter size-full is-resized\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2026/01/blason-nice.webp\" alt=\"\" class=\"wp-image-33864\" style=\"width:84px;height:auto\"/\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\u003C/div\u003E\n\u003C!-- /wp:column --\u003E\u003C/div\u003E\n\u003C!-- /wp:columns --\u003E\n\n\u003C!-- wp:heading {\"level\":3} --\u003E\n\u003Ch3 class=\"wp-block-heading\"\u003EBetween authenticity and urban effervescence\u003C/h3\u003E\n\u003C!-- /wp:heading --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EWhether you're looking for a city break, a cultural break, a seaside break or a gourmet experience, indeed, you'll find it all here in an instant. An international airport links the city to the rest of the world, and a hotel network of around 200 establishments caters for every style of traveller. By the sea, 7 km of beaches line the C\u00f4te d'Azur coastline, while a wide range of activities and major cultural and sporting events punctuate the year. In the heart of Nice, the coul\u00e9e verte extends the promenade into a green setting, while opening onto a city centre bustling with shops.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:gallery {\"linkTo\":\"none\",\"align\":\"wide\"} --\u003E\n\u003Cfigure class=\"wp-block-gallery alignwide has-nested-images columns-default is-cropped\"\u003E\u003C!-- wp:image {\"id\":35278,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} --\u003E\n\u003Cfigure class=\"wp-block-image size-full\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2026/01/cours-saleya-ville-de-nice-david-nouy6-scaled.webp\" alt=\"The Cours Saleya flower market\" class=\"wp-image-35278\"/\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\n\n\u003C!-- wp:image {\"id\":39386,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} --\u003E\n\u003Cfigure class=\"wp-block-image size-full\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2026/01/promenade-des-anglais-nice-otnca2-scaled.webp\" alt=\"A stroll along the Promenade des Anglais\" class=\"wp-image-39386\"/\u003E\u003Cfigcaption class=\"wp-element-caption\"\u003EA stroll along the Promenade des Anglais\u003C/figcaption\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\n\n\u003C!-- wp:image {\"id\":33887,\"sizeSlug\":\"full\",\"linkDestination\":\"none\"} --\u003E\n\u003Cfigure class=\"wp-block-image size-full\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2026/01/vuegc389nc389ralenice-olivierhuitel-1-1-scaled.webp\" alt=\"Photo of old Nice\" class=\"wp-image-33887\"/\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\u003C/figure\u003E\n\u003C!-- /wp:gallery --\u003E\n\n\u003C!-- wp:columns --\u003E\n\u003Cdiv class=\"wp-block-columns\"\u003E\u003C!-- wp:column --\u003E\n\u003Cdiv class=\"wp-block-column\"\u003E\u003C!-- wp:iris/icon {\"icon\":\"ficore ficore\\u002d\\u002dcentered-position\",\"size\":\"xlarge\",\"label\":\"Altitude : 0 - 520 m\",\"alignment\":\"center\",\"className\":\"wp-block-iris-icon aligncenter style-default margin-default\"} /--\u003E\u003C/div\u003E\n\u003C!-- /wp:column --\u003E\n\n\u003C!-- wp:column --\u003E\n\u003Cdiv class=\"wp-block-column\"\u003E\u003C!-- wp:iris/icon {\"icon\":\"ficore ficore\\u002d\\u002dgroup\",\"size\":\"xlarge\",\"label\":\"Population : 343 477 Ni\u00e7ois\",\"alignment\":\"center\",\"className\":\"wp-block-iris-icon aligncenter style-default margin-default\"} /--\u003E\u003C/div\u003E\n\u003C!-- /wp:column --\u003E\n\n\u003C!-- wp:column --\u003E\n\u003Cdiv class=\"wp-block-column\"\u003E\u003C!-- wp:iris/icon {\"icon\":\"fi fi\\u002d\\u002dcustomer-live\",\"size\":\"xlarge\",\"label\":\" Area : 71.92 km2\",\"alignment\":\"center\",\"className\":\"wp-block-iris-icon aligncenter style-default margin-default\"} /--\u003E\u003C/div\u003E\n\u003C!-- /wp:column --\u003E\u003C/div\u003E\n\u003C!-- /wp:columns --\u003E\n\n\u003C!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} --\u003E\n\u003Cdiv class=\"wp-block-buttons\"\u003E\u003C!-- wp:button {\"width\":25,\"className\":\"is-style-external\"} --\u003E\n\u003Cdiv class=\"wp-block-button has-custom-width wp-block-button__width-25 is-style-external\"\u003E\u003Ca class=\"wp-block-button__link wp-element-button\" href=\"https://www.google.fr/maps/dir//43.70313,7.26608\" target=\"_blank\" rel=\"noreferrer noopener\"\u003EItinerary\u003C/a\u003E\u003C/div\u003E\n\u003C!-- /wp:button --\u003E\u003C/div\u003E\n\u003C!-- /wp:buttons --\u003E\n\n\u003C!-- wp:heading {\"textAlign\":\"center\"} --\u003E\n\u003Ch2 class=\"wp-block-heading has-text-align-center\"\u003ELabels\u003C/h2\u003E\n\u003C!-- /wp:heading --\u003E\n\n\u003C!-- wp:columns {\"verticalAlignment\":\"center\"} --\u003E\n\u003Cdiv class=\"wp-block-columns are-vertically-aligned-center\"\u003E\u003C!-- wp:column {\"verticalAlignment\":\"center\"} --\u003E\n\u003Cdiv class=\"wp-block-column is-vertically-aligned-center\"\u003E\u003C!-- wp:image {\"id\":33596,\"width\":\"65px\",\"height\":\"auto\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"center\"} --\u003E\n\u003Cfigure class=\"wp-block-image aligncenter size-full is-resized\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2026/01/800par600-logo-accueil-velo-1309-560x0-1-331x480.png.webp\" alt=\"\" class=\"wp-image-33596\" style=\"width:65px;height:auto\"/\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\u003C/div\u003E\n\u003C!-- /wp:column --\u003E\n\n\u003C!-- wp:column {\"verticalAlignment\":\"center\"} --\u003E\n\u003Cdiv class=\"wp-block-column is-vertically-aligned-center\"\u003E\u003C!-- wp:image {\"id\":33584,\"width\":\"129px\",\"height\":\"auto\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"center\"} --\u003E\n\u003Cfigure class=\"wp-block-image aligncenter size-full is-resized\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2026/01/logofamilleplus440x301.jpg.webp\" alt=\"\" class=\"wp-image-33584\" style=\"width:129px;height:auto\"/\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\u003C/div\u003E\n\u003C!-- /wp:column --\u003E\n\n\u003C!-- wp:column {\"verticalAlignment\":\"center\"} --\u003E\n\u003Cdiv class=\"wp-block-column is-vertically-aligned-center\"\u003E\u003C!-- wp:image {\"id\":33897,\"width\":\"98px\",\"height\":\"auto\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"center\"} --\u003E\n\u003Cfigure class=\"wp-block-image aligncenter size-full is-resized\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2026/01/vpha-web-3.png.webp\" alt=\"\" class=\"wp-image-33897\" style=\"width:98px;height:auto\"/\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\u003C/div\u003E\n\u003C!-- /wp:column --\u003E\u003C/div\u003E\n\u003C!-- /wp:columns --\u003E\n\n\u003C!-- wp:columns --\u003E\n\u003Cdiv class=\"wp-block-columns\"\u003E\u003C!-- wp:column {\"verticalAlignment\":\"center\"} --\u003E\n\u003Cdiv class=\"wp-block-column is-vertically-aligned-center\"\u003E\u003C!-- wp:image {\"id\":33641,\"width\":\"85px\",\"height\":\"auto\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"center\"} --\u003E\n\u003Cfigure class=\"wp-block-image aligncenter size-full is-resized\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2026/01/pelagos-logo-339x480.jpg.webp\" alt=\"\" class=\"wp-image-33641\" style=\"width:85px;height:auto\"/\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\u003C/div\u003E\n\u003C!-- /wp:column --\u003E\n\n\u003C!-- wp:column {\"verticalAlignment\":\"center\"} --\u003E\n\u003Cdiv class=\"wp-block-column is-vertically-aligned-center\"\u003E\u003C!-- wp:image {\"id\":33605,\"width\":\"143px\",\"height\":\"auto\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"center\"} --\u003E\n\u003Cfigure class=\"wp-block-image aligncenter size-full is-resized\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2026/01/villesvillagesfleuris-480x339.jpg.webp\" alt=\"\" class=\"wp-image-33605\" style=\"width:143px;height:auto\"/\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\u003C/div\u003E\n\u003C!-- /wp:column --\u003E\n\n\u003C!-- wp:column {\"verticalAlignment\":\"center\"} --\u003E\n\u003Cdiv class=\"wp-block-column is-vertically-aligned-center\"\u003E\u003C!-- wp:image {\"id\":33590,\"width\":\"70px\",\"height\":\"auto\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"center\"} --\u003E\n\u003Cfigure class=\"wp-block-image aligncenter size-full is-resized\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2026/01/logo-station-classee-345x480.png.webp\" alt=\"\" class=\"wp-image-33590\" style=\"width:70px;height:auto\"/\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\u003C/div\u003E\n\u003C!-- /wp:column --\u003E\u003C/div\u003E\n\u003C!-- /wp:columns --\u003E\n\n\u003C!-- wp:wp-etourisme-v3/carrousel-sit {\"list\":{\"value\":\"699574af3e62f274d70e3169\",\"label\":\"EN - NICE - Agenda mise en avant \"},\"nbResults\":10,\"title\":\"Coming Soon in Nice\"} /--\u003E\n\n\u003C!-- wp:iris/section {\"appearance\":\"0\"} --\u003E\n\u003Cdiv class=\"wp-block-iris-section  iris-appearance iris-appearance--bleu-fonce iris-appearance--secondary-button \" id=\"\"\u003E\u003Cdiv class=\"article\"\u003E\u003C!-- wp:heading {\"textAlign\":\"center\"} --\u003E\n\u003Ch2 class=\"wp-block-heading has-text-align-center\"\u003ESee all events\u003C/h2\u003E\n\u003C!-- /wp:heading --\u003E\n\n\u003C!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} --\u003E\n\u003Cdiv class=\"wp-block-buttons\"\u003E\u003C!-- wp:button --\u003E\n\u003Cdiv class=\"wp-block-button\"\u003E\u003Ca class=\"wp-block-button__link wp-element-button\" href=\"https://www.explorenicecotedazur.com/en/explore/towns-villages/coastal-area/nice/events/\"\u003ENice events calendar\u003C/a\u003E\u003C/div\u003E\n\u003C!-- /wp:button --\u003E\u003C/div\u003E\n\u003C!-- /wp:buttons --\u003E\u003C/div\u003E\u003C/div\u003E\n\u003C!-- /wp:iris/section --\u003E\n\n\u003C!-- wp:buttons {\"layout\":{\"type\":\"flex\",\"justifyContent\":\"center\"}} --\u003E\n\u003Cdiv class=\"wp-block-buttons\"\u003E\u003C!-- wp:button --\u003E\n\u003Cdiv class=\"wp-block-button\"\u003E\u003Ca class=\"wp-block-button__link wp-element-button\" href=\"https://www.explorenicecotedazur.com/en/tourism-info/office-de-tourisme-nice-cote-dazur-nice-jean-medecin/\"\u003ESee our information office\u003C/a\u003E\u003C/div\u003E\n\u003C!-- /wp:button --\u003E\u003C/div\u003E\n\u003C!-- /wp:buttons --\u003E\n\n\u003C!-- wp:separator {\"align\":\"wide\"} --\u003E\n\u003Chr class=\"wp-block-separator alignwide has-alpha-channel-opacity\"/\u003E\n\u003C!-- /wp:separator --\u003E\n\n\u003C!-- wp:heading {\"level\":3} --\u003E\n\u003Ch3 class=\"wp-block-heading\"\u003EA city of history and light\u003C/h3\u003E\n\u003C!-- /wp:heading --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ESince 2021, Nice has been listed as a \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/explore/unesco-and-heritage/\"\u003EUNESCO World Heritage\u003C/a\u003E\u003C/strong\u003E Site as a \u003Cstrong\u003E\"Riviera Winter Resort\".\u003C/strong\u003E This distinction recognises the exceptional heritage of a city shaped by winter visitors who came to admire its light and enjoy its climate.\u003Cbr\u003ETake a stroll through the districts that gave birth to this art of living: from the \u003Cstrong\u003EMusiciens district\u003C/strong\u003E to \u003Cstrong\u003ECimiez\u003C/strong\u003E, let yourself be seduced by the architectural richness of its facades, the reinvented \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/gare-du-sud/\"\u003EGare du Sud station\u003C/a\u003E\u003C/strong\u003E or the majestic \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/cathedrale-orthodoxe-russe-de-saint-nicolas/\"\u003ERussian Orthodox Cathedral of Saint-Nicolas\u003C/a\u003E\u003C/strong\u003E.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:heading {\"level\":3} --\u003E\n\u003Ch3 class=\"wp-block-heading\"\u003EA strong cultural identity in Nice\u003C/h3\u003E\n\u003C!-- /wp:heading --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EAs the capital of the C\u00f4te d'Azur, Nice is a destination for art and culture. Its museums, galleries, architecture and festivals make it a veritable open-air museum.\u003Cbr\u003EStroll through \u003Cstrong\u003EVieux-Nice\u003C/strong\u003E, thrill to the \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/promenade-des-anglais/\"\u003EPromenade des Anglais\u003C/a\u003E\u003C/strong\u003E, push open the door of the \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/musee-matisse-nice/\"\u003EMus\u00e9e Matisse\u003C/a\u003E\u003C/strong\u003E or the \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/musee-dart-moderne-et-dart-contemporain-m-a-m-a-c-closed-until-2028/\"\u003EMus\u00e9e d'Art Contemporain\u003C/a\u003E\u003C/strong\u003E, and let yourself be inspired by the city's creative energy.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:gallery {\"linkTo\":\"none\",\"align\":\"wide\"} --\u003E\n\u003Cfigure class=\"wp-block-gallery alignwide has-nested-images columns-default is-cropped\"\u003E\u003C!-- wp:image {\"id\":33928,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --\u003E\n\u003Cfigure class=\"wp-block-image size-large\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2026/01/museematisse-villedenice-1-1-1024x683.webp\" alt=\"Photo of a statue in the Matisse Museum\" class=\"wp-image-33928\"/\u003E\u003Cfigcaption class=\"wp-element-caption\"\u003EMatisse Museum\u003C/figcaption\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\n\n\u003C!-- wp:image {\"id\":33932,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --\u003E\n\u003Cfigure class=\"wp-block-image size-large\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2026/01/museedartmoderne-otcn-1-1-1024x683.webp\" alt=\"Photo of the exterior of the MAMAC\" class=\"wp-image-33932\"/\u003E\u003Cfigcaption class=\"wp-element-caption\"\u003EMuseum of Modern and Contemporary Art\u003C/figcaption\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\u003C/figure\u003E\n\u003C!-- /wp:gallery --\u003E\n\n\u003C!-- wp:heading {\"level\":3} --\u003E\n\u003Ch3 class=\"wp-block-heading\"\u003EFlavours and know-how from Nice\u003C/h3\u003E\n\u003C!-- /wp:heading --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EHere,\u003Cstrong\u003E Cuisine Nissarde\u003C/strong\u003E is an integral part of our heritage. Moreover, the town promotes its authenticity through the \u003Cstrong\u003E\" \u003Ca href=\"https://www.explorenicecotedazur.com/en/out-and-about/restaurants/restaurants-and-establishments-of-cuisine-nissarde/\"\u003ECuisine Nissarde, respecting tradition\u003C/a\u003E \"\u003C/strong\u003E label \u003Cstrong\u003E,\u003C/strong\u003E awarded each year to around thirty establishments.\u003Cbr\u003ETry a \u003Cstrong\u003Esocca\u003C/strong\u003E, \u003Cstrong\u003Epan bagnat\u003C/strong\u003E, \u003Cstrong\u003Estuffed sa\u003C/strong\u003E usage or \u003Cstrong\u003ENicoise salad\u003C/strong\u003E: simple, convivial recipes that reflect the people who share them.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:gallery {\"linkTo\":\"none\",\"align\":\"center\"} --\u003E\n\u003Cfigure class=\"wp-block-gallery aligncenter has-nested-images columns-default is-cropped\"\u003E\u003C!-- wp:image {\"id\":32128,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --\u003E\n\u003Cfigure class=\"wp-block-image size-large\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2025/12/pan-bagnat-restaurant-lou-balico-nice-gaia-giuliani10-683x1024.webp\" alt=\"Pan bagnat at the Lou Balico restaurant\" class=\"wp-image-32128\"/\u003E\u003Cfigcaption class=\"wp-element-caption\"\u003EPan bagnat at the Lou Balico restaurant\u003C/figcaption\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\n\n\u003C!-- wp:image {\"id\":31889,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --\u003E\n\u003Cfigure class=\"wp-block-image size-large\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2025/12/les-farcis-restaurant-chez-cane-nice-gaia-giuliani16-683x1024.webp\" alt=\"Farcis ni\u00e7ois at Chez Cane restaurant\" class=\"wp-image-31889\"/\u003E\u003Cfigcaption class=\"wp-element-caption\"\u003EFarcis ni\u00e7ois at Chez Cane restaurant\u003C/figcaption\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\n\n\u003C!-- wp:image {\"id\":32062,\"sizeSlug\":\"large\",\"linkDestination\":\"none\"} --\u003E\n\u003Cfigure class=\"wp-block-image size-large\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2025/12/salade-nicoise-restaurant-le-safari-nice-gaia-giuliani3-683x1024.webp\" alt=\"Ni\u00e7oise salad at Le Safari restaurant\" class=\"wp-image-32062\"/\u003E\u003Cfigcaption class=\"wp-element-caption\"\u003ENi\u00e7oise salad at Le Safari restaurant\u003C/figcaption\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\u003C/figure\u003E\n\u003C!-- /wp:gallery --\u003E\n\n\u003C!-- wp:heading {\"level\":3} --\u003E\n\u003Ch3 class=\"wp-block-heading\"\u003EA responsible way of life\u003C/h3\u003E\n\u003C!-- /wp:heading --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003ENice is also committed to sustainable development, confirming its role as a driving force within the Nice C\u00f4te d'Azur metropolitan area. Soft mobility, accredited accommodation, the creation of green spaces and slow tourism are all part of its daily routine.\u003Cbr\u003EThe city's many gardens, parks and vantage points offer a breath of fresh air in the heart of the city: \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/promenade-du-paillon/\"\u003Ethe Promenade du Paillon\u003C/a\u003E\u003C/strong\u003E, \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/parc-de-la-colline-du-chateau/\"\u003EColline du Ch\u00e2teau\u003C/a\u003E\u003C/strong\u003E, \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/jardin-des-arenes-de-cimiez/\"\u003ECimiez\u003C/a\u003E\u003C/strong\u003E, \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/parc-forestier-du-mont-boron/\"\u003EMont Boron\u003C/a\u003E\u003C/strong\u003E and \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/parc-phoenix/\"\u003EParc Phoenix\u003C/a\u003E\u003C/strong\u003E are all inviting places to relax and contemplate.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:image {\"id\":27574,\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"center\"} --\u003E\n\u003Cfigure class=\"wp-block-image aligncenter size-full\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2025/12/musee-matisse-nice-unesco-olivier-huitel4.webp\" alt=\"Matisse Museum Nice\" class=\"wp-image-27574\"/\u003E\u003Cfigcaption class=\"wp-element-caption\"\u003EThe Nice Matisse Museum in the heart of the Cimiez Arena Park\u003C/figcaption\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\n\n\u003C!-- wp:heading {\"level\":3} --\u003E\n\u003Ch3 class=\"wp-block-heading\"\u003EAn easy and welcoming destination\u003C/h3\u003E\n\u003C!-- /wp:heading --\u003E\n\n\u003C!-- wp:paragraph --\u003E\n\u003Cp\u003EWith its international airport, 200 \u003Cstrong\u003Ehotels \u003C/strong\u003E, \u003Cstrong\u003E7km of beaches\u003C/strong\u003E, \u003Cstrong\u003Ecultural \u003C/strong\u003Eand\u003Cstrong\u003E sporting\u003C/strong\u003E events and \u003Cstrong\u003Ecountless shops\u003C/strong\u003E, Nice is a city to discover all year round.\u003Cbr\u003EAn ideal base for exploring the C\u00f4te d'Azur, it combines comfort, elegance and simple pleasure.\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\n\n\u003C!-- wp:separator --\u003E\n\u003Chr class=\"wp-block-separator has-alpha-channel-opacity\"/\u003E\n\u003C!-- /wp:separator --\u003E\n\n\u003C!-- wp:heading --\u003E\n\u003Ch2 class=\"wp-block-heading\"\u003E\u003Cstrong\u003EWhat to see in \u003C/strong\u003ENice\u003C/h2\u003E\n\u003C!-- /wp:heading --\u003E\n\n\u003C!-- wp:list --\u003E\n\u003Cul class=\"wp-block-list\"\u003E\u003C!-- wp:list-item --\u003E\n\u003Cli\u003EMuseums: \u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/musee-matisse-nice/\"\u003EMus\u00e9e Matisse\u003C/a\u003E, \u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/musee-dart-moderne-et-dart-contemporain-m-a-m-a-c-closed-until-2028/\"\u003EMus\u00e9e d'Art Moderne et d'Art Contemporain\u003C/a\u003E, \u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/musee-darcheologie-de-nice-cimiez/\"\u003EMus\u00e9e Arch\u00e9ologique\u003C/a\u003E, \u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/musee-de-la-photographie-charles-negre/\"\u003EMus\u00e9e de la Photographie\u003C/a\u003E, etc.\u003Cbr\u003E\u003C/li\u003E\n\u003C!-- /wp:list-item --\u003E\n\n\u003C!-- wp:list-item --\u003E\n\u003Cli\u003E\u003Cstrong\u003EArchitectural heritage \u003C/strong\u003E: ancient Baroque palaces, Belle \u00c9poque villas, Art Deco facades and contemporary architecture.\u003Cbr\u003E\u003C/li\u003E\n\u003C!-- /wp:list-item --\u003E\n\n\u003C!-- wp:list-item --\u003E\n\u003Cli\u003E\u003Cstrong\u003EOld Nice\u003C/strong\u003E, with its picturesque streets and craft shops.\u003Cbr\u003E\u003C/li\u003E\n\u003C!-- /wp:list-item --\u003E\n\n\u003C!-- wp:list-item --\u003E\n\u003Cli\u003EColourful markets: fruit, vegetables, flowers, fish and second-hand goods on the \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/cours-saleya/\"\u003ECours Saleya\u003C/a\u003E\u003C/strong\u003E, \u003Cstrong\u003ELib\u00e9ration\u003C/strong\u003E, \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/event/marche-de-la-place-du-palais/\"\u003EPlace du Palais\u003C/a\u003E\u003C/strong\u003E and \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/la-place-saint-francois/\"\u003EPlace Saint-Fran\u00e7ois\u003C/a\u003E\u003C/strong\u003E.\u003Cbr\u003E\u003C/li\u003E\n\u003C!-- /wp:list-item --\u003E\n\n\u003C!-- wp:list-item --\u003E\n\u003Cli\u003EGardens and green spaces: \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/parc-de-la-colline-du-chateau/\"\u003EColline du Ch\u00e2teau\u003C/a\u003E\u003C/strong\u003E, \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/promenade-du-paillon/\"\u003EPromenade du Paillon\u003C/a\u003E\u003C/strong\u003E, \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/jardin-des-arenes-de-cimiez/\"\u003ECimiez\u003C/a\u003E\u003C/strong\u003E, \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/parc-forestier-du-mont-boron/\"\u003EMont Boron\u003C/a\u003E\u003C/strong\u003E, \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/parc-phoenix/\"\u003EParc Phoenix\u003C/a\u003E\u003C/strong\u003E, etc.\u003Cbr\u003E\u003C/li\u003E\n\u003C!-- /wp:list-item --\u003E\n\n\u003C!-- wp:list-item --\u003E\n\u003Cli\u003E\u003Cstrong\u003EPanoramic views\u003C/strong\u003E: from sunrise to sunset, the \u003Cstrong\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/culture/promenade-des-anglais/\"\u003EPromenade des Anglais\u003C/a\u003E\u003C/strong\u003E is a spectacle in itself.\u003C/li\u003E\n\u003C!-- /wp:list-item --\u003E\u003C/ul\u003E\n\u003C!-- /wp:list --\u003E\n\n\u003C!-- wp:separator {\"align\":\"wide\",\"className\":\"is-style-advanced\"} --\u003E\n\u003Chr class=\"wp-block-separator alignwide has-alpha-channel-opacity is-style-advanced\"/\u003E\n\u003C!-- /wp:separator --\u003E\n\n\u003C!-- wp:columns {\"align\":\"wide\"} --\u003E\n\u003Cdiv class=\"wp-block-columns alignwide\"\u003E\u003C!-- wp:column {\"verticalAlignment\":\"center\",\"width\":\"33.33%\"} --\u003E\n\u003Cdiv class=\"wp-block-column is-vertically-aligned-center\" style=\"flex-basis:33.33%\"\u003E\u003C!-- wp:image {\"id\":25064,\"width\":\"197px\",\"height\":\"auto\",\"sizeSlug\":\"full\",\"linkDestination\":\"none\",\"align\":\"center\"} --\u003E\n\u003Cfigure class=\"wp-block-image aligncenter size-full is-resized\"\u003E\u003Cimg src=\"https://www.explorenicecotedazur.com/app/uploads/2025/11/my-adventure.png.webp\" alt=\"\" class=\"wp-image-25064\" style=\"width:197px;height:auto\"/\u003E\u003C/figure\u003E\n\u003C!-- /wp:image --\u003E\u003C/div\u003E\n\u003C!-- /wp:column --\u003E\n\n\u003C!-- wp:column {\"width\":\"66.66%\"} --\u003E\n\u003Cdiv class=\"wp-block-column\" style=\"flex-basis:66.66%\"\u003E\u003C!-- wp:iris/section {\"appearance\":\"3\"} --\u003E\n\u003Cdiv class=\"wp-block-iris-section  iris-appearance iris-appearance--fond-light iris-appearance--main-button \" id=\"\"\u003E\u003Cdiv class=\"article\"\u003E\u003C!-- wp:iris/advanced-title {\"title\":\"With my Adventure\"} --\u003E\n\u003Cdiv class=\"wp-block-iris-advanced-title\" id=\"\"\u003E\u003Cp class=\"iris-over-title\"\u003EVisit Nice\u003C/p\u003E\u003Ch2 class=\"h2\"\u003EWith my Adventure\u003C/h2\u003E\u003C/div\u003E\n\u003C!-- /wp:iris/advanced-title --\u003E\n\n\u003C!-- wp:paragraph {\"className\":\"iris-appearance__content\"} --\u003E\n\u003Cp class=\"iris-appearance__content\"\u003E\u003Cstrong\u003E\u003Cem\u003E\u003Ca href=\"https://www.explorenicecotedazur.com/en/explore/my-adventure-exploration-game/\"\u003Emy Adventure\u003C/a\u003E\u003C/em\u003E\u003C/strong\u003E is your exploration game between the sea and the mountains! This XXL explore game offers 31 adventures spread across our territory.\u003Cbr\u003EWith the 2 \u003Ca href=\"https://boutique.explorenicecotedazur.com/my-adventure-nice.html?origine_affinage=true&amp;mid=1&amp;action=result&amp;origine_affinage=true\"\u003E\u003Cstrong\u003E\u003Cem\u003Emy Adventure\u003C/em\u003E\u003C/strong\u003E quests \u003Cstrong\u003Ein Nice\u003C/strong\u003E\u003C/a\u003E\u003Cstrong\u003E, follow in the footsteps of Nice heroine Catherine de S\u00e9gurane, or try to restore the famous cannon shot!\u003C/strong\u003E\u003C/p\u003E\n\u003C!-- /wp:paragraph --\u003E\u003C/div\u003E\u003C/div\u003E\n\u003C!-- /wp:iris/section --\u003E\u003C/div\u003E\n\u003C!-- /wp:column --\u003E\u003C/div\u003E\n\u003C!-- /wp:columns --\u003E\n\n\u003C!-- wp:acf/iris-block-related-posts {\"name\":\"acf/iris-block-related-posts\",\"data\":{\"iris-block-related-posts-mode\":\"slider\",\"_iris-block-related-posts-mode\":\"field_iris-block-related-posts_iris-block-related-posts-mode\",\"iris-block-related-posts-background\":\"bg-default\",\"_iris-block-related-posts-background\":\"field_iris-block-related-posts_iris-block-related-posts-background\",\"iris-block-related-posts-overtitle\":\"\",\"_iris-block-related-posts-overtitle\":\"field_iris-block-related-posts_iris-block-related-posts-overtitle\",\"iris-block-related-posts-title\":\"Explore Nice\",\"_iris-block-related-posts-title\":\"field_iris-block-related-posts_iris-block-related-posts-title\",\"iris-block-related-posts-content\":\"\",\"_iris-block-related-posts-content\":\"field_iris-block-related-posts_iris-block-related-posts-content\",\"iris-block-related-posts-type\":\"manual\",\"_iris-block-related-posts-type\":\"field_iris-block-related-posts_iris-block-related-posts-type\",\"iris-block-related-posts-type-manual\":[\"51615\",\"51641\",\"51666\"],\"_iris-block-related-posts-type-manual\":\"field_iris-block-related-posts_iris-block-related-posts-type-manual\",\"iris-block-related-posts-manual-orderby\":\"selection\",\"_iris-block-related-posts-manual-orderby\":\"field_iris-block-related-posts_iris-block-related-posts-manual-orderby\",\"iris-block-related-posts-posts-per-page\":\"\",\"_iris-block-related-posts-posts-per-page\":\"field_iris-block-related-posts_iris-block-related-posts-posts-per-page\",\"iris-block-related-posts-link\":\"\",\"_iris-block-related-posts-link\":\"field_iris-block-related-posts_iris-block-related-posts-link\",\"iris-block-related-posts-title-size\":\"\",\"_iris-block-related-posts-title-size\":\"field_iris-block-related-posts_iris-block-related-posts-title-size\"},\"align\":false,\"mode\":\"preview\"} /--\u003E\n\n\u003C!-- wp:heading --\u003E\n\u003Ch2 class=\"wp-block-heading\"\u003EFAQ \u003C/h2\u003E\n\u003C!-- /wp:heading --\u003E\n\n\u003C!-- wp:acf/iris-block-collapse {\"name\":\"acf/iris-block-collapse\",\"data\":{\"iris-block-collapse-row_0_title\":\"Why is Nice called Nice?\",\"_iris-block-collapse-row_0_title\":\"field_iris-block-collapse_iris-block-collapse-row_title\",\"iris-block-collapse-row_0_content\":\"\\u003cp class=\\u0022isSelectedEnd\\u0022\\u003eThere are two main hypotheses regarding the origin of the name Nice:\\u003c/p\\u003e\\r\\n\\u003cp class=\\u0022isSelectedEnd\\u0022\\u003eThe first dates back to the 4th century BC, when the Phocaeans, a people from Greece, sought to expand their presence after founding Massalia (Marseille). They settled in what is now known as the Old Town of Nice and founded Nikaia (also spelled Nik\u00e9a or Nik\u00ea). In Greek, this name means \\u0022victory.\\u0022\\u003c/p\\u003e\\r\\nHistorian Luc Th\u00e9venon, however, believes that the name Nice may have Ligurian origins. In that language, it means \\u0022a spring\\u0022 or \\u0022a fountain,\\u0022 referring to the waters of the sea.\",\"_iris-block-collapse-row_0_content\":\"field_iris-block-collapse_iris-block-collapse-row_content\",\"iris-block-collapse-row_1_title\":\"When did the city of Nice become French?\",\"_iris-block-collapse-row_1_title\":\"field_iris-block-collapse_iris-block-collapse-row_title\",\"iris-block-collapse-row_1_content\":\"Nice officially became part of France in 1860, following the annexation of the County of Nice under the Treaty of Turin on 24 March 1860, confirmed by a popular vote held on 15 and 16 April 1860.\",\"_iris-block-collapse-row_1_content\":\"field_iris-block-collapse_iris-block-collapse-row_content\",\"iris-block-collapse-row_2_title\":\"What can I do in Nice in 3 days?\",\"_iris-block-collapse-row_2_title\":\"field_iris-block-collapse_iris-block-collapse-row_title\",\"iris-block-collapse-row_2_content\":\"In three days in Nice, you can explore the Cours Saleya, visit the Matisse Museum, join the guided tour \\u0022When Nice Invented the Riviera,\\u0022 and taste local specialities such as socca and pan bagnat. \\u003ca href=\\u0022https://www.explorenicecotedazur.com/en/explore/towns-villages/coastal-area/nice/what-to-do-in-nice/\\u0022\\u003eDiscover our suggestions here\\u003c/a\\u003e.\",\"_iris-block-collapse-row_2_content\":\"field_iris-block-collapse_iris-block-collapse-row_content\",\"iris-block-collapse-row_3_title\":\"What can I see and do in Old Nice?\",\"_iris-block-collapse-row_3_title\":\"field_iris-block-collapse_iris-block-collapse-row_title\",\"iris-block-collapse-row_3_content\":\"During your visit to Old Nice, we recommend exploring the Cours Saleya Flower Market, discovering Place Rossetti and its fountain, or joining a guided tour of Old Nice offered by the Nice Heritage Centre.\",\"_iris-block-collapse-row_3_content\":\"field_iris-block-collapse_iris-block-collapse-row_content\",\"iris-block-collapse-row_4_title\":\"Where can I swim in Nice?\",\"_iris-block-collapse-row_4_title\":\"field_iris-block-collapse_iris-block-collapse-row_title\",\"iris-block-collapse-row_4_content\":\"\\u003cp class=\\u0022isSelectedEnd\\u0022\\u003eYou can swim at the beaches along the Promenade des Anglais or at La R\u00e9serve.\\u003c/p\\u003e\\r\\n\\u003cp class=\\u0022isSelectedEnd\\u0022\\u003eOn the Promenade des Anglais, Lenval Beach is open to dogs.\\u003c/p\\u003e\\r\\nYou will also find many private beaches offering sunbed rentals, restaurants and other services.\",\"_iris-block-collapse-row_4_content\":\"field_iris-block-collapse_iris-block-collapse-row_content\",\"iris-block-collapse-row_5_title\":\"How do I get to Castle Hill in Nice?\",\"_iris-block-collapse-row_5_title\":\"field_iris-block-collapse_iris-block-collapse-row_title\",\"iris-block-collapse-row_5_content\":\"You can reach Castle Hill on foot via the Lesage stairs, the streets of Old Nice, or from the port via Rue S\u00e9gurane. There is also a free lift located near Rue des Ponchettes.\",\"_iris-block-collapse-row_5_content\":\"field_iris-block-collapse_iris-block-collapse-row_content\",\"iris-block-collapse-row_6_title\":\"Are there any casinos in Nice, France?\",\"_iris-block-collapse-row_6_title\":\"field_iris-block-collapse_iris-block-collapse-row_title\",\"iris-block-collapse-row_6_content\":\"\\u003cp class=\\u0022PDq2pG_selectionAnchorContainer\\u0022 data-start=\\u002218\\u0022 data-end=\\u0022251\\u0022\\u003eYes, there are two casinos in Nice: Casino Barri\u00e8re Le Ruhl, located at 1 Promenade des Anglais, and Casino Partouche at the Palais de la M\u00e9diterran\u00e9e, located at 15 Promenade des Anglais.\\u003c/p\\u003e\",\"_iris-block-collapse-row_6_content\":\"field_iris-block-collapse_iris-block-collapse-row_content\",\"iris-block-collapse-row_7_title\":\"Where is Nice-Saint-Augustin train station located?\",\"_iris-block-collapse-row_7_title\":\"field_iris-block-collapse_iris-block-collapse-row_title\",\"iris-block-collapse-row_7_content\":\"Nice-Saint-Augustin train station is located in the Arenas district, in the western part of Nice, in the immediate vicinity of Nice C\u00f4te d\u2019Azur Airport.\",\"_iris-block-collapse-row_7_content\":\"field_iris-block-collapse_iris-block-collapse-row_content\",\"iris-block-collapse-row\":8,\"_iris-block-collapse-row\":\"field_iris-block-collapse_iris-block-collapse-row\",\"iris-block-collapse-faq-microdata\":\"0\",\"_iris-block-collapse-faq-microdata\":\"field_iris-block-collapse_iris-block-collapse-faq-microdata\",\"iris-block-collapse-title-size\":\"\",\"_iris-block-collapse-title-size\":\"field_iris-block-collapse_iris-block-collapse-title-size\"},\"mode\":\"preview\"} /--\u003E","post_title":"Nice","post_excerpt":"","post_status":"publish","comment_status":"closed","ping_status":"closed","post_password":"","post_name":"nice","to_ping":"","pinged":"","post_modified":"2026-08-14 15:54:39","post_modified_gmt":"2026-08-14 13:54:39","post_content_filtered":"","post_parent":59135,"guid":"https://www.explorenicecotedazur.com/?page_id=60321","menu_order":0,"post_type":"page","post_mime_type":"","comment_count":"0","filter":"raw"},"themeUrl":"https://www.explorenicecotedazur.com/app/themes/theme_customer","ajaxUrl":"https://www.explorenicecotedazur.com/wp-admin/admin-ajax.php","markerImageUrl":"https://www.explorenicecotedazur.com/app/plugins/iris_collection_plugin_core/public/images/markers/marker.6a5c819359e4e09c.svg","easepickStyleUrl":"https://www.explorenicecotedazur.com/app/plugins/iris_collection_plugin_core/public/styles/lib/easepick.918a4b74992b9fa1.css","coreUrl":"https://www.explorenicecotedazur.com/app/plugins/iris_collection_plugin_core","serverUrl":"https://www.explorenicecotedazur.com","contentHelpfull":{"thisContentIsHelpfull":"https://www.explorenicecotedazur.com/wp-json/iris-collection-plugin-core/v1/this-content-is-helpful","translate":{"helpfull":"Useful: You have already chosen this option","useless":"Not useful: You have already chosen this option","confirmation":"Thank you, your reply has been taken into account.","error":"An error has occurred while sending your response to the server. If the problem persists, please contact an administrator"}},"cookieNameOfHelpfulPreviousVote":"iris-any-is-helpful-previous-vote_post_60321","cookieNameOfEcoMode":"iris_eco_config","carbonApiUpdateViewRoute":"https://carbon.iris-interactive.com/update-view-by-url?url=","config":{"ecomodeActive":false,"GTMActive":true,"axeptioActive":true},"data":{"kml":null},"translate":{"noBookingOffer":"The offers displayed below have not communicated their availability, please contact the provider.","noResult":"No results found for your search.","successForm":"The message has been sent successfully. Thank you","slider":{"prevSlideMessage":"Previous slide","nextSlideMessage":"Next slide","firstSlideMessage":"You\u2019re at the begining","lastSlideMessage":"You reach