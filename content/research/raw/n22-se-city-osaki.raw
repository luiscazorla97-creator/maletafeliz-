	jQuery(function() {
		var mv = jQuery('#menu-colorchange-flg').offset();
		jQuery(window).on('load scroll', function() {

			if (jQuery(window).scrollTop() > mv.top) {
				jQuery('body').addClass('menu-colorchange');
			} else {
				jQuery('body').removeClass('menu-colorchange');
			}
		});
	});
</script>
    <script>
