<script>$('.date-display').datepicker({
    dateFormat: 'mm-d-yy',
    onSelect: function (dateText) {
        const inputId = $(this).attr('id');
        const hiddenId = inputId.replace('_display', '');
        const date = $.datepicker.parseDate('mm-d-yy', dateText);
        $('#' + hiddenId).val(
            $.datepicker.formatDate('yy-mm-dd', date)
        );
    }
});

// サーバーから渡されたY-m-dを表示用形式に変換
$('.date-display').each(function () {
