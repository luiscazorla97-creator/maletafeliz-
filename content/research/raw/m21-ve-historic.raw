                    class="inline-block px-7 py-3.5 bg-[#5C113C] hover:bg-[#4a1723] active:bg-[#38111a] text-white font-bold text-[11px] md:text-xs tracking-[0.15em] uppercase rounded-xl shadow-lg transition-transform transform hover:-translate-y-0.5 font-sans border border-[#5C113C]">
