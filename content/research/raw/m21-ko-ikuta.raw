						<li><a href="index_1_2_3.html">Sannomiya / Motomachi</a></li>
					</ul>
				</div>
			</div>
			<div id="category">
				<h3>Category</h3>
				<div>
					<ul>
						<li><a href="index_1_2__2.html">History & Culture</a></li>
					</ul>
				</div>
			</div>
		</div>
		
