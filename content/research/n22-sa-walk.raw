  <div class="glide__slide glide-slide-style" role="group" aria-roledescription="slide" aria-label="3 of 9">
    <div class="glide__inner-wrap">
      
        
  <figure class="media media-image carousel-square-aspect ma-0 carousel-square-aspect--view-mode media-caption media-location">

    <div class="square-aspect"></div>
      
    <img loading="lazy" src="/sites/default/files/styles/carousel_image/public/2025-08/savtheatre2.jpg.webp?itok=Ijtx3aBZ" width="640" height="640" alt="A young couple walking away from the Savannah Theatre in Savannah, GA." class="image-style-carousel-image scale-with-grid" />




          <figcaption class="caption-basic text-align-right z-2">
