wp-etourisme-v3/section-header {\"content\":\"Tourisme adapt\u00e9\"} /--\u003E\n\n\u003C!-- wp:wp-etourisme-v3/section-body --\u003E\n\u003C!-- wp:wp-etourisme-v3/list {\"fields\":[{\"label\":\"Labels Tourisme et Handicap\",\"value\":\"labels-tourisme-handicap\"}],\"format\":\"tag\"} /--\u003E\n\n\u003C!-- wp:wp-etourisme-v3/icon-label-value {\"field\":{\"label\":\"Tourisme adapt\u00e9\",\"value\":\"tourisme-adapte\"},\"label\":\"Prestation(s) adapt\u00e9e(s) :\",\"excludedValues\":[]} /--\u003E\n\n\u003C!-- wp:wp-etourisme-v3/section {\"level\":2} --\u003E\n\u003C!-- wp:wp-etourisme-v3/section-header {\"content\":\"Handicap auditif\"} /--\u003E\n\n\u003C!-- wp:wp-etourisme-v3/section-body --\u003E\n\u003C!-- wp:wp-etourisme-v3/text {\"field\":{\"label\":\"Descriptif handicap auditif\",\"value\":\"descriptif-handicap-auditif\"}} /--\u003E\n\u003C!-- /wp:wp-etourisme-v3/section-body --\u003E\n\u003C!-- /wp:wp-etourisme-v3/section --\u003E\n\n\u003C!-- wp:wp-etourisme-v3/section {\"level\":2} --\u003E\n\u003C!-- wp:wp-etourisme-v3/section-header {\"content\":\"Handicap moteur\"} /--\u003E\n\n\u003C!-- wp:wp-etourisme-v3/section-body --\u003E\n\u003C!-- wp:wp-etourisme-v3/text {\"field\":{\"label\":\"Descriptif handicap moteur\",\"value\":\"descriptif-handicap-moteur\"}} /--\u003E\n\u003C!-- /wp:wp-etourisme-v3/section-body --\u003E\n\u003C!-- /wp:wp-etourisme-v3/section --\u003E\n\n\u003C!-- wp:wp-etourisme-v3/section {\"level\":2} --\u003E\n\u003C!-- wp:wp-etourisme-v3/section-header {\"content\":\"Handicap visuel\"} /--\u003E\n\n\u003C!-- wp:wp-etourisme-v3/section-body --\u003E\n\u003C!-- wp:wp-etourisme-v3/text {\"field\":{\"label\":\"Descriptif handicap visuel\",\"value\":\"descriptif-handicap-visuel\"}} /--\u003E\n\u003C!-- /wp:wp-etourisme-v3/section-body --\u003E\n\u003C!-- /wp:wp-etourisme-v3/section --\u003E\n\n\u003C!-- wp:wp-etourisme-v3/section {\"level\":2} --\u003E\n\u003C!-- wp:wp-etourisme-v3/section-header {\"content\":\"Handicap mental\"} /--\u003E