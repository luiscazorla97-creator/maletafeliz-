<style id="wp-custom-css">

.elementor-15 .elementor-element.elementor-element-a30313c .elementor-image-box-img img {
    filter: none !important;
}
.elementor-11491 .elementor-element.elementor-element-1cb8e736 .elementskit-navbar-nav .elementskit-submenu-panel {
    border-radius: 0px 0px 7px 7px;
    min-width: 220px
px
;
    box-shadow: 0px 0px 10px 0pxrgba(0,0,0,0.12);
    margin-top: 10px;
}
.ekit-wid-con .ekit-instagram-feed-posts-item-content {
    padding: 16px;
    font-size: 12px;
}
.rz-listing-image .rz-image,
.rz-listing-gallery .rz-listing-gallery-item {
    padding-top: 100%!important;
}
.gallery-item {
    padding-right: 5px!important;
    padding-left: 5px!important;
}

@media screen and (max-width: 991.98px) {

.routiz .rz-search-filter--inline {
    top: 80px;

}
}

body {
    padding-top: 0px !important;
}

@media screen and (max-width: 767.98px) {
	.rz-submission-types .rz--type .rz--image {
    display: none;
}
}
.elementor-nav-menu a, .elementor-nav-menu li {
    position: relative;
    fill: #ccc;
    color: #888;
    border-radius:6px;
    border-style: solid;
    border-width: 1px 1px 1px 1px;
  width:200px;
margin: 2px !important;
}
.tribe-events-event-image img {
    width: 100%;
}
.tribe-common img {
    width: 100%;
	height:auto;
}
.tribe-events-venue-map {
    width: 420px;
}
.tribe-events-event-image {
  border: 1px solid #b7b3b3;
	padding:10px;
  border-radius: 5px;
}
.brk-msnry .brk--item .brk--excerpt {
    word-wrap: break-word;
}
.elementor-posts--thumbnail-top .elementor-post__text {
    width: 100%;
    padding: 1.5rem !important;
}
div#gform_wrapper_8 {
    text-align: center;
}
input#input_8_1 {
    border: 0;
    background-color: #fff;
    box-shadow: 0 22px 50px 0 rgb(0 0 0 / 5%);
    border-radius: 50px;
    color: #000;
    text-align: center;
    font-style: italic;
}
.gform_wrapper.gravity-theme #field_submit, .gform_wrapper.gravity-theme .gform_footer {
    display: block !important;
    text-align: center !important;
}
.brk-carousel-search.brk--style-horizontal .brk-carousel-nav li a {

    background-color: #999;
}

.rz-submission-types .rz--type .rz--image .rz-dummy-image {
    display: none;
}
.splw-lite-wrapper .splw-lite-header {
    display: none;
}
.splw-lite-wrapper .splw-lite-current-temp span.cur-temp {
    font-family: Roboto,sans-serif;
    font-size: 12px;
    font-weight: 400;
    line-height: nomal;
}
.splw-lite-wrapper .splw-lite-body {
    padding-bottom: 0;
}
#splw-location-weather-156620.splw-main-wrapper {
    margin-bottom: 0;
	  
}
#splw-location-weather-156620 .splw-weather-title {
    margin-bottom: 0px;
}
.splw-lite-wrapper .splw-lite-current-temp {
    margin-bottom: -21px;
    margin-top: -26px;
}

.broken_link, a.broken_link {
    text-decoration: none;
}
svg:not(:host).svg-inline--fa, svg:not(:root).svg-inline--fa {
    padding: 5px;
}

.rz-mod-listing-meta .rz--meta li i {
    font-size: 15px !important; 
}
.icon, .icon::before {
    font-family: 'media-icons' !important;
}
