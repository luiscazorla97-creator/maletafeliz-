---
import Layout from '../layouts/Layout.astro';
import Home from '../components/Home.astro';
---

<Layout
  lang="es"
  title="Viaja con curiosidad"
  alternates={{ es: '/es/', en: '/en/' }}
  noindex
  showAdvertisement={false}
>
  <script slot="head" is:inline>
    (() => {
      let preferred;
      try {
        const saved = localStorage.getItem('maletafeliz-language');
        if (saved === 'es' || saved === 'en') preferred = saved;
      } catch {}
      if (!preferred) {
        const languages = navigator.languages?.length
          ? navigator.languages
          : [navigator.language];
        preferred = languages
          .map((language) => language.toLowerCase().split('-')[0])
          .find((language) => language === 'es' || language === 'en') || 'es';
      }
      // Replace the entry page so Back never returns to a language chooser.
      location.replace('/' + preferred + '/' + location.search + location.hash);
    })();
  </script>
  <!-- A complete Spanish homepage remains available without JavaScript. -->
  <Home lang="es" />
</Layout>
