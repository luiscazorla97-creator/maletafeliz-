						<div class="text-2xl min-[1296px]:text-3xl text-primary font-semibold mb-4 pb-2 border-b-2 border-white">Support</div>
						<ul class="flex flex-col gap-1 space-y-2 mb-6">
							<li class="!p-1 my-0"><a href="/memberships/"
