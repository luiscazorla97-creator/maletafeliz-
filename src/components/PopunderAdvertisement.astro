---
import { production } from '../lib/site';
---
{production && (
  <script is:inline data-cfasync="false">
    (() => {
      // Initialize once from a real content click. Never cancel navigation or
      // synthesize a click/window; the provider manages subsequent popunders.
      const initialize = (event) => {
        const target = event.target;
        if (!event.isTrusted || event.button !== 0 || !(target instanceof Element)) return;
        if (!target.closest('#main') || target.closest('.advertisement, .native-advertisement, #analytics-consent, [data-analytics-settings]')) return;
        document.removeEventListener('click', initialize, true);
        if (document.getElementById('adsterra-popunder-script')) return;
        const script = document.createElement('script');
        script.id = 'adsterra-popunder-script';
        script.setAttribute('data-cfasync', 'false');
        script.src = 'https://abscloud.org/1/7a7683e73ba102718744e3df1c9fbe35';
        script.async = true;
        document.body.append(script);
      };
      document.addEventListener('click', initialize, true);
    })();
  </script>
)}
