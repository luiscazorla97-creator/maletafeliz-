        class="relative bg-black rounded-3xl overflow-hidden shadow-2xl w-full max-w-4xl aspect-[16/9] max-h-[85vh] z-10 transform scale-95 opacity-0 transition-all duration-300 flex items-center justify-center border-4 border-white/10">

