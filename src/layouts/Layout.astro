---
import '../styles/global.css';
import { dictionary, otherLocale, type Locale } from '../i18n';
import { route } from '../lib/routes';
import { absolute, production } from '../lib/site';
import Icon from '../components/Icon.astro';
import BrandLogo from '../components/BrandLogo.astro';
import Advertisement from '../components/Advertisement.astro';
import NativeAdvertisement from '../components/NativeAdvertisement.astro';
import AnalyticsConsent from '../components/AnalyticsConsent.astro';
import { heroAvifSrcSet, heroSizes, heroPreload } from '../lib/hero-image';
interface Props {
  lang: Locale;
  title: string;
  description?: string;
  alternates?: Partial<Record<Locale, string>>;
  noindex?: boolean;
  image?: string;
  jsonLd?: unknown;
  showAdvertisement?: boolean;
  advertisementAfterHero?: boolean;
}
const {
  lang,
  title,
  description = dictionary[lang].footerText,
  alternates = {},
  noindex = false,
  image,
  jsonLd,
  showAdvertisement = true,
  advertisementAfterHero = false,
} = Astro.props;
const t = dictionary[lang];
const other = otherLocale(lang);
const canonical = absolute(Astro.url.pathname);
const alternate = alternates[other];
const structuredData = jsonLd as
  { '@type'?: string; '@graph'?: { '@type'?: string }[] } | undefined;
const isArticle =
  structuredData?.['@type'] === 'Article' ||
  structuredData?.['@graph']?.some((node) => node['@type'] === 'Article');
const links = [
  ['destinations', t.destinations],
  ['guides', t.guides],
  ['explore', t.inspiration],
] as const;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <slot name="head" />
    {['/es/', '/en/'].includes(Astro.url.pathname) && (
      <link rel="preload" as="image" type="image/avif" href={heroPreload} imagesrcset={heroAvifSrcSet} imagesizes={heroSizes} fetchpriority="high" />
    )}
    <script is:inline>
      (() => {
        const remember = (lang) => {
          try {
            if (lang === 'es' || lang === 'en')
              localStorage.setItem('maletafeliz-language', lang);
          } catch {}
        };
        const lang = document.documentElement.lang;
        if (location.pathname.startsWith('/' + lang + '/')) remember(lang);
        // Save a manual switch before navigation, even on a slow connection.
        document.addEventListener('click', (event) => {
          const link = event.target instanceof Element
            ? event.target.closest('a.language')
            : null;
          if (link) remember(link.getAttribute('lang'));
        });
      })();
    </script>
    <title>{title} | MaletaFeliz</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#f47835" />
    {production && <meta name="google-adsense-account" content="ca-pub-1382859681401211" />}
    {production && showAdvertisement && (
      <script
        is:inline
        async
        src="https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=ca-pub-1382859681401211"
        crossorigin="anonymous"
      ></script>
    )}
    <link rel="icon" type="image/png" sizes="32x32" href="/brand/favicon-3d-32.png" />
    <link rel="icon" type="image/png" sizes="192x192" href="/brand/icon-3d-192.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/brand/apple-touch-icon-3d.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="canonical" href={canonical} />
    {Object.entries(alternates).map(([language, path]) => (
      <link rel="alternate" hreflang={language} href={absolute(path!)} />
    ))}
    {!production || noindex ? (
      <meta name="robots" content="noindex,follow" />
    ) : (
      <meta name="robots" content="index,follow,max-image-preview:large" />
    )}
    <meta property="og:site_name" content="MaletaFeliz" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:locale" content={lang === 'es' ? 'es_ES' : 'en_US'} />
    <meta property="og:type" content={isArticle ? 'article' : 'website'} />
    {image && <meta property="og:image" content={absolute(image)} />}
    <meta
      name="twitter:card"
      content={image ? 'summary_large_image' : 'summary'}
    />
    {jsonLd && (
      <script
        type="application/ld+json"
        set:html={JSON.stringify(jsonLd).replace(/</g, '\\u003c')}
      />
    )}
  </head>
  <body>
    <a class="skip-link" href="#main">
      {t.skip}
    </a>
    {production && <AnalyticsConsent lang={lang} />}
    {!production && <div class="preview-bar">{t.preview}</div>}
    <header class="site-header">
      <div class="shell header-inner">
        <a class="brand" href={`/${lang}/`} aria-label="MaletaFeliz">
          <BrandLogo />
        </a>
        <nav aria-label={t.menu} class="desktop-nav">
          {links.map(([kind, label]) => (
            <a
              href={route(lang, kind)}
              aria-current={
                Astro.url.pathname.startsWith(route(lang, kind))
                  ? 'page'
                  : undefined
              }
            >
              {label}
            </a>
          ))}
          <a href={route(lang, 'info', 'about')}>{t.about}</a>
        </nav>
        <div class="header-actions">
          <a
            class="header-search"
            href={route(lang, 'search')}
            aria-label={t.search}
          >
            <Icon name="search" />
          </a>
          {alternate ? (
            <a
              class="language"
              href={alternate}
              hreflang={other}
              lang={other}
              aria-label={t.language}
            >
              <Icon name="globe" size={16} />
              {lang.toUpperCase()}
              <span aria-hidden="true">⌄</span>
            </a>
          ) : (
            <a class="language" href={`/${other}/`} lang={other}>
              {other === 'es' ? 'Español' : 'English'}
            </a>
          )}
          <details class="mobile-menu">
            <summary aria-label={t.menu}>
              <Icon name="menu" />
            </summary>
            <nav>
              {links.map(([kind, label]) => (
                <a href={route(lang, kind)}>{label}</a>
              ))}
              <a href={route(lang, 'info', 'about')}>{t.about}</a>
            </nav>
          </details>
        </div>
      </div>
    </header>
    <div class="content-frame">
      {showAdvertisement && <Advertisement lang={lang} placement="left" />}
      <main id="main">
        {showAdvertisement && !advertisementAfterHero && <Advertisement lang={lang} placement="top" />}
        <slot />
        {showAdvertisement && <Advertisement lang={lang} placement="bottom" />}
        {showAdvertisement && <NativeAdvertisement lang={lang} />}
      </main>
      {showAdvertisement && <Advertisement lang={lang} placement="right" />}
    </div>
    <footer>
      <div class="shell footer-grid">
        <div>
          <a class="brand brand-footer" href={`/${lang}/`} aria-label="MaletaFeliz">
            <BrandLogo />
          </a>
          <h3>{t.footer}</h3>
          <p>{t.footerText}</p>
        </div>
        <div>
          <h4>{t.destinations}</h4>
          {[
            ['america', lang === 'es' ? 'América' : 'Americas'],
            ['europe', lang === 'es' ? 'Europa' : 'Europe'],
            ['asia', 'Asia'],
            ['africa', lang === 'es' ? 'África' : 'Africa'],
            ['oceania', lang === 'es' ? 'Oceanía' : 'Oceania'],
          ].map(([id, label]) => (
            <a href={route(lang, 'explore', id)}>{label}</a>
          ))}
        </div>
        <div>
          <h4>{t.magazine}</h4>
          {[
            ['about', t.about],
            [
              'editorial',
              lang === 'es' ? 'Política editorial' : 'Editorial policy',
            ],
            ['ai', lang === 'es' ? 'Uso de IA' : 'AI disclosure'],
            ['corrections', lang === 'es' ? 'Correcciones' : 'Corrections'],
            ['contact', lang === 'es' ? 'Contacto' : 'Contact'],
          ].map(([id, label]) => (
            <a href={route(lang, 'info', id)}>{label}</a>
          ))}
        </div>
        <div>
          <h4>{t.legal}</h4>
          {[
            ['privacy', lang === 'es' ? 'Privacidad' : 'Privacy'],
            ['terms', lang === 'es' ? 'Términos de uso' : 'Terms of use'],
            ['cookies', 'Cookies'],
            [
              'photography',
              lang === 'es' ? 'Fotografías y licencias' : 'Photography credits',
            ],
          ].map(([id, label]) => (
            <a href={route(lang, 'info', id)}>{label}</a>
          ))}
          {production && (
            <button class="analytics-settings" type="button" data-analytics-settings>
              {lang === 'es' ? 'Preferencias de Analytics' : 'Analytics preferences'}
            </button>
          )}
          <span class="footer-motto">
            <Icon name="compass" size={24} />
            {lang === 'es'
              ? 'Siempre hay algo por descubrir.'
              : 'There is always more to discover.'}
          </span>
        </div>
      </div>
      <div class="shell footer-bottom">
        <span>
          © {new Date().getFullYear()} {t.rights}
        </span>
        <span>
          ES / EN <span class="little-dot">●</span>{' '}
          {lang === 'es' ? 'El mundo nos espera' : 'The world is waiting'}
        </span>
      </div>
    </footer>
  </body>
</html>
