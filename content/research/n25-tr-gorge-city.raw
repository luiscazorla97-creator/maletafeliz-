        'LBL_STRUTTURE': 'accommodation',
        'LBL_MEALCODE': 'Board',
        'LBL_MEALCODE_HB': 'Half board',
        'LBL_MEALCODE_FB': 'Full board',
        'LBL_MEALCODE_BB': 'Breakfast included',
        'LBL_MEALCODE_NO': 'Only overnight stay',
        'LBL_MEALCODE_34': '3/4 board',
        'LBL_MEALCODE_AI': 'All inclusive',
        'LBL_A_PARTIRE_DA': 'Starting from',
        'LBL_GRATUITO': 'Free',
        'LBL_MOSTRA': 'Show',
        'LBL_NASCONDI': 'Hide',
        'LBL_RIPROVA': 'Try again',
        'LBL_MIGLIORAMENTO_ACCESSIBILITA_ATTIVO': 'Visual accessibility improvement activated',
        'LBL_MIGLIORAMENTO_ACCESSIBILITA_INATTIVO': 'Visual accessibility improvement deactivated',
        'LEGGI_DI_PIU': 'Read more',
        'LBL_LEGGI_DI_MENO': 'Read less',
        'LBL_ERRORE_SCONOSCIUTO_RIPROVA': 'An error occurred, please try again. '  // usata per il form di registrazione
    };
</script><script>
    var K_MAPBOX;
    var K_MAPBOX_TO_GEOJSON_PROMISE = null;
    var K_MAPBOX_CHART_PROMISE = null;
    var K_MAPBOX_GPX_COLOR = '#00A871';
    var K_MAPBOX_ACTIVE_GPX_COLOR = '#00A871';

    window.K_MAPBOX_INSTANCES = window.K_MAPBOX_INSTANCES || {};
    window.K_MAPBOX_GPX_FEATURES_CACHE = window.K_MAPBOX_GPX_FEATURES_CACHE || {};

    function getLegacyCompatibleMapboxInstance(preferredMapSectionId = null) {
        if(preferredMapSectionId && window.K_MAPBOX_INSTANCES[preferredMapSectionId]) {
            return window.K_MAPBOX_INSTANCES[preferredMapSectionId];
        }

        if(window.K_MAPBOX_ACTIVE_INSTANCE_KEY && window.K_MAPBOX_INSTANCES[window.K_MAPBOX_ACTIVE_INSTANCE_KEY]) {
            return window.K_MAPBOX_INSTANCES[window.K_MAPBOX_ACTIVE_INSTANCE_KEY];
        }

        let visibleMapWrapper = document.querySelector('.fc-map-wrapper:not(.d-none):not([hidden])');
        if(visibleMapWrapper && window.K_MAPBOX_INSTANCES[visibleMapWrapper.id]) {
            return window.K_MAPBOX_INSTANCES[visibleMapWrapper.id];
        }

        return Object.values(window.K_MAPBOX_INSTANCES)[0] || null;
    }

    function syncLegacyCompatibleMapboxGlobals(instance) {
        if(!instance) {
            return null;
        }

        window.K_MAPBOX_ACTIVE_INSTANCE_KEY = instance.mapContainer?.id || null;
        window.map = instance.map;
        window.markers = instance.markers;

        return instance;
    }

    function resetLegacyCompatibleMapboxGlobals(targetMapSectionId = null) {
        if(targetMapSectionId) {
            window.K_MAPBOX_ACTIVE_INSTANCE_KEY = targetMapSectionId;
        }

        window.map = null;
        window.markers = {
            type: 'FeatureCollection',
            crs: {
                type: 'name',
                properties: {
                    name: 'urn:ogc:def:crs:OGC:1.3:CRS84'
                }
            },
            features: []
        };
    }

    if(typeof window.updateMarkers !== 'function') {
        window.updateMarkers = function(markersElems, resetMarkers = true, targetMapSectionId = null) {
            let instance = syncLegacyCompatibleMapboxGlobals(getLegacyCompatibleMapboxInstance(targetMapSectionId));
            if(!instance) {
                let normalizedTargetMapSectionId = targetMapSectionId || window.K_MAPBOX_ACTIVE_INSTANCE_KEY || null;

                if(normalizedTargetMapSectionId) {
                    if(typeof window.markersOnLoad === 'undefined' || Array.isArray(window.markersOnLoad) || !window.markersOnLoad) {
                        window.markersOnLoad = {};
                    }

                    window.markersOnLoad[normalizedTargetMapSectionId] = markersElems;
                } else {
                    window.markersOnLoad = markersElems;
                }

                return;
            }

            instance.updateMarkers(markersElems, resetMarkers);
            syncLegacyCompatibleMapboxGlobals(instance);
        }
    }

    if(typeof window.removeAllPopups !== 'function') {
        window.removeAllPopups = function() {
            let instance = syncLegacyCompatibleMapboxGlobals(getLegacyCompatibleMapboxInstance());
            if(!instance) {
                return;
            }

            instance.removeAllPopups();
        }
    }

    if(typeof window.setMapZoom !== 'function') {
        window.setMapZoom = function(markersToUse = null, options = {}) {
            let instance = syncLegacyCompatibleMapboxGlobals(getLegacyCompatibleMapboxInstance());
            if(!instance) {
                return;
            }

            instance.setMapZoom(markersToUse, options);
        }
    }

    if(typeof window.addPopup !== 'function') {
        window.addPopup = function(coordinates, properties) {
            let instance = syncLegacyCompatibleMapboxGlobals(getLegacyCompatibleMapboxInstance());
            if(!instance) {
                return;
            }

            instance.addPopup(coordinates, properties);
        }
    }

    document.addEventListener('click', (event) => {
        let mapToggler = event.target.closest?.('.showMap[data-target]');
        if(!mapToggler?.dataset?.target) {
            return;
        }

        let instance = getLegacyCompatibleMapboxInstance(mapToggler.dataset.target);
        if(instance) {
            syncLegacyCompatibleMapboxGlobals(instance);
        } else {
            resetLegacyCompatibleMapboxGlobals(mapToggler.dataset.target);
        }
    });

    document.addEventListener('mapboxMapLoaded', (event) => {
        let instance = event.detail?.instance;
        let mapSectionId = event.detail?.mapSectionId;

        if(!instance || !mapSectionId) {
            return;
        }

        window.K_MAPBOX_INSTANCES[mapSectionId] = instance;
        syncLegacyCompatibleMapboxGlobals(instance);
    });

    class KMapboxAddFullscreenControl {
        constructor(kMapboxInstance) {
            this.kMapboxInstance = kMapboxInstance;
        }
        onAdd(map) {
            this._map = map;

            this._img = document.createElement('img');
            this._img.src = '/imgfiles/icons/general/icon-expand.svg';
            this._img.setAttribute('alt', 'LBL_APRI_FULLSCREEN_MAPPA')
            this._img.style.width = '29px';
            this._img.style.height = '29px';

            this._btn = document.createElement('a');
            this._btn.setAttribute('title', 'LBL_APRI_FULLSCREEN_MAPPA');
            this._btn.setAttribute('href', 'javascript:void(0);');
            this._btn.classList.add('fullscreen-button');
            this._btn.classList.add('open-fullscreen-button');
            this._btn.classList.add('d-block');
            this._btn.appendChild(this._img);

            this._btn.addEventListener('click', () => {
                this.kMapboxInstance.openFullscreen();
            })

            this._container = document.createElement('div');
            this._container.appendChild(this._btn)
            this._container.className = 'mapboxgl-ctrl';
            return this._container;
        }
        onRemove() {
            this._container.parentNode.removeChild(this._container);
            this._map = undefined;
        }
    }
    class KMapboxRemoveFullscreenControl {
        constructor(kMapboxInstance) {
            this.kMapboxInstance = kMapboxInstance;
        }
        onAdd(map) {
            this._map = map;

            this._img = document.createElement('img');
            this._img.src = '/imgfiles/icons/general/icon-reduce.svg';
            this._img.setAttribute('alt', 'LBL_CHIUDI_FULLSCREEN_MAPPA')
            this._img.style.width = '29px';
            this._img.style.height = '29px';

            this._btn = document.createElement('a');
            this._btn.setAttribute('title', 'LBL_CHIUDI_FULLSCREEN_MAPPA');
            this._btn.setAttribute('href', 'javascript:void(0);');
            this._btn.classList.add('fullscreen-button');
            this._btn.classList.add('close-fullscreen-button');
            this._btn.classList.add('d-block');
            this._btn.appendChild(this._img);

            this._btn.addEventListener('click', () => {
                this.kMapboxInstance.closeFullscreen();
            })

            this._container = document.createElement('div');
            this._container.appendChild(this._btn)
            this._container.className = 'mapboxgl-ctrl';
            return this._container;
        }
        onRemove() {
            this._container.parentNode.removeChild(this._container);
            this._map = undefined;
        }
    }

    class KBaseMapbox {
        constructor(mapContainerId, options = {}) {
            this.mapContainer = mapContainerId;
            if(!(this.mapContainer instanceof HTMLElement)) {
                this.mapContainer = document.querySelector(mapContainerId);
            }
            if(!this.mapContainer) {
                this._warn('No valid mapContainer given.');
                return;
            }

            this.options = Object.assign({}, options);
            this.options.clustersOptions = {
                cluster: true,
                clusterMaxZoom: 14,
                clusterRadius: 60,
                tolerance: 1,
                maxzoom: 40
            }
            this.events = {};

            this.isMapboxLoaded = false;
            this.isMapboxInitializationPending = false;
            this.hasPendingMarkersSourceSync = false;
            this.runtimeState = {
                swiperNavigationListenersAttached: false,
                currentSelectedFeatureId: null,
                currentSelectedFeature: null,
                zoom: {
                    userSelectedZoom: null,
                    isLastZoomFromUser: true
                },
                unclusteredPointsLabelsTimer: null
            };

            this.map = null;
            this.zoom = 14;

            this.markers = {
                type: 'FeatureCollection',
                crs: {
                    type: 'name',
                    properties: {
                        name: 'urn:ogc:def:crs:OGC:1.3:CRS84'
                    }
                },
                features: []
            }
            this.routePoints = {
                type: 'FeatureCollection',
                crs: {
                    type: 'name',
                    properties: {
                        name: 'urn:ogc:def:crs:OGC:1.3:CRS84'
                    }
                },
                features: []
            };
            // Routes passed directly by a Mapbox brick must survive GPX routes
            // refreshed from markers.
            this.staticRouteFeatures = [];
            this.routeProfileChart = null;
            this.routeRefreshRequestId = 0;
            this.selectedRouteFeatureId = null;
            this._mapboxGlHtmlScript = null;
            this._languagesPluginHtmlScript = null;
            this._cssHtmlLink = null;
            this._toGeoJsonHtmlScript = null;
            this._chartHtmlScript = null;
            this.center = this.getCalculatedMapCenter();
            this.startingCenter = options.startingCenter ?? null
            this.startingZoomLevel = options.startingZoomLevel ?? null;

            this.mapSwiper = {
                instance: null,
                container: this.mapContainer.querySelector('.map-swiper-container'),
                isSilent: false,
                activeIndex: 0
            };

            this.mapSwiper.htmlElement = this.mapSwiper.container?.querySelector('.map-markers-swiper');
            this.mapSwiper.slidesWrapper = this.mapSwiper.htmlElement?.querySelector('.swiper-wrapper')

            this.fullscreenIstance = null;

            this._setupMapboxScripts();
            this._showMapWhenNeeded();
            this.loadEvents();
        }
        on(eventName, fn) {
            this.events[eventName] = this.events[eventName] || [];
            this.events[eventName].push(fn);
        }
        off(eventName) {
            if (this.events[eventName]) {
                for (var i = 0; i < this.events[eventName].length; i++) {
                    if (this.events[eventName][i]) {
                        this.events[eventName].splice(i, 1);
                        break;
                    }
                }
            }
        }
        trigger(eventName, data) {
            if (this.events[eventName]) {
                this.events[eventName].forEach(function(fn) {
                    fn(data);
                });
            }
        }
        loadLayers() {
            this._loadMarkersLayers();

            if(!this.options.hasOwnProperty('loadRouteLayer') || this.options.loadRouteLayer) {
                this._loadRouteLayers();
            }

            if(!this.options.hasOwnProperty('load3DLayer') || this.options.load3DLayer) {
                this._load3DLayers();
            }
        }
        loadEventsListeners() {
            let self = this;

            this.map.addInteraction('kframe-hover-unclustered-points-enter', {
                type: 'mouseenter',
                target: { layerId: 'unclustered-points' },
                handler: () => {
                    this.map.getCanvas().style.cursor = 'pointer';
                }
            });
            this.map.addInteraction('kframe-hover-unclustered-points-leave', {
                type: 'mouseleave',
                target: { layerId: 'unclustered-points' },
                handler: () => {
                    this.map.getCanvas().style.cursor = '';
                }
            });
            this.map.addInteraction('kframe-hover-selected-marker-enter', {
                type: 'mouseenter',
                target: { layerId: 'selected-marker' },
                handler: () => {
                    this.map.getCanvas().style.cursor = 'pointer';
                }
            });
            this.map.addInteraction('kframe-hover-selected-marker-leave', {
                type: 'mouseleave',
                target: { layerId: 'selected-marker' },
                handler: () => {
                    this.map.getCanvas().style.cursor = '';
                }
            });
            this.map.addInteraction('kframe-hover-lines-enter', {
                type: 'mouseenter',
                target: { layerId: 'lines' },
                handler: () => {
                    this.map.getCanvas().style.cursor = 'pointer';
                }
            });
            this.map.addInteraction('kframe-hover-lines-leave', {
                type: 'mouseleave',
                target: { layerId: 'lines' },
                handler: () => {
                    this.map.getCanvas().style.cursor = '';
                }
            });
            this.map.addInteraction('kframe-click-unclustered-points', {
                type: 'click',
                target: { layerId: 'unclustered-points' },
                handler: (event) => {
                    if(event?.originalEvent?.defaultPrevented || !event?.feature) {
                        return;
                    }

                    this._log('KMapbox: click unclustered marker', {
                        markerId: event.feature?.properties?.id ?? null
                    });
                    this._log('KMapbox: click target', {
                        targetType: 'base-marker',
                        markerId: event.feature?.properties?.id ?? null
                    });

                    this.openFeaturePopup(event.feature, event.lngLat);
                    this.markFeatureAsSelected(event.feature);
                }
            });
            this.map.addInteraction('kframe-click-selected-marker', {
                type: 'click',
                target: { layerId: 'selected-marker' },
                handler: (event) => {
                    if(event?.originalEvent?.defaultPrevented || !event?.feature) {
                        return;
                    }

                    this._log('KMapbox: click selected marker', {
                        markerId: event.feature?.properties?.id ?? null
                    });
                    this._log('KMapbox: click target', {
                        targetType: 'selected-marker',
                        markerId: event.feature?.properties?.id ?? null
                    });

                    // Se il click cade abbastanza vicino al centro icona lo trattiamo come click sul marker;
                    // altrimenti, se sotto c'è anche un cluster, lasciamo vincere il cluster.
                    let overlappingClusters = this.map.queryRenderedFeatures(event.point, {
                        layers: ['clusters']
                    });
                    let overlappingCluster = overlappingClusters[0] ?? null;
                    let projectedSelectedMarkerPoint = Array.isArray(event.feature?.geometry?.coordinates)
                        ? this.map.project(event.feature.geometry.coordinates)
                        : null;
                    let selectedMarkerClickDistance = projectedSelectedMarkerPoint
                        ? Math.hypot(
                            Number(projectedSelectedMarkerPoint.x ?? 0) - Number(event.point?.x ?? 0),
                            Number(projectedSelectedMarkerPoint.y ?? 0) - Number(event.point?.y ?? 0)
                        )
                        : 0;
                    let isClickOnSelectedMarkerIcon = selectedMarkerClickDistance <= 12;

                    this._log('KMapbox: click selected marker:hit-test', {
                        markerId: event.feature?.properties?.id ?? null,
                        hasOverlappingCluster: !!overlappingCluster,
                        clickDistancePx: Number(selectedMarkerClickDistance.toFixed(2)),
                        isClickOnSelectedMarkerIcon: isClickOnSelectedMarkerIcon
                    });

                    if(overlappingCluster && !isClickOnSelectedMarkerIcon) {
                        let clusterId = overlappingCluster.properties?.cluster_id;
                        let pointCount = Number(overlappingCluster.properties?.point_count ?? 0);
                        let clusterSource = this.map.getSource('mapbox-markers');
                        let getClusterLeavesStartedAt = performance.now();

                        this._log('KMapbox: click selected marker:cluster priority', {
                            markerId: event.feature?.properties?.id ?? null,
                            clusterId: clusterId ?? null,
                            pointCount: pointCount,
                            clickDistancePx: Number(selectedMarkerClickDistance.toFixed(2))
                        });
                        this._log('KMapbox: click target', {
                            targetType: 'cluster-under-selected-marker',
                            markerId: event.feature?.properties?.id ?? null,
                            clusterId: clusterId ?? null
                        });

                        if(!clusterSource || clusterId === undefined || !pointCount) {
                            return;
                        }

                        // Manteniamo inline la stessa logica del click cluster per non introdurre helper dedicati.
                        if(this.markers.features.length > 5000) {
                            let options = {
                                bearing: 0,
                                center: {
                                    lat: overlappingCluster.geometry.coordinates[1],
                                    lng: overlappingCluster.geometry.coordinates[0]
                                },
                                pitch: 0,
                                zoom: this.map.getZoom() + 3,
                                paddingX: this.mapContainer.offsetWidth * 0.30,
                                paddingY: this.mapContainer.offsetHeight * 0.30
                            }

                            this.map.easeTo(options);
                        } else {
                            clusterSource.getClusterLeaves(clusterId, pointCount, 0, (error, clusterFeatures) => {
                                this._log('KMapbox: click selected marker:getClusterLeaves:done', {
                                    clusterId: clusterId ?? null,
                                    pointCount: pointCount,
                                    featuresCount: Array.isArray(clusterFeatures) ? clusterFeatures.length : 0,
                                    durationMs: Number((performance.now() - getClusterLeavesStartedAt).toFixed(2)),
                                    hasError: !!error
                                });

                                if(error || !Array.isArray(clusterFeatures) || !clusterFeatures.length) {
                                    return;
                                }

                                this.setMapZoom({
                                    features: clusterFeatures
                                });
                            });
                        }

                        return;
                    }

                    this.openFeaturePopup(event.feature, event.lngLat);
                    this.markFeatureAsSelected(event.feature);
                }
            });
            this.map.addInteraction('kframe-hover-clusters-enter', {
                type: 'mouseenter',
                target: { layerId: 'clusters' },
                handler: () => {
                    this.map.getCanvas().style.cursor = 'pointer';
                }
            });
            this.map.addInteraction('kframe-hover-clusters-leave', {
                type: 'mouseleave',
                target: { layerId: 'clusters' },
                handler: () => {
                    this.map.getCanvas().style.cursor = '';
                }
            });
            this.map.addInteraction('kframe-click-clusters', {
                type: 'click',
                target: { layerId: 'clusters' },
                handler: (event) => {
                    if(event?.originalEvent?.defaultPrevented || !event?.feature) {
                        return;
                    }

                    let clusterId = event.feature.properties?.cluster_id;
                    let pointCount = Number(event.feature.properties?.point_count ?? 0);
                    let clusterSource = this.map.getSource('mapbox-markers');
                    let getClusterLeavesStartedAt = performance.now();

                    this._log('KMapbox: click cluster', {
                        clusterId: clusterId ?? null,
                        pointCount: pointCount
                    });
                    this._log('KMapbox: click target', {
                        targetType: 'cluster',
                        clusterId: clusterId ?? null,
                        pointCount: pointCount
                    });

                    if(!clusterSource || clusterId === undefined || !pointCount) {
                        return;
                    }

                    // Con dataset molto grandi si evita getClusterLeaves() (e i relativi calcoli sui bounds)
                    // e si preferisce uno zoom fisso centrato sul cluster cliccato per mantenere l'interazione reattiva.
                    if(this.markers.features.length > 5000) {

                        let options = {
                            bearing: 0,
                            center: {
                                lat: event.feature.geometry.coordinates[1],
                                lng: event.feature.geometry.coordinates[0]
                            },
                            pitch: 0,
                            zoom: this.map.getZoom() + 3,
                            paddingX: this.mapContainer.offsetWidth * 0.30,
                            paddingY: this.mapContainer.offsetHeight * 0.30
                        }

                        this.map.easeTo(options);
                    } else {
                        clusterSource.getClusterLeaves(clusterId, pointCount, 0, (error, clusterFeatures) => {
                            this._log('KMapbox: click cluster:getClusterLeaves:done', {
                                clusterId: clusterId ?? null,
                                pointCount: pointCount,
                                featuresCount: Array.isArray(clusterFeatures) ? clusterFeatures.length : 0,
                                durationMs: Number((performance.now() - getClusterLeavesStartedAt).toFixed(2)),
                                hasError: !!error
                            });

                            if(error || !Array.isArray(clusterFeatures) || !clusterFeatures.length) {
                                return;
                            }

                            this.map.getSource('mapbox-markers').getClusterExpansionZoom(
                                clusterId,
                                (err, zoom) => {
                                    if (err) return;

                                    this.setMapZoom({
                                        features: clusterFeatures
                                    }, {
                                        minimumZoom: zoom
                                    });
                                }
                            );
                        });
                    }
                }
            });
            this.map.on('mouseout', () => {
                this.map.getCanvas().style.cursor = '';
            });
            this.map.on('movestart', () => {

            });
            this.map.on('moveend', () => {
                clearTimeout(this.unclusteredPointsLabelsTimer);
            });
            this.map.on('zoomstart', () => {
                this._log('KMapbox: zoomstart', {
                    zoom: this.map?.getZoom?.(),
                    isLastZoomFromUser: this.runtimeState.zoom.isLastZoomFromUser,
                    userSelectedZoom: this.runtimeState.zoom.userSelectedZoom
                });
            });
            this.map.on('zoomend', () => {
                let currentZoom = this.map?.getZoom?.() ?? null;

                if(this.runtimeState.zoom.isLastZoomFromUser && currentZoom !== null) {
                    this.runtimeState.zoom.userSelectedZoom = currentZoom;
                }

                clearTimeout(this.unclusteredPointsLabelsTimer);

                this._log('KMapbox: zoomend', {
                    zoom: currentZoom,
                    isLastZoomFromUser: this.runtimeState.zoom.isLastZoomFromUser,
                    userSelectedZoom: this.runtimeState.zoom.userSelectedZoom
                });

                this.runtimeState.zoom.isLastZoomFromUser = true;
            });
        }
        setMarkers(elements, resetMarkers = true) {
            if(typeof elements === 'string'){
                try {
                    elements = JSON.parse(elements);
                } catch (ex) {
                    this._log(ex);
                }
            }

            if(!Array.isArray(elements)) {
                elements = [];
            }

            let elementsToAdd = [];

            for(let i = 0; i < elements.length; i++) {
                let element = elements[i];

                if(element.properties) {
                    element.properties.autoIndex = i;

                    element.properties.cutTitle = element.properties.title;
                    if(element.properties.cutTitle && element.properties.cutTitle.length > 12) {
                        element.properties.cutTitle = element.properties.cutTitle.slice(0, 12) + '...';
                    }
                }

                if(element.geometry && Array.isArray(element.geometry.coordinates)
                    && element.geometry.coordinates.length > 1
                    && element.geometry.coordinates[0] >= -180 && element.geometry.coordinates[0] <= 180
                    && element.geometry.coordinates[1] >= -90 && element.geometry.coordinates[1] <= 90
                ) {
                    elementsToAdd.push(element);
                }
            }

                        if(elementsToAdd.length > 1) {
                elementsToAdd = elementsToAdd.sort((a, b) => {
                    if(a.properties.index === b.properties.index) {
                        return a.geometry.coordinates[0] - b.geometry.coordinates[0];
                    }

                    return a.properties.index - b.properties.index;
                });
            }

            this.spreadSameCoordinatesMarkers(elementsToAdd);

            if(resetMarkers){
                this.markers.features = [];
            }

            if(!elementsToAdd.length) {
                return;
            }

            this.markers.features = this.markers.features.concat(elementsToAdd);
        }
        updateMarkers(markersElems, resetMarkers) {
            this._log('KMapbox: updateMarkers', {
                resetMarkers: !!resetMarkers,
                inputCount: Array.isArray(markersElems) ? markersElems.length : null
            });
            this.setMarkers(markersElems, resetMarkers);

            if(!this.updateSources()) {
                this.hasPendingMarkersSourceSync = true;
                return;
            }

            this.hasPendingMarkersSourceSync = false;
            this.refreshRouteSource();
            this.afterMarkersUpdated();
        }
        afterMarkersUpdated() {
            this._log('KMapbox: afterMarkersUpdated', {
                markersCount: this.markers.features?.length ?? 0,
                popupType: this.options.popupType ?? null
            });
            if(this.markers.features === undefined || this.markers.features.length === 0){
                this.removeAllPopups();
            } else {
                this.setMapZoom();
            }

            if(this.options.popupType === 'slider') {
                this.setMarkersSwiper();
            }
        }
        flushPendingMarkersSourceSync() {
            if(!this.hasPendingMarkersSourceSync || !this.updateSources()) {
                return;
            }

            this._log('KMapbox: flushPendingMarkersSourceSync');
            this.hasPendingMarkersSourceSync = false;
            this.refreshRouteSource();
            this.afterMarkersUpdated();
        }
        setRoutePointsMarkers(elements, resetMarkers = true) {
            if(typeof elements === 'string'){
                try {
                    elements = JSON.parse(elements);
                } catch (ex) {
                    this._log(ex);
                }
            }

            if(!Array.isArray(elements)) {
                elements = [];
            }

                        if(elements.length > 1) {
                elements = elements.sort((a, b) => {
                    return a.geometry.coordinates[0] - b.geometry.coordinates[0];
                });
            }

            if(resetMarkers){
                this.routePoints.features = [];
            }

            if(!Array.isArray(elements) || !elements.length){
                return;
            }

            this.routePoints.features = this.routePoints.features.concat(elements);
        }
        updateSources(markers = null) {
            let updateSourcesStartedAt = performance.now();

            if(!markers) {
                markers = this.markers;
            }

            if(
                !this.map
                || !this.isMapboxLoaded
                || !this.map.getSource('mapbox-markers')
            ) {
                return false;
            }

            this._log('KMapbox: updateSources', {
                markersCount: markers?.features?.length ?? 0
            });

            if(Array.isArray(markers?.features)) {
                markers.features.forEach((feature, index) => {
                    feature.properties = feature.properties ?? {};

                    if(feature?.properties?.id !== undefined && feature?.properties?.id !== null) {
                        feature.id = feature.properties.id;
                    } else if(feature.id === undefined || feature.id === null) {
                        feature.id = `k-mapbox-marker-${index}`;
                    }
                });
            }

            this.map.getSource('mapbox-markers').setData(markers);
            this.syncSelectedMarkerSource();
            this._log('KMapbox: updateSources:done', {
                markersCount: markers?.features?.length ?? 0,
                durationMs: Number((performance.now() - updateSourcesStartedAt).toFixed(2))
            });

            return true;
        }
        getEmptyFeatureCollection() {
            return {
                type: 'FeatureCollection',
                crs: {
                    type: 'name',
                    properties: {
                        name: 'urn:ogc:def:crs:OGC:1.3:CRS84'
                    }
                },
                features: []
            };
        }
        getRouteCoordinates(routePoints = null) {
            let features = routePoints?.features ?? this.routePoints.features;

            return features.flatMap(feature => {
                if(!feature?.geometry?.type || !Array.isArray(feature.geometry.coordinates)) {
                    return [];
                }

                if(feature.geometry.type === 'LineString') {
                    return feature.geometry.coordinates;
                }

                if(feature.geometry.type === 'MultiLineString') {
                    return feature.geometry.coordinates.flat();
                }

                return [];
            });
        }
        getMarkersGpxFileUrls(markers = null) {
            let markersFeatures = markers?.features ?? this.markers.features ?? [];

            return Array.from(new Set(
                markersFeatures
                    .map(feature => feature?.properties?.gpxFileUrl ?? null)
                    .filter(url => typeof url === 'string' && url.trim() !== '')
            ));
        }
        getDefaultZoomFeatures() {
            let routeCoordinates = this.getRouteCoordinates();

            return {
                features: [
                    ...(Array.isArray(this.markers.features) ? this.markers.features : []),
                    ...routeCoordinates.map(coordinate => {
                        return {
                            geometry: {
                                coordinates: [coordinate[0], coordinate[1]]
                            }
                        };
                    })
                ]
            };
        }
        syncSelectedMarkerSource() {
            if(!this.map?.getSource('mapbox-selected-marker')) {
                return;
            }

            if(this.runtimeState.currentSelectedFeatureId === null) {
                this.map.getSource('mapbox-selected-marker').setData(this.getEmptyFeatureCollection());
                return;
            }

            let selectedFeature = (this.map.getSource('mapbox-markers')?._data?.features ?? []).find((feature) => {
                return String(feature?.properties?.id ?? feature?.id ?? '') === String(this.runtimeState.currentSelectedFeatureId);
            }) ?? null;

            this.map.getSource('mapbox-selected-marker').setData(selectedFeature ? {
                ...this.getEmptyFeatureCollection(),
                features: [{
                    ...selectedFeature,
                    properties: {
                        ...(selectedFeature.properties ?? {})
                    }
                }]
            } : this.getEmptyFeatureCollection());
        }
        setMarkerPriorityById(featureId) {
            if(!featureId || !this.map?.getSource('mapbox-markers')) {
                return;
            }

            const source = this.map.getSource('mapbox-markers');
            const data = source._data;
            const targetFeature = data.features.find((feature) => feature.properties.id === featureId);

            if(!targetFeature) {
                return;
            }

            targetFeature.properties.priority = 'primary';
            this.map.triggerRepaint();
        }
        setSelectedRouteFeatureId(featureId = null) {
            this.selectedRouteFeatureId = featureId || null;

            if(!Array.isArray(this.routePoints.features) || !this.routePoints.features.length) {
                return;
            }

            this.routePoints.features = this.routePoints.features.map((feature) => {
                feature.properties = {
                    ...(feature.properties ?? {}),
                    kIsSelected: !!(this.selectedRouteFeatureId && feature.properties?.id === this.selectedRouteFeatureId)
                };

                return feature;
            });

            if(this.map?.getSource('mapbox-track')) {
                this.map.getSource('mapbox-track').setData(this.routePoints);
            }
        }
        getPopupCoordinatesFromFeature(feature, fallbackCoordinates = null) {
            if(Array.isArray(fallbackCoordinates) && fallbackCoordinates.length >= 2) {
                return [fallbackCoordinates[0], fallbackCoordinates[1]];
            }

            if(feature?.geometry?.type === 'Point') {
                return Array.isArray(feature.geometry.coordinates)
                    ? [...feature.geometry.coordinates]
                    : null;
            }

            let routeCoordinates = this.getRouteCoordinates({
                features: feature ? [feature] : []
            });

            if(routeCoordinates.length) {
                return [routeCoordinates[0][0], routeCoordinates[0][1]];
            }

            return null;
        }
        openFeaturePopup(feature, clickedLngLat = null) {
            if(!feature?.properties) {
                return;
            }

            this._log('KMapbox: openFeaturePopup', {
                markerId: feature.properties?.id ?? null,
                popupType: this.options.popupType ?? null
            });

            const coordinates = this.getPopupCoordinatesFromFeature(feature, clickedLngLat ? [clickedLngLat.lng, clickedLngLat.lat] : null);
            if(!coordinates) {
                return;
            }

            this.setSelectedRouteFeatureId(feature.properties.id ?? null);

            while (clickedLngLat && Math.abs(clickedLngLat.lng - coordinates[0]) > 180) {
                coordinates[0] += clickedLngLat.lng > coordinates[0] ? 360 : -360;
            }

            if(this.options.popupType === "slider" && feature.properties.id) {
                this.setSwiperSlideFromMarker(feature.properties.id, { zoomInMaximumValue: this.options.clustersOptions.clusterMaxZoom - 1.5 });
            } else {
                this.addPopup(coordinates, feature.properties);
            }
        }
        markFeatureAsSelected(feature) {
            let markFeatureAsSelectedStartedAt = performance.now();
            let featureId = feature?.properties?.id ?? null;
            if(featureId === null) {
                return;
            }

            this._log('KMapbox: markFeatureAsSelected', {
                featureId: featureId,
                previousFeatureId: this.runtimeState.currentSelectedFeatureId
            });

            let dataSource = this.map?.getSource('mapbox-markers');

            if(dataSource) {
                // reset della feature precedentemente attivata
                if(this.runtimeState.currentSelectedFeatureId !== null) {
                    this.map.setFeatureState({
                        source: 'mapbox-markers',
                        id: this.runtimeState.currentSelectedFeatureId
                    }, {
                        currentlySelected: false
                    });
                }

                // attivazione della nuova feature selezionata
                this.map.setFeatureState({
                    source: 'mapbox-markers',
                    id: featureId
                }, {
                    currentlySelected: true
                });
            }

            this.runtimeState.currentSelectedFeatureId = featureId;
            this.runtimeState.currentSelectedFeature = feature;

            this.syncSelectedMarkerSource();

            this._log('KMapbox: markFeatureAsSelected:done', {
                featureId: featureId,
                durationMs: Number((performance.now() - markFeatureAsSelectedStartedAt).toFixed(2))
            });
        }
        updateRouteSource(routeFeatures = []) {
            this.routePoints = this.getEmptyFeatureCollection();
            this.routePoints.features = [
                ...this.staticRouteFeatures,
                ...(Array.isArray(routeFeatures) ? routeFeatures : [])
            ].map((feature) => {
                feature.properties = {
                    ...(feature.properties ?? {}),
                    kIsSelected: !!(this.selectedRouteFeatureId && feature.properties?.id === this.selectedRouteFeatureId)
                };

                return feature;
            });

            if(this.map?.getSource('mapbox-track')) {
                this.map.getSource('mapbox-track').setData(this.routePoints);
            }

            this.buildHeightProfile();
        }
        ensureToGeoJsonIsLoaded() {
            if(typeof window.toGeoJSON !== 'undefined') {
                return Promise.resolve(window.toGeoJSON);
            }

            if(!K_MAPBOX_TO_GEOJSON_PROMISE) {
                if(!document.getElementById(this._toGeoJsonHtmlScript.id)) {
                    document.head.appendChild(this._toGeoJsonHtmlScript);
                }

                K_MAPBOX_TO_GEOJSON_PROMISE = this._waitForScript(this._toGeoJsonHtmlScript, () => typeof window.toGeoJSON !== 'undefined')
                    .then(() => window.toGeoJSON);
            }

            return K_MAPBOX_TO_GEOJSON_PROMISE;
        }
        ensureChartIsLoaded() {
            if(typeof window.Chart !== 'undefined') {
                return Promise.resolve(window.Chart);
            }

            if(!document.getElementById('elevationChart')) {
                return Promise.resolve(null);
            }

            if(!K_MAPBOX_CHART_PROMISE) {
                if(!document.getElementById(this._chartHtmlScript.id)) {
                    document.head.appendChild(this._chartHtmlScript);
                }

                K_MAPBOX_CHART_PROMISE = this._waitForScript(this._chartHtmlScript, () => typeof window.Chart !== 'undefined')
                    .then(() => window.Chart)
                    .catch((error) => {
                        this._warn('Chart assets loading failed', error);
                        return null;
                    });
            }

            return K_MAPBOX_CHART_PROMISE;
        }
        fetchGpxFeatures(url, markerProperties = {}) {
            if(!window.K_MAPBOX_GPX_FEATURES_CACHE[url]) {
                window.K_MAPBOX_GPX_FEATURES_CACHE[url] = this.ensureToGeoJsonIsLoaded()
                    .then(() => fetch(url))
                    .then((response) => {
                        if(!response.ok) {
                            throw new Error('Unable to fetch GPX file: ' + url);
                        }

                        return response.text();
                    })
                    .then((data) => {
                        let fileData = new DOMParser().parseFromString(data, 'text/xml');
                        let formatterResult = window.toGeoJSON.gpx(fileData);

                        return Array.isArray(formatterResult?.features)
                            ? formatterResult.features.filter(feature => feature?.geometry)
                            : [];
                    })
                    .catch((error) => {
                        delete window.K_MAPBOX_GPX_FEATURES_CACHE[url];
                        this._warn('GPX parsing failed', url, error);

                        return [];
                    });
            }

            return window.K_MAPBOX_GPX_FEATURES_CACHE[url]
                .then((features) => JSON.parse(JSON.stringify(features)).map((feature) => {
                    feature.properties = {
                        ...(feature.properties ?? {}),
                        ...markerProperties
                    };

                    return feature;
                }));
        }
        refreshRouteSource(markers = null) {
            const markersFeatures = markers?.features ?? this.markers.features ?? [];
            const currentRequestId = ++this.routeRefreshRequestId;

            const gpxMarkers = markersFeatures.filter((feature) => {
                return typeof feature?.properties?.gpxFileUrl === 'string' && feature.properties.gpxFileUrl.trim() !== '';
            });

            if(!gpxMarkers.length) {
                this.updateRouteSource([]);
                return Promise.resolve(this.routePoints);
            }

            return Promise.all(gpxMarkers.map((feature) => this.fetchGpxFeatures(
                feature.properties.gpxFileUrl,
                feature.properties
            )))
                .then((routeFeaturesGroups) => {
                    if(currentRequestId !== this.routeRefreshRequestId) {
                        return this.routePoints;
                    }

                    this.updateRouteSource(routeFeaturesGroups.flat());
                    return this.routePoints;
                })
                .catch((error) => {
                    if(currentRequestId !== this.routeRefreshRequestId) {
                        return this.routePoints;
                    }

                    this._warn('Route source refresh failed', error);
                    this.updateRouteSource([]);

                    return this.routePoints;
                });
        }
        spreadSameCoordinatesMarkers(markers) {
            let groupedMarkers = {};
            markers.forEach(marker => {
                let coordinatesKey = marker.geometry.coordinates[1] + '-' + marker.geometry.coordinates[0];

                if(!groupedMarkers[coordinatesKey]) {
                    groupedMarkers[coordinatesKey] = [];
                }

                groupedMarkers[coordinatesKey].push(marker);
            });

            for(let markersGroupIndex in groupedMarkers) {
                let markersGroup = groupedMarkers[markersGroupIndex];

                if(markersGroup.length < 2) {
                    continue;
                }

                let duplicatedCoordinates = JSON.parse(JSON.stringify(markersGroup[0].geometry.coordinates));

                // i punti "duplicati" vengono modificati nelle coordinate per disporti in cerchio rispetto alle coordinate originali
                let spreadPoints = this.getSpreadPointsFromCoordinates(
                    duplicatedCoordinates[1],
                    duplicatedCoordinates[0],
                    .00005,
                    markersGroup.length
                );

                spreadPoints.forEach((coordinates, index) => {
                    markersGroup[index].properties.isSpread = true;
                    markersGroup[index].properties.originalCoordinates = duplicatedCoordinates;
                    markersGroup[index].geometry.coordinates = coordinates;
                })
            }
        }
        getSpreadPointsFromCoordinates(latitude, longitude, radius, numberOfPoints) {
            const result = [];

            for (let i = 0; i < numberOfPoints; i++) {
                const theta = (2 * Math.PI * i) / numberOfPoints;
                const x = latitude + radius * Math.cos(theta);
                const y = longitude + radius * Math.sin(theta);
                result.push([y, x]);
            }

            return result;
        }
        setMapZoom(markersToUse = null, options = {}) {
            let correction = options.correction ?? 0;
            let offset = options.offset;
            let zoomInMaximumValue = options.zoomInMaximumValue;
            let minimumZoom = options.minimumZoom;

                        if(!markersToUse) {
                markersToUse = this.getDefaultZoomFeatures();
            }

            if(markersToUse.features === undefined || markersToUse.features.length === 0) {
                return
            }

                        if(this.map.getZoom() > 15 && markersToUse.features.length > 1) {
                correction = 0.0003;
            }

            let latitudes = markersToUse.features.map(m => m.geometry.coordinates[1]);
            let longitudes = markersToUse.features.map(m => m.geometry.coordinates[0]);

                        let sudWest = [Math.min.apply(null, longitudes) - correction, Math.min.apply(null, latitudes) - correction];
            let northEast = [Math.max.apply(null, longitudes) + correction, Math.max.apply(null, latitudes) + correction];

            const bounds = new K_MAPBOX.LngLatBounds(
                new K_MAPBOX.LngLat(sudWest[0], sudWest[1]),
                new K_MAPBOX.LngLat(northEast[0], northEast[1])
            );

            // viene sempre mantenuto uno spazio del 25% intorno al bound, per motivi estetici
            let paddingX = this.mapContainer.offsetWidth * 0.25; //this.mapContainer.offsetWidth * 0.3;
            let paddingY = this.mapContainer.offsetHeight * 0.25; //this.mapContainer.offsetHeight * 0.3;

            let boundsData = this.map.cameraForBounds(bounds, {
                padding: {
                    top: paddingY,
                    left: paddingX,
                    bottom: paddingY,
                    right: paddingX
                }
            });

            if(markersToUse.features.length === 1) {
                if(boundsData.zoom < (this.options.clustersOptions.clusterMaxZoom + 1)) {
                    boundsData.zoom = this.options.clustersOptions.clusterMaxZoom + 1.1;
                }

                if(boundsData.zoom < this.map.getZoom()) {
                    boundsData.zoom = this.map.getZoom();
                }
            }

            if(zoomInMaximumValue && boundsData.zoom > zoomInMaximumValue && this.map.getZoom() < boundsData.zoom) {
                boundsData.zoom = zoomInMaximumValue;
            }

            if(minimumZoom && boundsData.zoom < minimumZoom) {
                boundsData.zoom = minimumZoom;
            }

            this.map.flyTo(Object.assign(
                boundsData,
                {
                    offset: offset ?? [0, 0],
                    speed: 2.5,
                    curve: 1
                })
            );
        }
        getFirstLevelClustersFromFeatures(clustersIndex, features) {
            let result = [];

            for(let i = 0; i < features.length; i++) {
                let feature = features[i];
                if(!feature.properties || !feature.properties.cluster) {
                    continue;
                }

                result.push(this.getLastClusterFromFeature(clustersIndex, feature));
            }

            return result;
        }
        getLastClusterFromFeature(clustersIndex, clusterFeature) {
            let result = null;

            let clusterChildren = clustersIndex.getChildren(clusterFeature.id);

            if(!clusterChildren.find(child => child.properties?.cluster)) {
                return clusterFeature;
            }

            for(let i = 0; i < clusterChildren.length; i++) {
                let feature = clusterChildren[i];
                if(!feature.properties?.cluster) {
                    continue;
                }

                result = this.getLastClusterFromFeature(clustersIndex, feature);
            }

            return result;
        }
        getCalculatedMapCenter(merkersFeatures = null) {
            if(!merkersFeatures) {
                merkersFeatures = this.markers.features;
            }
            if(merkersFeatures.length === 1){
                return merkersFeatures[0].geometry.coordinates;
            }

            if(merkersFeatures.length === 0) {
                let centerDefaultLatitude = '46.067390686722874';
                let centerDefaultLongitude = '11.127787409187569';
                if(centerDefaultLatitude && centerDefaultLongitude) {
                    return [parseFloat(centerDefaultLongitude), parseFloat(centerDefaultLatitude)];
                } else {
                    return [10.769616937124763, 46.04360187114996];
                }
            }

            let longitudes = merkersFeatures.map(f=>f.geometry.coordinates[0]);
            let sumLongitudes = longitudes.reduce((a, b) => a + b, 0);

            let latitudes = merkersFeatures.map(f=>f.geometry.coordinates[1]);
            let sumLatitudes = latitudes.reduce((a, b) => a + b, 0);

            let averageLongitude = (sumLongitudes / longitudes.length) || 0;
            let averageLatitude = (sumLatitudes / latitudes.length) || 0;

            return [averageLongitude, averageLatitude];
        }
        setMapCenter(center = null, options = {}) {
            let animate = options.animate ?? true;

            let mapCenter = (center !== null) ? center : this.getCalculatedMapCenter();

            if(animate) {
                this.map.flyTo({
                    center: mapCenter,
                    curve: 0,
                    speed: .8
                });
            } else {
                this.map.setCenter(mapCenter);
            }
        }
        addPopup(coordinates, properties) {
            window.popupHtml = '';

window.getPopupHtml = async function (coordinates, properties, kMapbox) {

    return new Promise(async (resolve, reject) => {
        if (properties.isLazyLoadPopup && !properties.isLazyDataLoaded) {
            let language = window.language || 'en';
            let lazyLoadResponse = await fetch('/' + language + '/get-map-marker-popup-data/' + (properties.originalId || properties.id))

            if (lazyLoadResponse.ok) {
                const result = await lazyLoadResponse.json();
                if(result.data) {
                    for (let key in result.data) {
                        properties[key] = result.data[key];
                    }
                    properties.isLazyDataLoaded = true;
                }
            }
        }
        console.log(properties);
        let title = properties.title ?? '';
        if (title) {
            title = '<b>' + title + '</b>';
        }
        let description = properties.description ?? '';
        let cardText = [title, description];

        let image = properties.mainImage ?? '';
        if (image) {
            image = kMapbox.getPopupImage(properties.mainImage, title);
        }

        let detailUrl = properties.urlDetail ? properties.urlDetail : '';

        let additionalClasses = properties.additionalClasses ?? '';
        let additionalAttributes = properties.additionalAttributes ?? '';
        window.popupHtml = `
                        <a href='${detailUrl}' title="${title.stripTags()}" class="text-decoration-none ${additionalClasses}" ${additionalAttributes}>
    ${image}
    <p>${cardText.join('<br>')}</p>
</a>
<a class="btn btn-default btn-sm m-auto d-block w-100 marker-popup-external-cta" href="https://www.google.com/maps/dir/?api=1&destination=${coordinates[1]},${coordinates[0]}&travelmode=driving" target="_blank" title="Take me here">Take me here</a>        `;

        resolve(window.popupHtml);
    })
}
            let popup = new K_MAPBOX.Popup({
                className: '',
                            });

            popup.on('close', () => {
                this.setSelectedRouteFeatureId(null);
            });

            if(typeof getPopupHtml === 'function') {
                let self = this;
                getPopupHtml(coordinates, properties, this).then(function (popupHtml) {
                    popup.setLngLat(coordinates)
                        .setHTML(popupHtml)
                        .addTo(self.map);
                })
            } else {
                popup.setLngLat(coordinates)
                    .setHTML(window.popupHtml)
                    .addTo(this.map);
            }
        }
        removeAllPopups() {
            let openedPopups = document.querySelectorAll('.mapboxgl-popup');
            for(let popup of openedPopups){
                popup.remove();
            }
        }
        removeAllLayers() {
            this.map.eachLayer(function (layer) {
                this.map.removeLayer(layer);
            });
        }
        getPopupImage(imageUrl) {
            return (imageUrl !== '') ? '<div class="set-img"><picture style="max-width: 200px;"><img src="'+imageUrl+'" class="img-fluid"></picture></div>' : '';
        }
        openAvailablePopups() {
                        this.removeAllPopups();

                        let visibleMarkers = this.map.queryRenderedFeatures(null, { layers: ['unclustered-points'] });

                        for(let marker of visibleMarkers){
                const coordinates = marker.geometry.coordinates;
                const properties = marker.properties;
                this.addPopup(coordinates, properties);
            }
        }
        setMarkersSwiper() {
            let self = this;

            if(!this.mapSwiper.slidesWrapper) {
                this._warn('No swiper wrapper found Please add a div with class .map-swiper-container and a .swiper-wrapper div');
                return;
            }

            if(this.markers.features.length === 0) {
                this.mapSwiper.container.classList.add('d-none');
                return;
            }

            this.mapSwiper.container.classList.remove('d-none');

                        let firstActiveMarkerIndex = self.markers.features.findIndex(marker => marker.properties.priority === 'primary');
            let firstActiveMarker;
            if(firstActiveMarkerIndex !== -1) {
                firstActiveMarker = self.markers.features[firstActiveMarkerIndex];
            }

            if(!firstActiveMarker || !self.options.zoomOnFirstMarker) {
                this.mapSwiper.container.style.visibility = 'hidden';
            }

            if(this.mapSwiper.container.style.visibility !== 'hidden' && firstActiveMarkerIndex !== -1 && this.options.zoomOnFirstMarker) {
                // viene impedito di lanciare l'evento di slideChange per evitare di modificare lo zoom corrente
                this.mapSwiper.isSilent = true;
                this.setSwiperSlideFromMarker(firstActiveMarker.properties.id).then(() => {
                    this.mapSwiper.isSilent = false;
                });
            }

            if(!this.runtimeState.swiperNavigationListenersAttached) {
                this.mapSwiper.container.querySelector('.swiper-next')?.addEventListener('click', () => {
                    this.showNextSliderSlide();
                });

                this.mapSwiper.container.querySelector('.swiper-prev')?.addEventListener('click', () => {
                    this.showPreviousSliderSlide();
                });

                this.runtimeState.swiperNavigationListenersAttached = true;
            }
        }
        async setSwiperSlideFromMarker(markerId, options = {}) {
            let markerToUseIndex = this.markers.features.findIndex(marker => marker.properties.id === markerId);
            if(markerToUseIndex === -1) {
                return;
            }

                        let marker = this.markers.features[markerToUseIndex];

                        if(this.mapSwiper.container.style.visibility === 'hidden') {
                this.mapSwiper.container.style.visibility = 'visible';
            }

            let sliderSlideHtml = '';

            if(typeof marker !== 'undefined' && typeof marker === 'object') {
    if (marker.properties.isLazyLoadPopup && !marker.properties.isLazyDataLoaded) {
        let language = window.language || 'en';
        let lazyLoadUrl = '/' + language + '/get-map-marker-popup-data/' + (marker.properties.originalId || marker.properties.id);

        if(this.mapSwiper.slidesWrapper) {
            let preloader = document.createElement('div');
            preloader.classList.add('preloader-wrapper');
            preloader.innerHTML = `<div class="circle-wrapper">
                <div class="circle-loader" style="width: 30px; height: 30px;">
                    <div class="checkmark draw"></div>
                </div>
            </div>`;
            this.mapSwiper.slidesWrapper.appendChild(preloader);
        }

        let lazyLoadResponse = await fetch(lazyLoadUrl);

        if (lazyLoadResponse.ok) {
            const result = await lazyLoadResponse.json();
            if(result.data) {
                for (let key in result.data) {
                    marker.properties[key] = result.data[key];
                }
                marker.properties.isLazyDataLoaded = true;
            }
        }

        if(this.mapSwiper.slidesWrapper) {
            this.mapSwiper.slidesWrapper.querySelector('.preloader-wrapper').remove();
        }
    }

    let slideTitleHtml = '';
    let slideMainImageHtml = '';
    let slideAddressHtml = '';
    let slideIconsCtasHtml = ``;
    let slideInfoRequestHtml = ``;
    let slideGoogleMapsLinkHtml = ``;
    let slideTelephoneHtml = ``;
    let slideUrlHtml = ``;

    if(marker.properties.title) {
        slideTitleHtml = `<h3 class="element-title">${marker.properties.title}</h3>`;
    }

    if(marker.properties.mainImage) {
        let mainImageUrl;
        if(typeof marker.properties.mainImage === 'object') {
            if(marker.properties.mainImage.url) {
                mainImageUrl = marker.properties.mainImage.url;
            }
        } else if (typeof marker.properties.mainImage === 'string') {
            mainImageUrl = marker.properties.mainImage;
        }

        if(mainImageUrl) {
            slideMainImageHtml = `
                <div class="col-4">
                    <div class="set-img element-main-image">
                        <picture>
                            <img alt="${marker.properties.title}" src="${mainImageUrl}">
                        </picture>
                    </div>
                </div>
            `;
        }
    }

    if(marker.properties.address) {
        slideAddressHtml = `<span class="element-address">${marker.properties.address}</span>`;
    }

    if(marker.properties.email) {
        slideInfoRequestHtml = `
            <a href="javascript:void(0);" class="showContentWindow element-email" target="${marker.properties.className === 'accommodation' ? '_popover_accommodations_infopop' : '_popoverinfopop'}" data-email="${marker.properties.email}" data-name="${marker.properties.title}" aria-label="Request\u0020information" title="Request\u0020information">
                <img src="/imgfiles/icons/general/mapcard-info.svg" alt="Request\u0020information">
            </a>
        `;
    }
    if(marker.properties.urlIndications) {
        slideGoogleMapsLinkHtml = `
            <a href="${marker.properties.urlIndications}" class="element-how-to-arrive" target="_blank" rel="noopener noreferrer" aria-label="LBL_LINK_ESTERNO_A_GOOGLE_MAPS" title="How\u0020to\u0020get\u0020there">
                <img src="/imgfiles/icons/general/mapcard-arrivare.svg" alt="How\u0020to\u0020get\u0020there">
            </a>
        `;
    }
    if(marker.properties.telephone) {
        slideTelephoneHtml = `
            <a href="tel:${marker.properties.telephone}" class="element-telephone" aria-label="Call" title="Call">
                <img src="/imgfiles/icons/general/mapcard-tel.svg" alt="Call">
            </a>
        `;
    }

    if(slideInfoRequestHtml || slideGoogleMapsLinkHtml || slideTelephoneHtml) {
        if(slideInfoRequestHtml) {
            slideIconsCtasHtml += slideInfoRequestHtml;
        }
        if(slideGoogleMapsLinkHtml) {
            slideIconsCtasHtml += slideGoogleMapsLinkHtml;
        }
        if(slideTelephoneHtml) {
            slideIconsCtasHtml += slideTelephoneHtml;
        }

        slideIconsCtasHtml = `<div class="mapcard-icons">${slideIconsCtasHtml}</div>`;
    }

    if(marker.properties.detailUrl) {
        let detailUrlLabel = 'View\u0020details';
        if(marker.properties.detailUrlLabel) {
            detailUrlLabel = marker.properties.detailUrlLabel;
        }
        slideUrlHtml = `
            <a href="${marker.properties.detailUrl}" target="${marker.properties.urlTarget ?? '_self' }" class="btn btn-sm btn-fourth" title="${detailUrlLabel}">${detailUrlLabel}</a>
        `;
    }

    sliderSlideHtml = `
        <div class="swiper-slide">
            <div class="row g-3">
                ${slideMainImageHtml}
                <div class="${slideMainImageHtml ? 'col-8' : 'col-12'}">
                    ${slideTitleHtml}
                    ${slideAddressHtml}
                    ${slideIconsCtasHtml}
                    ${slideUrlHtml}
                </div>
            </div>
        </div>
    `;
}
            if(typeof sliderSlideHtml === 'undefined' || !sliderSlideHtml) {
                return;
            }

            if(options.exitAnimationClass && this.mapSwiper.slidesWrapper.querySelector('.swiper-slide')) {
                this.mapSwiper.slidesWrapper.querySelector('.swiper-slide').classList.add(options.exitAnimationClass);
            }

            this.mapSwiper.activeIndex = markerToUseIndex;
            this.triggerSliderSlideChangeHooks(options);

            this.mapSwiper.slidesWrapper.innerHTML = sliderSlideHtml;

            if(options.enterAnimationClass && this.mapSwiper.slidesWrapper.querySelector('.swiper-slide')) {
                this.mapSwiper.slidesWrapper.querySelector('.swiper-slide').classList.add(options.enterAnimationClass);

                setTimeout(() => {
                    this.mapSwiper.slidesWrapper.querySelector('.swiper-slide').classList.remove(options.enterAnimationClass);
                }, 300)
            }
        }
        showNextSliderSlide() {
            if(this.mapSwiper.activeIndex === this.markers.features.length - 1) {
                this.mapSwiper.activeIndex = 0;
            } else {
                this.mapSwiper.activeIndex++;
            }

            let markerId = this.markers.features[this.mapSwiper.activeIndex].properties.id;

            this.setSwiperSlideFromMarker(markerId, {
                exitAnimationClass: 'swipe-left-exit',
                enterAnimationClass: 'enter-from-right',
                zoomInMaximumValue: this.runtimeState.zoom.userSelectedZoom || 12
            });
        }
        showPreviousSliderSlide() {
            if(this.mapSwiper.activeIndex === 0) {
                this.mapSwiper.activeIndex = this.markers.features.length - 1;
            } else {
                this.mapSwiper.activeIndex--;
            }

            console.log('this.mapSwiper.activeIndex', this.mapSwiper.activeIndex)

            let markerId = this.markers.features[this.mapSwiper.activeIndex].properties.id;

            this.setSwiperSlideFromMarker(markerId, {
                exitAnimationClass: 'swipe-right-exit',
                enterAnimationClass: 'enter-from-left',
                zoomInMaximumValue: this.runtimeState.zoom.userSelectedZoom || 12
            });
        }
        triggerSliderSlideChangeHooks(options = {}) {
            if(this.mapSwiper.isSilent) {
                return;
            }

            let markerToFocus = this.markers.features[this.mapSwiper.activeIndex];

            const activeSlideFeature = this.map.getSource('mapbox-markers')._data.features.find(markerData => markerData.properties.id === markerToFocus.properties.id);

            if(activeSlideFeature) {
                activeSlideFeature.source = 'mapbox-markers';
                this.markFeatureAsSelected(activeSlideFeature);
            }

            let isMarkerVisibile = !!this.map.queryRenderedFeatures({
                layers: ['unclustered-points', 'selected-marker']
            }).find(markerFeature => markerFeature.properties.id === markerToFocus.properties.id || (markerFeature.properties.originalId && markerToFocus.properties.originalId && markerFeature.properties.originalId === markerToFocus.properties.originalId));

            if(isMarkerVisibile && !this.options.alwaysFocusSelectedMarkerOnSlidesChange) {
                this.setMapCenter(markerToFocus.geometry.coordinates, { animate: true });
            } else {
                this.setMapZoom({
                    features: [markerToFocus]
                }, options);
            }
        }
        openFullscreen() {
            let fullscreenModeWrapper = this.mapContainer.querySelector('.fullscreen-mode-wrapper');

            if(!fullscreenModeWrapper) {
                return;
            }

            fullscreenModeWrapper.showPopover();
            fullscreenModeWrapper.classList.add('fullscreen-open');

            const currentMarkersData = JSON.parse(JSON.stringify(this.map.getSource('mapbox-markers')._data));
            let currentRoutePointsMarkersData = {
                features: []
            };
            if(this.map.getSource('mapbox-track')) {
                currentRoutePointsMarkersData = JSON.parse(JSON.stringify(this.map.getSource('mapbox-track')._data));
            }

            let mainInstance = this;
            if(!this.fullscreenIstance) {
                this.fullscreenIstance = new KMapbox(fullscreenModeWrapper, {
                    allowFullscreen: false,
                    markersAsClusters: Boolean(1),
                    startUpOnClick: false,
                    startingCenter: this.map.getCenter(),
                    startingZoomLevel: this.map.getZoom(),
                    zoomOnFirstMarker: this.mapSwiper.container?.style.visibility !== 'hidden' && !!currentMarkersData.features.find(feature => feature.properties?.priority === 'primary'),
                    addUnclusteredPointLabels: !!this.options.addUnclusteredPointLabels,
                    alwaysFocusSelectedMarkerOnSlidesChange: !!this.options.alwaysFocusSelectedMarkerOnSlidesChange,
                    popupType: this.options.popupType || 'popup'
                });
                this.fullscreenIstance.setMarkers(currentMarkersData.features);
                this.fullscreenIstance.setRoutePointsMarkers(currentRoutePointsMarkersData.features);
                this.fullscreenIstance.staticRouteFeatures = JSON.parse(JSON.stringify(currentRoutePointsMarkersData.features));
                this.fullscreenIstance.on('load', () => {
                    this.fullscreenIstance.runtimeState.currentSelectedFeatureId = mainInstance.runtimeState.currentSelectedFeatureId;
                    this.fullscreenIstance.runtimeState.zoom.userSelectedZoom = mainInstance.runtimeState.zoom.userSelectedZoom;
                    this.fullscreenIstance.runtimeState.zoom.isLastZoomFromUser = mainInstance.runtimeState.zoom.isLastZoomFromUser;
                    this.fullscreenIstance.syncSelectedMarkerSource();

                    if(this.fullscreenIstance.options.popupType === 'slider') {
                        let activeFullscreenMarkerId = this.fullscreenIstance.map.getSource('mapbox-selected-marker')?._data?.features?.[0]?.properties?.id ?? null;
                        if(activeFullscreenMarkerId) {
                            this.fullscreenIstance.mapSwiper.isSilent = true;
                            this.fullscreenIstance.setSwiperSlideFromMarker(activeFullscreenMarkerId).finally(() => {
                                setTimeout(() => {
                                    this.fullscreenIstance.mapSwiper.isSilent = false;
                                }, 0);
                            });
                        }
                    }
                })
            } else {
                this.fullscreenIstance.map.setZoom(this.map.getZoom());
                this.fullscreenIstance.map.setCenter(this.map.getCenter());
                this.fullscreenIstance.markers = JSON.parse(JSON.stringify(currentMarkersData));
                this.fullscreenIstance.map.getSource('mapbox-markers').setData(currentMarkersData);
                this.fullscreenIstance.runtimeState.currentSelectedFeatureId = this.runtimeState.currentSelectedFeatureId;
                this.fullscreenIstance.runtimeState.zoom.userSelectedZoom = this.runtimeState.zoom.userSelectedZoom;
                this.fullscreenIstance.runtimeState.zoom.isLastZoomFromUser = this.runtimeState.zoom.isLastZoomFromUser;
                this.fullscreenIstance.syncSelectedMarkerSource();
                this.fullscreenIstance.routePoints = JSON.parse(JSON.stringify(currentRoutePointsMarkersData));
                this.fullscreenIstance.staticRouteFeatures = JSON.parse(JSON.stringify(currentRoutePointsMarkersData.features));
                this.fullscreenIstance.map.getSource('mapbox-track').setData(currentRoutePointsMarkersData);

                if(this.fullscreenIstance.options.popupType === 'slider') {
                    let activeFullscreenMarkerId = this.fullscreenIstance.map.getSource('mapbox-selected-marker')?._data?.features?.[0]?.properties?.id ?? null;
                    if(activeFullscreenMarkerId) {
                        this.fullscreenIstance.mapSwiper.isSilent = true;
                        this.fullscreenIstance.setSwiperSlideFromMarker(activeFullscreenMarkerId).finally(() => {
                            setTimeout(() => {
                                this.fullscreenIstance.mapSwiper.isSilent = false;
                            }, 0);
                        });
                    }
                }
            }

            let fullscreenInstance = this.fullscreenIstance;
            this.fullscreenIstance.on('closeFullscreen', () => {
                let updatedMarkers = JSON.parse(JSON.stringify(fullscreenInstance.map.getSource('mapbox-markers')._data));
                mainInstance.map.getSource('mapbox-markers').setData(updatedMarkers);
                mainInstance.runtimeState.currentSelectedFeatureId = fullscreenInstance.runtimeState.currentSelectedFeatureId;
                mainInstance.runtimeState.zoom.userSelectedZoom = fullscreenInstance.runtimeState.zoom.userSelectedZoom;
                mainInstance.runtimeState.zoom.isLastZoomFromUser = fullscreenInstance.runtimeState.zoom.isLastZoomFromUser;
                mainInstance.syncSelectedMarkerSource();
                mainInstance.map.setZoom(fullscreenInstance.map.getZoom());
                mainInstance.map.setCenter(fullscreenInstance.map.getCenter());

                if(fullscreenInstance.map.getSource('mapbox-track')) {
                    let updatedRoutePointsMarkers = JSON.parse(JSON.stringify(fullscreenInstance.map.getSource('mapbox-track')._data));
                    mainInstance.map.getSource('mapbox-track').setData(updatedRoutePointsMarkers);
                }

                // come per l'apertura, viene reimpostato il marker corrente nello slider
                // viene impedito di lanciare l'evento di slideChange per evitare di modificare lo zoom corrente
                let activeMainMarkerId = fullscreenInstance.map.getSource('mapbox-selected-marker')?._data?.features?.[0]?.properties?.id ?? null;
                if(mainInstance.options.popupType === 'slider' && activeMainMarkerId) {
                    mainInstance.mapSwiper.isSilent = true;
                    mainInstance.setSwiperSlideFromMarker(activeMainMarkerId).finally(() => {
                        setTimeout(() => {
                            mainInstance.mapSwiper.isSilent = false;
                        }, 0)
                    });
                }

            })
        }
        closeFullscreen() {
            if(this.fullscreenIstance) {
                this.fullscreenIstance.mapContainer.hidePopover();
                this.fullscreenIstance.mapContainer.classList.remove('fullscreen-open');
                this.fullscreenIstance.trigger('closeFullscreen');
            } else if (this.mapContainer.classList.contains('fullscreen-open')) {
                this.mapContainer.hidePopover();
                this.mapContainer.classList.remove('fullscreen-open');
                this.trigger('closeFullscreen');
            }
        }
        loadEvents() {
            let self = this;

                        this.mapContainer.addEventListener('click', (event) => {
                if(event.target.tagName?.toLowerCase() === 'a') {
                    let href = event.target.getAttribute('href');
                    let isFullscreenModeActive = self.mapContainer.querySelector('.fullscreen-mode-wrapper.fullscreen-open') !== null;

                    if(isFullscreenModeActive && href.startsWith('#')) {
                        setTimeout(() => {
                            self.closeFullscreen();
                        }, 100)
                    }
                }
            })
        }
        _log() {
                    }
        _warn() {
                    }
        _setupMapboxScripts() {
            this._mapboxGlHtmlScript = document.querySelector('script#mapbox_gl_script');
            if(!this._mapboxGlHtmlScript) {
                this._mapboxGlHtmlScript = document.createElement('script');
                this._mapboxGlHtmlScript.id = 'mapbox_gl_script';
                this._mapboxGlHtmlScript.type = 'text/javascript';
                this._mapboxGlHtmlScript.src = 'https://api.mapbox.com/mapbox-gl-js/v3.32.0/mapbox-gl.js';
                this._mapboxGlHtmlScript.setAttribute('data-cmp-info', '2');
                this._mapboxGlHtmlScript.setAttribute('data-cmp-ab', '2');
            }

            this._languagesPluginHtmlScript = document.querySelector('script#mapbox_gl_languages_plugin_script');
            if(!this._languagesPluginHtmlScript) {
                this._languagesPluginHtmlScript = document.createElement('script');
                this._languagesPluginHtmlScript.id = 'mapbox_gl_languages_plugin_script';
                this._languagesPluginHtmlScript.type = 'text/javascript';
                this._languagesPluginHtmlScript.src = 'https://api.mapbox.com/mapbox-gl-js/plugins/mapbox-gl-language/v1.0.0/mapbox-gl-language.js';
                this._languagesPluginHtmlScript.setAttribute('data-cmp-info', '2');
                this._languagesPluginHtmlScript.setAttribute('data-cmp-ab', '2');
            }

            this._toGeoJsonHtmlScript = document.querySelector('script#mapbox_gpx_to_geojson_script');
            if(!this._toGeoJsonHtmlScript) {
                this._toGeoJsonHtmlScript = document.createElement('script');
                this._toGeoJsonHtmlScript.id = 'mapbox_gpx_to_geojson_script';
                this._toGeoJsonHtmlScript.type = 'text/javascript';
                this._toGeoJsonHtmlScript.src = '/kumbe/minified/js/togeojson.min.js';
            }

            this._chartHtmlScript = document.querySelector('script#mapbox_chart_js_script');
            if(!this._chartHtmlScript) {
                this._chartHtmlScript = document.createElement('script');
                this._chartHtmlScript.id = 'mapbox_chart_js_script';
                this._chartHtmlScript.type = 'text/javascript';
                this._chartHtmlScript.src = 'https://cdn.jsdelivr.net/npm/chart.js';
                this._chartHtmlScript.setAttribute('data-cmp-info', '2');
                this._chartHtmlScript.setAttribute('data-cmp-ab', '2');
            }

            this._cssHtmlLink = document.querySelector('link#mapbox_gl_css_link');
            if(!this._cssHtmlLink) {
                this._cssHtmlLink = document.createElement('link');
                this._cssHtmlLink.id = 'mapbox_gl_css_link';
                this._cssHtmlLink.rel = 'stylesheet';
                this._cssHtmlLink.href = 'https://api.mapbox.com/mapbox-gl-js/v3.32.0/mapbox-gl.css';
            }
        }
        _waitForScript(scriptElement, readyCallback) {
            return new Promise((resolve, reject) => {
                if(readyCallback()) {
                    resolve();
                    return;
                }

                const onLoad = () => {
                    cleanup();
                    resolve();
                };
                const onError = (event) => {
                    cleanup();
                    reject(event);
                };
                const cleanup = () => {
                    scriptElement.removeEventListener('load', onLoad);
                    scriptElement.removeEventListener('error', onError);
                };

                scriptElement.addEventListener('load', onLoad);
                scriptElement.addEventListener('error', onError);
            });
        }
        _getMapboxAssetsPromise() {
            return Promise.all([
                this._waitForScript(this._mapboxGlHtmlScript, () => typeof window.mapboxgl !== 'undefined' || typeof window.K_MAPBOX !== 'undefined'),
                this._waitForScript(this._languagesPluginHtmlScript, () => typeof window.MapboxLanguage !== 'undefined'),
            ]);
        }
        _showMapWhenNeeded() {
            if(typeof this.options.startUpOnClick === 'undefined' || this.options.startUpOnClick) {
                window.addEventListener('click', (event) => {
                    if(event.target.classList.contains('showMap') && (!event.target.dataset.target || event.target.dataset.target === this.mapContainer.id) && getComputedStyle(event.target).display !== 'none') {
                        this.showMap();
                    }
                })
            } else {
                if(document.readyState === 'complete') {
                    this.showMap();
                } else {
                    window.addEventListener('load', (event) => {
                        this.showMap();
                    })
                }
            }
        }
        async loadMap() {
            this._appendMapboxAssets();

            this.isMapboxInitializationPending = true;

            try {
                await this._getMapboxAssetsPromise();

                if(!this.map) {
                    this._setupMapbox();
                }
            } catch (exception) {
                this._warn('Mapbox assets loading failed', exception);
            }

            this.isMapboxInitializationPending = false;
        }
        showMap() {
            if(this.isMapboxLoaded) {
                this._doShowMap();
            } else {
                // il container va comunque mostrato prima per dare a Mapbox lo spazio necessario per il render
                this._doShowMap();
                this.loadMap().then(() => {

                    if(!this.startingZoomLevel) {
                        this.setMapZoom();
                    }
                });
            }
        }
        _doShowMap() {
                        document.querySelector('.map-placeholder')?.classList.add('d-none');
            this.mapContainer?.classList.remove('d-none');

                        if(this.options.isFullscreenOnly && this.mapContainer.hasAttribute('popover')) {
                this.mapContainer.showPopover();
                this.mapContainer.classList.add('fullscreen-open');
            }
        }
        _appendMapboxAssets() {
            if(this.map || this.isMapboxInitializationPending) {
                return;
            }

            if(!document.getElementById(this._mapboxGlHtmlScript.id)) {
                document.head.appendChild(this._mapboxGlHtmlScript);
            }

            if(!document.getElementById(this._languagesPluginHtmlScript.id)) {
                document.head.appendChild(this._languagesPluginHtmlScript);
            }

            if(!document.getElementById(this._cssHtmlLink.id)) {
                document.head.appendChild(this._cssHtmlLink);
            }
        }
        _setupMapbox(options = {}) {
            let self = this;

            /*
             * NB IMPORTANTE!
             * Tutto il plugin Mapbox si basa sulla variabile "mapboxgl" che è generata dagli script di Mapbox importati allo startup (vedi this._mapboxGlHtmlScript)
             * Nel caso in ci sia una pagina che integra una FlexView Outdoor Active, anche questa utilizza mapbox per generare la mappa
             * PROBLEMA: i due mapboxgl vanno in conflitto
             * SOLUZIONE: appena Mapbox viene avviato per questa mappa viene salvata l'API in una variabile separata (K_MAPBOX) e nel codice viene usata quella.
             * In fondo a questo metodo viene effettuato un delete window.mapboxgl in modo che Outdoor Active la valorizzi poi senza ulteriori problemi da 0.
            */
            if(!K_MAPBOX && typeof mapboxgl === 'undefined') {
                this._warn('mapboxgl is not available.');
                return;
            }

            if(!K_MAPBOX) {
                K_MAPBOX = mapboxgl;
            }

            K_MAPBOX.accessToken = '[REDACTED_PUBLIC_MAPBOX_TOKEN]';
            K_MAPBOX.language = 'en';

                        this.map = new K_MAPBOX.Map({
                container: this.mapContainer.querySelector('.kumbe'),                 style: 'mapbox://styles/kumbe/cmg5ah2uh001601sa6obl44rp',
                center: this.startingCenter ?? this.center,                 zoom: this.startingZoomLevel ?? this.zoom,                 fadeDuration: 0
            });

                        if(this.options.allowFullscreen) {
                this.map.addControl(new KMapboxAddFullscreenControl(this));
            }
            if(this.mapContainer.hasAttribute('popover')) {
                this.map.addControl(new KMapboxRemoveFullscreenControl(this));
            }
            if(typeof this.options.navigation === 'undefined' || this.options.navigation) {
                this.map.addControl(new K_MAPBOX.NavigationControl());
            }

            if(typeof markersOnLoad !== 'undefined') {
                if(Array.isArray(markersOnLoad) && markersOnLoad.length) {
                    this.setMarkers(markersOnLoad, false);
                    markersOnLoad = [];
                } else if (typeof markersOnLoad === 'object' && markersOnLoad.hasOwnProperty(this.mapContainer.id) && Array.isArray(markersOnLoad[this.mapContainer.id]) && markersOnLoad[this.mapContainer.id].length) {
                    this.setMarkers(markersOnLoad[this.mapContainer.id], false);
                    delete markersOnLoad[this.mapContainer.id];
                }
            }
            if(typeof routePointsOnLoad !== 'undefined') {
                if(Array.isArray(routePointsOnLoad) && routePointsOnLoad.length){
                    this.staticRouteFeatures = this.staticRouteFeatures.concat(routePointsOnLoad);
                    this.routePoints.features = this.routePoints.features.concat(routePointsOnLoad);
                    routePointsOnLoad = [];
                } else if (typeof routePointsOnLoad === 'object' && routePointsOnLoad.hasOwnProperty(this.mapContainer.id) && Array.isArray(routePointsOnLoad[this.mapContainer.id]) && routePointsOnLoad[this.mapContainer.id].length) {
                    this.staticRouteFeatures = this.staticRouteFeatures.concat(routePointsOnLoad[this.mapContainer.id]);
                    this.routePoints.features = this.routePoints.features.concat(routePointsOnLoad[this.mapContainer.id]);
                    delete routePointsOnLoad[this.mapContainer.id];
                }
            }

            this.map.once('load', () => {
                this._loadMarkerImages()
                    .catch((error) => {
                        this._warn('Marker images loading failed', error);
                    })
                    .finally(() => {
                        const language = new MapboxLanguage();
                        this.map.addControl(language);
                        this.map.setLanguage('en');

                                                this._setupZoomGestures();
                        this.map.doubleClickZoom.enable();

                        this.loadLayers();
                        this.loadEventsListeners();

                        this.map.resize();   //resize per correggere bugs grafici

                        this.isMapboxLoaded = true;

                        this.flushPendingMarkersSourceSync();
                        this.trigger('load');

                        this.setMarkersSwiper();

                        document.dispatchEvent(new CustomEvent('mapboxMapLoaded', {
                            detail: {
                                mapSectionId: this.mapContainer.id,
                                instance: this
                            }
                        }));


                        //se c'è solo un marker ne apre il popup direttamente
                        if (this.markers.features.length === 1) {
                            const coordinates = this.markers.features[0].geometry.coordinates;
                            const properties = this.markers.features[0].properties;

                                                        if(!this.map.isEasing()) {
                                this.addPopup(coordinates, properties);
                            } else {
                                this.map.once('moveend', (e) => {
                                    this.addPopup(coordinates, properties);
                                });
                            }
                        }

                        clearTimeout(this.unclusteredPointsLabelsTimer);
                    });
            });

            delete window.mapboxgl;
        }
        _setupZoomGestures() {
                        if(!this.map) {
                return;
            }

            this.map.scrollZoom.disable();
            this.map.touchZoomRotate.enable();

            const canvasContainer = this.map.getCanvasContainer?.();
            if(!canvasContainer) {
                return;
            }

            if(this._boundCooperativeWheelHandler) {
                canvasContainer.removeEventListener('wheel', this._boundCooperativeWheelHandler, true);
            }

            this._boundCooperativeWheelHandler = (event) => {
                if(event.ctrlKey) {
                    this.map.scrollZoom.enable();
                    return;
                }

                this.map.scrollZoom.disable();
            };

            canvasContainer.addEventListener('wheel', this._boundCooperativeWheelHandler, {
                capture: true,
                passive: true
            });
        }
        _loadMarkerImage(imageName, imageUrl) {
            return new Promise((resolve, reject) => {
                if(this.map.hasImage(imageName)) {
                    resolve();
                    return;
                }

                this.map.loadImage(imageUrl, (error, image) => {
                    if(error) {
                        reject(error);
                        return;
                    }

                    if(!this.map.hasImage(imageName)) {
                        this.map.addImage(imageName, image);
                    }

                    resolve();
                });
            });
        }
        _loadMarkerImages() {
            return Promise.all([
                this._loadMarkerImage('marker-icon', 'https://www.visittrento.it/imgfiles/icons/general/mapbox-marker.png'),
                this._loadMarkerImage('marker-icon-secondary', 'https://www.visittrento.it/imgfiles/icons/general/mapbox-marker.png'),
                this._loadMarkerImage('marker-icon-unselected', 'https://www.visittrento.it/imgfiles/icons/general/mapbox-marker-unselected.png')
            ]);
        }
        _removeUnclusteredPointsLabels() {
            if(!this.options.addUnclusteredPointLabels) {
                return;
            }
            document.querySelectorAll('.k-marker-label').forEach(markerLabel => markerLabel.remove());
        }
        _addUnclusteredPointsLabels() {
            if(!this.map || !this.options.addUnclusteredPointLabels) {
                return;
            }

            this._removeUnclusteredPointsLabels();

            let featuresToLabel = this.map.queryRenderedFeatures('mapbox-markers');

            featuresToLabel.forEach(feature => {
                if(!feature.properties.point_count && feature.properties.title) {
                    const labelElement = document.createElement('div');

                    labelElement.innerText = feature.properties.title;
                    labelElement.classList.add('k-marker-label');

                    if(feature.properties.id === this.runtimeState.currentSelectedFeatureId) {
                        labelElement.style.backgroundColor = '#E6005C';
                        labelElement.style.zIndex = '1';
                    } else {
                        labelElement.style.backgroundColor = '#4b4b4b';
                    }

                    labelElement.style.marginTop = '-45px';

                    labelElement.style.borderRadius = '12px';
                    labelElement.style.padding = '0 10px';
                    labelElement.style.fontWeight = '500';
                    labelElement.style.fontFamily = 'Raleway, sans-serif';
                    labelElement.style.color = '#fff';
                    labelElement.style.maxWidth = '170px';
                    labelElement.style.whiteSpace = 'nowrap';
                    labelElement.style.overflow = 'hidden';
                    labelElement.style.textOverflow = 'ellipsis';
                    labelElement.style.letterSpacing = '0.01em';
                    labelElement.style.cursor = 'pointer';

                    labelElement.addEventListener('click', () => {
                        this.setSwiperSlideFromMarker(feature.properties.id);
                    })

                    labelElement.id = 'unclustered_label_' + feature.properties.id;

                    new K_MAPBOX.Marker(labelElement)
                        .setLngLat(feature.geometry.coordinates)
                        .addTo(this.map);
                }
            });
        }
        _loadRouteLayers() {
            this.map.addSource('mapbox-track', {
                type: 'geojson',
                data: this.routePoints
            });

            this.map.addLayer({
                'id': 'lines',
                'type': 'line',
                'source': 'mapbox-track',
                'layout': {
                    'line-join': 'round',
                    'line-cap': 'round'
                },
                'paint': {
                    'line-color': [
                        'case',
                        ['boolean', ['get', 'kIsSelected'], false],
                        K_MAPBOX_ACTIVE_GPX_COLOR,
                        K_MAPBOX_GPX_COLOR
                    ],
                    'line-width': 4
                }
            });

            this.refreshRouteSource();
        }
        _loadMarkersLayers() {

            let markersOptions = {
                type: 'geojson',
                data: this.markers,
                clusterProperties: {
                    hasSelectedMarkers: [
                        'max',
                        ['case', ['==', ['get', 'priority'], 'primary'], 1, 0]
                    ]
                },
                ...(this.options.markersAsClusters ? this.options.clustersOptions : {})
            };

            if(this.markers.features.length > 1000) {
                this.options.clustersOptions.clusterMaxZoom = 16;
            }

            this.map.addSource('mapbox-markers', markersOptions);
            this.map.addSource('mapbox-selected-marker', {
                type: 'geojson',
                data: this.getEmptyFeatureCollection()
            });

            if(this.options.markersAsClusters){
                //https://docs.mapbox.com/mapbox-gl-js/style-spec/layers/   => TUTTI I TIPI DI LAYER DISPONIBILI
                //aggiunta layer dei cluster
                this.map.addLayer({
                    id: 'clusters',
                    type: 'circle',
                    source: 'mapbox-markers',
                    filter: ['has', 'point_count'],     //searchs for point_count generated by the "point" type in the markers and if the map zoom is less than 13
                    paint: {
                        'circle-color': [
                            'case',
                            ['==', ['get', 'hasSelectedMarkers'], 1],
                            '#00A871',
                            '#00A871'
                        ],
                        'circle-radius': 25
                    }
                });

                this.map.addLayer({
                    id: 'clusters-count',
                    type: 'symbol',
                    source: 'mapbox-markers',
                    filter: ['has', 'point_count'],     //searchs for point_count generated by the "point" type in the markers and if the map zoom is less than 13
                    layout: {
                        'text-field': '{point_count_abbreviated}',
                        'text-font': ['DIN Offc Pro Bold', 'Arial Unicode MS Bold'],
                        'text-size': 13
                    },
                    paint: {
                        'text-color': '#ffffff'
                    }
                });

            }

                        let unclusteredPointsLayerOptions = this.getUnclusteredPointLayerConfiguration();

            if (this.options.addUnclusteredPointLabels) {
                unclusteredPointsLayerOptions.layout['text-field'] = ['get', 'cutTitle'];
                unclusteredPointsLayerOptions.layout['text-size'] = 12;
                unclusteredPointsLayerOptions.layout['text-offset'] = [0, -4];
                unclusteredPointsLayerOptions.layout['text-anchor'] = 'top';
                unclusteredPointsLayerOptions.layout['text-allow-overlap'] = false;
            }
            this.map.addLayer(unclusteredPointsLayerOptions);

            let selectedMarkerLayerOptions = this.getSelectedMarkerLayerConfiguration();
            this.map.addLayer(selectedMarkerLayerOptions);
        }
        getUnclusteredPointLayerConfiguration()
        {
            return {
                id: 'unclustered-points',
                type: 'symbol',
                source: 'mapbox-markers',
                filter: ['!', ['has', 'point_count']],
                layout: {
                                        'icon-image': 'marker-icon-unselected',
                    'icon-size': 0.5,
                    'icon-allow-overlap': false,
                    "icon-ignore-placement": true
                },
                'paint': {
                    'icon-translate': [0, 0]
                },
                'appearances': [
                    {
                        'name': 'selected',
                        'condition': [
                            'boolean',
                            ['feature-state', 'currentlySelected'],
                            false
                        ],
                        'properties': {
                            'icon-image': 'marker-icon'
                        }
                    }
                ]
            };
        }
        getSelectedMarkerLayerConfiguration() {
            let selectedMarkerLayerOptions = {
                id: 'selected-marker',
                type: 'symbol',
                source: 'mapbox-selected-marker',
                layout: {
                    'icon-image': 'marker-icon',
                    'icon-size': 0.5,
                    'icon-allow-overlap': true,
                    'icon-ignore-placement': true
                },
                paint: {
                    'icon-translate': [0, 0]
                }
            };
            if (this.options.addUnclusteredPointLabels) {
                selectedMarkerLayerOptions.layout['text-field'] = ['get', 'cutTitle'];
                selectedMarkerLayerOptions.layout['text-size'] = 12;
                selectedMarkerLayerOptions.layout['text-offset'] = [0, -4];
                selectedMarkerLayerOptions.layout['text-anchor'] = 'top';
                selectedMarkerLayerOptions.layout['text-allow-overlap'] = false;
            }
            return selectedMarkerLayerOptions;
        }
        _load3DLayers() {
            return;
            let layers = this.map.getStyle().layers;
            let labelLayerId = layers.find(l => l.type === 'symbol' && l.layout['text-field']).id;

            this.map.addLayer({
                'id': '3d-buildings',
                'source': 'composite',
                'source-layer': 'building',
                'filter': ['==', 'extrude', 'true'],
                'type': 'fill-extrusion',
                'minzoom': 14,
                'paint': {
                    'fill-extrusion-color': '#1D1D1B',
                                                            'fill-extrusion-height': [
                        "interpolate", ["linear"],
                        ["zoom"],
                        15, 0,
                        15.05, ["get", "height"]
                    ],
                    'fill-extrusion-base': [
                        "interpolate", ["linear"],
                        ["zoom"],
                        15, 0,
                        15.05, ["get", "min_height"]
                    ],
                    'fill-extrusion-opacity': .4
                }
            }, labelLayerId);

        }
        buildHeightProfile() {
            if(!document.getElementById('elevationChart')){
                return;
            }

            let elevationData = this.getRouteCoordinates()
                .map(coordinates => parseInt(coordinates?.[2]))
                .filter(altitude => Number.isFinite(altitude) && altitude > 0);

            if(this.routeProfileChart) {
                this.routeProfileChart.destroy();
                this.routeProfileChart = null;
            }

            if(!elevationData.length) {
                return;
            }

            this.ensureChartIsLoaded().then((ChartLibrary) => {
                if(!ChartLibrary) {
                    return;
                }

                let chartCanvas = document.getElementById('elevationChart');
                if(!chartCanvas) {
                    return;
                }

                let ctx = chartCanvas.getContext('2d');
                this.routeProfileChart = new ChartLibrary(ctx, {
                    type: 'line',
                    data: {
                        labels: Array.from({length: elevationData.length}).map(() => 'h'),
                        datasets: [{
                            label: labels.LBL_PROFILO_ALTIMETRICO,
                            data: elevationData,
                            borderColor: '#00A871',
                            borderWidth: 2,
                            tension: 1,
                            fill: false
                        }]
                    },
                    options: {
                        scales: {
                            x: {
                                ticks: {
                                    color: '#F5EFE9'
                                }
                            }
                        }
                    }
                });
            });
        }
    }
</script>

    <script>
        class KMapbox extends KBaseMapbox
        {
            constructor(mapContainerId, options = {}) {
                super(mapContainerId, options);
            }
        }
    </script>

<script src="https://code.jquery.com/jquery-3.7.0.min.js" integrity="sha256-2Pmvv0kuTBOenSvLm6bvfBSSHrUJ+3A7x6P5Ebd07/g=" crossorigin="anonymous" data-cookieconsent="ignore" data-cmp-ab="2"></script>





                                    
            
                                    
<style>
    #tosc5_cart_btn {
        z-index: 9999;
        width: 50px;
        height: 50px;
        display: block;
        position: fixed;
        bottom: 15px;
        right: 10px;
    }
</style>

    

<div id="tosc5_cart_btn" class="d-none">
    <span id="carrello_feratel" class="carrello-feratel"></span>
</div>

<script data-cookieconsent="ignore" data-cmp-ab="2">
    function toggleToscCart(){
        if(!document.getElementById('tosc5_cart_btn')){
            return;
        }
        // se il tosc ha settato degli elementi nel carrello in sessione mostriamo l'icona del carrello, altrimenti no
        if(typeof(localStorage['deskline/web/_data']) !== 'undefined' && typeof(JSON.parse(localStorage['deskline/web/_data'])['UserContextBase.shoppingList']) !== 'undefined' && JSON.parse(localStorage['deskline/web/_data'])['UserContextBase.shoppingList'].shoppingCarts.length > 0){
            let cartScript = document.createElement('script');
            cartScript.src = 'https://resc.deskline.net/DW5/start///index.js';
            cartScript.type = 'text/javascript';
            document.head.appendChild(cartScript);
            document.getElementById('tosc5_cart_btn').classList.remove('d-none');
        }else{
            document.getElementById('tosc5_cart_btn').classList.add('d-none');
        }
    }

    toggleToscCart();
</script>

    <script defer src="https://web5.deskline.net/dwutility.js"></script>
                
                <script>
            window.addEventListener('load', () => {
                $('body').delegate('.element-detail-link, .tosc5-quick-find-trigger', 'click', function(event) {
                    let elementClassName = $(this).attr('data-class-name') ?? '';
                    console.log('ELEMENT CLASS NAME: ' + elementClassName);
                    event.preventDefault();

                    let linkUrl = $(this).attr('href');
                    let integrationsProviderId = $(this).attr('data-uid');
                    let dateFrom = new Date(localStorage.getItem('dateFrom'));
                    let dateTo = new Date(localStorage.getItem('dateTo'));
                    let occupancies = localStorage.getItem('occupancies');

                    if(!linkUrl || !dateFrom || !dateTo || !occupancies) {
                        window.location.href = linkUrl;
                        return;
                    }

                    try {
                        occupancies = JSON.parse(occupancies);

                        var configurazione = {
                            dateFrom: dateFrom,
                            dateTo: dateTo,
                            dbCode: 'TRN'
                        };
                        if (integrationsProviderId) {
                            configurazione.id = integrationsProviderId;
                        }

                        occupancies.forEach((occupancy, index) => {
                            configurazione['occupancy' + (index + 1)] = {
                                units: 1,
                                adults: occupancy.adultsNumber,
                                children: occupancy.childrenAges,
                            }
                        });

                        if (typeof elementClassName !== "undefined" && elementClassName) {
                            if (elementClassName === "accommodation") {
                                console.log('Quick find ' + 'trento', configurazione);
                                if(integrationsProviderId) {
                                    dw.accommodationDetailQuickFind(
                                        'trento',
                                        configurazione,
                                        function() {
                                            window.location.href = linkUrl;
                                        }
                                    );
                                } else {
                                    dw.accommodationQuickFind(
                                        'trento',
                                        configurazione,
                                        function() {
                                            window.location.href = linkUrl;
                                        }
                                    );
                                }

                            } else if (elementClassName === "experience") {
                                console.log('Quick find ' + 'trento', configurazione);
                                if(integrationsProviderId) {
                                    dw.addServiceDetailQuickFind(
                                        'trento',
                                        configurazione,
                                        function() {
                                            window.location.href = linkUrl;
                                        }
                                    );
                                } else {
                                    dw.addServiceQuickFind(
                                        'trento',
                                        configurazione,
                                        function() {
                                            window.location.href = linkUrl;
                                        }
                                    );
                                }

                            } else if (elementClassName === "offer") {
                                console.log('Quick find ' + 'trento', configurazione);
                                dw.eventQuickFind(
                                    'trento',
                                    configurazione,
                                    function() {
                                        window.location.href = linkUrl;
                                    }
                                );
                            } else if (elementClassName === "event") {
                                console.log('Quick find ' + 'trento', configurazione);
                                dw.eventQuickFind(
                                    'trento',
                                    configurazione,
                                    function() {
                                        window.location.href = linkUrl;
                                    }
                                );
                            } else {
                                console.log('Quick find non supportato per l\'elemento: ' + elementClassName)
                                window.location.href = linkUrl;
                            }
                        } else {
                            // fallback accommodation
                            console.log('data-class-name non impostato sulla card selezionata');
                            if(integrationsProviderId) {
                                dw.accommodationDetailQuickFind(
                                    'trento',
                                    configurazione,
                                    function () {
                                        window.location.href = linkUrl;
                                    }
                                );
                            } else {
                                dw.accommodationQuickFind(
                                    'trento',
                                    configurazione,
                                    function () {
                                        window.location.href = linkUrl;
                                    }
                                );
                            }
                        }



                    } catch(e) {
                        console.log("js_tosc5: errore accommodationDetailQuickFind")
                        console.log(e);
                        window.location.href = linkUrl;
                    }
                })
            })
        </script>
