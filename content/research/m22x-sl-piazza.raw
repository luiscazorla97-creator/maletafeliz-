(function () {
	var iconUrl = "https:\/\/cultura.comune.salerno.it\/wp-content\/mu-plugins\/assets\/cookie-consent-revisit-icon.png";
	function applyIcon() {
		var img = document.querySelector('[data-cky-tag="revisit-consent"] .cky-btn-revisit img');
		if (img && img.getAttribute('src') !== iconUrl) {
			img.setAttribute('src', iconUrl);
			img.setAttribute('alt', 'Preferenze cookie');
		}
	}
	applyIcon();
	document.addEventListener('cookieyes_consent_update', applyIcon);
	if (window.MutationObserver) {
		new MutationObserver(applyIcon).observe(document.documentElement, { childList: true, subtree: true });
	}
})();
