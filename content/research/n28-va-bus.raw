age/webp\",\"filesize\":259230,\"filename\":\"343401_exp-r-valladolid-1400x933.webp\"},\"xlarge\":{\"url\":\"/cms/api/media/file/343401_exp-r-valladolid-1920x1280.webp?prefix=tenant-103\",\"width\":1920,\"height\":1280,\"mimeType\":\"image/webp\",\"filesize\":476540,\"filename\":\"343401_exp-r-valladolid-1920x1280.webp\"},\"og\":{\"url\":\"/cms/api/media/file/343401_exp-r-valladolid-1200x630.webp?prefix=tenant-103\",\"width\":1200,\"height\":630,\"mimeType\":\"image/webp\",\"filesize\":143426,\"filename\":\"343401_exp-r-valladolid-1200x630.webp\"}},\"fullUrl\":\"https://international.ado.com.mx/cms/api/media/file/343401_exp-r-valladolid.jpg\",\"_resolvedLocale\":\"es-MX\"},\"bookingResolved\":{\"resolvedTemplateUrl\":\"\"}}},{\"type\":\"Text\",\"props\":{\"id\":\"Text-valladolid-in\",\"text\":\"\u003ch2\u003eUna sola terminal ADO en Valladolid\u003c/h2\u003e\u003cp\u003eTodos los autobuses ADO que se venden en este sitio usan \u003cstrong\u003eValladolid C.46\u003c/strong\u003e, la terminal ADO de la Calle 46 #197, en el centro de Valladolid, a unos 400 m (5 minutos a pie) del parque principal y de la iglesia de San Servacio. Tu boleto la muestra como «Valladolid C.46».\u003c/p\u003e\u003cp\u003eLa \u003cstrong\u003eestación del Tren Maya\u003c/strong\u003e es otro lugar, a unos 6 km al norte del centro. Es para el tren, no para los autobuses ADO, así que revisa tu boleto antes de salir.\u003c/p\u003e\",\"bookingResolved\":{\"resolvedText\":\"\u003ch2\u003eUna sola terminal ADO en Valladolid\u003c/h2\u003e\u003cp\u003eTodos los autobuses ADO que se venden en este sitio usan \u003cstrong\u003eValladolid C.46\u003c/strong\u003e, la terminal ADO de la Calle 46 #197, en el centro de Valladolid, a unos 400 m (5 minutos a pie) del parque principal y de la iglesia de San Servacio. Tu boleto la muestra como «Valladolid C.46».\u003c/p\u003e\u003cp\u003eLa \u003cstrong\u003eestación del Tren Maya\u003c/strong\u003e es otro lugar, a unos 6 km al norte del centro. Es para el tren, no para los autobuses ADO, así que revisa tu boleto antes de salir.\u003c/p\u003e\",\"hasUnresolvedBooking\":false}}}],\"id\":\"Grid-valladolid-in\",\"rows\":{\"sm\":1,\"base\":1},\"width\":\"\",\"rowGap\":\"var(--mantine-spacing-lg)\",\"styles\":{\"margin\":{\"top\":\"sm\",\"left\":\"sm\",\"unit\":\"var(--)\",\"right\":\"sm\",\"bottom\":\"sm\",\"linked\":true},\"padding\":{\"top\":\"sm\",\"left\":\"sm\",\"unit\":\"var(--)\",\"right\":\"sm\",\"bottom\":\"sm\",\"linked\":true}},\"columns\":{\"sm\":2,\"base\":1},\"autoFlow\":\"row\",\"disabled\":false,\"columnGap\":\"var(--mantine-spacing-lg)\"}}],\"id\":\"Container-valladolid-inc\",\"wrap\":\"no-wrap\",\"width\":\"\",\"rowGap\":\"var(--mantine-spacing-sm)\",\"styles\":{\"margin\":{\"top\":\"20px\",\"left\":\"auto\",\"unit\":\"manual\",\"right\":\"auto\",\"bottom\":\"20px\",\"linked\":false},\"padding\":{\"top\":2,\"left\":2,\"unit\":\"rem\",\"right\":2,\"bottom\":2,\"linked\":true},\"boxShadow\":\"0 4px 8px #0d0b2312\",\"background\":\"var(--mantine-color-white)\",\"borderRadius\":\"20px\"},\"disabled\":false,\"columnGap\":\"var(--mantine-spacing-sm)\",\"direction\":\"column\",\"alignItems\":\"start\",\"gridRowSpan\":{\"sm\":1,\"base\":1},\"contentWidth\":\"boxed\",\"gridColumnSpan\":{\"sm\":1,\"base\":1},\"justifyContent\":\"start\"}}],\"id\":\"Container-valladolid-in\",\"wrap\":\"no-wrap\",\"width\":\"\",\"rowGap\":\"var(--mantine-spacing-sm)\",\"styles\":{},\"disabled\":false,\"columnGap\":\"var(--mantine-spacing-sm)\",\"direction\":\"column\",\"alignItems\":\"start\",\"gridRowSpan\":{\"sm\":1,\"base\":1},\"contentWidth\":\"boxed\",\"gridColumnSpan\":{\"sm\":1,\"base\":1},\"justifyContent\":\"start\"}},{\"type\":\"Container\",\"props\":{\"children\":[{\"type\":\"Container\",\"props\":{\"children\":[{\"type\":\"Text\",\"props\":{\"id\":\"Text-valladolid-desth\",\"text\":\"\u003ch2\u003eAutobuses ADO directos desde Valladolid\u003c/h2\u003e\",\"bookingResolved\":{\"resolvedText\":\"\u003ch2\u003eAutobuses ADO di