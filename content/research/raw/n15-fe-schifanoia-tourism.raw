<div class="col-xs-12 col-sm-6 map-container">
<div class="">
<div class="real_google_map_place"><input type="hidden" id="place-id-indirizzo" name="Pagine[indirizzo]" value="ChIJyYSCd0ROfkcRXLqaW3ysh3U"><input type="text" id="pac-input-indirizzo" class="controls hidden" name="tmp-pac-input_indirizzo" value=""><div id="map-loader-indirizzo" class="map-loader">Loading map<br /><div id="progress-indirizzo" class="progress"><div class="progress-bar progress-bar-striped active" role="progressbar" aria-valuenow="100" aria-valuemin="0" aria-valuemax="100" style="width:100%"></div></div></div><div id="map-indirizzo" class="map" data-attribute="indirizzo"></div></div>
<div class="fake_google_map_place hide locked"><img style="width: 100%;" src="/assets/1ca9e6b31b9cf974a974088b1c241b39/img/map_place.png" /></div>
</div>
