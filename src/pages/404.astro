---
import Layout from '../layouts/Layout.astro';
---

<Layout lang="es" title="404 · Ruta no encontrada / Page not found" noindex showAdvertisement={false}>
  <section class="shell not-found">
    <img src="/brand/logo.svg" width="95" height="95" alt="" />
    <span class="eyebrow orange">404</span>
    <h1>Nos salimos de la ruta.</h1>
    <p>
      Esta página no existe. <span lang="en">This page does not exist.</span>
    </p>
    <a class="button button-orange" href="/es/">
      Volver al inicio
    </a>{' '}
    <a class="button button-dark" href="/en/" lang="en">
      Back to home
    </a>
  </section>
</Layout>
