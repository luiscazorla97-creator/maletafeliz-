                <section id="mosaico" class="bg-brand-cream font-sans w-full px-6 sm:px-10 lg:px-16 py-14 lg:py-20 scroll-mt-20">
    <div class="max-w-7xl mx-auto">

        
        <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-5 mb-10">
            <div>
                <div class="w-16 h-1 bg-brand-gold mb-5"></div>
                <h2 class="text-3xl md:text-4xl lg:text-5xl font-bold text-brand-burgundy leading-tight">Explore Jarocho Culture</h2>
                <p class="mt-3 text-gray-700 max-w-xl">Everything that makes the port unique, organized in a mosaic to discover at your own pace.</p>
            </div>
            <a href="#agenda" class="shrink-0 px-7 py-3.5 rounded-full border border-brand-muted text-brand-burgundy font-semibold uppercase tracking-widest text-sm hover:bg-brand-muted/15 transition-all text-center">
                View cultural agenda
            </a>
        </div>

        
        <div class="grid grid-cols-2 lg:grid-cols-6 auto-rows-[260px] gap-4">

            
            <div data-ms-field="bento.mesas.image" data-ms-media class="group relative col-span-2 row-span-2 lg:col-span-4 rounded-3xl overflow-hidden shadow-xl">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image:url('https://descubre.veracruzmunicipio.gob.mx/module-assets/cultura/images/Cultura/MesasCallejones.jpg')"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-brand-burgundy-deep/95 via-brand-burgundy-deep/40 via-40% to-transparent"></div>
                <div class="absolute inset-0 p-5 sm:p-7 flex flex-col justify-end text-white">
                    <span class="text-[10px] sm:text-[11px] font-bold uppercase tracking-[0.18em] text-brand-gold mb-1"></span>
                    <h3 class="text-xl sm:text-2xl lg:text-3xl font-extrabold leading-tight"></h3>
                    <p class="mt-1.5 text-xs sm:text-sm text-brand-cream/90 max-w-lg leading-relaxed"></p>
                </div>
            </div>

            
            <button type="button" onclick="abrirModalHeroico()" class="group text-left col-span-2 bg-gradient-to-br from-[#5C113C] via-[#3F0B29] to-[#230616] rounded-3xl p-6 flex flex-col justify-between text-white shadow-xl border-2 border-[#DDB304]/40 hover:border-[#DDB304] hover:scale-[1.02] transition-all duration-300 relative overflow-hidden cursor-pointer">
                
                <div class="absolute -right-8 -bottom-8 w-36 h-36 bg-[#DDB304]/10 rounded-full blur-xl pointer-events-none"></div>

                <div>
                    <div class="flex items-center justify-between mb-2">
                        <span class="text-[11px] font-extrabold uppercase tracking-[0.2em] text-[#DDB304]" data-ms-field="bento.historia.k">Orgullo e Identidad</span>
                        <span class="w-6 h-6 rounded-full bg-[#DDB304]/20 flex items-center justify-center text-[#DDB304] text-xs">
                            <i class="pi pi-shield"></i>
                        </span>
                    </div>
                    <div class="flex items-baseline gap-2 mt-1">
                        <b class="text-4xl sm:text-5xl font-black text-[#DDB304] leading-none fuente-titulos" data-ms-field="bento.historia.number">4 Veces</b>
                        <span class="text-xl font-extrabold text-white fuente-titulos" data-ms-field="bento.historia.label">Heroica</span>
                    </div>
                    <p class="mt-2 text-xs text-white/85 leading-relaxed font-light">
                        Conoce las 4 gestas históricas que consolidaron la soberanía y memoria patria en nuestro puerto.
                    </p>
                </div>

                <div class="mt-4 pt-3 border-t border-white/10 flex items-center justify-between text-xs font-bold text-[#DDB304]">
                    <span>Explorar gestas históricas</span>
                    <i class="pi pi-arrow-right group-hover:translate-x-1 transition-transform"></i>
                </div>
            </button>

            
            <div data-ms-field="bento.recorrido.image" data-ms-media class="group relative col-span-2 rounded-3xl overflow-hidden shadow-xl">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image:url('https://descubre.veracruzmunicipio.gob.mx/module-assets/cultura/images/Cultura/Recorrido.jpg')"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-brand-burgundy-deep/95 via-brand-burgundy-deep/60 via-35% to-transparent"></div>
                <div class="absolute inset-0 p-4 sm:p-5 flex flex-col justify-end text-white">
                    <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-brand-gold mb-0.5"></span>
                    <h3 class="text-sm sm:text-base font-extrabold leading-tight"></h3>
                    <p class="mt-1 text-[11px] sm:text-xs text-brand-cream/90 leading-tight"></p>
                </div>
            </div>

            
            <div data-ms-field="bento.ajedrez.image" data-ms-media class="group relative col-span-2 lg:col-span-3 rounded-3xl overflow-hidden shadow-xl">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image:url('https://descubre.veracruzmunicipio.gob.mx/module-assets/cultura/images/Cultura/Ajedrez.jpg')"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-brand-burgundy-deep/95 via-brand-burgundy-deep/60 via-35% to-transparent"></div>
                <div class="absolute inset-0 p-4 sm:p-5 flex flex-col justify-end text-white">
                    <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-brand-gold mb-0.5"></span>
                    <h3 class="text-base sm:text-lg font-extrabold leading-tight"></h3>
                    <p class="mt-1 text-xs sm:text-sm text-brand-cream/90 leading-snug"></p>
                </div>
            </div>

            
            <a href="https://descubre.veracruzmunicipio.gob.mx/cultura/conocenos" class="group col-span-2 lg:col-span-3 rounded-3xl p-6 bg-brand-cream-dim ring-1 ring-brand-muted/40 flex flex-col justify-end hover:-translate-y-1 transition-transform shadow-sm">
                <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-brand-muted mb-1.5" data-ms-field="bento.museos.k">Museums</span>
                <h3 class="text-xl font-extrabold text-brand-burgundy leading-tight">State Museum Network</h3>
                <p class="mt-1.5 text-sm text-gray-600">From colonial ramparts to contemporary art galleries.</p>
                <span class="mt-3 text-xs font-bold uppercase tracking-widest text-brand-burgundy flex items-center gap-2">Explore venues <i class="pi pi-arrow-right text-[10px]"></i></span>
            </a>

            
            <div data-ms-field="bento.danzon.image" data-ms-media class="group relative col-span-2 rounded-3xl overflow-hidden shadow-xl">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image:url('https://descubre.veracruzmunicipio.gob.mx/module-assets/cultura/images/Cultura/Danzon.jpg')"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-brand-burgundy-deep/95 via-brand-burgundy-deep/60 via-35% to-transparent"></div>
                <div class="absolute inset-0 p-4 sm:p-5 flex flex-col justify-end text-white">
                    <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-brand-gold mb-0.5"></span>
                    <h3 class="text-sm sm:text-base font-extrabold leading-tight"></h3>
                    <p class="mt-1 text-[11px] sm:text-xs text-brand-cream/90 leading-tight"></p>
                </div>
            </div>

            
            <div data-ms-field="bento.honores.image" data-ms-media class="group relative col-span-2 rounded-3xl overflow-hidden shadow-xl">
                <div class="absolute inset-0 bg-cover bg-center transition-transform duration-500 group-hover:scale-105" style="background-image:url('https://descubre.veracruzmunicipio.gob.mx/module-assets/cultura/images/Cultura/Honores.jpg')"></div>
                <div class="absolute inset-0 bg-gradient-to-t from-brand-burgundy-deep/95 via-brand-burgundy-deep/60 via-35% to-transparent"></div>
                <div class="absolute inset-0 p-4 sm:p-5 flex flex-col justify-end text-white">
                    <span class="text-[10px] font-bold uppercase tracking-[0.18em] text-brand-gold mb-0.5"></span>
                    <h3 class="text-sm sm:text-base font-extrabold leading-tight"></h3>
                    <p class="mt-1 text-[11px] sm:text-xs text-brand-cream/90 leading-tight"></p>
                </div>
            </div>

            
            <a href="#agenda" class="group col-span-2 rounded-3xl p-6 bg-brand-cream-dim ring-1 ring-brand-muted/40 flex flex-col justify-end hover:-translate-y-1 transition-transform shadow-sm">
                <span class="text-[11px] font-bold uppercase tracking-[0.18em] text-brand-muted mb-1.5">Agenda</span>
                <h3 class="text-lg font-extrabold text-brand-burgundy leading-tight">Events &amp; Activities</h3>
                <span class="mt-3 text-xs font-bold uppercase tracking-widest text-brand-burgundy flex items-center gap-2">View calendar <i class="pi pi-arrow-right text-[10px]"></i></span>
            </a>

        </div>
    </div>
</section>
                                            <div class="bg-brand-cream py-8 lg:py-10">
    <div class="greca-sep" role="presentation" aria-hidden="true"></div>
</div>
                
                <section id="agenda" class="bg-gradient-to-b from-brand-cream to-brand-cream-dim w-full px-6 sm:px-10 lg:px-16 py-14 lg:py-20 scroll-mt-20">
    <div class="max-w-7xl mx-auto">
        <style>
        .av-box{position:relative;overflow:hidden;background:#5C113C;border-radius:16px;padding:22px 22px 18px;box-shadow:0 18px 40px rgba(42,20,32,.28);font-family:'Montserrat',ui-sans-serif,system-ui,-apple-system,'Segoe UI',Roboto,Helvetica,Arial,sans-serif}
        .av-box::before{content:"";position:absolute;inset:0;background:radial-gradient(120% 100% at 100% 0,rgba(221,179,4,.10),transparent 55%);pointer-events:none}
        .av-head{position:relative;z-index:2;display:flex;align-items:flex-start;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-bottom:22px;padding:0 2px}
        .av-head-l{display:flex;align-items:flex-start;gap:14px;min-width:0;flex:1 1 320px}
        .av-ico{flex-shrink:0;width:46px;height:46px;border-radius:13px;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.1);border:1px solid rgba(255,255,255,.18);color:var(--av-acento,#B19657);box-shadow:0 6px 16px rgba(0,0,0,.18)}
        .av-ico svg{width:24px;height:24px}
        .av-h2{margin:0;color:#fff;font-size:22px;font-weight:800;letter-spacing:.05em;text-transform:uppercase;line-height:1.15;text-shadow:0 2px 10px rgba(0,0,0,.25)}
        @media (min-width:768px){.av-h2{font-size:25px}}
        .av-sub{margin:6px 0 0;color:rgba(255,255,255,.84);font-size:13.5px;font-weight:500;line-height:1.45;max-width:640px}
        .av-live-clock{display:inline-flex;align-items:center;gap:8px;margin-top:10px;padding:4px 12px 4px 8px;border-radius:999px;background:rgba(0,0,0,.22);border:1px solid rgba(255,255,255,.18);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);box-shadow:0 4px 14px rgba(0,0,0,.2)}
        .av-clock-badge{display:inline-flex;align-items:center;gap:5px;padding:2px 7px;border-radius:999px;background:color-mix(in srgb,var(--av-acento,#DDB304) 25%,transparent);border:1px solid color-mix(in srgb,var(--av-acento,#DDB304) 50%,transparent);color:var(--av-acento,#DDB304);font-size:9.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase}
        .av-clock-dot{width:6px;height:6px;border-radius:50%;background:var(--av-acento,#DDB304);box-shadow:0 0 8px var(--av-acento,#DDB304);animation:av-pulse 2s ease-in-out infinite}
        @keyframes av-pulse{0%,100%{opacity:1;transform:scale(1)}50%{opacity:.35;transform:scale(.75)}}
        .av-clock-text{color:rgba(255,255,255,.94);font-size:12px;font-weight:600;letter-spacing:.01em}
        .av-clock-time{color:#fff;font-weight:800;font-size:11.5px;padding:2px 7px;border-radius:6px;background:rgba(255,255,255,.14);border:1px solid rgba(255,255,255,.12);letter-spacing:.04em;font-variant-numeric:tabular-nums}
        .av-head-r{display:flex;align-items:center;gap:12px;flex-wrap:wrap}
        .av-pause{display:inline-flex;align-items:center;gap:7px;padding:8px 16px;border-radius:999px;border:1.5px solid #DDB304;background:rgba(221,179,4,0.25);color:#DDB304;font-size:11.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;cursor:pointer;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);box-shadow:0 4px 14px rgba(0,0,0,0.25),0 0 10px rgba(221,179,4,0.2);transition:all .25s ease}
        .av-pause:hover{background:#DDB304;color:#230616;border-color:#fff;transform:translateY(-1px);box-shadow:0 6px 18px rgba(221,179,4,0.45)}
        .av-pause svg{width:14px;height:14px}
        .av-more{color:#DDB304;font-size:12.5px;font-weight:800;text-decoration:none;display:inline-flex;align-items:center;gap:6px;white-space:nowrap;transition:color .2s}
        .av-more:hover{color:#fff}
        .av-more svg{width:14px;height:14px}

        .av-month-selector{display:inline-flex;align-items:center;justify-content:center;gap:6px;padding:5px 12px;border-radius:999px;border:1.5px solid #DDB304;background:rgba(221,179,4,0.25);color:#DDB304;backdrop-filter:blur(8px);-webkit-backdrop-filter:blur(8px);box-shadow:0 4px 14px rgba(0,0,0,0.25),0 0 10px rgba(221,179,4,0.2)}
        .av-month-btn{display:inline-flex;align-items:center;justify-content:center;width:24px;height:24px;border-radius:50%;border:none;background:rgba(221,179,4,0.35);color:#DDB304;cursor:pointer;transition:all .25s ease;flex-shrink:0}
        .av-month-btn:hover{background:#DDB304;color:#230616;transform:scale(1.08)}
        .av-month-btn svg{width:14px;height:14px}
        .av-month-text{color:#DDB304;font-size:12.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;padding:0 8px;min-width:120px;text-align:center;white-space:nowrap;text-shadow:0 1px 3px rgba(0,0,0,0.5);display:inline-block}

        .av-carousel{position:relative;z-index:2;min-height:120px}
        .av-viewport{overflow:hidden;border-radius:12px;position:relative}
        .av-track{display:flex;gap:16px;transition:transform .5s cubic-bezier(.22,.61,.36,1);will-change:transform}
        .av-slot{flex:0 0 100%;max-width:100%;min-width:0}
        @media (min-width:768px){.av-slot{flex:0 0 calc(33.333% - 11px);max-width:calc(33.333% - 11px)}}

        .av-card{display:flex;flex-direction:column;height:378px;background:#F4F0E9;border-radius:14px;overflow:hidden;border:1px solid rgba(221,179,4,.22);box-shadow:0 8px 20px rgba(0,0,0,.18)}
        .av-cover{position:relative;height:198px;flex-shrink:0;overflow:hidden}
        .av-img{width:100%;height:100%;object-fit:cover;transition:transform .7s ease}
        .av-card:hover .av-img{transform:scale(1.06)}
        .av-ph{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;background:#5C113C}
        .av-ph::after{content:"";position:absolute;inset:0;background:radial-gradient(130% 120% at 20% 0,rgba(255,255,255,.16),transparent 55%)}
        .av-ph svg{width:56px;height:56px;color:rgba(255,255,255,.42)}
        .av-veil{position:absolute;inset:0;background:linear-gradient(to top,rgba(20,7,14,.42),rgba(20,7,14,0) 52%)}
        .av-date{position:absolute;top:11px;left:11px;padding:6px 10px;border-radius:12px;text-align:center;line-height:1;background:rgba(28,10,20,.5);border:1px solid rgba(255,255,255,.24);backdrop-filter:blur(6px);-webkit-backdrop-filter:blur(6px);color:#fff}
        .av-date b{display:block;font-size:20px;font-weight:800;color:#DDB304}
        .av-date span{font-size:9px;font-weight:700;letter-spacing:.16em}
        .av-cat{position:absolute;bottom:11px;left:11px;max-width:calc(100% - 22px);padding:4px 9px;border-radius:999px;font-size:10px;font-weight:700;letter-spacing:.05em;text-transform:uppercase;color:#fff;text-shadow:0 1px 2px rgba(0,0,0,.55);box-shadow:0 2px 6px rgba(0,0,0,.2);overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
        .av-hoy{position:absolute;top:12px;right:11px;padding:3px 9px;border-radius:999px;background:#DDB304;color:#3a2e05;font-size:9px;font-weight:800;letter-spacing:.1em;box-shadow:0 2px 6px rgba(0,0,0,.25)}
        .av-body{padding:15px 16px;display:flex;flex-direction:column;justify-content:space-between;flex-grow:1}
        .av-title{margin:0 0 7px;color:#5C113C;font-size:15.5px;font-weight:700;line-height:1.22;display:-webkit-box;-webkit-line-clamp:2;-webkit-box-orient:vertical;overflow:hidden}
        .av-place{display:flex;align-items:center;gap:6px;color:#6b6b6b;font-size:12px;font-weight:500;line-height:1.3}
        .av-place svg{width:13px;height:13px;flex-shrink:0;color:#B19657}
        .av-place span{overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
        .av-foot{margin-top:12px;padding-top:11px;border-top:1px solid #eadfe6;display:flex;align-items:center;justify-content:space-between;gap:10px}
        .av-time{display:flex;align-items:center;gap:6px;color:#7a7a7a;font-size:11px;font-weight:600}
        .av-time svg{width:12px;height:12px;color:#B19657}
        .av-cost{color:#B19657;font-size:11.5px;font-weight:800;letter-spacing:.03em;white-space:nowrap}

        .av-nav{position:absolute;top:99px;transform:translateY(-50%);width:36px;height:36px;border-radius:50%;border:none;display:flex;align-items:center;justify-content:center;background:var(--av-acento,#B19657);color:#fff;cursor:pointer;box-shadow:0 6px 14px rgba(0,0,0,.25);opacity:0;transition:opacity .25s,background .2s,transform .2s;z-index:5}
        .av-carousel:hover .av-nav{opacity:1}
        .av-nav:hover{background:#fff;color:#5C113C}
        .av-nav svg{width:18px;height:18px}
        .av-nav.l{left:-8px}
        .av-nav.r{right:-8px}
        .av-dots{display:flex;justify-content:center;gap:7px;margin-top:16px;position:relative;z-index:2}
        .av-dot{height:8px;width:8px;border:none;padding:0;border-radius:999px;background:rgba(255,255,255,.32);cursor:pointer;transition:width .3s,background .3s}
        .av-dot:hover{background:rgba(255,255,255,.6)}
        .av-dot.on{width:24px;background:var(--av-acento,#B19657)}
        .av-empty{color:rgba(244,240,233,.8);text-align:center;padding:36px 10px;font-size:14px;font-weight:500;position:relative;z-index:2}
        @media (prefers-reduced-motion:reduce){.av-track,.av-img,.av-nav,.av-dot{transition:none}}
        @media (max-width:767px){.av-nav{display:none}}

        .av-viewbtn{font-weight:800}
        .av-cal{position:relative;z-index:2;background:#F4F0E9;border-radius:14px;padding:16px 16px 14px;border:1px solid rgba(221,179,4,.22)}
        .av-cal-head{display:flex;align-items:center;justify-content:center;gap:16px;margin-bottom:14px}
        .av-cal-nav{width:32px;height:32px;flex-shrink:0;border-radius:999px;border:none;background:var(--av-acento,#B19657);color:#fff;display:flex;align-items:center;justify-content:center;cursor:pointer;transition:filter .2s}
        .av-cal-nav:hover{filter:brightness(1.08)}
        .av-cal-nav svg{width:15px;height:15px}
        .av-cal-mo{font-size:16.5px;font-weight:800;color:#5C113C;min-width:158px;text-align:center;letter-spacing:.01em}
        .av-cal-wd{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin-bottom:7px}
        .av-cal-wd span{text-align:center;font-size:10px;font-weight:700;color:#b0a3ab;letter-spacing:.1em}
        .av-cal-grid{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;grid-auto-rows:94px}
        .av-cal-cell{border-radius:10px;border:1px solid #efe7ec;background:#fff;padding:6px 6px 5px;display:flex;flex-direction:column;gap:3px;overflow:hidden;transition:border-color .15s,box-shadow .15s}
        .av-cal-cell.dim{background:#f7f2f5;border-color:transparent}
        .av-cal-cell.has{cursor:pointer}
        .av-cal-cell.has:hover{border-color:var(--av-acento,#B19657);box-shadow:0 3px 10px rgba(92,17,60,.10)}
        .av-cal-cell.sel{border-color:var(--av-acento,#B19657);box-shadow:0 0 0 1.5px var(--av-acento,#B19657)}
        .av-cal-cell.today{background:linear-gradient(145deg, #FFFDF5, #FFF7DC) !important;border:2px solid #DDB304 !important;box-shadow:0 4px 18px rgba(221,179,4,.4),inset 0 0 0 1px rgba(221,179,4,.2) !important;position:relative;z-index:3}
        .av-cal-top-row{display:flex;align-items:center;justify-content:space-between;width:100%;margin-bottom:2px}
        .av-cal-hoy-chip{padding:2px 6px;border-radius:999px;background:linear-gradient(135deg, #DDB304, #C79A00);color:#230616;font-size:8.5px;font-weight:800;letter-spacing:.08em;text-transform:uppercase;box-shadow:0 2px 6px rgba(221,179,4,.4);border:1px solid rgba(255,255,255,.6);line-height:1}
        .av-cal-dn{font-size:11.5px;font-weight:700;color:#8a7d84;align-self:flex-start;min-width:20px;height:20px;display:flex;align-items:center;justify-content:center}
        .av-cal-cell.dim .av-cal-dn{color:#cabfc6}
        .av-cal-cell.today .av-cal-dn{background:linear-gradient(135deg, #DDB304, #B19657) !important;color:#230616 !important;font-weight:900 !important;font-size:12px !important;border-radius:50%;box-shadow:0 2px 6px rgba(221,179,4,.5);width:22px;height:22px}
        .av-cal-ev{padding:2px 6px;border-radius:4px;border-left:3px solid var(--c,#5C113C);background:color-mix(in srgb,var(--c,#5C113C) 13%,#fff);overflow:hidden}
        .av-cal-ev .t{display:block;font-size:10px;font-weight:600;color:#4a3f46;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;line-height:1.45}
        .av-cal-more{font-size:9.5px;color:#a89aa2;font-weight:700;padding-left:3px}
        .av-cal-day{margin-top:14px;border-top:1px solid #eadfe6;padding-top:14px;display:flex;flex-direction:column;gap:8px}
        .av-cal-day h4{margin:0 0 2px;font-size:13.5px;color:#5C113C;font-weight:800}
        .av-cal-day h4 .c{color:#b0a3ab;font-weight:600}
        .av-cal-di{display:flex;align-items:center;gap:12px;background:#fff;border:1px solid #efe7ec;border-left:3px solid var(--c,#5C113C);border-radius:14px;padding:10px 13px}
        .av-cal-di .info{min-width:0;flex:1}
        .av-cal-di h5{margin:0 0 3px;font-size:13.5px;color:#2f2530;font-weight:700;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
        .av-cal-di .mr{font-size:11px;color:#7a7a7a;display:flex;gap:14px;flex-wrap:wrap}
        .av-cal-di .mr span{display:flex;align-items:center;gap:5px;min-width:0}
        .av-cal-di .mr svg{width:11px;height:11px;flex-shrink:0;color:#B19657}
        .av-cal-di .cost{font-size:11px;font-weight:800;color:#B19657;white-space:nowrap;flex-shrink:0}
        .av-cal-thumb{width:56px;height:56px;border-radius:10px;overflow:hidden;flex-shrink:0;position:relative;margin-left:4px;border:1px solid rgba(0,0,0,0.08)}
        .av-cal-thumb-img{width:100%;height:100%;object-fit:cover}
        .av-cal-thumb-ph{width:100%;height:100%;display:flex;align-items:center;justify-content:center;color:rgba(255,255,255,0.7);position:relative}
        .av-cal-thumb-ph::after{content:"";position:absolute;inset:0;background:radial-gradient(130% 120% at 20% 0,rgba(255,255,255,.16),transparent 55%)}
        .av-cal-thumb-ph svg{width:22px;height:22px;color:rgba(255,255,255,.7)}
        @media (max-width:520px){.av-cal-grid{grid-auto-rows:56px}.av-cal-ev,.av-cal-more{display:none}.av-cal-cell.has::after{content:"";width:6px;height:6px;border-radius:50%;background:var(--av-acento,#B19657);margin:2px auto 0}.av-cal-di{flex-wrap:wrap}.av-cal-di .mr{flex-direction:column;gap:3px}}

        /* Lo clicable: tarjeta, fila del día y chip del calendario abren la
           ventana de detalle (agenda::portal.evento-modal, incluida abajo). */
        .av-card { cursor: pointer; }
        .av-cal-di { cursor: pointer; transition: transform .2s, box-shadow .2s; }
        .av-cal-di:hover { transform: translateY(-2px); box-shadow: 0 4px 14px rgba(0,0,0,.12); }
        .av-cal-ev { cursor: pointer; transition: opacity .2s; }
        .av-cal-ev:hover { opacity: .85; }

        .av-card-more {
            display: flex !important;
            flex-direction: column !important;
            align-items: center !important;
            justify-content: center !important;
            text-align: center !important;
            padding: 24px !important;
            background: linear-gradient(145deg, rgba(92, 17, 60, 0.95), rgba(45, 6, 27, 0.98)) !important;
            border: 2px dashed rgba(221, 179, 4, 0.5) !important;
            transition: transform 0.3s ease, border-color 0.3s ease, box-shadow 0.3s ease !important;
            cursor: pointer;
            text-decoration: none !important;
        }
        .av-card-more:hover {
            transform: translateY(-5px) scale(1.02) !important;
            border-color: #DDB304 !important;
            box-shadow: 0 14px 30px rgba(221, 179, 4, 0.35) !important;
        }
        .av-more-circle {
            width: 60px;
            height: 60px;
            border-radius: 50%;
            background: rgba(221, 179, 4, 0.2);
            border: 2px solid #DDB304;
            display: grid;
            place-items: center;
            color: #DDB304;
            margin-bottom: 16px;
            box-shadow: 0 0 20px rgba(221, 179, 4, 0.3);
            transition: transform 0.3s ease, background 0.3s ease, color 0.3s ease;
        }
        .av-card-more:hover .av-more-circle {
            transform: scale(1.1);
            background: #DDB304;
            color: #230616;
        }
        .av-more-circle svg { width: 28px; height: 28px; }
        .av-more-title { margin: 0 0 6px; color: #fff; font-size: 18px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; }
        .av-more-sub { margin: 0; color: rgba(255, 255, 255, 0.82); font-size: 13px; font-weight: 500; }
    </style>


<style>
        .av-modal-bg { position: fixed; inset: 0; z-index: 99999; background: rgba(18, 4, 12, 0.75); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; padding: 20px; animation: avFadeIn .25s ease-out; }
        @keyframes avFadeIn { from { opacity: 0; } to { opacity: 1; } }
        /* La ventana son DOS columnas: el cartel a la izquierda y lo que hay que
           leer a la derecha. Antes iba el cartel arriba a media altura y el texto
           debajo, y con carteles verticales (que es lo normal en la agenda) la
           imagen salía recortada por arriba y por abajo y había que bajar la
           ventana entera para leer.

           El que rueda es el cuerpo, no la tarjeta: así el cartel se queda a la
           vista mientras se lee una descripción larga. */
        .av-modal-card { position: relative; display: flex; align-items: stretch; width: 100%; max-width: 800px; max-height: 90vh; background: #F4F0E9; border-radius: 20px; overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,0.45); border: 1px solid rgba(221, 179, 4, 0.35); animation: avScaleUp .25s cubic-bezier(0.16, 1, 0.3, 1); font-family: 'Montserrat', ui-sans-serif, system-ui, sans-serif; overscroll-behavior: contain; }
        @keyframes avScaleUp { from { transform: scale(0.92); opacity: 0; } to { transform: scale(1); opacity: 1; } }
        .av-modal-close { position: absolute; top: 14px; right: 14px; z-index: 10; width: 36px; height: 36px; border-radius: 50%; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.3); color: #fff; font-size: 22px; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .2s, transform .2s; }
        .av-modal-close:hover { background: #5C113C; color: #DDB304; transform: scale(1.08); }
        /* Mitad y mitad: el cartel es la mitad de lo que se ve, no el acompañante
           de una columna de texto el doble de ancha. */
        .av-modal-hero { position: relative; flex: 0 0 50%; min-height: 420px; background: #5C113C; overflow: hidden; }
        /* El cartel es una <img> de verdad y no un fondo CSS: así en teléfono
           puede medir lo que mida (height: auto) y salir ENTERO, que es lo que
           un cartel de evento necesita, porque lleva escritos los días y las
           horas. En ordenador llena su columna recortando lo que sobre. */
        .av-modal-hero-img { display: block; width: 100%; height: 100%; object-fit: cover; }
        /* Un velo por abajo y por arriba: es lo que deja legibles las dos
           etiquetas cuando el cartel es claro justo detrás de ellas. */
        .av-modal-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(20, 7, 14, 0.55), transparent 35%, transparent 75%, rgba(20, 7, 14, 0.45)); }
        .av-modal-badge { position: absolute; bottom: 14px; left: 16px; z-index: 2; padding: 5px 12px; border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: #fff; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
        .av-modal-hoy { position: absolute; top: 14px; left: 16px; z-index: 2; padding: 4px 10px; border-radius: 999px; background: #DDB304; color: #3a2e05; font-size: 10px; font-weight: 800; letter-spacing: 0.1em; }
        .av-modal-body { flex: 1 1 auto; min-width: 0; overflow-y: auto; overscroll-behavior: contain; padding: 26px 28px; color: #333; }

        /* En teléfono no caben dos columnas: el cartel vuelve arriba y el texto
           debajo.

           Ahí el cartel se enseña COMPLETO, con el alto que le pida su propia
           proporción, aunque la ventana quede más larga: recortado no se leen
           las fechas que trae impresas, y desplazarse hacia abajo cuesta menos
           que quedarse sin la mitad del cartel. Por eso aquí rueda la tarjeta
           entera y no solo el cuerpo. */
        @media (max-width: 720px) {
            .av-modal-card { flex-direction: column; max-width: 540px; overflow-y: auto; }
            .av-modal-hero { flex: 0 0 auto; min-height: 0; }
            .av-modal-hero-img { height: auto; }
            .av-modal-body { overflow: visible; padding: 22px 24px; }
            /* Sin cartel no hay nada que enseñar, pero el color de la categoría
               sí: se le deja una franja para que la ventana no empiece en seco. */
            .av-modal-hero-vacio { min-height: 140px; }
        }
        .av-modal-meta { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; }
        .av-modal-chip { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 8px; background: rgba(92, 17, 60, 0.08); color: #5C113C; font-size: 12px; font-weight: 600; }
        .av-modal-chip svg { width: 14px; height: 14px; color: var(--av-acento, #B19657); }
        .av-modal-title { font-size: 21px; font-weight: 800; color: #5C113C; margin: 0 0 10px; line-height: 1.25; }
        .av-modal-venue { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: #666; margin-bottom: 14px; }
        .av-modal-venue svg { width: 16px; height: 16px; color: var(--av-acento, #B19657); flex-shrink: 0; }
        .av-modal-cost-bar { margin-bottom: 16px; display: inline-block; padding: 5px 14px; border-radius: 8px; background: var(--av-acento, #B19657); color: #3a0f27; font-size: 12px; font-weight: 800; letter-spacing: 0.04em; }
        .av-modal-desc { font-size: 13.5px; line-height: 1.6; color: #4a4a4a; margin: 0 0 20px; white-space: pre-line; }
        .av-modal-actions { display: flex; justify-content: flex-end; gap: 10px; padding-top: 14px; border-top: 1px solid #eee; }
        .av-modal-btn-sec { padding: 9px 20px; border-radius: 10px; background: #e8e2e6; color: #5C113C; border: none; font-weight: 700; font-size: 12.5px; cursor: pointer; transition: background .2s, color .2s; }
        .av-modal-btn-sec:hover { background: #5C113C; color: #fff; }

        /*
         * Ver el cartel entero.
         *
         * Hace falta porque en ordenador el cartel se recorta para llenar su
         * columna, y un cartel de agenda lleva impresos los días y las horas de
         * todas las funciones: lo que se pierde por los lados es justo lo que
         * alguien quiere leer. El botón va abajo a la derecha, que es la esquina
         * libre (la categoría ocupa la izquierda, la cruz de cerrar la de
         * arriba), y va SIEMPRE visible y no solo al pasar el ratón: en un
         * teléfono no hay ratón que pasar.
         *
         * Es SOLO el icono, sin rótulo, para tapar lo menos posible del cartel.
         * El nombre sigue estando para quien no ve el dibujo: va en aria-label,
         * que es lo que lee un lector de pantalla, y en title, que es el globito
         * que sale al parar el ratón encima. Las cuatro flechas hacia afuera son
         * el gesto de "ampliar" de toda la vida, así que el dibujo solo se
         * entiende sin que haya que explicarlo.
         */
        .av-modal-zoom { position: absolute; bottom: 14px; right: 14px; z-index: 3; display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; padding: 0; border-radius: 50%; border: 1px solid rgba(255,255,255,0.25); background: rgba(20, 7, 14, 0.6); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); color: #fff; cursor: pointer; transition: background .2s, transform .2s; }
        .av-modal-zoom:hover { background: #5C113C; transform: translateY(-1px); }
        .av-modal-zoom:focus-visible { outline: 2px solid #DDB304; outline-offset: 2px; }
        .av-modal-zoom svg { width: 17px; height: 17px; flex-shrink: 0; }

        /*
         * El visor del cartel.
         *
         * Es una capa por ENCIMA de la ventana del evento, no otra ventana con
         * decisiones dentro: no pregunta nada, solo enseña más grande algo que
         * ya estaba a la vista, y solo se sale por un sitio. Tres cuidados lo
         * hacen llevadero, y son los que suelen faltar cuando se apilan capas:
         *
         *   · Escape cierra SOLO la de encima. El guion de abajo mira si el
         *     visor está abierto antes de cerrar la ventana del evento; sin eso,
         *     una tecla cerraba las dos de golpe y quien miraba el cartel se
         *     quedaba de vuelta en la agenda sin haberlo pedido.
         *   · El visor NO toca el bloqueo del desplazamiento. Lo puso la ventana
         *     del evento al abrirse y lo quita ella al cerrarse; si el visor lo
         *     quitara al cerrarse, la página de detrás volvería a rodar con la
         *     ventana todavía abierta.
         *   · Su fondo es casi opaco a propósito. Con un velo tenue se verían
         *     tres capas a la vez (página, ventana, visor) y el cartel quedaría
         *     compitiendo con lo que hay debajo.
         */
        .av-visor { position: fixed; inset: 0; z-index: 100000; display: none; align-items: center; justify-content: center; padding: 24px; background: rgba(12, 3, 8, 0.93); animation: avFadeIn .2s ease-out; }
        .av-visor.abierto { display: flex; }
        .av-visor-marco { position: relative; max-width: 100%; max-height: 100%; display: flex; }
        .av-visor-img { max-width: 100%; max-height: calc(100vh - 48px); object-fit: contain; border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
        .av-visor-cerrar { position: absolute; top: -14px; right: -14px; width: 40px; height: 40px; border-radius: 50%; background: #5C113C; border: 2px solid rgba(255,255,255,0.85); color: #fff; font-size: 22px; font-weight: bold; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .2s, transform .2s; }
        .av-visor-cerrar:hover { background: #DDB304; color: #5C113C; transform: scale(1.08); }
        .av-visor-cerrar:focus-visible { outline: 2px solid #DDB304; outline-offset: 3px; }
        /* En pantalla estrecha la cruz no puede salirse del marco, que se lo come
           el borde de la pantalla: se mete dentro, sobre la propia imagen. */
        @media (max-width: 560px) {
            .av-visor { padding: 16px; }
            .av-visor-cerrar { top: 10px; right: 10px; }
        }
    </style>

    <div id="av-modal-backdrop" class="av-modal-bg" style="display:none;" role="dialog" aria-modal="true">
        <div class="av-modal-card" id="av-modal-card">
            <button type="button" class="av-modal-close" id="av-modal-close" aria-label="Close">&times;</button>
            <div class="av-modal-hero" id="av-modal-hero">
                <img id="av-modal-img" class="av-modal-hero-img" src="" alt="">
                <div id="av-modal-cat-badge" class="av-modal-badge"></div>
                <div id="av-modal-hoy-badge" class="av-modal-hoy" style="display:none;">TODAY</div>
                <button type="button" id="av-modal-zoom" class="av-modal-zoom" style="display:none;"
                        aria-label="View full image"
                        title="View full image">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                </button>
            </div>
            <div class="av-modal-body">
                <div class="av-modal-meta">
                    <span id="av-modal-date" class="av-modal-chip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                        <b id="av-modal-date-text"></b>
                    </span>
                    <span id="av-modal-time" class="av-modal-chip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                        <b id="av-modal-time-text"></b>
                    </span>
                </div>
                <h3 id="av-modal-title" class="av-modal-title"></h3>
                <div class="av-modal-venue">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                    <span id="av-modal-place"></span>
                </div>
                <div class="av-modal-cost-bar"><span id="av-modal-cost"></span></div>
                <p id="av-modal-desc" class="av-modal-desc"></p>
                <div class="av-modal-actions">
                    <button type="button" id="av-modal-close-btn" class="av-modal-btn-sec">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div id="av-visor" class="av-visor" role="dialog" aria-modal="true" aria-label="View full image">
        <div class="av-visor-marco">
            <img id="av-visor-img" class="av-visor-img" src="" alt="">
            <button type="button" id="av-visor-cerrar" class="av-visor-cerrar" aria-label="Close image">&times;</button>
        </div>
    </div>

    <script>
        const i18nModalEvento = {
            todoElDia: "All day",
            gratuito: "FREE",
            entradaLibre: "FREE ADMISSION"        };

        // El costo llega escrito por quien capturó el evento y puede venir en
        // cualquiera de los tres idiomas. Se reconocen las formas conocidas para
        // mostrarlas en el idioma de quien mira; lo demás (un precio) va tal cual.
        window.formatCostoGlobal = function (costoStr) {
            if (!costoStr) return i18nModalEvento.gratuito;

            const str = String(costoStr).trim().toUpperCase();

            if (str === 'GRATUITO' || str === 'GRATIS' || str === 'FREE' || str === 'GRATUIT') {
                return i18nModalEvento.gratuito;
            }
            if (str === 'ENTRADA LIBRE' || str === 'ENTRÉE LIBRE' || str === 'FREE ADMISSION') {
                return i18nModalEvento.entradaLibre;
            }

            return costoStr;
        };

        window.abrirModalEventoGlobal = function (e) {
            if (!e) return;

            const modalBg = document.getElementById('av-modal-backdrop');
            if (!modalBg) return;

            const hero = document.getElementById('av-modal-hero');
            const badge = document.getElementById('av-modal-cat-badge');
            const hoyBadge = document.getElementById('av-modal-hoy-badge');
            const dateText = document.getElementById('av-modal-date-text');
            const timeText = document.getElementById('av-modal-time-text');
            const title = document.getElementById('av-modal-title');
            const place = document.getElementById('av-modal-place');
            const cost = document.getElementById('av-modal-cost');
            const desc = document.getElementById('av-modal-desc');

            const color = e.color || '#5C113C';

            const heroImg = document.getElementById('av-modal-img');
            const zoomBtn = document.getElementById('av-modal-zoom');

            // Sin cartel no hay nada que ampliar: el botón se esconde con la
            // imagen, no se queda prometiendo una vista que no existe.
            if (zoomBtn) zoomBtn.style.display = e.img ? 'inline-flex' : 'none';

            if (hero && heroImg) {
                if (e.img) {
                    heroImg.src = e.img;
                    heroImg.alt = e.titulo || '';
                    heroImg.style.display = 'block';
                    hero.classList.remove('av-modal-hero-vacio');
                    hero.style.backgroundColor = '';
                } else {
                    // Sin cartel se queda el color de la categoría. El src se
                    // vacía además de esconder la etiqueta: si no, el navegador
                    // seguiría enseñando el cartel del evento anterior al abrir
                    // el siguiente.
                    heroImg.removeAttribute('src');
                    heroImg.style.display = 'none';
                    hero.classList.add('av-modal-hero-vacio');
                    hero.style.backgroundColor = color;
                }
            }

            const costoTxt = window.formatCostoGlobal(e.costo);

            /*
             * La etiqueta sobre el cartel se calla cuando dice lo MISMO que el
             * costo de abajo.
             *
             * Pasa siempre con los eventos gratuitos: el portal les añade
             * "GRATUITO" a las etiquetas, esa es la primera y por tanto la que
             * llega aquí como categoría, así que la palabra salía dos veces en
             * la misma ventana. Se compara sin distinguir mayúsculas ni acentos
             * porque cada sitio la escribe a su manera.
             */
            if (badge) {
                const categoria = (e.categoria || '').trim();
                const repetida = categoria !== '' && costoTxt
                    && categoria.localeCompare(costoTxt, undefined, { sensitivity: 'base' }) === 0;

                if (categoria !== '' && ! repetida) {
                    badge.textContent = categoria;
                    badge.style.backgroundColor = color;
                    badge.style.display = 'block';
                } else {
                    badge.style.display = 'none';
                }
            }

            if (hoyBadge) hoyBadge.style.display = e.hoy ? 'block' : 'none';

            const fechaStr = e.dia && e.mes ? `${e.dia} ${e.mes}` : (e.fecha || '');
            if (dateText) dateText.textContent = fechaStr;
            if (timeText) timeText.textContent = e.hora || i18nModalEvento.todoElDia;
            if (title) title.textContent = e.titulo || '';
            if (place) place.textContent = e.lugar || 'Veracruz';
            if (cost) cost.textContent = costoTxt;

            const detalleTxt = e.descripcion || e.observaciones || e.subtitulo || '';
            if (desc) {
                desc.textContent = detalleTxt;
                desc.style.display = detalleTxt ? 'block' : 'none';
            }

            modalBg.style.display = 'flex';
            document.documentElement.style.overflow = 'hidden';
            document.body.style.overflow = 'hidden';
        };

        window.cerrarModalEventoGlobal = function () {
            // Si el cartel estaba ampliado, se cierra con la ventana: dejarlo
            // abierto sobre la agenda sería una capa huérfana, sin nada debajo a
            // lo que volver.
            window.cerrarVisorEventoGlobal();

            const modalBg = document.getElementById('av-modal-backdrop');
            if (modalBg) {
                modalBg.style.display = 'none';
                document.documentElement.style.overflow = '';
                document.body.style.overflow = '';
            }
        };

        window.visorEventoAbierto = function () {
            const visor = document.getElementById('av-visor');
            return !! (visor && visor.classList.contains('abierto'));
        };

        window.abrirVisorEventoGlobal = function () {
            const visor = document.getElementById('av-visor');
            const heroImg = document.getElementById('av-modal-img');
            const visorImg = document.getElementById('av-visor-img');
            const card = document.getElementById('av-modal-card');
            if (! visor || ! heroImg || ! visorImg || ! heroImg.getAttribute('src')) return;

            visorImg.src = heroImg.src;
            visorImg.alt = heroImg.alt;
            visor.classList.add('abierto');

            /*
             * La ventana de debajo se apaga para el teclado mientras el visor
             * está delante. Sin esto, tabular desde el visor lleva a los botones
             * de la ventana, que se ven a medias detrás del velo: el foco se va
             * a un sitio que no se puede leer. `inert` es de 2022 para acá; en un
             * navegador anterior no hace nada y todo lo demás sigue funcionando.
             */
            if (card) card.inert = true;

            // El desplazamiento ya está bloqueado por la ventana del evento. No
            // se vuelve a tocar aquí a propósito (ver el comentario del estilo).
            const cerrar = document.getElementById('av-visor-cerrar');
            if (cerrar) cerrar.focus();
        };

        window.cerrarVisorEventoGlobal = function () {
            const visor = document.getElementById('av-visor');
            if (! visor || ! visor.classList.contains('abierto')) return;

            visor.classList.remove('abierto');

            const card = document.getElementById('av-modal-card');
            if (card) card.inert = false;

            // El foco vuelve al botón que abrió el visor, no al principio de la
            // página: quien navega con teclado se queda donde estaba.
            const zoomBtn = document.getElementById('av-modal-zoom');
            if (zoomBtn && zoomBtn.style.display !== 'none') zoomBtn.focus();
        };

        document.addEventListener('DOMContentLoaded', function () {
            /*
             * Las dos capas se mudan al final del <body> nada más cargar.
             *
             * Esta vista se incluye desde dentro de la sección de la agenda, y
             * esa sección cuelga de dos contenedores que llevan `relative z-10`.
             * Un elemento con z-index dentro de otro con z-index no puede
             * adelantarlo: lo de dentro se ordena SOLO respecto a sus hermanos,
             * y todo el grupo vale 10 frente al resto de la página. Por eso la
             * ventana, que pide 99999, se pintaba por DEBAJO de la barra de
             * navegación, que pide 50: la barra estaba fuera de esa caja y la
             * ventana dentro. Se veía en que la barra se quedaba encendida
             * mientras el resto de la página se oscurecía.
             *
             * Colgarlas del <body> las saca de esa caja y las deja compitiendo
             * con la barra de tú a tú, que es lo que su z-index ya decía. Los
             * escuchadores se ponen después de mudarlas, aunque daría igual:
             * viajan con el elemento.
             */
            [document.getElementById('av-modal-backdrop'), document.getElementById('av-visor')]
                .forEach(function (capa) {
                    if (capa && capa.parentElement !== document.body) document.body.appendChild(capa);
                });

            const closeBtn = document.getElementById('av-modal-close');
            const closeBtnSec = document.getElementById('av-modal-close-btn');
            const modalBg = document.getElementById('av-modal-backdrop');

            if (closeBtn) closeBtn.addEventListener('click', window.cerrarModalEventoGlobal);
            if (closeBtnSec) closeBtnSec.addEventListener('click', window.cerrarModalEventoGlobal);

            if (modalBg) {
                modalBg.addEventListener('click', function (ev) {
                    if (ev.target === modalBg) window.cerrarModalEventoGlobal();
                });
            }

            const zoomBtn = document.getElementById('av-modal-zoom');
            const visor = document.getElementById('av-visor');
            const visorCerrar = document.getElementById('av-visor-cerrar');

            if (zoomBtn) zoomBtn.addEventListener('click', window.abrirVisorEventoGlobal);
            if (visorCerrar) visorCerrar.addEventListener('click', window.cerrarVisorEventoGlobal);

            if (visor) {
                visor.addEventListener('click', function (ev) {
                    // Un clic en el fondo cierra; en la propia imagen, no. Quien
                    // está mirando un cartel suele pinchar encima sin querer
                    // cerrarlo.
                    if (ev.target === visor || ev.target.classList.contains('av-visor-marco')) {
                        window.cerrarVisorEventoGlobal();
                    }
                });
            }

            document.addEventListener('keydown', function (ev) {
                if (ev.key !== 'Escape') return;

                // Escape cierra UNA capa, la de encima. Si está el cartel
                // ampliado se cierra ese y la ventana del evento se queda: antes
                // de separarlo, la misma tecla cerraba las dos y quien miraba el
                // cartel acababa de vuelta en la agenda.
                if (window.visorEventoAbierto()) {
                    window.cerrarVisorEventoGlobal();
                    return;
                }

                window.cerrarModalEventoGlobal();
            });
        });
    </script>

<div class="av-root" style="--av-acento:rgb(var(--brand-gold));scroll-margin-top:5rem">
    <div class="av-box">
        <div class="av-head">
            <div class="av-head-l">
                <span class="av-ico" aria-hidden="true">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                </span>
                <div>
                    <h2 class="av-h2">Don&#039;t miss anything</h2>
                    <p class="av-sub">What the mosaic doesn&#039;t show: the culture happening in the port this season.</p>                    <div id="culturaAgendaLiveClock" class="av-live-clock" aria-label="Fecha y hora actual"></div>
                </div>
            </div>
            <div class="av-head-r">
                <div class="av-month-selector" id="culturaAgendaMonthSelector">
                    <button type="button" id="culturaAgendaMonthPrev" class="av-month-btn" aria-label="Mes anterior">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
                    </button>
                    <span id="culturaAgendaMonthLabel" class="av-month-text">Noviembre 2026</span>
                    <button type="button" id="culturaAgendaMonthNext" class="av-month-btn" aria-label="Mes siguiente">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                    </button>
                </div>

                <button type="button" id="culturaAgendaViewToggle" class="av-pause av-viewbtn" aria-label="Cambiar a vista de calendario">
                    <svg id="culturaAgendaViewIcon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                    <span id="culturaAgendaViewText">Calendario</span>
                </button>
                <button type="button" id="culturaAgendaPause" class="av-pause" aria-label="Pausar reproducción automática">
                    <svg id="culturaAgendaPauseIcon" viewBox="0 0 24 24" fill="currentColor"><rect x="6" y="5" width="4" height="14" rx="1"/><rect x="14" y="5" width="4" height="14" rx="1"/></svg>
                    <span id="culturaAgendaPauseText" class="av-pause-txt">Pausar</span>
                </button>
                            </div>
        </div>

        <div class="av-carousel" id="culturaAgendaCarousel">
            <button type="button" id="culturaAgendaPrev" class="av-nav l" aria-label="Evento anterior">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
            </button>
            <div class="av-viewport">
                <div id="culturaAgendaTrack" class="av-track"></div>
                <div id="culturaAgendaEmpty" class="av-empty" style="display:none">No hay eventos programados por el momento.</div>
            </div>
            <button type="button" id="culturaAgendaNext" class="av-nav r" aria-label="Evento siguiente">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
            </button>
        </div>
        <div id="culturaAgendaDots" class="av-dots"></div>

        <div id="culturaAgendaCalendar" class="av-cal" style="display:none">
            <div class="av-cal-head">
                <button type="button" id="culturaAgendaCalPrev" class="av-cal-nav" aria-label="Mes anterior">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M15 6l-6 6 6 6"/></svg>
                </button>
                <span id="culturaAgendaCalLabel" class="av-cal-mo"></span>
                <button type="button" id="culturaAgendaCalNext" class="av-cal-nav" aria-label="Mes siguiente">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.4" stroke-linecap="round" stroke-linejoin="round"><path d="M9 6l6 6-6 6"/></svg>
                </button>
            </div>
            <div class="av-cal-wd"><span>LUN</span><span>MAR</span><span>MIÉ</span><span>JUE</span><span>VIE</span><span>SÁB</span><span>DOM</span></div>
            <div id="culturaAgendaCalGrid" class="av-cal-grid"></div>
            <div id="culturaAgendaCalDay" class="av-cal-day" style="display:none"></div>
        </div>
    </div>
</div>

    </div>
</section>
                    
    
    <div id="modalHistoriaHeroica" class="fixed inset-0 z-50 flex items-center justify-center p-3 sm:p-6 bg-black/80 backdrop-blur-md opacity-0 pointer-events-none transition-opacity duration-300 font-['Montserrat',sans-serif]">
    
    <div class="bg-[#F4F0E9] w-full max-w-5xl h-[88vh] rounded-3xl shadow-2xl border border-[#B19657]/50 flex flex-col overflow-hidden relative">
        
        
        <div class="bg-gradient-to-r from-[#5C113C] via-[#3F0B29] to-[#230616] text-white px-6 sm:px-10 py-6 flex items-center justify-between border-b border-[#DDB304]/40 flex-shrink-0">
            <div>
                <span class="px-3.5 py-1 rounded-full bg-[#DDB304]/20 border border-[#DDB304]/40 text-[#DDB304] text-[10px] font-extrabold uppercase tracking-widest inline-flex items-center gap-1.5">
                    <i class="pi pi-shield text-xs"></i> Patrimonio y Soberanía Nacional
                </span>
                <h2 class="text-2xl sm:text-3xl font-extrabold fuente-titulos text-white mt-1.5">
                    Las 4 Gesta Heroicas de Veracruz
                </h2>
            </div>
            <button onclick="cerrarModalHeroico()" class="w-10 h-10 rounded-full bg-white/10 hover:bg-white/20 text-white flex items-center justify-center transition-colors">
                <i class="pi pi-times text-lg"></i>
            </button>
        </div>

        
        <div class="bg-[#F4F0E9] px-6 sm:px-10 py-4 border-b border-[#B19657]/20 flex items-center gap-3 text-xs sm:text-sm text-gray-700">
            <span class="w-2.5 h-2.5 rounded-full bg-[#DDB304] flex-shrink-0"></span>
            <span>Veracruz es la única ciudad en México honrada con el título de <strong>"Cuatro Veces Heroica"</strong> por sus defensas históricas.</span>
        </div>

        
        <div class="flex-grow overflow-y-auto overscroll-contain p-6 sm:p-10 space-y-8">

            
            <div class="grid grid-cols-1 md:grid-cols-2 gap-6">

                
                <div class="bg-white rounded-3xl p-7 shadow-md border-2 border-[#DDB304]/40 hover:border-[#5C113C] hover:shadow-xl transition-all group flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <span class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#5C113C] to-[#3F0B29] text-[#DDB304] font-extrabold text-lg flex items-center justify-center shadow-md">
                                1ª
                            </span>
                            <span class="text-xs font-extrabold text-[#B19657] uppercase tracking-widest">23 Noviembre 1825</span>
                        </div>
                        <h3 class="text-xl font-extrabold text-[#5C113C] fuente-titulos">Consumación de la Independencia</h3>
                        <p class="text-xs sm:text-sm text-gray-600 mt-2.5 leading-relaxed">
                            Capitulación de las últimas tropas virreinales españolas atrincheradas en la fortaleza de San Juan de Ulúa. El heroísmo del puerto consolidó formalmente la Independencia de la República Mexicana.
                        </p>
                    </div>
                    <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-bold text-[#B19657]">
                        <span>Capitulación de San Juan de Ulúa</span>
                        <i class="pi pi-shield text-[#5C113C]"></i>
                    </div>
                </div>

                
                <div class="bg-white rounded-3xl p-7 shadow-md border-2 border-[#DDB304]/40 hover:border-[#5C113C] hover:shadow-xl transition-all group flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <span class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#5C113C] to-[#3F0B29] text-[#DDB304] font-extrabold text-lg flex items-center justify-center shadow-md">
                                2ª
                            </span>
                            <span class="text-xs font-extrabold text-[#B19657] uppercase tracking-widest">27 Noviembre 1838</span>
                        </div>
                        <h3 class="text-xl font-extrabold text-[#5C113C] fuente-titulos">Guerra de los Pasteles</h3>
                        <p class="text-xs sm:text-sm text-gray-600 mt-2.5 leading-relaxed">
                            El puerto enfrenta con gallardía el ataque e invasión de la escuadra naval de Francia, resistiendo el fuego enemigo y resguardando la dignidad territorial de la patria.
                        </p>
                    </div>
                    <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-bold text-[#B19657]">
                        <span>Defensa ante la Armada Francesa</span>
                        <i class="pi pi-flag text-[#5C113C]"></i>
                    </div>
                </div>

                
                <div class="bg-white rounded-3xl p-7 shadow-md border-2 border-[#DDB304]/40 hover:border-[#5C113C] hover:shadow-xl transition-all group flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <span class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#5C113C] to-[#3F0B29] text-[#DDB304] font-extrabold text-lg flex items-center justify-center shadow-md">
                                3ª
                            </span>
                            <span class="text-xs font-extrabold text-[#B19657] uppercase tracking-widest">22 Marzo 1847</span>
                        </div>
                        <h3 class="text-xl font-extrabold text-[#5C113C] fuente-titulos">Intervención Norteamericana</h3>
                        <p class="text-xs sm:text-sm text-gray-600 mt-2.5 leading-relaxed">
                            Resistencia patriótica ininterrumpida de soldados y ciudadanos veracruzanos frente al sitio y bombardeo masivo de las fuerzas armadas invasoras de Estados Unidos.
                        </p>
                    </div>
                    <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-bold text-[#B19657]">
                        <span>Sitio y Bombardeo Patriótico</span>
                        <i class="pi pi-map text-[#5C113C]"></i>
                    </div>
                </div>

                
                <div class="bg-white rounded-3xl p-7 shadow-md border-2 border-[#DDB304]/40 hover:border-[#5C113C] hover:shadow-xl transition-all group flex flex-col justify-between">
                    <div>
                        <div class="flex items-center justify-between mb-4">
                            <span class="w-12 h-12 rounded-2xl bg-gradient-to-br from-[#5C113C] to-[#3F0B29] text-[#DDB304] font-extrabold text-lg flex items-center justify-center shadow-md">
                                4ª
                            </span>
                            <span class="text-xs font-extrabold text-[#B19657] uppercase tracking-widest">21 Abril 1914</span>
                        </div>
                        <h3 class="text-xl font-extrabold text-[#5C113C] fuente-titulos">Gesta Naval Militar</h3>
                        <p class="text-xs sm:text-sm text-gray-600 mt-2.5 leading-relaxed">
                            Sublime sacrificio de los cadetes de la Escuela Naval Militar como José Azueta y Virgilio Uribe, quienes junto al pueblo dieron su vida defendiendo al puerto de la ocupación extranjera.
                        </p>
                    </div>
                    <div class="mt-6 pt-4 border-t border-gray-100 flex items-center justify-between text-xs font-bold text-[#B19657]">
                        <span>Inmortalidad del Valor Naval</span>
                        <i class="pi pi-star-fill text-[#5C113C]"></i>
                    </div>
                </div>

            </div>

            
            <a href="https://veracruzmunicipio.gob.mx/wp-content/uploads/2026/07/Revista-Digital-Ciudad-Heroica-200anos.pdf" 
               target="_blank"
               rel="noopener noreferrer"
               class="block relative rounded-3xl overflow-hidden shadow-xl border-2 border-[#B19657]/40 bg-[#F4F0E9] group hover:scale-[1.01] hover:border-[#5C113C] transition-all duration-300">
                <img src="https://descubre.veracruzmunicipio.gob.mx/module-assets/cultura/images/Cultura/banner-4-veces-heroica.png" 
                     alt="Descubre cómo Veracruz se convirtió en Ciudad Heroica - Edición Especial" 
                     class="w-full h-auto object-cover block"
                     data-ms-field="banner.heroica.image" data-ms-media>
            </a>
        </div>

        
        <div class="bg-white px-6 py-4 border-t border-gray-200 flex items-center justify-between flex-shrink-0">
            <span class="text-xs text-gray-500 font-medium hidden sm:inline">Veracruz: Heroica Ciudad y Puerto</span>
            <button onclick="cerrarModalHeroico()" class="px-7 py-2.5 rounded-full bg-[#5C113C] hover:bg-[#3F0B29] text-white text-xs font-extrabold uppercase tracking-widest transition-colors shadow-md ml-auto">
                Cerrar
            </button>
        </div>
    </div>
</div>

