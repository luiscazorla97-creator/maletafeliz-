<div class="reveal" id="blog-signup" data-reveal data-swiftype-index="false">
	<div class="popup-box">
		<div class="popup-box__header">
			<h2 class="popup-box__pretitle">Sign Up For Insider Updates</h2>
			<p class="popup-box__description">Our free newsletter offers fun tidbits gathered by Charleston insiders. Sign up today to receive the flavors, sights, sounds, and traditions of Charleston delivered directly to your&nbsp;inbox.</p>
		</div>
		<form data-ajax-form class="popup-box__form" method="post" action="/cgi-bin/subscribe.cgi">
			<label for="blog-signup-email">Email Address</label>
			<input type="email" name="email" id="blog-signup-email">
			<div class="popup-box__actions">
				<button type="submit" class="button button--arrow">Join</button>
			</div>
			<div class="form-response" data-ajax-response></div>
			<button class="popup-box__close close-button" data-close aria-label="Close modal" type="button"><span aria-hidden="true">×</span></button>
		</form>
	</div>
</div><!-- .reveal -->

