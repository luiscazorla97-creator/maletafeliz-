<div class="l-cookie js-cookie-popup" data-cookie="first" aria-hidden="false">
  <div class="l-cookie__content">
    <button class="l-cookie__close js-close-popup js-close-first-popup" aria-label="Close cookie popup"><img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAEgAAABIAQMAAABvIyEEAAAAA1BMVEUAAACnej3aAAAAAXRSTlMAQObYZgAAAA5JREFUGBljGAWjYBgBAALQAAGGqQ8oAAAAAElFTkSuQmCC" alt="Close modal" data-src="https://d1ixxqrn2t5gu0.cloudfront.net/wp/wp-content/themes/kamakura/assets/images/common/img_modal_btn.png" decoding="async" class="lazyload" data-eio-rwidth="72" data-eio-rheight="72"><noscript><img src="https://d1ixxqrn2t5gu0.cloudfront.net/wp/wp-content/themes/kamakura/assets/images/common/img_modal_btn.png" alt="Close modal" data-eio="l"></noscript></button>
    <p class="l-cookie__text">We use cookies and similar technologies to improve your experience. For more information, please refer to our <a href="/policy/" class="l-cookie__link">Privacy Policy / Cookie Policy</a>. To learn about your preferences and opt-out options, please click [Do Not Sell or Share My Personal Information].</p>
    <div class="l-cookie__button-area"><button class="l-cookie__button js-open-settings">Do Not Sell or Share My Personal Information</button></div>
  </div>
</div>

<div class="l-cookie js-cookie-settings" data-cookie="second" aria-hidden="true">
  <div class="l-cookie__content">
    <button class="l-cookie__close js-close-popup js-close-second-popup" aria-label="Close cookie popup"><img src="data:image/png;base64,iVBORw0KGgoAAAANSUhEUgAAAEgAAABIAQMAAABvIyEEAAAAA1BMVEUAAACnej3aAAAAAXRSTlMAQObYZgAAAA5JREFUGBljGAWjYBgBAALQAAGGqQ8oAAAAAElFTkSuQmCC" alt="Close modal" data-src="https://d1ixxqrn2t5gu0.cloudfront.net/wp/wp-content/themes/kamakura/assets/images/common/img_modal_btn.png" decoding="async" class="lazyload" data-eio-rwidth="72" data-eio-rheight="72"><noscript><img src="https://d1ixxqrn2t5gu0.cloudfront.net/wp/wp-content/themes/kamakura/assets/images/common/img_modal_btn.png" alt="Close modal" data-eio="l"></noscript></button>
    <div class="l-cookie__title" id="settings-title">Cookie Settings</div>
    <p class="l-cookie__text">Our website uses both first-party and third-party cookies and similar technologies to improve the website, analyze traffic and usage, and provide more relevant content. This information typically does not directly identify you, but it can enhance your web experience. For more details, please refer to our <a href="/policy/" class="l-cookie__link">Privacy Policy / Cookie Policy</a>.</p>
    <p class="l-cookie__text">If you wish to opt out, please select "Disable" under the "Sale or Share of Personal Information" section below and click [Save Settings]. After clicking, this window will automatically close and the page will reload to apply your preferences. Please note, however, that opting out may affect the functionality of certain parts of the website.</p>
    <div class="l-cookie__checkbox-group">
      <div class="l-cookie__checkbox-group-text">Sale or share of personal information</div>
      <div class="l-cookie__checkbox-area">
        <label class="l-cookie__label js-cookie-label">
          <input type="radio" name="sale-share" value="Enable" class="l-cookie__checkbox" id="ccpa-accept" checked>Enable        </label>
        <label class="l-cookie__label js-cookie-label">
          <input type="radio" name="sale-share" value="Disable" class="l-cookie__checkbox" id="ccpa-reject">Disable        </label>
      </div>
    </div>
    <div class="l-cookie__button-area"><button class="l-cookie__button js-save-settings">Save Settings</button></div>
  </div>
</div>

