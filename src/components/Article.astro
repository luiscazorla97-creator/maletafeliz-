---
import { dictionary, type Locale } from '../i18n';
import {
  photoFor,
  photoSrcSet,
  articleText,
  publishedArticles,
  articlePath,
  type Article,
} from '../lib/content';
import { destinations, destinationUrl } from '../data/destinations';
import { route } from '../lib/routes';
import { countryGuidePath, hasCountryGuide } from '../lib/country-clusters';
import { articleCoverSizes, articleBodySizes } from '../lib/image-sizes';
const { article: a } = Astro.props as { article: Article };
const lang = a.locale as Locale;
const t = dictionary[lang];
const cover = photoFor(a.coverImageId)!;
const d = destinations.find((d) => d.id === a.destinationId)!;
const related = publishedArticles.filter(
  (b) => b.locale === lang && a.relatedIds.includes(b.id),
);
// Keep the calendar date recorded by the publisher, including offset dates.
const format = (s?: string) =>
  s
    ? new Intl.DateTimeFormat(lang, {
        dateStyle: 'long',
        timeZone: 'UTC',
      }).format(new Date(`${s.slice(0, 10)}T12:00:00Z`))
    : '';
---

<div class="shell">
  <header class="article-header">
    <nav class="breadcrumbs" aria-label="Breadcrumb">
      <a href={`/${lang}/`}>{t.home}</a>
      <span>/</span>
      {hasCountryGuide(d.countryId) && (
        <>
          <a href={countryGuidePath(d.countryId, lang)}>{d.country[lang]}</a>
          <span>/</span>
        </>
      )}
      <a href={destinationUrl(d, lang)}>{d.city[lang]}</a>
    </nav>
    <span class="eyebrow orange">
      {t.guide} · {d.country[lang]}
    </span>
    <h1>{a.title}</h1>
    <p>{a.description}</p>
    {a.id.startsWith('christmas-') && (
      <a class="text-link" href={route(lang, 'christmas')}>
        {lang === 'es'
          ? 'Más ciudades para viajar en Navidad'
          : 'More cities for a Christmas trip'}
      </a>
    )}
    <div class="article-meta">
      <span>{t.editor}</span>
      <span>
        {t.published}:{' '}
        <time datetime={a.publishedAt}>{format(a.publishedAt)}</time>
      </span>
      {a.updatedAt && a.updatedAt !== a.publishedAt && (
        <span>
          {t.updated}: <time datetime={a.updatedAt}>{format(a.updatedAt)}</time>
        </span>
      )}
      <span>
        {Math.ceil(articleText(a).split(/\s+/).length / 220)} {t.minutes}
      </span>
    </div>
  </header>
  <figure class="article-cover">
    <img
      src={cover.src}
      srcset={photoSrcSet(cover)}
      sizes={articleCoverSizes}
      width={cover.width}
      height={cover.height}
      alt={cover.alt[lang]}
      fetchpriority="high"
    />
    <figcaption class="photo-credit">
      <span class="photo-description">{cover.alt[lang]}</span>
      <a href={cover.sourceUrl} rel="noopener noreferrer">
        {cover.credit}
      </a>{' '}
      ·{' '}
      <a href={cover.licenseUrl} rel="license noopener noreferrer">
        {cover.license}
      </a>
      {cover.attributionUrl && (
        <span>
          {' '}
          ·{' '}
          <a href={cover.attributionUrl} rel="noopener noreferrer">
            {lang === 'es' ? 'Web del autor' : 'Author’s website'}
          </a>
        </span>
      )}
    </figcaption>
  </figure>
  <div class="article-grid">
    <aside class="toc">
      <h2>{t.contents}</h2>
      {a.sections.map((s) => (
        <a href={`#${s.id}`}>{s.heading}</a>
      ))}
      {a.itinerary.length > 0 && <a href="#itinerary">{t.itinerary}</a>}
      <a href="#faq">{t.faq}</a>
      <a href="#sources">{t.sources}</a>
    </aside>
    <article class="prose">
      {a.intro.map((p) => (
        <p>{p}</p>
      ))}
      <div class="notice">
        <h2 style="font-size:23px;margin:0 0 15px">{t.quick}</h2>
        <dl class="facts">
          {a.quickFacts.map((f) => (
            <div>
              <dt>{f.label}</dt>
              <dd>{f.value}</dd>
            </div>
          ))}
        </dl>
      </div>
      {a.sections.map((s) => {
        const image = s.imageId && photoFor(s.imageId);
        return (
          <section aria-labelledby={s.id}>
            <h2 id={s.id}>{s.heading}</h2>
            {s.paragraphs.map((p) => (
              <p>{p}</p>
            ))}
            {image && (
              <figure>
                <img
                  src={image.src}
                  srcset={photoSrcSet(image)}
                  sizes={articleBodySizes}
                  alt={image.alt[lang]}
                  width={image.width}
                  height={image.height}
                  loading="lazy"
                  decoding="async"
                />
                <figcaption class="photo-credit">
                  <span class="photo-description">{image.alt[lang]}</span>
                  <a href={image.sourceUrl}>{image.credit}</a> ·{' '}
                  <a href={image.licenseUrl} rel="license">
                    {image.license}
                  </a>
                  {image.attributionUrl && (
                    <span>
                      {' '}
                      ·{' '}
                      <a href={image.attributionUrl} rel="noopener noreferrer">
                        {lang === 'es' ? 'Web del autor' : 'Author’s website'}
                      </a>
                    </span>
                  )}
                </figcaption>
              </figure>
            )}
          </section>
        );
      })}
      {a.itinerary.length > 0 && (
        <section>
          <h2 id="itinerary">{t.itinerary}</h2>
          <ol>
            {a.itinerary.map((p) => (
              <li>{p}</li>
            ))}
          </ol>
        </section>
      )}
      <section>
        <h2 id="faq">{t.faq}</h2>
        {a.faq.map((f) => (
          <details>
            <summary>{f.question}</summary>
            <p>{f.answer}</p>
          </details>
        ))}
      </section>
      <p>{a.conclusion}</p>
      <section>
        <h2 id="sources">{t.sources}</h2>
        <ul>
          {a.sources.map((s) => (
            <li>
              <a href={s.url} rel="noopener noreferrer">
                {s.title}
              </a>{' '}
              — <time datetime={s.accessedAt}>{format(s.accessedAt)}</time>
            </li>
          ))}
        </ul>
      </section>
      {hasCountryGuide(d.countryId) && (
        <p class="country-guide-link">
          {lang === 'es'
            ? 'Para combinar esta visita con otros destinos, consulta '
            : 'To combine this visit with other destinations, see '}
          <a href={countryGuidePath(d.countryId, lang)}>
            {lang === 'es'
              ? `la guía de ${d.country[lang]}`
              : `the ${d.country[lang]} guide`}
          </a>
          .
        </p>
      )}
      {related.length > 0 && (
        <section>
          <h2>{t.related}</h2>
          <ul>
            {related.map((b) => (
              <li>
                <a href={articlePath(b)}>{b.title}</a>
              </li>
            ))}
          </ul>
        </section>
      )}
    </article>
  </div>
</div>
