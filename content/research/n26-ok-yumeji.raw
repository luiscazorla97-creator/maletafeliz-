<script>
    // MCM Premium (PC): hide header row 1 when scrolling down, show it again when scrolling up
    (function () {
        var header = document.querySelector('.mcmofficialsite-header');
        if (!header) return;
        var pcQuery = window.matchMedia('(min-width: 980px)');
        var lastY = window.pageYOffset;
        var ticking = false;

        function update() {
            var y = window.pageYOffset;
            if (!pcQuery.matches || y <= header.offsetHeight) {
                header.classList.remove('is-hide-top');
            } else if (y > lastY) {
                header.classList.add('is-hide-top');
            } else if (y < lastY) {
                header.classList.remove('is-hide-top');
            }
            lastY = y;
            ticking = false;
        }

        window.addEventListener('scroll', function () {
            if (!ticking) {
                window.requestAnimationFrame(update);
                ticking = true;
            }
        }, { passive: true });
        pcQuery.addEventListener && pcQuery.addEventListener('change', update);
    })();
</script>
