            <style data-id=>.major-notification{margin-left:2rem;margin-right:2rem;width:100%}@media only screen and (min-width:1280px){.major-notification{display:none}}@media only screen and (max-width:1279px){.sidebar-notification:not(.secondary-notification){height:1px;margin:-1px;overflow:hidden;padding:0;position:absolute;width:1px;clip:rect(0,0,0,0);border:0;white-space:nowrap}}.major-notification,.sidebar-notification{--_background-colour:var(--body-secondary-colour,var(--body-primary-colour-contrast,#000));--_heading-colour:var(--colour-tertiary,#bfbfbf);--_text-colour:var(--body-primary-colour,#fff);--_icon-colour:var(--body-primary-colour,#fff);--_pattern-width:5rem;background-color:var(--_background-colour);color:var(--_text-colour);padding-bottom:7rem;padding-left:var(--_pattern-width);position:relative}.major-notification:not(:last-child),.sidebar-notification:not(:last-child){margin-bottom:2rem}.major-notification.secondary-notification,.sidebar-notification.secondary-notification{--_background-colour:hsl(from var(--body-secondary-colour,var(--body-primary-colour-contrast,#000)) h s l/0.63)}.major-notification,.sidebar-notification{--_icon-colour:var(--colour-tertiary,#bfbfbf);--_heading-colour:var(--body-primary-colour,#fff)}.major-notification:before,.sidebar-notification:before{background-image:url(/_resources/mysite/client/images/patterns/weave.svg?v=1792532929713);background-position:0 0;background-repeat:repeat-y;background-size:100% auto;content:"";height:100%;left:0;position:absolute;top:0;width:var(--_pattern-width)}.major-notification__wrap,.sidebar-notification__wrap{padding:2rem}.major-notification__icon,.sidebar-notification__icon{background-color:var(--_icon-colour);border-radius:50%;display:block;height:4rem;margin-bottom:1rem;-webkit-mask-image:url(/_resources/mysite/client/images/icons/info.svg?v=1792532929713);mask-image:url(/_resources/mysite/client/images/icons/info.svg?v=1792532929713);-webkit-mask-position:center;mask-position:center;-webkit-mask-repeat:no-repeat;mask-repeat:no-repeat;-webkit-mask-size:contain;mask-size:contain;position:relative;width:4rem}.major-notification__title,.sidebar-notification__title{color:var(--_heading-colour);display:block;font-weight:700;margin-bottom:3rem;width:min-content}.major-notification__content :last-child,.sidebar-notification__content :last-child{margin-bottom:0}.major-notification__content a:active,.major-notification__content a:focus-visible,.major-notification__content a:hover,.sidebar-notification__content a:active,.sidebar-notification__content a:focus-visible,.sidebar-notification__content a:hover{color:var(--colour-tertiary,#bfbfbf)}</style>
        

        

        
