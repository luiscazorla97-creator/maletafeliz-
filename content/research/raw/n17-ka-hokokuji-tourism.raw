		<section class="c-things-to-do-post">
		<div class="c-things-to-do-post__head u-container u-max-contents is-fade-blur js-fade-firstview">
<p class="c-things-to-do-post__category-area">Things to see - Shrine &amp; Temples</p>		 <h1 class="c-things-to-do-post__ttl">Hokokuji Temple</h1>
		 <p class="c-things-to-do-post__spot">Hokokuji Temple</p>		 <div class="c-things-to-do-post__area">
			<div class="c-things-to-do-post__area"><span class="c-things-to-do-post__area-icon c-icon-area"></span><p class="c-things-to-do-post__area-txt">Kanazawa-kaido Area</p></div>		</div>
		</div>

		<div class="c-things-to-do-post-unit-wrapper u-container u-max-contents">
		 <div class="c-things-to-do-post-wrapper">
		<nav class="c-sticky-nav js-things-to-do-post-nav" aria-label="Page sections navigation">
  <div class="c-sticky-nav__contents js-things-to-do-post-nav-contents">
    <ul class="c-sticky-nav__lists">
                        <li class="c-sticky-nav__list js-things-to-do-post-nav-list">
            <a class="c-sticky-nav__link js-things-to-do-post-nav-link" href="#description">
              Description            </a>
          </li>
                  <li class="c-sticky-nav__list js-things-to-do-post-nav-list">
