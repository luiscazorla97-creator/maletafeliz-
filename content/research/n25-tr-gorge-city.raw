</form>

<script data-cookieconsent="ignore" data-cmp-ab="2">
    document.addEventListener('DOMContentLoaded', function() {
        document.body.addEventListener('click', function (event) {
            let element = event.target.closest('[target$="_accommodations_infopop"]');
            if(!element && event.target.getAttribute('target') === '_accommodations_infopop') {
                element = event.target;
            }

            if (!element) {
                return
            }

            // se il form è aperto dal box di richieste multiple
            if (element.closest('.list-bar-request')) {
                const infoPopElementTmp = document.querySelector('#window' + element.getAttribute('target'));
                if (infoPopElementTmp) {
                    const emailField = infoPopElementTmp.querySelector('[name="targetEmail"]');
                    const nameField = infoPopElementTmp.querySelector('[name="targetName"]');
                    if (emailField) emailField.value = "";
                    if (nameField) nameField.value = "";
                }

                return;
            }

            const infoPopElement = document.querySelector('#window' + element.getAttribute('target'));
            if (!infoPopElement) {
                return;
            }

            // tracking (solo se esiste "tr")
            if (typeof tr !== 'undefined' && tr) {
                tr.track('K_clic_prenota_struttura', {event_label: window.location.href});
            }

            const informationHeaderField = infoPopElement.querySelector('.information-header');
            const targetEmailField = infoPopElement.querySelector('[name="targetEmail"]');
            const targetNameField = infoPopElement.querySelector('[name="targetName"]');
            const targetIdsField = infoPopElement.querySelector('[name="targetIds"]');
            const targetNameLabelField = infoPopElement.querySelector('.send-label-email');

            let isHeaderVisible = true;
            let targetEmailFieldValue = '';
            let targetNameFieldValue = '';
            let targetNameLabelFieldValue = '';

            if (!element.dataset.email || !element.dataset.name) {
                isHeaderVisible = false;
            } else {
                targetEmailFieldValue = element.dataset.email;
                targetNameFieldValue = element.dataset.name;
                targetNameLabelFieldValue = element.dataset.name;

                targetIdsField.value = '';
            }
                            if (targetEmailField) targetEmailField.value = targetEmailFieldValue;
                if (targetNameField) targetNameField.value = targetNameFieldValue;
                if (targetNameLabelField) targetNameLabelField.textContent = targetNameLabelFieldValue;
                if (informationHeaderField) {
                    informationHeaderField.classList.toggle('d-none', !isHeaderVisible);
                }
                    });
    });
</script>
                
                            
                    

                </div>
            </div>
        </div>
    </div>
</div>


