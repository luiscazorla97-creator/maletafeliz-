            <!-- RIGHT COLUMN: Calendar Sidebar (Col 4) -->
            <div class="col-span-12 min-[1248px]:col-span-4 justify-self-center w-full">
                <style>
        .av-modal-bg { position: fixed; inset: 0; z-index: 99999; background: rgba(18, 4, 12, 0.75); backdrop-filter: blur(8px); -webkit-backdrop-filter: blur(8px); display: flex; align-items: center; justify-content: center; padding: 20px; animation: avFadeIn .25s ease-out; }
        @keyframes avFadeIn { from { opacity: 0; } to { opacity: 1; } }
        /* La ventana son DOS columnas: el cartel a la izquierda y lo que hay que
           leer a la derecha. Antes iba el cartel arriba a media altura y el texto
           debajo, y con carteles verticales (que es lo normal en la agenda) la
           imagen salía recortada por arriba y por abajo y había que bajar la
           ventana entera para leer.

           El que rueda es el cuerpo, no la tarjeta: así el cartel se queda a la
           vista mientras se lee una descripción larga. */
        .av-modal-card { position: relative; display: flex; align-items: stretch; width: 100%; max-width: 800px; max-height: 90vh; background: #F4F0E9; border-radius: 20px; overflow: hidden; box-shadow: 0 24px 60px rgba(0,0,0,0.45); border: 1px solid rgba(221, 179, 4, 0.35); animation: avScaleUp .25s cubic-bezier(0.16, 1, 0.3, 1); font-family: 'Montserrat', ui-sans-serif, system-ui, sans-serif; overscroll-behavior: contain; }
        @keyframes avScaleUp { from { transform: scale(0.92); opacity: 0; } to { transform: scale(1); opacity: 1; } }
        .av-modal-close { position: absolute; top: 14px; right: 14px; z-index: 10; width: 36px; height: 36px; border-radius: 50%; background: rgba(0,0,0,0.5); border: 1px solid rgba(255,255,255,0.3); color: #fff; font-size: 22px; font-weight: bold; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .2s, transform .2s; }
        .av-modal-close:hover { background: #5C113C; color: #DDB304; transform: scale(1.08); }
        /* Mitad y mitad: el cartel es la mitad de lo que se ve, no el acompañante
           de una columna de texto el doble de ancha. */
        .av-modal-hero { position: relative; flex: 0 0 50%; min-height: 420px; background: #5C113C; overflow: hidden; }
        /* El cartel es una <img> de verdad y no un fondo CSS: así en teléfono
           puede medir lo que mida (height: auto) y salir ENTERO, que es lo que
           un cartel de evento necesita, porque lleva escritos los días y las
           horas. En ordenador llena su columna recortando lo que sobre. */
        .av-modal-hero-img { display: block; width: 100%; height: 100%; object-fit: cover; }
        /* Un velo por abajo y por arriba: es lo que deja legibles las dos
           etiquetas cuando el cartel es claro justo detrás de ellas. */
        .av-modal-hero::after { content: ''; position: absolute; inset: 0; background: linear-gradient(to top, rgba(20, 7, 14, 0.55), transparent 35%, transparent 75%, rgba(20, 7, 14, 0.45)); }
        .av-modal-badge { position: absolute; bottom: 14px; left: 16px; z-index: 2; padding: 5px 12px; border-radius: 999px; font-size: 11px; font-weight: 800; letter-spacing: 0.05em; text-transform: uppercase; color: #fff; box-shadow: 0 4px 10px rgba(0,0,0,0.3); }
        .av-modal-hoy { position: absolute; top: 14px; left: 16px; z-index: 2; padding: 4px 10px; border-radius: 999px; background: #DDB304; color: #3a2e05; font-size: 10px; font-weight: 800; letter-spacing: 0.1em; }
        .av-modal-body { flex: 1 1 auto; min-width: 0; overflow-y: auto; overscroll-behavior: contain; padding: 26px 28px; color: #333; }

        /* En teléfono no caben dos columnas: el cartel vuelve arriba y el texto
           debajo.

           Ahí el cartel se enseña COMPLETO, con el alto que le pida su propia
           proporción, aunque la ventana quede más larga: recortado no se leen
           las fechas que trae impresas, y desplazarse hacia abajo cuesta menos
           que quedarse sin la mitad del cartel. Por eso aquí rueda la tarjeta
           entera y no solo el cuerpo. */
        @media (max-width: 720px) {
            .av-modal-card { flex-direction: column; max-width: 540px; overflow-y: auto; }
            .av-modal-hero { flex: 0 0 auto; min-height: 0; }
            .av-modal-hero-img { height: auto; }
            .av-modal-body { overflow: visible; padding: 22px 24px; }
            /* Sin cartel no hay nada que enseñar, pero el color de la categoría
               sí: se le deja una franja para que la ventana no empiece en seco. */
            .av-modal-hero-vacio { min-height: 140px; }
        }
        .av-modal-meta { display: flex; flex-wrap: wrap; gap: 10px; margin-bottom: 12px; }
        .av-modal-chip { display: inline-flex; align-items: center; gap: 6px; padding: 5px 12px; border-radius: 8px; background: rgba(92, 17, 60, 0.08); color: #5C113C; font-size: 12px; font-weight: 600; }
        .av-modal-chip svg { width: 14px; height: 14px; color: var(--av-acento, #B19657); }
        .av-modal-title { font-size: 21px; font-weight: 800; color: #5C113C; margin: 0 0 10px; line-height: 1.25; }
        .av-modal-venue { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: #666; margin-bottom: 14px; }
        .av-modal-venue svg { width: 16px; height: 16px; color: var(--av-acento, #B19657); flex-shrink: 0; }
        .av-modal-cost-bar { margin-bottom: 16px; display: inline-block; padding: 5px 14px; border-radius: 8px; background: var(--av-acento, #B19657); color: #3a0f27; font-size: 12px; font-weight: 800; letter-spacing: 0.04em; }
        .av-modal-desc { font-size: 13.5px; line-height: 1.6; color: #4a4a4a; margin: 0 0 20px; white-space: pre-line; }
        .av-modal-actions { display: flex; justify-content: flex-end; gap: 10px; padding-top: 14px; border-top: 1px solid #eee; }
        .av-modal-btn-sec { padding: 9px 20px; border-radius: 10px; background: #e8e2e6; color: #5C113C; border: none; font-weight: 700; font-size: 12.5px; cursor: pointer; transition: background .2s, color .2s; }
        .av-modal-btn-sec:hover { background: #5C113C; color: #fff; }

        /*
         * Ver el cartel entero.
         *
         * Hace falta porque en ordenador el cartel se recorta para llenar su
         * columna, y un cartel de agenda lleva impresos los días y las horas de
         * todas las funciones: lo que se pierde por los lados es justo lo que
         * alguien quiere leer. El botón va abajo a la derecha, que es la esquina
         * libre (la categoría ocupa la izquierda, la cruz de cerrar la de
         * arriba), y va SIEMPRE visible y no solo al pasar el ratón: en un
         * teléfono no hay ratón que pasar.
         *
         * Es SOLO el icono, sin rótulo, para tapar lo menos posible del cartel.
         * El nombre sigue estando para quien no ve el dibujo: va en aria-label,
         * que es lo que lee un lector de pantalla, y en title, que es el globito
         * que sale al parar el ratón encima. Las cuatro flechas hacia afuera son
         * el gesto de "ampliar" de toda la vida, así que el dibujo solo se
         * entiende sin que haya que explicarlo.
         */
        .av-modal-zoom { position: absolute; bottom: 14px; right: 14px; z-index: 3; display: inline-flex; align-items: center; justify-content: center; width: 38px; height: 38px; padding: 0; border-radius: 50%; border: 1px solid rgba(255,255,255,0.25); background: rgba(20, 7, 14, 0.6); backdrop-filter: blur(6px); -webkit-backdrop-filter: blur(6px); color: #fff; cursor: pointer; transition: background .2s, transform .2s; }
        .av-modal-zoom:hover { background: #5C113C; transform: translateY(-1px); }
        .av-modal-zoom:focus-visible { outline: 2px solid #DDB304; outline-offset: 2px; }
        .av-modal-zoom svg { width: 17px; height: 17px; flex-shrink: 0; }

        /*
         * El visor del cartel.
         *
         * Es una capa por ENCIMA de la ventana del evento, no otra ventana con
         * decisiones dentro: no pregunta nada, solo enseña más grande algo que
         * ya estaba a la vista, y solo se sale por un sitio. Tres cuidados lo
         * hacen llevadero, y son los que suelen faltar cuando se apilan capas:
         *
         *   · Escape cierra SOLO la de encima. El guion de abajo mira si el
         *     visor está abierto antes de cerrar la ventana del evento; sin eso,
         *     una tecla cerraba las dos de golpe y quien miraba el cartel se
         *     quedaba de vuelta en la agenda sin haberlo pedido.
         *   · El visor NO toca el bloqueo del desplazamiento. Lo puso la ventana
         *     del evento al abrirse y lo quita ella al cerrarse; si el visor lo
         *     quitara al cerrarse, la página de detrás volvería a rodar con la
         *     ventana todavía abierta.
         *   · Su fondo es casi opaco a propósito. Con un velo tenue se verían
         *     tres capas a la vez (página, ventana, visor) y el cartel quedaría
         *     compitiendo con lo que hay debajo.
         */
        .av-visor { position: fixed; inset: 0; z-index: 100000; display: none; align-items: center; justify-content: center; padding: 24px; background: rgba(12, 3, 8, 0.93); animation: avFadeIn .2s ease-out; }
        .av-visor.abierto { display: flex; }
        .av-visor-marco { position: relative; max-width: 100%; max-height: 100%; display: flex; }
        .av-visor-img { max-width: 100%; max-height: calc(100vh - 48px); object-fit: contain; border-radius: 12px; box-shadow: 0 20px 60px rgba(0,0,0,0.5); }
        .av-visor-cerrar { position: absolute; top: -14px; right: -14px; width: 40px; height: 40px; border-radius: 50%; background: #5C113C; border: 2px solid rgba(255,255,255,0.85); color: #fff; font-size: 22px; font-weight: bold; line-height: 1; cursor: pointer; display: flex; align-items: center; justify-content: center; transition: background .2s, transform .2s; }
        .av-visor-cerrar:hover { background: #DDB304; color: #5C113C; transform: scale(1.08); }
        .av-visor-cerrar:focus-visible { outline: 2px solid #DDB304; outline-offset: 3px; }
        /* En pantalla estrecha la cruz no puede salirse del marco, que se lo come
           el borde de la pantalla: se mete dentro, sobre la propia imagen. */
        @media (max-width: 560px) {
            .av-visor { padding: 16px; }
            .av-visor-cerrar { top: 10px; right: 10px; }
        }
    </style>

    <div id="av-modal-backdrop" class="av-modal-bg" style="display:none;" role="dialog" aria-modal="true">
        <div class="av-modal-card" id="av-modal-card">
            <button type="button" class="av-modal-close" id="av-modal-close" aria-label="Close">&times;</button>
            <div class="av-modal-hero" id="av-modal-hero">
                <img id="av-modal-img" class="av-modal-hero-img" src="" alt="">
                <div id="av-modal-cat-badge" class="av-modal-badge"></div>
                <div id="av-modal-hoy-badge" class="av-modal-hoy" style="display:none;">TODAY</div>
                <button type="button" id="av-modal-zoom" class="av-modal-zoom" style="display:none;"
                        aria-label="View full image"
                        title="View full image">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M15 3h6v6M9 21H3v-6M21 3l-7 7M3 21l7-7"/></svg>
                </button>
            </div>
            <div class="av-modal-body">
                <div class="av-modal-meta">
                    <span id="av-modal-date" class="av-modal-chip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="4" width="18" height="18" rx="2"/><path d="M16 2v4M8 2v4M3 10h18"/></svg>
                        <b id="av-modal-date-text"></b>
                    </span>
                    <span id="av-modal-time" class="av-modal-chip">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
                        <b id="av-modal-time-text"></b>
                    </span>
                </div>
                <h3 id="av-modal-title" class="av-modal-title"></h3>
                <div class="av-modal-venue">
                    <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 21s7-5.5 7-11a7 7 0 1 0-14 0c0 5.5 7 11 7 11Z"/><circle cx="12" cy="10" r="2.5"/></svg>
                    <span id="av-modal-place"></span>
                </div>
                <div class="av-modal-cost-bar"><span id="av-modal-cost"></span></div>
                <p id="av-modal-desc" class="av-modal-desc"></p>
                <div class="av-modal-actions">
                    <button type="button" id="av-modal-close-btn" class="av-modal-btn-sec">Close</button>
                </div>
            </div>
        </div>
    </div>

    <div id="av-visor" class="av-visor" role="dialog" aria-modal="true" aria-label="View full image">
        <div class="av-visor-marco">
            <img id="av-visor-img" class="av-visor-img" src="" alt="">
            <button type="button" id="av-visor-cerrar" class="av-visor-cerrar" aria-label="Close image">&times;</button>
        </div>
    </div>

    <script>
        const i18nModalEvento = {
            todoElDia: "All day",
            gratuito: "FREE",
            entradaLibre: "FREE ADMISSION"        };

        // El costo llega escrito por quien capturó el evento y puede venir en
        // cualquiera de los tres idiomas. Se reconocen las formas conocidas para
        // mostrarlas en el idioma de quien mira; lo demás (un precio) va tal cual.
        window.formatCostoGlobal = function (costoStr) {
            if (!costoStr) return i18nModalEvento.gratuito;

            const str = String(costoStr).trim().toUpperCase();

            if (str === 'GRATUITO' || str === 'GRATIS' || str === 'FREE' || str === 'GRATUIT') {
                return i18nModalEvento.gratuito;
            }
            if (str === 'ENTRADA LIBRE' || str === 'ENTRÉE LIBRE' || str === 'FREE ADMISSION') {
                return i18nModalEvento.entradaLibre;
            }

            return costoStr;
        };

        window.abrirModalEventoGlobal = function (e) {
            if (!e) return;

            const modalBg = document.getElementById('av-modal-backdrop');
            if (!modalBg) return;

            const hero = document.getElementById('av-modal-hero');
            const badge = document.getElementById('av-modal-cat-badge');
            const hoyBadge = document.getElementById('av-modal-hoy-badge');
            const dateText = document.getElementById('av-modal-date-text');
            const timeText = document.getElementById('av-modal-time-text');
            const title = document.getElementById('av-modal-title');
            const place = document.getElementById('av-modal-place');
            const cost = document.getElementById('av-modal-cost');
            const desc = document.getElementById('av-modal-desc');

            const color = e.color || '#5C113C';

            const heroImg = document.getElementById('av-modal-img');
            const zoomBtn = document.getElementById('av-modal-zoom');

            // Sin cartel no hay nada que ampliar: el botón se esconde con la
            // imagen, no se queda prometiendo una vista que no existe.
            if (zoomBtn) zoomBtn.style.display = e.img ? 'inline-flex' : 'none';

            if (hero && heroImg) {
                if (e.img) {
                    heroImg.src = e.img;
                    heroImg.alt = e.titulo || '';
                    heroImg.style.display = 'block';
                    hero.classList.remove('av-modal-hero-vacio');
                    hero.style.backgroundColor = '';
                } else {
                    // Sin cartel se queda el color de la categoría. El src se
                    // vacía además de esconder la etiqueta: si no, el navegador
                    // seguiría enseñando el cartel del evento anterior al abrir
                    // el siguiente.
                    heroImg.removeAttribute('src');
                    heroImg.style.display = 'none';
                    hero.classList.add('av-modal-hero-vacio');
                    hero.style.backgroundColor = color;
                }
            }

            const costoTxt = window.formatCostoGlobal(e.costo);

            /*
             * La etiqueta sobre el cartel se calla cuando dice lo MISMO que el
             * costo de abajo.
             *
             * Pasa siempre con los eventos gratuitos: el portal les añade
             * "GRATUITO" a las etiquetas, esa es la primera y por tanto la que
             * llega aquí como categoría, así que la palabra salía dos veces en
             * la misma ventana. Se compara sin distinguir mayúsculas ni acentos
             * porque cada sitio la escribe a su manera.
             */
            if (badge) {
                const categoria = (e.categoria || '').trim();
                const repetida = categoria !== '' && costoTxt
                    && categoria.localeCompare(costoTxt, undefined, { sensitivity: 'base' }) === 0;

                if (categoria !== '' && ! repetida) {
                    badge.textContent = categoria;
                    badge.style.backgroundColor = color;
                    badge.style.display = 'block';
                } else {
                    badge.style.display = 'none';
                }
            }

            if (hoyBadge) hoyBadge.style.display = e.hoy ? 'block' : 'none';

            const fechaStr = e.dia && e.mes ? `${e.dia} ${e.mes}` : (e.fecha || '');
            if (dateText) dateText.textContent = fechaStr;
            if (timeText) timeText.textContent = e.hora || i18nModalEvento.todoElDia;
            if (title) title.textContent = e.titulo || '';
            if (place) place.textContent = e.lugar || 'Veracruz';
            if (cost) cost.textContent = costoTxt;

            const detalleTxt = e.descripcion || e.observaciones || e.subtitulo || '';
            if (desc) {
                desc.textContent = detalleTxt;
                desc.style.display = detalleTxt ? 'block' : 'none';
            }

            modalBg.style.display = 'flex';
            document.documentElement.style.overflow = 'hidden';
            document.body.style.overflow = 'hidden';
        };

        window.cerrarModalEventoGlobal = function () {
            // Si el cartel estaba ampliado, se cierra con la ventana: dejarlo
            // abierto sobre la agenda sería una capa huérfana, sin nada debajo a
            // lo que volver.
            window.cerrarVisorEventoGlobal();

            const modalBg = document.getElementById('av-modal-backdrop');
            if (modalBg) {
                modalBg.style.display = 'none';
                document.documentElement.style.overflow = '';
                document.body.style.overflow = '';
            }
        };

        window.visorEventoAbierto = function () {
            const visor = document.getElementById('av-visor');
            return !! (visor && visor.classList.contains('abierto'));
        };

        window.abrirVisorEventoGlobal = function () {
            const visor = document.getElementById('av-visor');
            const heroImg = document.getElementById('av-modal-img');
            const visorImg = document.getElementById('av-visor-img');
            const card = document.getElementById('av-modal-card');
            if (! visor || ! heroImg || ! visorImg || ! heroImg.getAttribute('src')) return;

            visorImg.src = heroImg.src;
            visorImg.alt = heroImg.alt;
            visor.classList.add('abierto');

            /*
             * La ventana de debajo se apaga para el teclado mientras el visor
             * está delante. Sin esto, tabular desde el visor lleva a los botones
             * de la ventana, que se ven a medias detrás del velo: el foco se va
             * a un sitio que no se puede leer. `inert` es de 2022 para acá; en un
             * navegador anterior no hace nada y todo lo demás sigue funcionando.
             */
            if (card) card.inert = true;

            // El desplazamiento ya está bloqueado por la ventana del evento. No
            // se vuelve a tocar aquí a propósito (ver el comentario del estilo).
            const cerrar = document.getElementById('av-visor-cerrar');
            if (cerrar) cerrar.focus();
        };

        window.cerrarVisorEventoGlobal = function () {
            const visor = document.getElementById('av-visor');
            if (! visor || ! visor.classList.contains('abierto')) return;

            visor.classList.remove('abierto');

            const card = document.getElementById('av-modal-card');
            if (card) card.inert = false;

            // El foco vuelve al botón que abrió el visor, no al principio de la
            // página: quien navega con teclado se queda donde estaba.
            const zoomBtn = document.getElementById('av-modal-zoom');
            if (zoomBtn && zoomBtn.style.display !== 'none') zoomBtn.focus();
        };

        document.addEventListener('DOMContentLoaded', function () {
            /*
             * Las dos capas se mudan al final del <body> nada más cargar.
             *
             * Esta vista se incluye desde dentro de la sección de la agenda, y
             * esa sección cuelga de dos contenedores que llevan `relative z-10`.
             * Un elemento con z-index dentro de otro con z-index no puede
             * adelantarlo: lo de dentro se ordena SOLO respecto a sus hermanos,
             * y todo el grupo vale 10 frente al resto de la página. Por eso la
             * ventana, que pide 99999, se pintaba por DEBAJO de la barra de
             * navegación, que pide 50: la barra estaba fuera de esa caja y la
             * ventana dentro. Se veía en que la barra se quedaba encendida
             * mientras el resto de la página se oscurecía.
             *
             * Colgarlas del <body> las saca de esa caja y las deja compitiendo
             * con la barra de tú a tú, que es lo que su z-index ya decía. Los
             * escuchadores se ponen después de mudarlas, aunque daría igual:
             * viajan con el elemento.
             */
            [document.getElementById('av-modal-backdrop'), document.getElementById('av-visor')]
                .forEach(function (capa) {
                    if (capa && capa.parentElement !== document.body) document.body.appendChild(capa);
                });

            const closeBtn = document.getElementById('av-modal-close');
            const closeBtnSec = document.getElementById('av-modal-close-btn');
            const modalBg = document.getElementById('av-modal-backdrop');

            if (closeBtn) closeBtn.addEventListener('click', window.cerrarModalEventoGlobal);
            if (closeBtnSec) closeBtnSec.addEventListener('click', window.cerrarModalEventoGlobal);

            if (modalBg) {
                modalBg.addEventListener('click', function (ev) {
                    if (ev.target === modalBg) window.cerrarModalEventoGlobal();
                });
            }

            const zoomBtn = document.getElementById('av-modal-zoom');
            const visor = document.getElementById('av-visor');
            const visorCerrar = document.getElementById('av-visor-cerrar');

            if (zoomBtn) zoomBtn.addEventListener('click', window.abrirVisorEventoGlobal);
            if (visorCerrar) visorCerrar.addEventListener('click', window.cerrarVisorEventoGlobal);

            if (visor) {
                visor.addEventListener('click', function (ev) {
                    // Un clic en el fondo cierra; en la propia imagen, no. Quien
                    // está mirando un cartel suele pinchar encima sin querer
                    // cerrarlo.
                    if (ev.target === visor || ev.target.classList.contains('av-visor-marco')) {
                        window.cerrarVisorEventoGlobal();
                    }
                });
            }

            document.addEventListener('keydown', function (ev) {
                if (ev.key !== 'Escape') return;

                // Escape cierra UNA capa, la de encima. Si está el cartel
                // ampliado se cierra ese y la ventana del evento se queda: antes
                // de separarlo, la misma tecla cerraba las dos y quien miraba el
                // cartel acababa de vuelta en la agenda.
                if (window.visorEventoAbierto()) {
                    window.cerrarVisorEventoGlobal();
                    return;
                }

                window.cerrarModalEventoGlobal();
            });
        });
    </script>

<div id="contenedor-principal" class="w-full max-w-[440px] mx-auto lg:bg-transparent">
    <div id="overlay-calendario" class="fixed inset-0 w-screen h-screen bg-black/60 backdrop-blur-sm z-[9998] hidden opacity-0 transition-opacity duration-300"></div>

    <div id="contenedor-calendario" class="bg-brand-burgundy/95 border border-brand-gold/30 rounded-3xl p-5 sm:p-6 shadow-2xl relative backdrop-blur-md">

        <!-- Mobile Drawer Close Header -->
        <div id="btn-cerrar-drawer" class="min-[1248px]:hidden pb-4 mb-4 border-b border-brand-gold/20 flex justify-between items-center">
            <div>
                <span class="text-[10px] uppercase text-brand-gold tracking-widest block font-semibold">Navigation</span>
                <h3 class="text-lg font-bold text-white fuente-titulos">Event Calendar</h3>
            </div>
            <button id="close-btn" class="w-9 h-9 rounded-full bg-black/40 text-brand-gold hover:bg-brand-gold hover:text-brand-burgundy transition flex items-center justify-center text-xl font-bold">&times;</button>
        </div>
        
        <!-- Header Controls (Month & Navigation) -->
        <div class="flex flex-wrap items-center justify-between gap-2 pb-4 mb-4 border-b border-brand-gold/20">
            <div class="min-w-0 flex-1">
                <span class="text-[10px] uppercase text-brand-gold tracking-widest block font-bold">Select date</span>
                <h2 id="mesAnoDisplay" class="text-lg sm:text-xl font-bold text-brand-gold tracking-wide truncate"></h2>
            </div>

            <div class="flex items-center gap-1.5 shrink-0">
                <button type="button" id="prevMonth" class="w-8 h-8 rounded-xl bg-black/30 border border-brand-gold/30 hover:border-brand-gold text-brand-gold hover:bg-brand-gold hover:text-brand-burgundy transition flex items-center justify-center">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                        
                        <path d="M12.707 5.293a1 1 0 010 1.414L9.414 10l3.293 3.293a1 1 0 01-1.414 1.414l-4-4a1 1 0 010-1.414l4-4a1 1 0 011.414 0z"/>
                    </svg>
                </button>

                <button type="button" id="nextMonth" class="w-8 h-8 rounded-xl bg-black/30 border border-brand-gold/30 hover:border-brand-gold text-brand-gold hover:bg-brand-gold hover:text-brand-burgundy transition flex items-center justify-center">
                    <svg class="w-4 h-4 fill-current" viewBox="0 0 20 20">
                        <path d="M7.293 14.707a1 1 0 010-1.414L10.586 10 7.293 6.707a1 1 0 011.414-1.414l4 4a1 1 0 010 1.414l-4 4a1 1 0 01-1.414 0z"/>
                    </svg>
                </button>
            </div>
        </div>

        <input type="hidden" name="fecha_seleccionada" id="calendario" required>

        <!-- Featured Spotlight Card -->
        <div id="tarjeta-evento-destacado" 
             class="mt-5 p-4 rounded-2xl bg-black/40 border border-brand-gold/25 space-y-2.5 transition-all duration-300 hover:border-brand-gold/50 cursor-pointer group hidden"
             >
            <div class="flex items-center justify-between text-xs font-bold text-brand-gold">
                <span class="flex items-center gap-1.5">
                    <i class="pi pi-star-fill text-xs text-brand-gold animate-pulse"></i>
                    <span>Featured of the Month</span>
                </span>
                <span id="destacado-tag" class="text-[9px] uppercase tracking-wider text-brand-cream/80 font-semibold px-2 py-0.5 rounded-full bg-brand-gold/15 border border-brand-gold/25">
                    Schedule
                </span>
            </div>
            <h4 id="destacado-titulo" class="text-xs sm:text-sm font-bold text-white leading-snug group-hover:text-brand-gold transition-colors line-clamp-2">
                
            </h4>
            <div id="destacado-meta" class="flex flex-wrap items-center gap-2 text-[11px] text-brand-gold/90 font-medium">
                                            </div>
            <p id="destacado-desc" class="text-xs text-brand-cream/70 leading-relaxed line-clamp-2">
                
            </p>
            <div class="pt-1 flex items-center justify-between text-[11px] text-brand-gold font-semibold group-hover:translate-x-0.5 transition-transform">
                <span>descubre-ver::pages.agenda.ver_evento</span>
                <i class="pi pi-arrow-right text-[10px]"></i>
            </div>
        </div>

    </div>
</div>



            </div>
        </div>

    </div>
</section>                                            <!-- Map Preview Section -->
<section id="seccion-mapa" class="py-6 lg:py-8 bg-[#f8f5f0]">
