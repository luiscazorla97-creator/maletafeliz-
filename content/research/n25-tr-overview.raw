        <h1 class="area-detail-hero__title">Trento - A city to discover </h1>

                            <p class="area-detail-hero__subtitle">History, culture, and nature: the three pillars of Trento</p>
        
                                                                                                                                                                                                                                                            
                            <ul class="area-detail-hero__highlights list-unstyled">
                                                                        <li class="area-detail-hero__highlight-item">
                                <span class="area-detail-hero__highlight-dot" aria-hidden="true"></span>
